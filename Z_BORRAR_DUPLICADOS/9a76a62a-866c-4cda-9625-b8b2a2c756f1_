{% extends "base.html" %}
{% block content %}
<div class="container mx-auto p-6 bg-white rounded shadow text-black" style="max-width: 400px; margin-top: 80px; text-align:center;">
  <h2 class="text-2xl font-bold mb-4">{% trans "Password changed!" %}</h2>
  <p class="mb-4">{% trans "Your password has been successfully reset. You can now sign in with your new password." %}</p>
  {% load country_url %}
  <a href="{% country_url 'account_login' %}" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 w-full inline-block">{% trans "Sign in" %}</a>
</div>
{% endblock %}
