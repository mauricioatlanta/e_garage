{% extends 'base.html' %}
{% load static %}
{% load i18n %}

{% block title %}{{ empresa.nombre_taller }} - Space Command Center{% endblock %}

<!-- 🟠 IDENTIFICATION SQUARE - USA TEMPLATE -->
<div style="position: fixed; top: 10px; right: 10px; width: 50px; height: 50px; background-color: #ff8800; z-index: 9999; border: 3px solid #fff; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 12px;">USA</div>

{% block extra_css %}
<style>
/* 🚀 Estilo de Estación Espacial para Dashboard */
:root {
    --space-blue: #00d4ff;
    --space-cyan: #00ffff;
    --space-green: #00ff88;
    --space-gold: #ffd700;
    --space-red: #ff3b3b;
    --space-purple: #8a2be2;
    --dark-space: #0a0a0f;
    --panel-bg: rgba(5, 15, 25, 0.95);
    --glass-bg: rgba(255, 255, 255, 0.03);
    --holo-glow: 0 0 20px;
}

body {
    background:
        radial-gradient(circle at 20% 80%, rgba(120, 119, 198, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(255, 119, 198, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 40% 40%, rgba(120, 200, 255, 0.2) 0%, transparent 50%),
        linear-gradient(135deg, #0a0a0f 0%, #1a1a2e 50%, #16213e 100%);
    color: #ffffff;
    font-family: 'Orbitron', 'Segoe UI', monospace;
    overflow-x: hidden;
}

.space-container {
    background: var(--panel-bg);
    border: 2px solid var(--space-cyan);
    border-radius: 20px;
    backdrop-filter: blur(15px);
    box-shadow:
        var(--holo-glow) var(--space-cyan),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    position: relative;
    overflow: hidden;
}

.space-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--space-cyan), transparent);
    animation: scan-line 3s infinite;
}

@keyframes scan-line {
    0%, 100% { opacity: 0; }
    50% { opacity: 1; }
}

.command-panel {
    background: var(--glass-bg);
    border: 1px solid var(--space-purple);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
}

.command-panel:hover {
    border-color: var(--space-gold);
    transform: translateY(-8px) rotateX(5deg);
    box-shadow:
        var(--holo-glow) var(--space-gold),
        0 15px 35px rgba(255, 215, 0, 0.3);
    color: inherit;
    text-decoration: none;
}

.command-panel::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.1), transparent);
    transition: left 0.6s;
}

.command-panel:hover::before {
    left: 100%;
}

.nav-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
}

.console-text {
    font-family: 'Courier New', monospace;
    color: var(--space-green);
    font-size: 0.9rem;
}
</style>
{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto p-6">

    <!-- Language Selector -->
    <div class="absolute top-6 right-8 z-20 flex gap-2">
        <a href="?lang=es" class="px-3 py-1 rounded-full text-sm font-bold transition-all shadow-md bg-cyan-500/80 text-white hover:bg-cyan-700 {% if request.GET.lang == 'es' or not request.GET.lang %}ring-2 ring-yellow-300{% endif %}">{% trans "Español" %}</a>
        <a href="?lang=en" class="px-3 py-1 rounded-full text-sm font-bold transition-all shadow-md bg-cyan-100 text-cyan-900 hover:bg-cyan-300 {% if request.GET.lang == 'en' %}ring-2 ring-fuchsia-400{% endif %}">{% trans "English" %}</a>
    </div>

    <!-- 🚀 Mission Command Panel -->
    <div class="space-container p-6">
        <h3 class="text-xl font-bold text-cyan-400 mb-4 console-text">🚀 MISSION COMMAND PANEL</h3>
        <div class="nav-grid">

            <!-- Business Intelligence -->
            <a href="/us/business-intelligence/dashboard/" class="command-panel">
                <div class="text-3xl mb-2">🧠</div>
                <div class="font-semibold console-text">BUSINESS INTELLIGENCE</div>
                <div class="text-sm text-gray-400 console-text">Advanced Analytics</div>
            </a>

            <!-- Technical Personnel -->
            <a href="/us/taller/reportes/mecanicos/" class="command-panel">
                <div class="text-3xl mb-2">👨‍🔧</div>
                <div class="font-semibold console-text">TECHNICAL PERSONNEL</div>
                <div class="text-sm text-gray-400 console-text">Individual Analysis</div>
            </a>

            <!-- Document Engine -->
            <a href="/us/documentos/" class="command-panel">
                <div class="text-3xl mb-2">📄</div>
                <div class="font-semibold console-text">DOC ENGINE</div>
                <div class="text-sm text-gray-400 console-text">Digital Workflow</div>
            </a>

            <!-- Client Matrix -->
            <a href="/us/clientes/" class="command-panel">
                <div class="text-3xl mb-2">🌐</div>
                <div class="font-semibold console-text">CLIENT MATRIX</div>
                <div class="text-sm text-gray-400 console-text">360° Database</div>
            </a>

            <!-- Fleet Command -->
            <a href="/us/vehiculos/" class="command-panel">
                <div class="text-3xl mb-2">🚗</div>
                <div class="font-semibold console-text">FLEET CMD</div>
                <div class="text-sm text-gray-400 console-text">Vehicle Control</div>
            </a>

            <!-- System Core -->
            {% url 'configuracion' as url_configuracion %}
            {% if url_configuracion %}
                <a href="{{ url_configuracion }}" class="command-panel">
            {% else %}
                <a href="#" class="command-panel">
            {% endif %}
                <div class="text-3xl mb-2">⚙️</div>
                <div class="font-semibold console-text">SYSTEM CORE</div>
                <div class="text-sm text-gray-400 console-text">Advanced Settings</div>
            </a>
        </div>
    </div>

    <!-- 📊 Metrics Dashboard -->
    <div class="space-container p-6 mt-6">
        <h3 class="text-xl font-bold text-cyan-400 mb-4 console-text">📊 OPERATIONAL METRICS</h3>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Today's Documents -->
            <div class="bg-gradient-to-br from-cyan-500/20 to-blue-600/20 border border-cyan-400/30 rounded-lg p-4">
                <div class="text-2xl font-bold text-cyan-300">{{ documentos_hoy|default:"24" }}</div>
                <div class="text-sm text-gray-400">Documents Today</div>
                <div class="text-xs text-green-400">+15% vs yesterday</div>
            </div>

            <!-- Weekly Clients -->
            <div class="bg-gradient-to-br from-purple-500/20 to-pink-600/20 border border-purple-400/30 rounded-lg p-4">
                <div class="text-2xl font-bold text-purple-300">{{ clientes_atendidos_semana|default:"87" }}</div>
                <div class="text-sm text-gray-400">Weekly Clients</div>
                <div class="text-xs text-green-400">Current week</div>
            </div>

            <!-- System Status -->
            <div class="bg-gradient-to-br from-green-500/20 to-emerald-600/20 border border-green-400/30 rounded-lg p-4">
                <div class="text-2xl font-bold text-green-300">ONLINE</div>
                <div class="text-sm text-gray-400">System Status</div>
                <div class="text-xs text-green-400">All modules active</div>
            </div>

            <!-- Efficiency -->
            <div class="bg-gradient-to-br from-yellow-500/20 to-orange-600/20 border border-yellow-400/30 rounded-lg p-4">
                <div class="text-2xl font-bold text-yellow-300">94%</div>
                <div class="text-sm text-gray-400">Efficiency Rate</div>
                <div class="text-xs text-green-400">Conversion rate</div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
