{% extends 'base.html' %}
{% load static %}

{% block extra_head %}
<style>
.form-group {
  margin-bottom: 20px;
}
.form-group label {
  display: block;
  font-weight: 600;
  color: #00e6d0 !important;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 8px;
}
.form-control {
  width: 100%;
  padding: 12px;
  background: rgba(0,230,208,0.1) !important;
  border: 1px solid rgba(0,230,208,0.3) !important;
  border-radius: 6px;
  color: #fff !important;
  font-size: 16px;
}
.form-control:focus {
  outline: none;
  border-color: #00e6d0 !important;
  background: rgba(0,230,208,0.15) !important;
  box-shadow: 0 0 0 2px rgba(0,230,208,0.2);
}
.btn-futuristic {
  background: linear-gradient(45deg, #00e6d0, #00b3a0);
  border: none;
  color: white;
  padding: 12px 24px;
  border-radius: 6px;
  font-weight: 600;
  text-decoration: none;
  display: inline-block;
  margin-right: 10px;
  cursor: pointer;
  transition: all 0.3s ease;
}
.btn-futuristic:hover {
  background: linear-gradient(45deg, #00b3a0, #008a7a);
  color: white;
  text-decoration: none;
  transform: translateY(-2px);
  box-shadow: 0 4px 15px rgba(0,230,208,0.3);
}
.btn-secondary {
  background: linear-gradient(45deg, #6c757d, #545b62);
}
.btn-secondary:hover {
  background: linear-gradient(45deg, #545b62, #495057);
}
</style>
{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto mt-12 translucent-card p-8 rounded-xl shadow-md">
<h1 class="text-3xl font-bold text-black mb-6">Editar Vehículo</h1>

<!-- DEBUG: Ver campos disponibles -->
<div style="background: #333; color: #fff; padding: 10px; margin: 10px 0; font-size: 12px;">
  <strong>DEBUG - Campos disponibles:</strong><br>
  {% for field in form %}
    {{ field.name }}: {{ field|default:"NO DISPONIBLE" }}<br>
  {% endfor %}
</div>
<form class="space-y-6 text-black" method="post">
    {% csrf_token %}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <div class="form-group">
          <label for="{{ form.patente.id_for_label }}">Patente</label>
          {{ form.patente }}
          {% if form.patente.errors %}
            <div class="text-red-400 text-sm mt-1">{{ form.patente.errors.0 }}</div>
          {% endif %}
        </div>

        <div class="form-group">
          <label for="{{ form.vin.id_for_label }}">VIN</label>
          {{ form.vin }}
          {% if form.vin.errors %}
            <div class="text-red-400 text-sm mt-1">{{ form.vin.errors.0 }}</div>
          {% endif %}
        </div>

        <div class="form-group">
          <label for="{{ form.anio.id_for_label }}">Año</label>
          {{ form.anio }}
          {% if form.anio.errors %}
            <div class="text-red-400 text-sm mt-1">{{ form.anio.errors.0 }}</div>
          {% endif %}
        </div>

        <div class="form-group">
          <label for="{{ form.millas.id_for_label }}">Millas/Kilometraje</label>
          {{ form.millas }}
          {% if form.millas.errors %}
            <div class="text-red-400 text-sm mt-1">{{ form.millas.errors.0 }}</div>
          {% endif %}
        </div>

        <div class="form-group">
          <label for="{{ form.cliente.id_for_label }}">Cliente</label>
          {{ form.cliente }}
          {% if form.cliente.errors %}
            <div class="text-red-400 text-sm mt-1">{{ form.cliente.errors.0 }}</div>
          {% endif %}
        </div>

        <div class="form-group">
          <label for="{{ form.marca.id_for_label }}">Marca</label>
          {{ form.marca }}
          {% if form.marca.errors %}
            <div class="text-red-400 text-sm mt-1">{{ form.marca.errors.0 }}</div>
          {% endif %}
        </div>

        <div class="form-group">
          <label for="{{ form.modelo.id_for_label }}">Modelo</label>
          {{ form.modelo }}
          {% if form.modelo.errors %}
            <div class="text-red-400 text-sm mt-1">{{ form.modelo.errors.0 }}</div>
          {% endif %}
        </div>

        <div class="form-group">
          <label for="{{ form.color.id_for_label }}">Color</label>
          {{ form.color }}
          {% if form.color.errors %}
            <div class="text-red-400 text-sm mt-1">{{ form.color.errors.0 }}</div>
          {% endif %}
        </div>

        <div class="form-group">
          <label for="{{ form.motor.id_for_label }}">Motor</label>
          {{ form.motor }}
          {% if form.motor.errors %}
            <div class="text-red-400 text-sm mt-1">{{ form.motor.errors.0 }}</div>
          {% endif %}
        </div>

        <div class="form-group">
          <label for="{{ form.caja.id_for_label }}">Caja/Transmisión</label>
          {{ form.caja }}
          {% if form.caja.errors %}
            <div class="text-red-400 text-sm mt-1">{{ form.caja.errors.0 }}</div>
          {% endif %}
        </div>

      </div>
      <div class="flex gap-3 mt-8 pt-6 border-t border-gray-600">
        <button type="submit" class="btn-futuristic">
          💾 Guardar cambios
        </button>

        <a href="{% if request.path|slice:":4" == "/us/" %}/us/vehiculos/{{ object.id }}/{% else %}/cl/vehiculos/{{ object.id }}/{% endif %}"
           class="btn-futuristic btn-secondary">
          ❌ Cancelar
        </a>
      </div>
</form>
</div>
<script src="{% static 'js/formulario_vehiculo.js' %}"></script>

{% endblock %}
