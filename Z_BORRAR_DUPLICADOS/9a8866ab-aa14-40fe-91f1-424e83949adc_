// Modal para agregar nueva ciudad
document.addEventListener('DOMContentLoaded', function() {
  const btnAgregarCiudad = document.getElementById('btn-agregar-ciudad');
  const modal = document.getElementById('modal-nueva-ciudad');
  const btnCerrarModal = document.getElementById('btn-cerrar-modal');
  const btnCancelarModal = document.getElementById('btn-cancelar-modal');
  const formNuevaCiudad = document.getElementById('form-nueva-ciudad');
  const inputNombreCiudad = document.getElementById('input-nombre-ciudad');

  if (btnAgregarCiudad) {
    btnAgregarCiudad.addEventListener('click', function() {
      const regionSelect = document.querySelector('select[name="region"]');
      if (!regionSelect.value) {
        alert('Primero debes seleccionar una región');
        return;
      }
      modal.classList.remove('hidden');
      inputNombreCiudad.focus();
    });
  }

  if (btnCerrarModal) {
    btnCerrarModal.addEventListener('click', function() {
      modal.classList.add('hidden');
      inputNombreCiudad.value = '';
    });
  }

  if (btnCancelarModal) {
    btnCancelarModal.addEventListener('click', function() {
      modal.classList.add('hidden');
      inputNombreCiudad.value = '';
    });
  }

  if (formNuevaCiudad) {
    formNuevaCiudad.addEventListener('submit', function(e) {
      e.preventDefault();

      const nombreCiudad = inputNombreCiudad.value.trim();
      const regionSelect = document.querySelector('select[name="region"]');
      const regionId = regionSelect.value;

      if (!nombreCiudad) {
        alert('Por favor ingresa el nombre de la ciudad');
        return;
      }

      // Enviar solicitud AJAX para crear nueva ciudad
      fetch('{% url "agregar_ciudad" %}', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]').value
        },
        body: JSON.stringify({
          nombre: nombreCiudad,
          region_id: regionId
        })
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          // Agregar la nueva ciudad al select
          const ciudadSelect = document.querySelector('select[name="ciudad"]');
          const option = document.createElement('option');
          option.value = data.ciudad.id;
          option.textContent = data.ciudad.nombre;
          option.selected = true;
          ciudadSelect.appendChild(option);

          // Cerrar modal
          modal.classList.add('hidden');
          inputNombreCiudad.value = '';

          // Mostrar mensaje de éxito
          alert('Ciudad agregada exitosamente');
        } else {
          alert('Error: ' + data.error);
        }
      })
      .catch(error => {
        console.error('Error:', error);
        alert('Error al agregar la ciudad');
      });
    });
  }
});
</script>

