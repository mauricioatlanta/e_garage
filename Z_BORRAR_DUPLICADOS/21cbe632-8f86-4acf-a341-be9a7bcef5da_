<!doctype html><html><body style="font-family:system-ui;padding:16px;background:#0b1020;color:#e6f0ff">
  <h3 style="margin:0 0 12px">Agregar motor</h3>
  {% if error %}<div style="color:#f87171;margin-bottom:8px">{{ error }}</div>{% endif %}
  <form method="post">
    {% csrf_token %}
    <input type="hidden" name="modelo" value="{{ modelo.id }}">
    <div style="display:grid;gap:8px">
      <label>Nombre del motor *</label>
      <input name="nombre" class="form-control" style="padding:8px;border-radius:8px;border:1px solid #334155;background:#0b1020;color:#e6f0ff">
      <div style="display:flex;gap:8px;margin-top:12px">
        <button type="button" onclick="window.close()" class="px-3 py-2">Cancelar</button>
        <button type="submit" class="px-3 py-2" style="background:#16a34a;color:white;border-radius:8px">Guardar</button>
      </div>
    </div>
  </form>
</body></html>
