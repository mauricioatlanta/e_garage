{% extends "taller/us/en/base.html" %}
{% load static %}
{% load i18n %}

{% block space_content %}
<!-- USA Space Theme Header -->
<div class="relative mb-6">
  <div class="space-glow">
    <div class="space-card p-6">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-400 to-blue-600 flex items-center justify-center text-lg shadow-lg ring-2 ring-cyan-400/40">
            {% block space_icon %}🚀{% endblock %}
          </div>
          <div>
            <h1 class="space-title text-2xl font-extrabold tracking-tight">
              {% block space_title %}{% trans "Space Station" %}{% endblock %}
            </h1>
            <p class="space-text-muted text-xs">
              {% block space_subtitle %}{% trans "Advanced Management System" %}{% endblock %}
            </p>
          </div>
        </div>
        <div class="flex items-center space-x-4">
          <div class="flex items-center space-x-2 text-xs space-text">
            <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
            <span>{% trans "System Active" %}</span>
          </div>
          {% block space_actions %}{% endblock %}
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Main Content Area -->
<div class="space-content">
  {% block space_main_content %}{% endblock %}
</div>
{% endblock %}
