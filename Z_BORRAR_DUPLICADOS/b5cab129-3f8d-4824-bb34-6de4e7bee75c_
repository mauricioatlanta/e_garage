{% extends 'taller/us/en/base.html' %}{% load static %}
{% load humanize %}

{% block content %}
<style>
  /* Estilos futuristas y tecnológicos */
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');

  .futuristic-bg {
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 25%, #16213e 50%, #0f3460 75%, #533483 100%);
    background-size: 400% 400%;
    animation: gradientShift 15s ease infinite;
  }

  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .holographic-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(0, 255, 255, 0.2);
    box-shadow:
      0 0 20px rgba(0, 255, 255, 0.3),
      inset 0 0 20px rgba(0, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .holographic-card:hover {
    border-color: rgba(0, 255, 255, 0.5);
    box-shadow:
      0 0 30px rgba(0, 255, 255, 0.5),
      inset 0 0 30px rgba(0, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .neon-text {
    text-shadow:
      0 0 5px currentColor,
      0 0 10px currentColor,
      0 0 15px currentColor,
      0 0 20px currentColor;
    animation: neonPulse 2s ease-in-out infinite alternate;
  }

  @keyframes neonPulse {
    from { opacity: 1; }
    to { opacity: 0.8; }
  }

  .cyber-button {
    background: linear-gradient(45deg, #00ffff, #0080ff);
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    color: #000;
    font-weight: bold;
    font-family: 'Orbitron', monospace;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow:
      0 0 20px rgba(0, 255, 255, 0.5),
      inset 0 0 20px rgba(255, 255, 255, 0.2);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .cyber-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
    transition: left 0.5s;
  }

  .cyber-button:hover::before {
    left: 100%;
  }

  .cyber-button:hover {
    transform: translateY(-2px);
    box-shadow:
      0 0 30px rgba(0, 255, 255, 0.8),
      inset 0 0 30px rgba(255, 255, 255, 0.3);
  }

  .cyber-input {
    background: rgba(0, 0, 0, 0.7);
    border: 2px solid rgba(0, 255, 255, 0.3);
    border-radius: 8px;
    color: #00ffff;
    font-family: 'Orbitron', monospace;
    padding: 12px 16px;
    transition: all 0.3s ease;
  }

  .cyber-input:focus {
    outline: none;
    border-color: #00ffff;
    box-shadow: 0 0 20px rgba(0, 255, 255, 0.5);
  }

  .cyber-input::placeholder {
    color: rgba(0, 255, 255, 0.5);
  }

  .data-table {
    background: rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(0, 255, 255, 0.3);
    border-radius: 12px;
    overflow: hidden;
  }

  .data-table th {
    background: linear-gradient(45deg, #00ffff, #0080ff);
    color: #000;
    font-family: 'Orbitron', monospace;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 16px 12px;
    border-bottom: 2px solid rgba(0, 255, 255, 0.5);
  }

  .data-table td {
    padding: 12px;
    border-bottom: 1px solid rgba(0, 255, 255, 0.1);
    color: #fff;
    font-family: 'Orbitron', monospace;
  }

  .data-table tr:hover {
    background: rgba(0, 255, 255, 0.1);
    box-shadow: inset 0 0 20px rgba(0, 255, 255, 0.1);
  }

  .status-indicator {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin-right: 8px;
    animation: statusPulse 2s ease-in-out infinite;
  }

  .status-high { background: #00ff00; box-shadow: 0 0 10px #00ff00; }
  .status-medium { background: #ffff00; box-shadow: 0 0 10px #ffff00; }
  .status-low { background: #ff0000; box-shadow: 0 0 10px #ff0000; }

  @keyframes statusPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .floating-particles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .particle {
    position: absolute;
    width: 2px;
    height: 2px;
    background: #00ffff;
    border-radius: 50%;
    animation: float 6s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); opacity: 0; }
    50% { transform: translateY(-20px) rotate(180deg); opacity: 1; }
  }

  .scan-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, #00ffff, transparent);
    animation: scan 3s linear infinite;
  }

  @keyframes scan {
    0% { transform: translateY(0); }
    100% { transform: translateY(100vh); }
  }

  /* Efectos adicionales */
  .font-orbitron {
    font-family: 'Orbitron', monospace;
  }

  .glitch-text {
    position: relative;
    animation: glitch 2s infinite;
  }

  @keyframes glitch {
    0%, 100% { transform: translate(0); }
    20% { transform: translate(-2px, 2px); }
    40% { transform: translate(-2px, -2px); }
    60% { transform: translate(2px, 2px); }
    80% { transform: translate(2px, -2px); }
  }

  .cyber-grid {
    background-image:
      linear-gradient(rgba(0, 255, 255, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 20px 20px;
    animation: gridMove 20s linear infinite;
  }

  @keyframes gridMove {
    0% { transform: translate(0, 0); }
    100% { transform: translate(20px, 20px); }
  }
</style>

<div class="relative min-h-screen futuristic-bg overflow-hidden">
  <!-- Grid cyber de fondo -->
  <div class="absolute inset-0 cyber-grid opacity-20"></div>

  <!-- Efectos de partículas flotantes -->
  <div class="floating-particles">
    {% for i in "123456789" %}
    <div class="particle" style="left: {{ forloop.counter|add:10 }}%; animation-delay: {{ forloop.counter|add:2 }}s;"></div>
    {% endfor %}
  </div>

  <!-- Línea de escaneo -->
  <div class="scan-line"></div>

  <!-- Contenido principal -->
  <div class="relative z-10 container mx-auto px-4 py-12">
    <!-- Navigation Menu -->
    <div class="mb-8">
      <div class="holographic-card p-4">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-gradient-to-br from-cyan-400 to-blue-600 rounded-full flex items-center justify-center shadow-lg">
              <i class="fas fa-microchip text-xl text-white"></i>
            </div>
            <div>
              <h1 class="text-3xl font-black neon-text text-cyan-400 font-orbitron">
                INVENTARIO CYBER
              </h1>
              <p class="text-cyan-300 font-orbitron text-xs tracking-wider">
                SISTEMA DE GESTIÓN DE REPUESTOS
              </p>
            </div>
          </div>

          <!-- Navigation Buttons -->
          <div class="flex flex-wrap items-center gap-2">
            <a href="{% url 'us:$1' %} %}" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-gradient-to-r from-blue-500/20 to-indigo-600/20 border border-blue-400/40 hover:border-blue-300/80 text-blue-300 hover:text-blue-100 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-blue-500/40">
              <i class="fas fa-home text-sm"></i>
              <span class="text-sm font-medium">{% trans "Operations Center" %}</span>
            </a>

            <a href="{% url 'us:$1' %} %}" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-gradient-to-r from-green-500/20 to-emerald-600/20 border border-green-400/40 hover:border-green-300/80 text-green-300 hover:text-green-100 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-green-500/40">
              <i class="fas fa-car text-sm"></i>
              <span class="text-sm font-medium">{% trans "Vehicles" %}</span>
            </a>

            <a href="{% url 'us:$1' %} %}" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-gradient-to-r from-purple-500/20 to-violet-600/20 border border-purple-400/40 hover:border-purple-300/80 text-purple-300 hover:text-purple-100 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-purple-500/40">
              <i class="fas fa-users text-sm"></i>
              <span class="text-sm font-medium">{% trans "Clients" %}</span>
            </a>

            <a href="{% if request.user.empresa.pais == 'CL' %}{% url 'cl:documentos:lista_documentos' %} %}{% else %}{% url 'us:documentos:lista_documentos' %} %}{% endif %}" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-gradient-to-r from-orange-500/20 to-amber-600/20 border border-orange-400/40 hover:border-orange-300/80 text-orange-300 hover:text-orange-100 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-orange-500/40">
              <i class="fas fa-file-alt text-sm"></i>
              <span class="text-sm font-medium">{% trans "Documents" %}</span>
            </a>

            <a href="{% url 'us:$1' %} %}" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-gradient-to-r from-indigo-500/20 to-blue-600/20 border border-indigo-400/40 hover:border-indigo-300/80 text-indigo-300 hover:text-indigo-100 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-indigo-500/40">
              <i class="fas fa-chart-bar text-sm"></i>
              <span class="text-sm font-medium">{% trans "Reports" %}</span>
            </a>

            <a href="{% url 'us:$1' %} %}" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-gradient-to-r from-gray-500/20 to-slate-600/20 border border-gray-400/40 hover:border-gray-300/80 text-gray-300 hover:text-gray-100 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-gray-500/40">
              <i class="fas fa-cog text-sm"></i>
              <span class="text-sm font-medium">{% trans "Settings" %}</span>
            </a>

            <a href="{% url 'us:$1' %} %}" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-gradient-to-r from-teal-500/20 to-cyan-600/20 border border-teal-400/40 hover:border-teal-300/80 text-teal-300 hover:text-teal-100 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-teal-500/40">
              <i class="fas fa-wrench text-sm"></i>
              <span class="text-sm font-medium">{% trans "Services" %}</span>
            </a>

            <a href="{% url 'us:$1' %} %}" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-gradient-to-r from-pink-500/20 to-rose-600/20 border border-pink-400/40 hover:border-pink-300/80 text-pink-300 hover:text-pink-100 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-pink-500/40">
              <i class="fas fa-tools text-sm"></i>
              <span class="text-sm font-medium">{% trans "Other Services" %}</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Header futurista con botón de agregar -->
    <div class="flex justify-between items-center mb-8">
      <div class="flex items-center gap-4">
        <div class="w-16 h-16 bg-gradient-to-br from-cyan-400 to-blue-600 rounded-full flex items-center justify-center shadow-lg">
          <i class="fas fa-microchip text-2xl text-white"></i>
        </div>
        <div>
          <h1 class="text-5xl font-black neon-text text-cyan-400 font-orbitron">
            INVENTARIO CYBER
          </h1>
          <p class="text-cyan-300 font-orbitron text-sm tracking-wider">
            SISTEMA DE GESTIÓN DE REPUESTOS
          </p>
        </div>
      </div>

      <a href="{% url 'us:$1' %} %}" class="cyber-button">
        <i class="fas fa-plus mr-2"></i>
        NUEVO REPUESTO
      </a>
    </div>

    <!-- Panel de búsqueda holográfico -->
    <div class="holographic-card p-6 mb-8">
      <div class="flex items-center gap-4">
        <div class="flex-1 relative">
          <input type="text" id="busqueda-repuesto"
                 placeholder="ESCANEAR REPUESTO..."
                 class="cyber-input w-full pl-12">
          <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-cyan-400"></i>
          <div id="loading-spinner" class="absolute right-4 top-1/2 transform -translate-y-1/2 hidden">
            <i class="fas fa-spinner fa-spin text-cyan-400"></i>
          </div>
        </div>
        <div class="text-cyan-300 font-orbitron text-sm">
          <i class="fas fa-database mr-1"></i>
          <span id="total-resultados">SINCRONIZADO</span>
        </div>
      </div>
    </div>

    <!-- Tabla de datos futurista -->
    <div class="data-table">
      <table class="w-full">
        <thead>
          <tr>
            <th><i class="fas fa-tag mr-2"></i>COMPONENTE</th>
            <th><i class="fas fa-barcode mr-2"></i>PART #</th>
            <th><i class="fas fa-store mr-2"></i>PROVEEDOR</th>
            <th><i class="fas fa-dollar-sign mr-2"></i>COSTO</th>
            <th><i class="fas fa-chart-line mr-2"></i>PRECIO</th>
            <th><i class="fas fa-boxes mr-2"></i>STOCK</th>
            <th><i class="fas fa-cogs mr-2"></i>ACCIONES</th>
          </tr>
        </thead>
        <tbody id="tabla-repuestos">
          {% for repuesto in repuestos %}
          <tr class="hover:bg-cyan-900/20 transition-all duration-300">
            <td class="font-bold text-cyan-300">{{ repuesto.nombre_repuesto }}</td>
            <td class="font-mono text-blue-300">{{ repuesto.part_number|default:"N/A" }}</td>
            <td>
              {% if repuesto.tienda %}
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs bg-cyan-900/50 text-cyan-300 border border-cyan-400/30">
                  <i class="fas fa-store mr-1"></i>
                  {{ repuesto.tienda.nombre }}
                </span>
              {% else %}
                <span class="text-gray-400">-</span>
              {% endif %}
            </td>
            <td class="text-right font-mono text-yellow-400">${{ repuesto.precio_compra|floatformat:0|intcomma }}</td>
            <td class="text-right font-mono text-green-400 font-bold">${{ repuesto.precio_venta|floatformat:0|intcomma }}</td>
            <td class="text-right">
              <div class="flex items-center justify-end">
                {% if repuesto.stock > 10 %}
                  <span class="status-indicator status-high"></span>
                  <span class="text-green-400 font-bold">{{ repuesto.stock }}</span>
                {% elif repuesto.stock > 0 %}
                  <span class="status-indicator status-medium"></span>
                  <span class="text-yellow-400 font-bold">{{ repuesto.stock }}</span>
                {% else %}
                  <span class="status-indicator status-low"></span>
                  <span class="text-red-400 font-bold">{{ repuesto.stock }}</span>
                {% endif %}
              </div>
            </td>
            <td class="text-center">
              <div class="flex justify-center gap-2">
                <a href="{% url 'us:$1' %} repuesto.pk %}"
                   class="w-8 h-8 bg-blue-600/50 hover:bg-blue-600 rounded flex items-center justify-center transition-all duration-300 hover:scale-110"
                   title="Ver detalles">
                  <i class="fas fa-eye text-blue-300"></i>
                </a>
                <a href="{% url 'us:$1' %} repuesto.pk %}"
                   class="w-8 h-8 bg-green-600/50 hover:bg-green-600 rounded flex items-center justify-center transition-all duration-300 hover:scale-110"
                   title="Editar">
                  <i class="fas fa-edit text-green-300"></i>
                </a>
              </div>
            </td>
          </tr>
          {% empty %}
          <tr>
            <td colspan="7" class="px-8 py-12 text-center">
              <div class="flex flex-col items-center gap-4">
                <div class="w-20 h-20 bg-cyan-900/50 rounded-full flex items-center justify-center">
                  <i class="fas fa-search text-3xl text-cyan-400"></i>
                </div>
                <div class="text-cyan-300 font-orbitron">
                  <p class="text-lg">SIN DATOS DETECTADOS</p>
                  <p class="text-sm opacity-70">No hay repuestos registrados en el sistema</p>
                </div>
              </div>
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  // Variables para la búsqueda AJAX futurista
  let timeoutId;
  const searchInput = document.getElementById("busqueda-repuesto");
  const tablaRepuestos = document.getElementById("tabla-repuestos");
  const loadingSpinner = document.getElementById("loading-spinner");
  const totalResultados = document.getElementById("total-resultados");

  // Efectos de sonido y feedback visual
  function playScanSound() {
    // Simular sonido de escaneo (en un entorno real se usaría Web Audio API)
    console.log('🔊 SCAN SOUND: BEEP BEEP');
  }

  function showScanEffect() {
    // Efecto visual de escaneo
    const scanEffect = document.createElement('div');
    scanEffect.className = 'absolute inset-0 bg-gradient-to-r from-transparent via-cyan-400/20 to-transparent pointer-events-none';
    scanEffect.style.animation = 'scan 0.5s ease-out';
    document.querySelector('.data-table').appendChild(scanEffect);

    setTimeout(() => scanEffect.remove(), 500);
  }

  // Función para realizar búsqueda AJAX con efectos futuristas
  function buscarRepuestos(query) {
    // Mostrar loading con efectos
    loadingSpinner.classList.remove('hidden');
    playScanSound();
    showScanEffect();

    console.log('🔍 INICIANDO ESCANEO CYBER:', query);

    // Actualizar estado visual
    totalResultados.textContent = 'ESCANEANDO...';

    fetch('{% url 'us:$1' %} %}', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]').value ||
                       document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({ 'query': query })
    })
    .then(response => {
      console.log('📡 RESPUESTA CYBER:', response.status);
      return response.json();
    })
    .then(data => {
      console.log('📊 DATOS PROCESADOS:', data);

      // Actualizar tabla con resultados
      tablaRepuestos.innerHTML = data.html;

      // Mostrar información de resultados con estilo futurista
      if (query.trim() === '') {
        totalResultados.textContent = 'SINCRONIZADO';
      } else {
        totalResultados.textContent = `${data.total} COMPONENTE${data.total !== 1 ? 'S' : ''} DETECTADO${data.total !== 1 ? 'S' : ''}`;
      }

      // Ocultar loading
      loadingSpinner.classList.add('hidden');

      // Efecto de éxito
      if (data.total > 0) {
        showScanEffect();
      }
    })
    .catch(error => {
      console.error('❌ ERROR CYBER:', error);
      loadingSpinner.classList.add('hidden');
      totalResultados.textContent = 'ERROR DE CONEXIÓN';

      // Mostrar mensaje de error futurista
      tablaRepuestos.innerHTML = `
        <tr>
          <td colspan="7" class="px-8 py-12 text-center">
            <div class="flex flex-col items-center gap-4">
              <div class="w-20 h-20 bg-red-900/50 rounded-full flex items-center justify-center">
                <i class="fas fa-exclamation-triangle text-3xl text-red-400"></i>
              </div>
              <div class="text-red-300 font-orbitron">
                <p class="text-lg">ERROR DE SISTEMA</p>
                <p class="text-sm opacity-70">Fallo en la conexión de red</p>
              </div>
            </div>
          </td>
        </tr>
      `;
    });
  }

  // Evento de búsqueda con delay y efectos
  searchInput.addEventListener("input", function() {
    const query = this.value.trim();

    // Limpiar timeout anterior
    clearTimeout(timeoutId);

    // Efecto de escritura
    if (query.length > 0) {
      this.style.borderColor = 'rgba(0, 255, 255, 0.8)';
      this.style.boxShadow = '0 0 20px rgba(0, 255, 255, 0.5)';
    } else {
      this.style.borderColor = 'rgba(0, 255, 255, 0.3)';
      this.style.boxShadow = 'none';
    }

    // Establecer nuevo timeout para búsqueda (300ms delay)
    timeoutId = setTimeout(() => {
      buscarRepuestos(query);
    }, 300);
  });

  // Búsqueda inicial si hay contenido en el campo
  document.addEventListener('DOMContentLoaded', function() {
    if (searchInput.value.trim() !== '') {
      buscarRepuestos(searchInput.value.trim());
    }

    // Efecto de inicialización del sistema
    console.log('🚀 SISTEMA CYBER INICIADO');
    console.log('🔧 MÓDULO DE INVENTARIO ACTIVO');
  });

  // Agregar token CSRF si no existe
  if (!document.querySelector('[name=csrfmiddlewaretoken]') && !document.querySelector('meta[name="csrf-token"]')) {
    const csrfMeta = document.createElement('meta');
    csrfMeta.name = 'csrf-token';
    csrfMeta.content = '{{ csrf_token }}';
    document.head.appendChild(csrfMeta);
  }

  // Efectos adicionales de partículas dinámicas
  function createParticle() {
    const particle = document.createElement('div');
    particle.className = 'particle';
    particle.style.left = Math.random() * 100 + '%';
    particle.style.animationDelay = Math.random() * 6 + 's';
    document.querySelector('.floating-particles').appendChild(particle);

    setTimeout(() => particle.remove(), 6000);
  }

  // Crear partículas adicionales cada 2 segundos
  setInterval(createParticle, 2000);
</script>
{% endblock %}
