{% extends 'taller/us/en/base.html' %}{% load widget_tweaks i18n %}

{% block content %}
<div class="max-w-4xl mx-auto">
  <!-- Form Container -->
  <div class="bg-gray-800 p-6 rounded-lg border border-cyan-500/30">
    <div class="mb-6">
      <h2 class="text-2xl font-bold text-cyan-300 mb-2">🔧 {% trans "Create Part" %}</h2>
      <p class="text-gray-400 text-sm">{% trans "Fill in the details for the new part" %}</p>
    </div>

          <form method="post" class="space-y-6">
            {% csrf_token %}

            <!-- Part Number and Name Row -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="{{ form.part_number.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                  {% trans "Part Number" %} <span class="text-red-400">*</span>
                </label>
                {{ form.part_number|add_class:"w-full px-4 py-3 rounded-lg bg-gray-800/50 border border-gray-600/50 text-white placeholder-gray-400 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20 focus:outline-none transition-all duration-300" }}
                {% if form.part_number.errors %}
                  <div class="mt-1 text-red-400 text-sm">{{ form.part_number.errors.0 }}</div>
                {% endif %}
              </div>

              <div>
                <label for="{{ form.nombre.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                  {% trans "Part Name" %} <span class="text-red-400">*</span>
                </label>
                {{ form.nombre|add_class:"w-full px-4 py-3 rounded-lg bg-gray-800/50 border border-gray-600/50 text-white placeholder-gray-400 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20 focus:outline-none transition-all duration-300" }}
                {% if form.nombre.errors %}
                  <div class="mt-1 text-red-400 text-sm">{{ form.nombre.errors.0 }}</div>
                {% endif %}
              </div>
            </div>

            <!-- Category -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="{{ form.categoria.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                  {% trans "Category" %}
                </label>
                {{ form.categoria|add_class:"w-full px-4 py-3 rounded-lg bg-gray-800/50 border border-gray-600/50 text-white focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20 focus:outline-none transition-all duration-300" }}
                {% if form.categoria.errors %}
                  <div class="mt-1 text-red-400 text-sm">{{ form.categoria.errors.0 }}</div>
                {% endif %}
              </div>
            </div>

            <!-- Purchase and Sale Price Row -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="{{ form.precio_compra.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                  {% trans "Purchase Price" %} <span class="text-red-400">*</span>
                </label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">$</span>
                  {{ form.precio_compra|add_class:"w-full pl-8 pr-4 py-3 rounded-lg bg-gray-800/50 border border-gray-600/50 text-white placeholder-gray-400 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20 focus:outline-none transition-all duration-300" }}
                </div>
                {% if form.precio_compra.errors %}
                  <div class="mt-1 text-red-400 text-sm">{{ form.precio_compra.errors.0 }}</div>
                {% endif %}
              </div>

              <div>
                <label for="{{ form.precio_venta.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                  {% trans "Sale Price" %} <span class="text-red-400">*</span>
                </label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">$</span>
                  {{ form.precio_venta|add_class:"w-full pl-8 pr-4 py-3 rounded-lg bg-gray-800/50 border border-gray-600/50 text-white placeholder-gray-400 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20 focus:outline-none transition-all duration-300" }}
                </div>
                {% if form.precio_venta.errors %}
                  <div class="mt-1 text-red-400 text-sm">{{ form.precio_venta.errors.0 }}</div>
                {% endif %}
              </div>
            </div>

            <!-- Stock Quantity -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="{{ form.cantidad_stock.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                  {% trans "Stock Quantity" %}
                </label>
                {{ form.cantidad_stock|add_class:"w-full px-4 py-3 rounded-lg bg-gray-800/50 border border-gray-600/50 text-white placeholder-gray-400 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20 focus:outline-none transition-all duration-300" }}
                {% if form.cantidad_stock.errors %}
                  <div class="mt-1 text-red-400 text-sm">{{ form.cantidad_stock.errors.0 }}</div>
                {% endif %}
              </div>
            </div>

            <!-- Supplier -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="{{ form.proveedor.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                  {% trans "Supplier" %}
                </label>
                {{ form.proveedor|add_class:"w-full px-4 py-3 rounded-lg bg-gray-800/50 border border-gray-600/50 text-white placeholder-gray-400 focus:border-cyan-400 focus:ring-2 focus:ring-cyan-400/20 focus:outline-none transition-all duration-300" }}
                {% if form.proveedor.errors %}
                  <div class="mt-1 text-red-400 text-sm">{{ form.proveedor.errors.0 }}</div>
                {% endif %}
              </div>
            </div>


            <!-- Form Actions -->
            <div class="flex flex-col sm:flex-row gap-4 pt-6">
              <button type="submit" class="flex-1 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-600 hover:to-blue-700 text-white font-medium transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-cyan-500/40">
                <i class="fas fa-save text-sm"></i>
                <span>{% trans "Create Part" %}</span>
              </button>

              <a href="{% url 'us:repuestos:lista_repuestos' %} %}" class="flex-1 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg bg-gradient-to-r from-gray-600 to-gray-700 hover:from-gray-700 hover:to-gray-800 text-white font-medium transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-gray-500/40">
                <i class="fas fa-times text-sm"></i>
                <span>{% trans "Cancel" %}</span>
              </a>
            </div>
          </form>
  </div>
</div>

<!-- JavaScript for form enhancements -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Auto-format price inputs
  const priceInputs = document.querySelectorAll('input[name="precio_compra"], input[name="precio_venta"]');
  priceInputs.forEach(input => {
    // Allow typing decimals naturally
    input.addEventListener('input', function(e) {
      let value = e.target.value;
      // Remove any characters that aren't digits or decimal point
      value = value.replace(/[^\d.]/g, '');

      // Prevent multiple decimal points
      const parts = value.split('.');
      if (parts.length > 2) {
        value = parts[0] + '.' + parts.slice(1).join('');
      }

      // Limit to 2 decimal places
      if (parts.length === 2 && parts[1].length > 2) {
        value = parts[0] + '.' + parts[1].substring(0, 2);
      }

      e.target.value = value;
    });

    // Format to 2 decimal places on blur (when user finishes typing)
    input.addEventListener('blur', function(e) {
      let value = parseFloat(e.target.value);
      if (!isNaN(value)) {
        e.target.value = value.toFixed(2);
      }
    });
  });

  // Auto-format stock input
  const stockInput = document.querySelector('input[name="cantidad_stock"]');
  if (stockInput) {
    stockInput.addEventListener('input', function(e) {
      e.target.value = e.target.value.replace(/[^\d]/g, '');
    });
  }
});
</script>
{% endblock content %}
