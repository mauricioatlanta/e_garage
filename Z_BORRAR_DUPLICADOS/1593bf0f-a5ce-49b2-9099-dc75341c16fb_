{% extends 'base.html' %}
{% load static %}
{% load country_url %}

<!-- Endpoints country-aware (sin hardcode) -->
<script>
  // Prefijo robusto desde la URL actual (/cl/es/ o /us/en/)
  window.__EG_PREFIX__ = (function(){
    const m = location.pathname.match(/^\/(cl|us)(?:\/(es|en))?\//i);
    const country = (m?.[1] || 'cl').toLowerCase();
    const lang    = (m?.[2] || 'es').toLowerCase();
    return `/${country}/${lang}/`;
  })();

  // Endpoints country-aware (Django los genera con el tag country_url)
  window.EG = window.EG || {};
  window.EG.endpoints = {
    buscarClientes: "{% country_url 'taller:ajax_buscar_clientes' %}" || window.__EG_PREFIX__ + "ajax/clientes/buscar/",
    vehiculosPorCliente: "{% country_url 'taller:ajax_vehiculos_por_cliente' %}" || window.__EG_PREFIX__ + "ajax/vehiculos-por-cliente/",
    numeroDocumento: "{% country_url 'taller:api_obtener_numero_documento' %}" || window.__EG_PREFIX__ + "documentos/api/obtener-numero-documento/",
    repuestoPorCodigo: "{% country_url 'taller:api_repuesto_por_codigo' %}" || window.__EG_PREFIX__ + "repuestos/api/repuesto-por-codigo/",
  };

  console.log('🔍 EG endpoints generados:', window.EG.endpoints);

  // Parche: si por alguna razón faltara el tag, caemos a prefijo inferido
  for (const [k,v] of Object.entries(window.EG.endpoints)) {
    if (!v || v === 'None') {
      if (k === 'buscarClientes')     window.EG.endpoints[k] = window.__EG_PREFIX__ + "ajax/clientes/buscar/";
      if (k === 'vehiculosPorCliente')window.EG.endpoints[k] = window.__EG_PREFIX__ + "ajax/vehiculos-por-cliente/";
      if (k === 'numeroDocumento')    window.EG.endpoints[k] = window.__EG_PREFIX__ + "documentos/api/obtener-numero-documento/";
      if (k === 'repuestoPorCodigo')  window.EG.endpoints[k] = window.__EG_PREFIX__ + "repuestos/api/repuesto-por-codigo/";
    }
  }

  // Parche DAL: corrige /autocomplete/cliente → /cl/es/autocomplete/cliente
  (function(){
    if (!window.jQuery) return;
    $.ajaxPrefilter(function (options) {
      if (/^\/?autocomplete\/cliente\/?(\?|$)/i.test(options.url)) {
        options.url = options.url.replace(/^\/?autocomplete\/cliente\/?/i, window.__EG_PREFIX__ + 'autocomplete/cliente/');
        console.log('🔁 Reescrito DAL →', options.url);
      }
    });
  })();
</script>

