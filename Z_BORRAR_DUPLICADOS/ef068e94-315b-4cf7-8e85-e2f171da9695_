{% extends "base.html" %}
{% load i18n static widget_tweaks %}

{% block content %}
<!-- Fondo animado -->
<div class="fixed inset-0 overflow-hidden pointer-events-none">
  <div class="absolute inset-0 bg-gradient-to-br from-[#0a0a0a] via-[#0d1117] to-[#0f172a]"></div>
  <!-- Partículas animadas -->
  <div class="absolute top-16 left-12 w-2 h-2 bg-cyan-400 rounded-full animate-ping opacity-20"></div>
  <div class="absolute top-1/3 right-20 w-1 h-1 bg-fuchsia-400 rounded-full animate-pulse opacity-30"></div>
  <div class="absolute bottom-24 left-1/4 w-1.5 h-1.5 bg-lime-400 rounded-full animate-bounce opacity-25"></div>
  <div class="absolute top-2/3 left-1/5 w-1 h-1 bg-emerald-400 rounded-full animate-ping opacity-20"></div>
  <div class="absolute bottom-1/2 right-1/3 w-2 h-2 bg-purple-400 rounded-full animate-pulse opacity-15"></div>
</div>

<div class="relative min-h-screen p-4 sm:p-6">
  <!-- Header compacto -->
  <div class="relative mb-6">
    <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-cyan-500 via-fuchsia-500 to-lime-400 opacity-20 blur-xl animate-pulse"></div>
    <div class="relative rounded-2xl border border-cyan-400/30 bg-gradient-to-r from-[#0d1117]/90 to-[#111827]/90 backdrop-blur-sm p-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-orange-400 to-yellow-600 flex items-center justify-center text-xl shadow-lg ring-2 ring-orange-400/40">✏️</div>
          <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-orange-300 via-yellow-300 to-amber-400">
              {% trans "Edit Vehicle" %}
            </h1>
            <p class="text-gray-400 text-xs mt-0.5">{% trans "Update vehicle information" %}</p>
          </div>
        </div>

        <a href="{% url 'vehiculos_usa:lista_vehiculos' %}"
           class="inline-flex items-center space-x-2 px-4 py-2 rounded-xl bg-gradient-to-r from-gray-600/20 to-gray-500/20 border border-gray-400/40 text-gray-300 hover:from-gray-500/30 hover:to-gray-400/30 hover:text-gray-200 transition-all duration-300">
          <span>⟲</span>
          <span class="hidden sm:inline">{% trans "Back" %}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Formulario -->
  <div class="max-w-4xl mx-auto">
    <form method="post" class="space-y-6">
      {% csrf_token %}

      <!-- Información del Cliente -->
      <div class="relative z-50">
        <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-cyan-500/20 via-blue-500/20 to-purple-500/20 blur-xl"></div>
        <div class="relative rounded-xl border border-cyan-400/30 bg-gradient-to-r from-[#0d1117]/90 to-[#111827]/90 backdrop-blur-sm p-6">
          <div class="flex items-center space-x-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-500/30 to-blue-500/30 border border-cyan-400/40 flex items-center justify-center">
              <span class="text-cyan-300 text-sm">👤</span>
            </div>
            <h2 class="text-lg font-bold text-cyan-300">{% trans "Client Information" %}</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="{{ form.cliente.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                {% trans "Client" %} *
              </label>
              {{ form.cliente|add_class:"w-full px-4 py-3 rounded-lg bg-black border border-cyan-500/30 text-cyan-200 focus:outline-none focus:ring-2 focus:ring-cyan-400/50 focus:border-cyan-400" }}
              {% if form.cliente.errors %}
                <div class="mt-1 text-xs text-red-400">
                  {{ form.cliente.errors.0 }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <!-- Información del Vehículo -->
      <div class="relative">
        <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-emerald-500/20 via-lime-500/20 to-green-500/20 blur-xl"></div>
        <div class="relative rounded-xl border border-emerald-400/30 bg-gradient-to-r from-[#0d1117]/90 to-[#111827]/90 backdrop-blur-sm p-6">
          <div class="flex items-center space-x-3 mb-6">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-emerald-500/30 to-green-500/30 border border-emerald-400/40 flex items-center justify-center">
              <span class="text-emerald-300 text-sm">🚗</span>
            </div>
            <h2 class="text-lg font-bold text-emerald-300">{% trans "Vehicle Data" %}</h2>
          </div>

          <!-- Primera fila: Año, Marca, Modelo -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
            <!-- Año -->
            <div>
              <label for="{{ form.anio.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                {% trans "Year" %} *
              </label>
              {{ form.anio|add_class:"w-full px-4 py-3 rounded-lg bg-black border border-emerald-500/30 text-emerald-200 focus:outline-none focus:ring-2 focus:ring-emerald-400/50 focus:border-emerald-400" }}
              {% if form.anio.errors %}
                <div class="mt-1 text-xs text-red-400">
                  {{ form.anio.errors.0 }}
                </div>
              {% endif %}
            </div>

            <!-- Marca -->
            <div>
              <label for="{{ form.marca_texto.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                {% trans "Brand" %} *
              </label>
              {{ form.marca_texto|add_class:"w-full px-4 py-3 rounded-lg bg-black border border-emerald-500/30 text-emerald-200 focus:outline-none focus:ring-2 focus:ring-emerald-400/50 focus:border-emerald-400" }}
              {% if form.marca_texto.errors %}
                <div class="mt-1 text-xs text-red-400">
                  {{ form.marca_texto.errors.0 }}
                </div>
              {% endif %}
            </div>

            <!-- Modelo -->
            <div>
              <label for="{{ form.modelo_texto.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                {% trans "Model" %} *
              </label>
              {{ form.modelo_texto|add_class:"w-full px-4 py-3 rounded-lg bg-black border border-emerald-500/30 text-emerald-200 focus:outline-none focus:ring-2 focus:ring-emerald-400/50 focus:border-emerald-400" }}
              {% if form.modelo_texto.errors %}
                <div class="mt-1 text-xs text-red-400">
                  {{ form.modelo_texto.errors.0 }}
                </div>
              {% endif %}
            </div>
          </div>

          <!-- Segunda fila: Patente, VIN -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
            <!-- Patente -->
            <div>
              <label for="{{ form.patente.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                {% trans "License Plate" %}
              </label>
              {{ form.patente|add_class:"w-full px-4 py-3 rounded-lg bg-black border border-emerald-500/30 text-emerald-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-400/50 focus:border-emerald-400" }}
              {% if form.patente.errors %}
                <div class="mt-1 text-xs text-red-400">
                  {{ form.patente.errors.0 }}
                </div>
              {% endif %}
            </div>

            <!-- VIN -->
            <div>
              <label for="{{ form.vin.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                {% trans "VIN" %}
              </label>
              {{ form.vin|add_class:"w-full px-4 py-3 rounded-lg bg-black border border-emerald-500/30 text-emerald-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-400/50 focus:border-emerald-400" }}
              {% if form.vin.errors %}
                <div class="mt-1 text-xs text-red-400">
                  {{ form.vin.errors.0 }}
                </div>
              {% endif %}
            </div>
          </div>

          <!-- Tercera fila: Color, Motor, Caja -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- Color -->
            <div>
              <label for="{{ form.color.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                {% trans "Color" %}
              </label>
              {{ form.color|add_class:"w-full px-4 py-3 rounded-lg bg-black border border-emerald-500/30 text-emerald-200 focus:outline-none focus:ring-2 focus:ring-emerald-400/50 focus:border-emerald-400" }}
              {% if form.color.errors %}
                <div class="mt-1 text-xs text-red-400">
                  {{ form.color.errors.0 }}
                </div>
              {% endif %}
            </div>

            <!-- Motor -->
            <div>
              <label for="{{ form.motor_texto.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                {% trans "Engine" %}
              </label>
              {{ form.motor_texto|add_class:"w-full px-4 py-3 rounded-lg bg-black border border-emerald-500/30 text-emerald-200 focus:outline-none focus:ring-2 focus:ring-emerald-400/50 focus:border-emerald-400" }}
              {% if form.motor_texto.errors %}
                <div class="mt-1 text-xs text-red-400">
                  {{ form.motor_texto.errors.0 }}
                </div>
              {% endif %}
            </div>

            <!-- Caja -->
            <div>
              <label for="{{ form.caja_texto.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                {% trans "Transmission" %}
              </label>
              {{ form.caja_texto|add_class:"w-full px-4 py-3 rounded-lg bg-black border border-emerald-500/30 text-emerald-200 focus:outline-none focus:ring-2 focus:ring-emerald-400/50 focus:border-emerald-400" }}
              {% if form.caja_texto.errors %}
                <div class="mt-1 text-xs text-red-400">
                  {{ form.caja_texto.errors.0 }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <!-- Información Adicional -->
      <div class="relative">
        <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-orange-500/20 via-yellow-500/20 to-amber-500/20 blur-xl"></div>
        <div class="relative rounded-xl border border-orange-400/30 bg-gradient-to-r from-[#0d1117]/90 to-[#111827]/90 backdrop-blur-sm p-6">
          <div class="flex items-center space-x-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-orange-500/30 to-amber-500/30 border border-orange-400/40 flex items-center justify-center">
              <span class="text-orange-300 text-sm">📝</span>
            </div>
            <h2 class="text-lg font-bold text-orange-300">{% trans "Additional Information" %}</h2>
          </div>

          <!-- Observaciones -->
          <div class="mt-4">
            <label for="{{ form.observaciones.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
              {% trans "Observations" %}
            </label>
            {{ form.observaciones|add_class:"w-full px-4 py-3 rounded-lg bg-black border border-orange-500/30 text-orange-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-400/50 focus:border-orange-400 resize-none" }}
            {% if form.observaciones.errors %}
              <div class="mt-1 text-xs text-red-400">
                {{ form.observaciones.errors.0 }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- Botones de acción -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="{% url 'vehiculos_usa:lista_vehiculos' %}"
           class="group flex-1 inline-flex items-center justify-center space-x-2 px-8 py-4 rounded-xl border border-gray-500/40 bg-gradient-to-r from-gray-600/20 to-gray-400/10 hover:from-gray-500/30 hover:to-gray-300/20 text-gray-200 font-semibold transition-all shadow hover:shadow-gray-500/20">
          <span class="text-lg">⟲</span>
          <span>{% trans "Cancel" %}</span>
        </a>

        <button type="submit"
                class="group flex-1 relative inline-flex items-center justify-center space-x-2 px-8 py-4 rounded-xl bg-gradient-to-r from-orange-600 via-yellow-600 to-amber-600 hover:from-orange-500 hover:via-yellow-500 hover:to-amber-500 text-white font-bold shadow-lg shadow-orange-800/40 transition-all duration-300 border border-orange-400/40">
          <span class="text-lg">💾</span>
          <span>{% trans "Update Vehicle" %}</span>
          <div class="absolute -inset-px rounded-xl ring-2 ring-orange-400/40 animate-pulse opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </button>
      </div>
    </form>
  </div>

  <!-- Footer del formulario -->
  <div class="mt-8 text-center">
    <div class="inline-flex items-center space-x-2 px-4 py-2 rounded-full bg-gradient-to-r from-gray-800/50 to-gray-700/50 border border-gray-600/30 text-gray-400 text-xs">
      <div class="w-2 h-2 bg-orange-400 rounded-full animate-pulse"></div>
      <span>{% trans "Vehicle update form" %}</span>
      <div class="w-2 h-2 bg-yellow-400 rounded-full"></div>
    </div>
  </div>
</div>
{% endblock %}
