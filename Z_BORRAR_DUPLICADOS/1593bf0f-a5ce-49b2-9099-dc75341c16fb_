const urlBuscarClientes = window.EG.endpoints.buscarClientes;
const urlVeh            = window.EG.endpoints.vehiculosPorCliente;
const urlNextNumber     = window.EG.endpoints.numeroDocumento;
const urlRep            = window.EG.endpoints.repuestoPorCodigo;

