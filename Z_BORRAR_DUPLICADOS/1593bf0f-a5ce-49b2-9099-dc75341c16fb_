<script>
// Variables globales
window.ES_EDICION = {{ es_edicion|yesno:"true,false" }};
window.COUNTRY = "{{ country|upper }}";

// Datos de líneas cargadas
let lineasData = JSON.parse(document.getElementById('bootstrap-lineas').textContent);

// Inicializar
document.addEventListener('DOMContentLoaded', function() {
    if (window.ES_EDICION) {
        cargarLineasExistentes();
    }
    recalcularTotales();
});

function actualizarBadgePago() {
    const checkbox = document.getElementById('switchPagado');
    const badge = document.getElementById('badge-pago');

    if (badge) {
        if (checkbox.checked) {
            badge.className = 'badge badge-pagado badge-pagado-si';
            badge.textContent = window.COUNTRY === 'US' ? '✅ Paid' : '✅ Pagado';
        } else {
            badge.className = 'badge badge-pagado badge-no-pagado';
            badge.textContent = window.COUNTRY === 'US' ? '❌ Not Paid' : '❌ No Pagado';
        }
    }
}

function cargarLineasExistentes() {
    // Cargar repuestos
    lineasData.repuestos.forEach(repuesto => {
        agregarRepuesto(repuesto);
    });

    // Cargar servicios
    lineasData.servicios.forEach(servicio => {
        agregarServicio(servicio);
    });

    // Cargar otros servicios
    lineasData.otros.forEach(otro => {
        agregarOtroServicio(otro);
    });
}

function agregarRepuesto(data = null) {
    const tbody = document.getElementById('repuestos-tbody');
    const row = tbody.insertRow();
    const index = tbody.children.length - 1;

    row.innerHTML = `
        <td>
            <input type="hidden" name="lineas_repuesto[repuesto_id][]" value="${data?.repuesto_id || ''}">
            <input type="text" class="form-control" name="lineas_repuesto[codigo][]"
                   value="${data?.codigo || ''}" placeholder="Code">
        </td>
        <td>
            <input type="text" class="form-control" name="lineas_repuesto[nombre][]"
                   value="${data?.nombre || ''}" placeholder="Description" required>
        </td>
        <td>
            <input type="number" class="form-control" name="lineas_repuesto[cantidad][]"
                   value="${data?.cantidad || '1'}" min="1" step="1" onchange="recalcularTotales()">
        </td>
        <td>
            <input type="number" class="form-control" name="lineas_repuesto[precio][]"
                   value="${data?.precio || '0'}" min="0" step="0.01" onchange="recalcularTotales()">
        </td>
        <td>
            <input type="number" class="form-control" name="lineas_repuesto[descuento][]"
                   value="${data?.descuento || '0'}" min="0" max="100" step="0.01" onchange="recalcularTotales()">
        </td>
        <td>
            <span class="subtotal-repuesto">$0.00</span>
        </td>
        <td>
            <button type="button" class="btn btn-danger btn-sm" onclick="eliminarFila(this)">
                <i class="fas fa-trash"></i>
            </button>
        </td>
    `;

    recalcularTotales();
}

function agregarServicio(data = null) {
    const tbody = document.getElementById('servicios-tbody');
