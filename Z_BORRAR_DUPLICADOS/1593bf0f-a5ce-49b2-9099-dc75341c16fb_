function eliminarFila(button) {
    button.closest('tr').remove();
    recalcularTotales();
}

function recalcularTotales() {
    let subtotalRepuestos = 0;
    let subtotalServicios = 0;
    let subtotalOtros = 0;

    // Calcular repuestos
    document.querySelectorAll('#repuestos-tbody tr').forEach(row => {
        const cantidad = parseFloat(row.querySelector('[name="lineas_repuesto[cantidad][]"]').value) || 0;
        const precio = parseFloat(row.querySelector('[name="lineas_repuesto[precio][]"]').value) || 0;
        const descuento = parseFloat(row.querySelector('[name="lineas_repuesto[descuento][]"]').value) || 0;

        const subtotal = cantidad * precio * (1 - descuento / 100);
        subtotalRepuestos += subtotal;

        row.querySelector('.subtotal-repuesto').textContent = `$${subtotal.toFixed(2)}`;
    });

    // Calcular servicios
    document.querySelectorAll('#servicios-tbody tr').forEach(row => {
        const cantidad = parseFloat(row.querySelector('[name="lineas_servicio[cantidad][]"]').value) || 0;
        const precio = parseFloat(row.querySelector('[name="lineas_servicio[precio][]"]').value) || 0;
        const descuento = parseFloat(row.querySelector('[name="lineas_servicio[descuento][]"]').value) || 0;

        const subtotal = cantidad * precio * (1 - descuento / 100);
        subtotalServicios += subtotal;

        row.querySelector('.subtotal-servicio').textContent = `$${subtotal.toFixed(2)}`;
    });

    // Calcular otros servicios
    document.querySelectorAll('#otros-tbody tr').forEach(row => {
        const cantidad = parseFloat(row.querySelector('[name="lineas_otro[cantidad][]"]').value) || 0;
        const precio = parseFloat(row.querySelector('[name="lineas_otro[precio_cliente][]"]').value) || 0;

        const subtotal = cantidad * precio;
        subtotalOtros += subtotal;
    });

    // Calcular impuestos
    let impuesto = 0;
    if (window.COUNTRY === 'US') {
        const aplicarTax = document.getElementById('aplicar-tax')?.checked || false;
        if (aplicarTax) {
            impuesto = (subtotalRepuestos + subtotalServicios + subtotalOtros) * 0.08; // 8% sales tax
        }
        if (document.getElementById('tax-amount')) {
            document.getElementById('tax-amount').textContent = `$${impuesto.toFixed(2)}`;
        }
    } else {
        // IVA 19% solo sobre repuestos en Chile
        impuesto = subtotalRepuestos * 0.19;
        if (document.getElementById('iva-amount')) {
            document.getElementById('iva-amount').textContent = `$${impuesto.toFixed(2)}`;
        }
    }

    // Actualizar totales en la UI
    if (document.getElementById('subtotal-repuestos')) {
        document.getElementById('subtotal-repuestos').textContent = `$${subtotalRepuestos.toFixed(2)}`;
    }
    if (document.getElementById('subtotal-servicios')) {
        document.getElementById('subtotal-servicios').textContent = `$${subtotalServicios.toFixed(2)}`;
    }
    if (document.getElementById('subtotal-otros')) {
        document.getElementById('subtotal-otros').textContent = `$${subtotalOtros.toFixed(2)}`;
    }

    const total = subtotalRepuestos + subtotalServicios + subtotalOtros + impuesto;
    if (document.getElementById('total-final')) {
        document.getElementById('total-final').textContent = `$${total.toFixed(2)}`;
    }
}

