                <div class="text-sm">Días restantes</div>
              </div>
              <div class="bg-gradient-to-r from-blue-500 to-blue-600 p-4 rounded-lg">
                <div class="text-2xl font-bold">{{ empresa.suscripcion_activa|yesno:"Si,No" }}</div>
                <div class="text-sm">Suscripción</div>
              </div>
              <div class="bg-gradient-to-r from-purple-500 to-purple-600 p-4 rounded-lg">
                <div class="text-2xl font-bold">{{ empresa.fecha_inicio|date:"d/m/Y" }}</div>
                <div class="text-sm">Fecha de inicio</div>
              </div>
            </div>
          </div>

          {% if tecnicos is not None %}
          <div class="config-section mt-10">
            <h3 class="futuristic-label flex items-center justify-between">Técnicos
              {% if crear_tecnico_url %}
                <a href="{{ crear_tecnico_url }}" class="ml-4 futuristic-btn py-1 px-3 text-sm">Agregar Técnico</a>
              {% endif %}
            </h3>
            <form method="post" class="mt-4 grid grid-cols-1 md:grid-cols-5 gap-3 items-end bg-black/30 p-4 rounded-lg border border-cyan-800/40">
              {% csrf_token %}
              <input type="hidden" name="crear_tecnico_rapido" value="1">
              <div class="md:col-span-2">
                <label class="futuristic-label text-xs" for="tec_nombre">Nombre</label>
                <input id="tec_nombre" name="nombre" required minlength="2" placeholder="Nombre" class="futuristic-input w-full" />
              </div>
              <div>
                <label class="futuristic-label text-xs" for="tec_tel">Teléfono</label>
                <input id="tec_tel" name="telefono" placeholder="+56..." class="futuristic-input w-full" />
              </div>
              <div class="md:col-span-1">
                <label class="futuristic-label text-xs" for="tec_dir">Dirección</label>
                <input id="tec_dir" name="direccion" placeholder="Opcional" class="futuristic-input w-full" />
              </div>
              <div>
                <button type="submit" class="futuristic-btn w-full py-2">Crear</button>
              </div>
            </form>
            {% if tecnicos %}
              <ul class="mt-4 divide-y divide-cyan-800/40 bg-black/30 rounded-xl border border-cyan-700/30">
                {% for t in tecnicos %}
                  <li class="p-3 flex items-center gap-4">
                    <span class="text-cyan-200 text-sm flex-1">{{ t.nombre }}</span>
                    <span class="text-xs {{ t.activo|yesno:'text-green-400,text-gray-500' }} font-mono">{{ t.activo|yesno:'ACTIVO,INACTIVO' }}</span>
                    <form method="post" class="ml-2">
                      {% csrf_token %}
                      <button name="toggle_tecnico" value="{{ t.id }}" class="text-xs px-3 py-1 rounded {{ t.activo|yesno:'bg-red-600 hover:bg-red-500,bg-green-600 hover:bg-green-500' }} transition">
                        {{ t.activo|yesno:'Desactivar,Activar' }}
                      </button>
                    </form>
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              <p class="text-gray-400 text-sm mt-2">No hay técnicos aún.</p>
            {% endif %}
          </div>
          {% endif %}

          <div class="text-center pt-6">
            <a href="/" class="futuristic-btn">Volver al Dashboard</a>
          </div>
        </div>

        <script src="{% static 'js/image_preview_simple.js' %}"></script>

{% endblock content %}
