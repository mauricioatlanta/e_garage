# ======================================================
# Variables de Entorno - eGarage (ProducciÃ³n)
# ======================================================

# ---------- Entorno ----------
EGARAGE_ENV=prod

# ---------- Base de Datos PostgreSQL ----------
DJANGO_DB_NAME=egarage_db
DJANGO_DB_USER=egarage
DJANGO_DB_PASSWORD=NuevaClaveFuerte_123
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432

# ---------- Django Core ----------
DJANGO_SECRET_KEY=tu-clave-secreta-muy-larga-y-aleatoria-aqui
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,egarage.cl,www.egarage.cl,atlantareciclajes.cl,www.atlantareciclajes.cl,.pythonanywhere.com

# ---------- Seguridad / HTTPS ----------
DJANGO_CSRF_TRUSTED_ORIGINS=https://egarage.cl,https://www.egarage.cl,https://atlantareciclajes.cl,https://www.atlantareciclajes.cl,https://*.pythonanywhere.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
DJANGO_X_FRAME_OPTIONS=DENY

# ---------- Email Configuration ----------
EMAIL_HOST=srv24.cpanelhost.cl
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=subscription@egarage.cl
EMAIL_PASSWORD=tu-password-de-email-aqui
DEFAULT_FROM_EMAIL=eGarage <subscription@egarage.cl>
EMAIL_TIMEOUT=30

# ---------- Allauth / AutenticaciÃ³n ----------
ACCOUNT_EMAIL_VERIFICATION=mandatory

# ---------- Static y Media Files ----------
STATIC_ROOT=/ruta/a/staticfiles
MEDIA_ROOT=/ruta/a/media

# ---------- Feature Flags ----------
# Marketplace - deshabilitado por defecto (0=off, 1=on)
EGARAGE_ENABLE_MARKETPLACE=0
