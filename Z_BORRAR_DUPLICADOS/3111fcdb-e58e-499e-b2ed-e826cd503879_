<!-- JavaScript simplificado (autocompletado manejado por django-autocomplete-light) -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // =================== BÚSQUEDA INTELIGENTE DE CLIENTES ===================
    const busquedaCliente = document.getElementById('busqueda-cliente');
    const sugerenciasContainer = document.getElementById('sugerencias-clientes');
    const loadingCliente = document.getElementById('loading-cliente');
    const clienteSeleccionado = document.getElementById('cliente-seleccionado');
    const clienteNombre = document.getElementById('cliente-nombre');
    const clienteInfo = document.getElementById('cliente-info');
    const limpiarCliente = document.getElementById('limpiar-cliente');
    const clienteInput = document.querySelector('input[name="cliente"]');

    let timeoutId;
    let clienteActual = null;

    function buscarClientes(query) {
        if (query.length < 2) {
            sugerenciasContainer.classList.add('hidden');
            return;
        }

        loadingCliente.classList.remove('hidden');

        // Simular búsqueda con datos de prueba
        setTimeout(() => {
            loadingCliente.classList.add('hidden');
            const clientesSimulados = [
                {id: 9, nombre: 'Fernando Zampedri', email: 'fernando@example.com', telefono: '+56912345678'},
                {id: 10, nombre: 'María González', email: 'maria@example.com', telefono: '+56987654321'},
                {id: 11, nombre: 'Carlos Silva', email: 'carlos@example.com', telefono: '+56911223344'}
            ].filter(c => c.nombre.toLowerCase().includes(query.toLowerCase()));

            mostrarSugerencias(clientesSimulados);
        }, 300);
    }

    function mostrarSugerencias(clientes) {
        if (clientes.length === 0) {
            sugerenciasContainer.innerHTML = `
                <div class="bg-gradient-to-r from-[#0d1117] to-[#111827] border border-cyan-400/40 rounded-lg shadow-2xl shadow-cyan-500/20">
                    <div class="p-4 text-center text-gray-400">
                        <div class="w-12 h-12 mx-auto mb-2 rounded-full bg-gradient-to-br from-gray-500/20 to-gray-600/20 border border-gray-400/30 flex items-center justify-center">
                            🔍
                        </div>
                        <p class="text-sm">No se encontraron clientes</p>
                        <p class="text-xs mt-1">Intenta con otro término de búsqueda</p>
                    </div>
                </div>
            `;
            sugerenciasContainer.classList.remove('hidden');
            return;
        }

        const sugerenciasHTML = clientes.map(cliente => `
            <div class="sugerencia-item" data-cliente-id="${cliente.id}" data-cliente-nombre="${cliente.nombre}" data-cliente-info="${cliente.email || ''} ${cliente.telefono || ''}">
                <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-500/30 to-blue-500/30 border border-cyan-400/40 flex items-center justify-center">
                        <span class="text-cyan-300 text-sm">👤</span>
                    </div>
                    <div class="flex-1">
                        <div class="sugerencia-nombre">${cliente.nombre}</div>
                        <div class="sugerencia-info">
                            ${cliente.email ? `📧 ${cliente.email}` : ''}
                            ${cliente.telefono ? `📱 ${cliente.telefono}` : ''}
                        </div>
                    </div>
                    <div class="text-cyan-400 text-xs font-mono">#${cliente.id}</div>
                </div>
            </div>
        `).join('');

        sugerenciasContainer.innerHTML = `
            <div class="bg-gradient-to-r from-[#0d1117] to-[#111827] border border-cyan-400/40 rounded-lg shadow-2xl shadow-cyan-500/20 max-h-60 overflow-y-auto">
                ${sugerenciasHTML}
            </div>
        `;

        sugerenciasContainer.classList.remove('hidden');

        // Agregar eventos de click
        document.querySelectorAll('.sugerencia-item').forEach(item => {
            item.addEventListener('click', function() {
                seleccionarCliente(
                    this.dataset.clienteId,
                    this.dataset.clienteNombre,
                    this.dataset.clienteInfo
                );
            });
        });
    }

    function seleccionarCliente(id, nombre, info) {
        clienteActual = {id, nombre, info};

        if (clienteInput) {
            clienteInput.value = id;
        }

        busquedaCliente.value = '';
        clienteNombre.textContent = nombre;
        clienteInfo.textContent = info;
        clienteSeleccionado.classList.remove('hidden');
        sugerenciasContainer.classList.add('hidden');

        // Efecto visual
        clienteSeleccionado.style.transform = 'scale(0.95)';
        clienteSeleccionado.style.transition = 'transform 0.2s ease';
        setTimeout(() => {
            clienteSeleccionado.style.transform = 'scale(1)';
        }, 100);
    }

    function limpiarSeleccion() {
        clienteActual = null;
        if (clienteInput) {
            clienteInput.value = '';
        }
        busquedaCliente.value = '';
        clienteSeleccionado.classList.add('hidden');
        sugerenciasContainer.classList.add('hidden');
        busquedaCliente.focus();
    }

    // Event listeners
    if (busquedaCliente) {
        busquedaCliente.addEventListener('input', function() {
            clearTimeout(timeoutId);
            const query = this.value.trim();

            if (query.length === 0) {
                sugerenciasContainer.classList.add('hidden');
                return;
            }

            timeoutId = setTimeout(() => {
                buscarClientes(query);
            }, 300);
        });

        busquedaCliente.addEventListener('focus', function() {
            if (this.value.trim().length >= 2) {
                buscarClientes(this.value.trim());
            }
        });
    }

    document.addEventListener('click', function(e) {
        if (busquedaCliente && !busquedaCliente.contains(e.target) && !sugerenciasContainer.contains(e.target)) {
            sugerenciasContainer.classList.add('hidden');
        }
    });

    if (limpiarCliente) {
        limpiarCliente.addEventListener('click', limpiarSeleccion);
    }

    console.log('Formulario de vehículos cargado correctamente');

    // =================== GESTIÓN DE MARCAS Y MODELOS ===================
    const marcaSelect = document.getElementById('id_marca');
    const modeloSelect = document.getElementById('id_modelo');
    const motorSelect = document.getElementById('id_motor');
    const cajaSelect = document.getElementById('id_caja');

    if (marcaSelect && modeloSelect) {
        marcaSelect.addEventListener('change', function() {
            const marcaId = this.value;
            console.log('Marca seleccionada:', marcaId);

            if (marcaId) {
                // Limpiar modelos
                modeloSelect.innerHTML = '<option value="">Cargando modelos...</option>';

                // Llamada AJAX real
                fetch(`/cl/es/vehiculos/autocomplete/modelo/?marca=${marcaId}&q=`, {
                    method: 'GET',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    console.log('Respuesta modelos:', data);
                    modeloSelect.innerHTML = '<option value="">Seleccionar modelo...</option>';

                    if (data.results && data.results.length > 0) {
                        data.results.forEach(modelo => {
                            const option = document.createElement('option');
                            option.value = modelo.id;
                            option.textContent = modelo.text;
                            modeloSelect.appendChild(option);
                        });
                        console.log(`Cargados ${data.results.length} modelos`);
                    } else {
                        const option = document.createElement('option');
                        option.value = '';
                        option.textContent = 'No hay modelos disponibles';
                        modeloSelect.appendChild(option);
                    }
                })
                .catch(error => {
                    console.error('Error cargando modelos:', error);
                    modeloSelect.innerHTML = '<option value="">Error cargando modelos</option>';
                });
            } else {
                modeloSelect.innerHTML = '<option value="">Seleccionar modelo...</option>';
            }
        });
    }

    // =================== FILTRADO DE MOTOR Y CAJA POR MODELO ===================
    // Esperar a que el DOM esté completamente cargado
    document.addEventListener('DOMContentLoaded', function() {
        const modeloSelect = document.getElementById('id_modelo');
        const motorSelect = document.getElementById('id_motor');
        const cajaSelect = document.getElementById('id_caja');

        console.log('🔥 INICIANDO FILTRADO - Elementos encontrados:');
        console.log('Modelo:', modeloSelect);
        console.log('Motor:', motorSelect);
        console.log('Caja:', cajaSelect);

        if (modeloSelect && motorSelect && cajaSelect) {
            modeloSelect.addEventListener('change', function() {
                const modeloId = this.value;
                console.log('🔥 MODELO SELECCIONADO:', modeloId);

                if (modeloId) {
                    // Limpiar campos
                    motorSelect.innerHTML = '<option value="">Cargando motores...</option>';
                    cajaSelect.innerHTML = '<option value="">Cargando cajas...</option>';

                    // Cargar motores
                    fetch(`/cl/es/vehiculos/autocomplete/motor/?modelo=${modeloId}&q=`)
                        .then(response => response.json())
                        .then(data => {
                            console.log('Motores recibidos:', data);
                            motorSelect.innerHTML = '<option value="">Seleccionar motor...</option>';
                            if (data.results) {
                                data.results.forEach(motor => {
                                    const option = document.createElement('option');
                                    option.value = motor.id;
                                    option.textContent = motor.text;
                                    motorSelect.appendChild(option);
                                });
                            }
                        })
                        .catch(error => {
                            console.error('Error motores:', error);
                            motorSelect.innerHTML = '<option value="">Error</option>';
                        });

                    // Cargar cajas
                    fetch(`/cl/es/vehiculos/autocomplete/caja/?modelo=${modeloId}&q=`)
                        .then(response => response.json())
                        .then(data => {
                            console.log('Cajas recibidas:', data);
                            cajaSelect.innerHTML = '<option value="">Seleccionar caja...</option>';
                            if (data.results) {
                                data.results.forEach(caja => {
                                    const option = document.createElement('option');
                                    option.value = caja.id;
                                    option.textContent = caja.text;
                                    cajaSelect.appendChild(option);
                                });
                            }
                        })
                        .catch(error => {
                            console.error('Error cajas:', error);
                            cajaSelect.innerHTML = '<option value="">Error</option>';
                        });
                } else {
                    motorSelect.innerHTML = '<option value="">Seleccionar motor...</option>';
                    cajaSelect.innerHTML = '<option value="">Seleccionar caja...</option>';
                }
            });
        }
    });

    // =================== CREAR NUEVOS MOTORES Y CAJAS ===================
    // Manejar creación de nuevos motores
    document.addEventListener('DOMContentLoaded', function() {
        const btnCrearMotor = document.getElementById('btn-crear-motor');
        const formCrearMotor = document.getElementById('form-crear-motor');
        const nuevoMotor = document.getElementById('nuevo-motor');
        const btnGuardarMotor = document.getElementById('btn-guardar-motor');
        const btnCancelarMotor = document.getElementById('btn-cancelar-motor');
        const motorSelect = document.getElementById('id_motor');
        const modeloSelect = document.getElementById('id_modelo');

        if (motorSelect && formCrearMotor) {
            motorSelect.addEventListener('change', function() {
                if (this.value === 'add_new') {
                    if (!modeloSelect.value) {
                        alert('Primero selecciona un modelo');
                        this.value = '';
                        return;
                    }
                    formCrearMotor.classList.remove('hidden');
                    nuevoMotor.focus();
                    this.value = ''; // Resetear el select
                }
            });

            btnCancelarMotor.addEventListener('click', function() {
                formCrearMotor.classList.add('hidden');
                nuevoMotor.value = '';
            });

            btnGuardarMotor.addEventListener('click', function() {
                const nombreMotor = nuevoMotor.value.trim();
                if (!nombreMotor) {
                    alert('Ingresa el nombre del motor');
                    return;
                }

                // Crear nuevo motor via AJAX
                fetch('/cl/es/vehiculos/crear-motor/', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]').value
                    },
                    body: JSON.stringify({
                        nombre: nombreMotor,
                        modelo_id: modeloSelect.value
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Agregar el nuevo motor al select
                        const option = document.createElement('option');
                        option.value = data.motor_id;
                        option.textContent = nombreMotor;
                        option.selected = true;
                        motorSelect.appendChild(option);

                        // Limpiar y ocultar formulario
                        nuevoMotor.value = '';
                        formCrearMotor.classList.add('hidden');

                        console.log('Motor creado:', nombreMotor);
                    } else {
                        alert('Error al crear el motor: ' + (data.error || 'Error desconocido'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error al crear el motor');
                });
            });
        }

        // Manejar creación de nuevas cajas
        const btnCrearCaja = document.getElementById('btn-crear-caja');
        const formCrearCaja = document.getElementById('form-crear-caja');
        const nuevoCaja = document.getElementById('nuevo-caja');
        const btnGuardarCaja = document.getElementById('btn-guardar-caja');
        const btnCancelarCaja = document.getElementById('btn-cancelar-caja');
        const cajaSelect = document.getElementById('id_caja');

        if (cajaSelect && formCrearCaja) {
            cajaSelect.addEventListener('change', function() {
                if (this.value === 'add_new') {
                    if (!modeloSelect.value) {
                        alert('Primero selecciona un modelo');
                        this.value = '';
                        return;
                    }
                    formCrearCaja.classList.remove('hidden');
                    nuevoCaja.focus();
                    this.value = ''; // Resetear el select
                }
            });

            btnCancelarCaja.addEventListener('click', function() {
                formCrearCaja.classList.add('hidden');
                nuevoCaja.value = '';
            });

            btnGuardarCaja.addEventListener('click', function() {
                const nombreCaja = nuevoCaja.value.trim();
                if (!nombreCaja) {
                    alert('Ingresa el nombre de la caja');
                    return;
                }

                // Crear nueva caja via AJAX
                fetch('/cl/es/vehiculos/crear-caja/', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]').value
                    },
                    body: JSON.stringify({
                        nombre: nombreCaja,
                        modelo_id: modeloSelect.value
                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Agregar la nueva caja al select
                        const option = document.createElement('option');
                        option.value = data.caja_id;
                        option.textContent = nombreCaja;
                        option.selected = true;
                        cajaSelect.appendChild(option);

                        // Limpiar y ocultar formulario
                        nuevoCaja.value = '';
                        formCrearCaja.classList.add('hidden');

                        console.log('Caja creada:', nombreCaja);
                    } else {
                        alert('Error al crear la caja: ' + (data.error || 'Error desconocido'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error al crear la caja');
                });
            });
        }
    });

    // =================== CREAR NUEVOS COLORES ===================
    document.addEventListener('DOMContentLoaded', function() {
        const colorSelect = document.getElementById('id_color');
        const formCrearColor = document.getElementById('form-crear-color');
        const nuevoColor = document.getElementById('nuevo-color');
        const btnGuardarColor = document.getElementById('btn-guardar-color');
        const btnCancelarColor = document.getElementById('btn-cancelar-color');

        if (colorSelect && formCrearColor) {
