{% extends "base.html" %}
{% load static %}

{% block title %}Usuario Ya Registrado - eGarage{% endblock %}

{% block content %}
<div class="min-h-screen bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 flex items-center justify-center px-4">
    <div class="max-w-md w-full bg-white rounded-lg shadow-xl p-8">
        <div class="text-center">
            <!-- Logo -->
            <div class="mb-6">
                <img src="{% static 'img/TallerPro_logo.png' %}" alt="eGarage Logo" class="w-20 h-20 mx-auto">
            </div>

            <!-- Icono de advertencia -->
            <div class="mb-4">
                <div class="w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center mx-auto">
                    <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                    </svg>
                </div>
            </div>

            <!-- Título -->
            <h1 class="text-2xl font-bold text-gray-900 mb-4">
                Usuario Ya Registrado
            </h1>

            <!-- Mensaje -->
            <p class="text-gray-600 mb-6">
                Ya existe una cuenta registrada con este email. Si olvidaste tu contraseña, puedes recuperarla usando el enlace de abajo.
            </p>

            <!-- Botones de acción -->
            <div class="space-y-3">
                <a href="{% url 'account_login' %}"
                   class="w-full bg-cyan-600 hover:bg-cyan-700 text-white font-medium py-3 px-4 rounded-lg transition duration-200 flex items-center justify-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
                    </svg>
                    Iniciar Sesión
                </a>

                <a href="{% url 'account_reset_password' %}"
                   class="w-full bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-3 px-4 rounded-lg transition duration-200 flex items-center justify-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                    </svg>
                    Recuperar Contraseña
                </a>

                <a href="{% url 'registro' %}"
                   class="w-full text-cyan-600 hover:text-cyan-700 font-medium py-2 px-4 transition duration-200">
                    ← Volver al Registro
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
