<!-- Información de contacto de la empresa -->
{% if COMPANY_ADDRESS or COMPANY_PHONE or COMPANY_EMAIL or COMPANY_WEBSITE %}
<div class="text-xs opacity-70 mt-4 p-3 bg-light rounded">
  <div class="row">
    {% if COMPANY_ADDRESS %}
    <div class="col-md-3 mb-2">
      <div class="d-flex align-items-center">
        <i class="fas fa-map-marker-alt text-primary me-2"></i>
        <span>{{ COMPANY_ADDRESS }}</span>
      </div>
    </div>
    {% endif %}

    {% if COMPANY_PHONE %}
    <div class="col-md-3 mb-2">
      <div class="d-flex align-items-center">
        <i class="fas fa-phone text-primary me-2"></i>
        <span>{{ COMPANY_PHONE }}</span>
      </div>
    </div>
    {% endif %}

    {% if COMPANY_EMAIL %}
    <div class="col-md-3 mb-2">
      <div class="d-flex align-items-center">
        <i class="fas fa-envelope text-primary me-2"></i>
        <a href="mailto:{{ COMPANY_EMAIL }}" class="text-decoration-none">{{ COMPANY_EMAIL }}</a>
      </div>
    </div>
    {% endif %}

    {% if COMPANY_WEBSITE %}
    <div class="col-md-3 mb-2">
      <div class="d-flex align-items-center">
        <i class="fas fa-globe text-primary me-2"></i>
        <a href="{{ COMPANY_WEBSITE }}" target="_blank" rel="noopener" class="text-decoration-none">{{ COMPANY_WEBSITE }}</a>
      </div>
    </div>
    {% endif %}
  </div>

  <!-- DEBUG: Company ID y Tax Rate para verificar que estamos viendo la misma empresa -->
  <div class="text-xs opacity-70 mt-2 text-center">
    Company ID (CP): {{ COMPANY_ID|default:"NO ID" }} | TAX: {{ COMPANY_TAX_RATE|default:"NO TAX" }}
  </div>
</div>
{% endif %}
