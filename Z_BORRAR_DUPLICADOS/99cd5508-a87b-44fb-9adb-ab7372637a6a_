{% extends "base.html" %}
{% load country_url %}
{% load i18n static %}

{% block content %}
{% csrf_token %}
<div class="min-h-screen bg-black relative overflow-hidden">
  <!-- Fondo dinámico espacial -->
  <div id="spaceBackground" class="absolute inset-0">
    <div class="stars"></div>
    <div class="twinkling"></div>
    <div class="clouds"></div>
  </div>

  <!-- Partículas flotantes -->
  <div id="particles" class="absolute inset-0 pointer-events-none"></div>

  <div class="relative z-10 p-4">
  <!-- Header Section with Glowing Effect -->
  <div class="relative mb-6">
    <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-cyan-500 via-fuchsia-500 to-lime-400 opacity-20 blur-xl animate-pulse"></div>
    <div class="relative rounded-xl border border-cyan-400/30 bg-black/40 backdrop-blur-sm p-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-400 to-blue-600 flex items-center justify-center text-lg shadow-lg ring-2 ring-cyan-400/40">🔧</div>
          <div>
            <h1 class="text-2xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-cyan-300 via-lime-300 to-emerald-400">
              {% trans "Servicios Mecánicos" %}
            </h1>
            <p class="text-gray-400 text-xs">{% trans "Sistema de gestión de servicios avanzado" %}</p>
          </div>
        </div>
        <div class="flex items-center space-x-4">
          <div class="flex items-center space-x-2 text-xs text-cyan-300">
            <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
            <span>{% trans "Sistema activo" %}</span>
          </div>
          <div class="relative group">
            <div class="absolute -inset-1 rounded-lg bg-gradient-to-r from-emerald-500 via-lime-500 to-green-500 opacity-30 blur group-hover:opacity-50 transition-opacity"></div>
            <a href="{% country_url 'servicios:crear_servicio' %}"
               class="relative inline-flex items-center space-x-2 px-4 py-2 rounded-lg bg-gradient-to-r from-emerald-600 via-lime-600 to-green-600 hover:from-emerald-500 hover:via-lime-500 hover:to-green-500 text-white font-bold text-sm shadow-lg shadow-emerald-800/40 transition-all duration-300 border border-emerald-400/40">
              <div class="w-4 h-4 rounded-md bg-white/20 flex items-center justify-center">
                <span class="text-sm">➕</span>
              </div>
              <span>{% trans "Agregar Servicio" %}</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Search Section -->
  <div class="mb-4">
    <div class="relative group">
      <div class="absolute -inset-0.5 rounded-lg bg-gradient-to-r from-cyan-600 via-fuchsia-600 to-lime-600 opacity-30 blur group-hover:opacity-50 transition-opacity"></div>
      <div class="relative flex rounded-lg border border-cyan-500/30 bg-black/40 backdrop-blur-sm overflow-hidden">
        <div class="flex-1 relative">
          <input type="search" id="searchInput" name="q" value="{{ request.GET.q }}"
                 placeholder="{% trans 'Buscar por nombre, categoría o subcategoría...' %}"
                 class="w-full px-3 py-2 bg-transparent text-gray-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-cyan-400/50 text-sm">
          <div class="absolute left-2 top-1/2 transform -translate-y-1/2 text-cyan-400 text-sm">🔍</div>
        </div>
        <button type="button" id="searchBtn" class="px-4 py-2 bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white font-bold transition-all shadow-lg hover:shadow-cyan-500/25 text-xs">
          {% trans "ESCANEAR" %}
        </button>
      </div>
    </div>
  </div>

  <!-- Filter Section -->
  <div class="mb-4">
    <div class="flex flex-wrap gap-2">
      <select id="categoriaFilter" class="px-3 py-2 rounded-lg bg-black/40 border border-cyan-400/30 text-cyan-300 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-400/50">
        <option value="">{% trans "Todas las Categorías" %}</option>
        {% for categoria in categorias %}
        <option value="{{ categoria.code }}">{{ categoria.get_label }}</option>
        {% endfor %}
      </select>

      <select id="subcategoriaFilter" class="px-3 py-2 rounded-lg bg-black/40 border border-cyan-400/30 text-cyan-300 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-400/50">
        <option value="">{% trans "Todas las Subcategorías" %}</option>
        {% for subcategoria in subcategorias %}
        <option value="{{ subcategoria.code }}">{{ subcategoria.get_label }}</option>
        {% endfor %}
      </select>
    </div>
  </div>

  <!-- Services Grid - Collage Style -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3" id="servicesContainer">
    {% for servicio in servicios %}
    <div class="group relative service-card transform hover:scale-105 transition-all duration-300"
         data-name="{{ servicio.nombre|default:'' }}"
         data-categoria="{{ servicio.categoria.get_label|default:'' }}"
         data-subcategoria="{{ servicio.subcategoria.get_label|default:'' }}"
         data-categoria-code="{{ servicio.categoria.code|default:'' }}"
         data-subcategoria-code="{{ servicio.subcategoria.code|default:'' }}">
      <!-- Glow effect -->
      <div class="absolute -inset-1 rounded-lg bg-gradient-to-r from-cyan-600/20 via-fuchsia-600/20 to-lime-600/20 opacity-0 group-hover:opacity-100 blur transition-all duration-300"></div>

      <!-- Main card -->
      <div class="relative rounded-lg border border-gray-700/50 bg-black/40 backdrop-blur-sm hover:border-cyan-400/30 transition-all duration-300 h-48 flex flex-col">
        <!-- Header with ID -->
        <div class="p-3 border-b border-gray-700/30 flex-shrink-0">
          <div class="flex items-center justify-between">
            <div class="flex items-center space-x-2">
              <div class="w-6 h-6 rounded-md bg-gradient-to-br from-cyan-500/20 to-blue-500/20 border border-cyan-400/30 flex items-center justify-center">
                <span class="text-cyan-300 font-mono text-xs">🔧</span>
              </div>
              <div>
                <p class="text-cyan-300 font-mono font-bold text-sm">{{ servicio.nombre|truncatechars:12 }}</p>
                <p class="text-gray-500 text-xs">ID: #{{ servicio.pk }}</p>
              </div>
            </div>
            <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
          </div>
        </div>

        <!-- Content -->
        <div class="p-3 space-y-2 flex-1">
          <!-- Nombre del servicio -->
          <div class="space-y-1">
            <p class="text-xs text-gray-500 uppercase tracking-wider">{% trans "Servicio" %}</p>
            <p class="text-gray-200 font-medium text-sm truncate">{{ servicio.nombre|default:"-" }}</p>
          </div>

          <!-- Categoría y Subcategoría -->
          <div class="grid grid-cols-2 gap-2">
            <div class="space-y-1">
              <p class="text-xs text-gray-500 uppercase tracking-wider">{% trans "Categoría" %}</p>
              <p class="text-emerald-300 font-bold text-xs truncate">{{ servicio.categoria.get_label|default:"-" }}</p>
            </div>
            <div class="space-y-1">
              <p class="text-xs text-gray-500 uppercase tracking-wider">{% trans "Subcategoría" %}</p>
              <p class="text-lime-300 font-semibold text-xs truncate">{{ servicio.subcategoria.get_label|default:"-" }}</p>
            </div>
          </div>

          <!-- Tipo de servicio -->
          <div class="flex items-center space-x-2">
            <div class="w-5 h-5 rounded-md bg-gradient-to-br from-fuchsia-500/20 to-purple-500/20 border border-fuchsia-400/30 flex items-center justify-center">
              <span class="text-fuchsia-300 text-xs">⚙️</span>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase tracking-wider">{% trans "Tipo" %}</p>
              <p class="text-fuchsia-300 font-bold text-sm">
                {% if servicio.tipo %}
                  {{ servicio.tipo|title }}
                {% else %}
                  Interno
                {% endif %}
              </p>
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="p-3 border-t border-gray-700/30 flex-shrink-0">
          <div class="flex justify-between space-x-1">
            <a href="{% country_url 'servicios:ver_servicio' servicio.pk  %}"
               class="flex-1 group/btn relative px-2 py-1.5 rounded-md bg-gradient-to-r from-cyan-600/20 to-blue-600/20 border border-cyan-400/40 text-cyan-300 hover:from-cyan-500/30 hover:to-blue-500/30 hover:text-cyan-200 transition-all duration-200 text-xs font-medium text-center">
              <span class="relative z-10 flex items-center justify-center space-x-1">
                <span>👁️</span>
                <span>{% trans "Ver" %}</span>
              </span>
              <div class="absolute inset-0 rounded-md bg-gradient-to-r from-cyan-600 to-blue-600 opacity-0 group-hover/btn:opacity-20 transition-opacity"></div>
            </a>
            <a href="{% country_url 'servicios:editar_servicio' servicio.pk  %}"
               class="flex-1 group/btn relative px-2 py-1.5 rounded-md bg-gradient-to-r from-emerald-600/20 to-green-600/20 border border-emerald-400/40 text-emerald-300 hover:from-emerald-500/30 hover:to-green-500/30 hover:text-emerald-200 transition-all duration-200 text-xs font-medium text-center">
              <span class="relative z-10 flex items-center justify-center space-x-1">
                <span>⚙️</span>
                <span>{% trans "Editar" %}</span>
              </span>
              <div class="absolute inset-0 rounded-md bg-gradient-to-r from-emerald-600 to-green-600 opacity-0 group-hover/btn:opacity-20 transition-opacity"></div>
            </a>
            <button onclick="confirmarEliminacion({{ servicio.pk }}, '{{ servicio.nombre|escapejs }}')"
                    class="flex-1 group/btn relative px-2 py-1.5 rounded-md bg-gradient-to-r from-red-600/20 to-pink-600/20 border border-red-400/40 text-red-300 hover:from-red-500/30 hover:to-pink-500/30 hover:text-red-200 transition-all duration-200 text-xs font-medium text-center">
              <span class="relative z-10 flex items-center justify-center space-x-1">
                <span>🗑️</span>
                <span>{% trans "Eliminar" %}</span>
              </span>
              <div class="absolute inset-0 rounded-md bg-gradient-to-r from-red-600 to-pink-600 opacity-0 group-hover/btn:opacity-20 transition-opacity"></div>
            </button>
          </div>
        </div>
      </div>
    </div>
    {% empty %}
    <div class="col-span-full">
      <div class="relative">
        <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-gray-600 via-gray-500 to-gray-600 opacity-20 blur-xl"></div>
        <div class="relative rounded-xl border border-gray-600/30 bg-black/40 backdrop-blur-sm p-8 text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-gray-500/20 to-gray-600/20 border border-gray-400/30 flex items-center justify-center text-2xl">
            🔧
          </div>
          <h3 class="text-lg font-bold text-gray-300 mb-2">{% trans "No hay servicios registrados" %}</h3>
          <p class="text-gray-500 text-sm">{% trans "Comienza agregando tu primer servicio al sistema" %}</p>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>

  <!-- Paginación Futurista -->
  {% if is_paginated %}
  <div class="mt-6">
    <div class="relative">
      <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-cyan-500/20 via-fuchsia-500/20 to-lime-500/20 blur-xl"></div>
      <div class="relative rounded-xl border border-cyan-400/20 bg-black/40 backdrop-blur-sm p-4">
        <div class="flex flex-col sm:flex-row items-center justify-between space-y-3 sm:space-y-0">
          <div class="flex items-center space-x-2 text-gray-400 text-sm">
            <span class="text-cyan-300">📊</span>
            <span>{% trans "Página" %} {{ page_obj.number }} {% trans "de" %} {{ page_obj.paginator.num_pages }}</span>
            <span class="text-gray-600">•</span>
            <span>{{ paginator.count }} {% trans "registros" %}</span>
          </div>

          <nav class="flex items-center space-x-2">
            {% if page_obj.has_previous %}
              <a href="?page=1{% if request.GET.q %}&q={{ request.GET.q }}{% endif %}"
                 class="group px-3 py-1.5 rounded-md bg-gradient-to-r from-cyan-600/20 to-blue-600/20 border border-cyan-400/40 text-cyan-300 hover:from-cyan-500/30 hover:to-blue-500/30 transition-all duration-200 text-xs font-medium">
                <span class="flex items-center space-x-1">
                  <span>⏮️</span>
                  <span class="hidden sm:inline">{% trans "Primera" %}</span>
                </span>
              </a>
              <a href="?page={{ page_obj.previous_page_number }}{% if request.GET.q %}&q={{ request.GET.q }}{% endif %}"
                 class="group px-3 py-1.5 rounded-md bg-gradient-to-r from-cyan-600/20 to-blue-600/20 border border-cyan-400/40 text-cyan-300 hover:from-cyan-500/30 hover:to-blue-500/30 transition-all duration-200 text-xs font-medium">
                <span class="flex items-center space-x-1">
                  <span>⬅️</span>
                  <span class="hidden sm:inline">{% trans "Anterior" %}</span>
                </span>
              </a>
            {% endif %}

            {% if page_obj.has_next %}
              <a href="?page={{ page_obj.next_page_number }}{% if request.GET.q %}&q={{ request.GET.q }}{% endif %}"
                 class="group px-3 py-1.5 rounded-md bg-gradient-to-r from-cyan-600/20 to-blue-600/20 border border-cyan-400/40 text-cyan-300 hover:from-cyan-500/30 hover:to-blue-500/30 transition-all duration-200 text-xs font-medium">
                <span class="flex items-center space-x-1">
                  <span class="hidden sm:inline">{% trans "Siguiente" %}</span>
                  <span>➡️</span>
                </span>
              </a>
              <a href="?page={{ page_obj.paginator.num_pages }}{% if request.GET.q %}&q={{ request.GET.q }}{% endif %}"
                 class="group px-3 py-1.5 rounded-md bg-gradient-to-r from-cyan-600/20 to-blue-600/20 border border-cyan-400/40 text-cyan-300 hover:from-cyan-500/30 hover:to-blue-500/30 transition-all duration-200 text-xs font-medium">
                <span class="flex items-center space-x-1">
                  <span class="hidden sm:inline">{% trans "Última" %}</span>
                  <span>⏭️</span>
                </span>
              </a>
            {% endif %}
          </nav>
        </div>
      </div>
    </div>
  </div>
  {% endif %}
  </div>
</div>

<!-- Modal de confirmación de eliminación -->
<div id="modalEliminacion" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden z-50">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="relative">
      <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-red-500 via-pink-500 to-red-500 opacity-30 blur-xl"></div>
      <div class="relative rounded-xl border border-red-400/30 bg-black/90 backdrop-blur-sm p-6 max-w-md w-full">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-red-600/20 to-pink-600/20 border border-red-400/40 flex items-center justify-center">
            <span class="text-red-400 text-2xl">⚠️</span>
          </div>
          <h3 class="text-xl font-bold text-gray-200 mb-2">{% trans "Confirmar Eliminación" %}</h3>
          <p class="text-gray-400 mb-6">{% trans "¿Está seguro de que desea eliminar el servicio" %} <span id="nombreServicio" class="text-red-400 font-semibold"></span>?</p>
          <div class="flex space-x-3">
            <button onclick="cerrarModal()"
                    class="flex-1 px-4 py-2 rounded-lg bg-gradient-to-r from-gray-600/20 to-gray-700/20 border border-gray-500/40 text-gray-300 hover:from-gray-500/30 hover:to-gray-600/30 transition-all duration-200 text-sm font-medium">
              {% trans "Cancelar" %}
            </button>
            <button onclick="eliminarServicio()"
                    class="flex-1 px-4 py-2 rounded-lg bg-gradient-to-r from-red-600/20 to-pink-600/20 border border-red-400/40 text-red-300 hover:from-red-500/30 hover:to-pink-500/30 transition-all duration-200 text-sm font-medium">
              {% trans "Eliminar" %}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Estilos CSS -->
<style>
@keyframes move-stars {
  0% { transform: translateY(0px); }
  100% { transform: translateY(-1000px); }
}

@keyframes twinkle {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

@keyframes move-clouds {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100vw); }
}

@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}

@keyframes explode {
  0% { transform: scale(0); opacity: 1; }
  100% { transform: scale(2); opacity: 0; }
}

.stars {
  position: absolute;
  width: 100%;
  height: 100%;
  background-image: radial-gradient(2px 2px at 20px 30px, #eee, transparent),
                    radial-gradient(2px 2px at 40px 70px, rgba(255,255,255,0.8), transparent),
                    radial-gradient(1px 1px at 90px 40px, #fff, transparent),
                    radial-gradient(1px 1px at 130px 80px, rgba(255,255,255,0.6), transparent),
                    radial-gradient(2px 2px at 160px 30px, #ddd, transparent);
  background-repeat: repeat;
  background-size: 200px 100px;
  animation: move-stars 50s linear infinite;
}

.twinkling {
  position: absolute;
  width: 100%;
  height: 100%;
  background-image: radial-gradient(1px 1px at 25px 5px, white, transparent),
                    radial-gradient(1px 1px at 50px 25px, white, transparent),
                    radial-gradient(1px 1px at 125px 20px, white, transparent),
                    radial-gradient(1px 1px at 150px 75px, white, transparent);
  background-repeat: repeat;
  background-size: 200px 100px;
  animation: twinkle 3s ease-in-out infinite;
}

.clouds {
  position: absolute;
  width: 100%;
  height: 100%;
  background-image: radial-gradient(20px 20px at 50px 50px, rgba(255,255,255,0.1), transparent),
                    radial-gradient(15px 15px at 150px 30px, rgba(255,255,255,0.1), transparent),
                    radial-gradient(25px 25px at 250px 70px, rgba(255,255,255,0.1), transparent);
  background-repeat: repeat;
  background-size: 300px 100px;
  animation: move-clouds 30s linear infinite;
}

.particle {
  position: absolute;
  width: 2px;
  height: 2px;
  background: #00ffff;
  border-radius: 50%;
  animation: float 3s ease-in-out infinite;
}

.explosion {
  position: absolute;
  width: 4px;
  height: 4px;
  background: radial-gradient(circle, #ff00ff, #00ffff, #ffff00);
  border-radius: 50%;
  animation: explode 0.5s ease-out forwards;
}

.service-card {
  cursor: pointer;
}

.service-card:hover {
  z-index: 10;
}
</style>

<!-- JavaScript -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  // =================== VARIABLES GLOBALES ===================
  const searchInput = document.getElementById('searchInput');
  const searchBtn = document.getElementById('searchBtn');
  const categoriaFilter = document.getElementById('categoriaFilter');
  const subcategoriaFilter = document.getElementById('subcategoriaFilter');
  const servicesContainer = document.getElementById('servicesContainer');
  const serviceCards = document.querySelectorAll('.service-card');
  let servicioAEliminar = null;

  // =================== FUNCIONES DE BÚSQUEDA Y FILTRADO ===================
  function performSearch() {
    const query = searchInput.value.toLowerCase().trim();
    const categoriaValue = categoriaFilter.value;
    const subcategoriaValue = subcategoriaFilter.value;

    serviceCards.forEach(card => {
      const name = card.dataset.name.toLowerCase();
      const categoria = card.dataset.categoria.toLowerCase();
      const subcategoria = card.dataset.subcategoria.toLowerCase();
      const categoriaCode = card.dataset.categoriaCode;
      const subcategoriaCode = card.dataset.subcategoriaCode;

      const matchesQuery = name.includes(query) ||
                          categoria.includes(query) ||
                          subcategoria.includes(query);

      const matchesCategoria = !categoriaValue || categoriaCode === categoriaValue;
      const matchesSubcategoria = !subcategoriaValue || subcategoriaCode === subcategoriaValue;

      const matches = matchesQuery && matchesCategoria && matchesSubcategoria;

      if (matches) {
        card.style.display = 'block';
        card.style.opacity = '1';
        card.style.transform = 'scale(1)';
      } else {
        card.style.opacity = '0.3';
        card.style.transform = 'scale(0.95)';
      }
    });
  }

  // =================== FUNCIONES DE PARTÍCULAS Y EFECTOS ===================
  function createParticles() {
    const particles = document.getElementById('particles');
    for (let i = 0; i < 50; i++) {
      const particle = document.createElement('div');
      particle.className = 'particle';
      particle.style.left = Math.random() * 100 + '%';
      particle.style.top = Math.random() * 100 + '%';
      particle.style.animationDelay = Math.random() * 3 + 's';
      particles.appendChild(particle);
    }
  }

  function createExplosion(x, y) {
    const explosion = document.createElement('div');
    explosion.className = 'explosion';
    explosion.style.left = x + 'px';
    explosion.style.top = y + 'px';
    document.body.appendChild(explosion);

    setTimeout(() => {
      explosion.remove();
    }, 500);
  }

  // =================== FUNCIONES DE ELIMINACIÓN ===================
  window.confirmarEliminacion = function(id, nombre) {
    servicioAEliminar = id;
    document.getElementById('nombreServicio').textContent = nombre;
    document.getElementById('modalEliminacion').classList.remove('hidden');
  };

  window.cerrarModal = function() {
    document.getElementById('modalEliminacion').classList.add('hidden');
    servicioAEliminar = null;
  };

  window.eliminarServicio = function() {
    if (!servicioAEliminar) return;

    const csrfToken = document.querySelector('[name=csrfmiddlewaretoken]').value;

    fetch(`/cl/es/servicios/${servicioAEliminar}/eliminar/`, {
      method: 'POST',
      headers: {
        'X-CSRFToken': csrfToken,
        'Content-Type': 'application/json',
      },
    })
    .then(response => {
      if (response.ok) {
        window.location.reload();
      } else {
        alert('Error al eliminar el servicio');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Error al eliminar el servicio');
    });
  };

  // =================== EVENT LISTENERS ===================
  if (searchInput) {
    searchInput.addEventListener('input', performSearch);
    searchInput.addEventListener('focus', function() {
      this.parentElement.style.borderColor = 'rgb(34 211 238 / 0.6)';
    });
    searchInput.addEventListener('blur', function() {
      this.parentElement.style.borderColor = 'rgb(34 211 238 / 0.3)';
    });
  }

  if (searchBtn) {
    searchBtn.addEventListener('click', performSearch);
  }

  if (categoriaFilter) {
    categoriaFilter.addEventListener('change', performSearch);
  }

  if (subcategoriaFilter) {
    subcategoriaFilter.addEventListener('change', performSearch);
  }

  // Event listeners para las tarjetas de servicios
  serviceCards.forEach(card => {
    card.addEventListener('click', function(e) {
      if (!e.target.closest('a') && !e.target.closest('button')) {
        const rect = card.getBoundingClientRect();
        createExplosion(
          e.clientX - rect.left,
          e.clientY - rect.top
        );
      }
    });
  });

  // Event listeners para el modal
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      cerrarModal();
    }
  });

  // Cerrar modal al hacer clic fuera
  document.getElementById('modalEliminacion').addEventListener('click', function(e) {
    if (e.target === this) {
      cerrarModal();
    }
  });

  // =================== INICIALIZACIÓN ===================
  createParticles();

  // Explosiones aleatorias
  setInterval(() => {
    const x = Math.random() * window.innerWidth;
    const y = Math.random() * window.innerHeight;
    createExplosion(x, y);
  }, 3000);
});
</script>

{% endblock %}
