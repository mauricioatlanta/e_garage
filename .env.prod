# ---------- Django Core ----------
DJANGO_SECRET_KEY="+@-(2n5*h3@m3(xkm$#q+f&k51_8wvh5zm8a0zh2+*)vjd)bs="
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,egarage.cl,www.egarage.cl,atlantareciclajes.cl,www.atlantareciclajes.cl,.pythonanywhere.com

# ---------- Seguridad / HTTPS ----------
DJANGO_CSRF_TRUSTED_ORIGINS=https://egarage.cl,https://www.egarage.cl,https://atlantareciclajes.cl,https://www.atlantareciclajes.cl
# Compartir cookie CSRF entre www y no-www (evita 403 en login si hay redirección)
# DJANGO_CSRF_COOKIE_DOMAIN=.egarage.cl
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
DJANGO_X_FRAME_OPTIONS=DENY

# ---------- Email: Resend API (producción) ----------
RESEND_API_KEY=re_Nf8haHzM_KL19Pfi6mwYvdPM3wjFAns6z
DEFAULT_FROM_EMAIL="eGarage <no-reply@egarage.cl>"
SERVER_EMAIL=support@egarage.cl

# NO usar Gmail/SMTP - se usa Resend. Si las tenías, déjalas comentadas:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
