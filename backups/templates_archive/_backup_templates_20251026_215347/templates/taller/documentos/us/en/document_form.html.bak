// Setup for other service row
function setupOtroRow(row) {
  const qEl = row.querySelector('.otr-cantidad');
  const pEl = row.querySelector('.otr-precio');
  const sub = row.querySelector('.otr-subtotal');
  const view = row.querySelector('.otr-subtotal-view');
  const inpPrecioTaller = row.querySelector('.otr-precio-taller');

  function recalc() {
    const q = Number(qEl?.value || 1);
    const p = Number(pEl?.value?.replace(/[^0-9.-]/g, '') || 0);
    const subtotal = q * p;
    if (sub) sub.value = subtotal;
    if (view) view.textContent = money(subtotal);
    window.recalcTotales();
  }

  qEl?.addEventListener('input', recalc);
  pEl?.addEventListener('input', recalc);
}
</script>
{% endblock %}
