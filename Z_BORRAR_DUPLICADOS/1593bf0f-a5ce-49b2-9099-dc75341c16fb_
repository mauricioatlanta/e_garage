                        <select name="tipo" class="form-select" id="id_tipo">
                            <option value="OT">🔧 Work Order</option>
                            <option value="PRES">📋 Estimate</option>
                            <option value="REC">🧾 Receipt/Invoice</option>
                        </select>
                        {% else %}
                        {{ form.tipo }}
                        {% endif %}
                    </div>

                    <div class="form-group">
                        <label class="form-label">{% if LANGUAGE_CODE == 'en' or request.path|slice:':3' == '/us' %}Document Number{% else %}{{ form.numero.label }}{% endif %}</label>
                        {% if LANGUAGE_CODE == 'en' or request.path|slice:':3' == '/us' %}
                        <input type="text" name="numero" class="form-control" readonly>
                        {% else %}
                        {{ form.numero }}
                        {% endif %}
                    </div>

                    <div class="form-group">
                        <label class="form-label">{% if LANGUAGE_CODE == 'en' or request.path|slice:':3' == '/us' %}Date{% else %}{{ form.fecha_emision.label }}{% endif %}</label>
