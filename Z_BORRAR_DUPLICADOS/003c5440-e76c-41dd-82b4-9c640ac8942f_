{% extends "taller/documentos/base/base_documento.html" %}
{% load i18n %}

{% load country_url %}
{% load static %}

<!-- 🇺🇸 USA TEMPLATE ALTERNATIVO -  ROJA -->
<!-- 📋 TEMPLATE ALTERNATIVO PARA USA (EN) -->

{% block title %}Create Document{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{% static 'css/documento_moderno.css' %}">
<style>
    .container-fluid {
        max-width: 1400px;
    }

    .form-section {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        border: 1px solid #e3e6f0;
    }

    .form-section h3 {
        color: #5a5c69;
        margin-bottom: 1rem;
        font-size: 1.1rem;
        font-weight: 600;
        border-bottom: 2px solid #4e73df;
        padding-bottom: 0.5rem;
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .form-label {
        color: #5a5c69;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .form-control {
        border-radius: 8px;
        border: 1px solid #d1d3e2;
        padding: 0.75rem;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

    .form-control:focus {
        border-color: #4e73df;
        box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
    }

    .btn-primary {
        background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);
        border: none;
        border-radius: 8px;
        padding: 0.75rem 2rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(78, 115, 223, 0.4);
    }

    .btn-secondary {
        background: #6c757d;
        border: none;
        border-radius: 8px;
        padding: 0.75rem 2rem;
        font-weight: 500;
        color: white;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .btn-secondary:hover {
        background: #5a6268;
        color: white;
        text-decoration: none;
        transform: translateY(-1px);
    }

    .alert {
        border-radius: 8px;
        border: none;
        margin-bottom: 1.5rem;
    }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 text-gray-800 mb-0">
                <i class="fas fa-plus-circle text-primary"></i>
                Create New Document
            </h1>
            <p class="text-muted">Complete the document information</p>
        </div>
        <div>
            <a href="{% url 'documentos_cl_es:lista_documentos' %}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <!-- Mensajes -->
    {% if messages %}
        {% for message in messages %}
        <div class="alert alert-{{ message.tags }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        {% endfor %}
    {% endif %}

    <!-- Formulario -->
    <form method="post" id="documentoForm">
        {% csrf_token %}

        <div class="row">
            <!-- Información del Documento -->
            <div class="col-lg-6">
                <div class="form-section">
                    <h3><i class="fas fa-file-alt text-primary"></i> Document Information</h3>

                    <div class="form-group">
                        <label class="form-label">Document Type</label>
                        <select name="tipo_documento" class="form-control" required>
                            <option value="">-- Select Type --</option>
                            {% if country == 'us' %}
                                <option value="ESTIMATE">Estimate</option>
                                <option value="WORK_ORDER">Work Order</option>
                                <option value="INVOICE">Invoice</option>
                            {% else %}
                                <option value="PRESUPUESTO">Presupuesto</option>
                                <option value="ORDEN_TRABAJO">Orden de Trabajo</option>
                                <option value="FACTURA">Recibo/Boleta</option>
                                <option value="BOLETA">Boleta</option>
                            {% endif %}
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Document Number</label>
                        <input type="text" name="numero_documento" class="form-control" placeholder="Ex: WO-00001" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Date</label>
                        <input type="date" name="fecha" class="form-control" value="{{ today|date:'Y-m-d' }}" required>
                    </div>
                </div>
            </div>

            <!-- Información del Cliente -->
            <div class="col-lg-6">
                <div class="form-section">
                    <h3><i class="fas fa-user text-primary"></i> Customer</h3>

                    <div class="form-group">
                        <label class="form-label">Customer</label>
                        <select name="cliente" class="form-control" id="id_cliente" required></select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Vehicle</label>
                        <select name="vehiculo" class="form-control">
                            <option value="">-- Select Vehicle --</option>
                        </select>
                    </div>

                    {% if country == 'us' %}
                    <div class="form-group">
                        <label class="form-label">Mileage</label>
                        <input type="number" name="millas" class="form-control" placeholder="0">
                    </div>
                    {% else %}
                    <div class="form-group">
                        <label class="form-label">Mileage</label>
                        <input type="number" name="kilometraje" class="form-control" placeholder="0">
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Técnico y Estado -->
        <div class="row">
            <div class="col-lg-6">
                <div class="form-section">
                    <h3><i class="fas fa-wrench text-primary"></i> Assignment</h3>

                    <div class="form-group">
                        <label class="form-label">Assigned Technician</label>
                        <select name="tecnico" class="form-control">
                            <option value="">-- Unassigned --</option>
                            {% for tecnico in tecnicos %}
                                <option value="{{ tecnico.id }}">{{ tecnico.nombre }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="form-section">
                    <h3><i class="fas fa-tasks text-primary"></i> Status</h3>

                    <div class="form-group">
                        <label class="form-label">Document Status</label>
                        <select name="estado" class="form-control" required>
                            <option value="BORRADOR">Draft</option>
                            <option value="PENDIENTE">Pending</option>
                            <option value="EN_PROCESO">In Progress</option>
                            <option value="COMPLETADO">Completed</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Observaciones -->
        <div class="form-section">
            <h3><i class="fas fa-comment-alt text-primary"></i> Observations</h3>

            <div class="form-group">
                <label class="form-label">General Observations</label>
                <textarea name="observaciones" class="form-control" rows="4" placeholder="Document observations..."></textarea>
            </div>
        </div>

        <!-- Botones -->
        <div class="text-center">
            <button type="submit" class="btn btn-primary btn-lg me-2">
                <i class="fas fa-save"></i> Create Document
            </button>
            <a href="{% url 'documentos_cl_es:lista_documentos' %}" class="btn btn-secondary btn-lg">
                <i class="fas fa-times"></i> Cancel
            </a>
        </div>

  {% include "taller/documentos/base/includes/payment_status_select.html" %}
</form>
</div>

<script>
(function() {
  // Asegura que exista el portal global (tú ya lo tienes: <div id="eg-portal" ...>)
  const dropdownParent = document.getElementById('eg-portal') || document.body;

  // --- CLIENT: Select2 remoto ---
  const $Client = window.jQuery && window.jQuery('#id_cliente');
  if (!$Client || !$Client.select2) {
    console.warn("Select2/jQuery no están cargados. Verifica assets.");
    return;
  }

  $Client.select2({
    theme: 'bootstrap-5',             // opcional, si usas Bootstrap 5
    placeholder: 'Search customer…',
    allowClear: true,
    minimumInputLength: 1,
    width: '100%',
    dropdownParent: window.jQuery(dropdownParent),
    ajax: {
      url: "{% country_url 'ajax-buscar-clientes' %}",
      dataType: 'json',
      delay: 250,
      cache: true,
      data: function(params) {
        return { q: params.term || '', page: params.page || 1 };
      },
      processResults: function(data, params) {
        params.page = params.page || 1;
        return {
          results: data.results.map(function(it) {
            // guardamos subtitle en 'it.subtitle' para templateResult
            return { id: it.id, text: it.text, subtitle: it.subtitle || '' };
          }),
          pagination: { more: !!data.more }
        };
      }
    },
    templateResult: function(item) {
      if (!item.id) return item.text;
      const sub = item.subtitle ? `<div class="text-muted small">${item.subtitle}</div>` : '';
      return window.jQuery(`<div><div><strong>${item.text}</strong></div>${sub}</div>`);
    },
    templateSelection: function(item) {
      return item.text || item.id;
    }
  });

  // --- VEHICLE: se rellena cuando cambia el Client ---
  const vehiculoSelect = document.querySelector('select[name="Vehicle"]');
  function cargarVehiculos(clienteId) {
    if (!vehiculoSelect) return;
    if (!clienteId) {
      vehiculoSelect.innerHTML = '<option value="">-- Select Vehicle --</option>';
      return;
    }
    vehiculoSelect.innerHTML = '<option value="">-- Loading vehicles... --</option>';
    fetch(`{% country_url 'ajax-vehiculos-por-cliente' %}?Client=${encodeURIComponent(clienteId)}`, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.json())
    .then(data => {
      const opts = ['<option value="">-- Select Vehicle --</option>']
        .concat((data.results || []).map(v => `<option value="${v.id}">${v.text}</option>`));
      vehiculoSelect.innerHTML = opts.join('');
    })
    .catch(() => {
      vehiculoSelect.innerHTML = '<option value="">-- Error loading vehicles --</option>';
    });
  }

  $Client.on('select2:select', function(e) {
    const id = e.params.data.id;
    cargarVehiculos(id);
  }).on('select2:clear', function() {
    cargarVehiculos('');
  });
})();
</script>
{% endblock %}
