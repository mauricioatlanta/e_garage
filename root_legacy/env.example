# eGarage - Variables de entorno (12-factor)
# Copia este archivo a .env y ajusta los valores según tu entorno

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,*

# Seguridad / HTTPS (solo si no estás detrás de proxy)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://egarage.cl,https://www.egarage.cl
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
# DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
# DJANGO_X_FRAME_OPTIONS=DENY

# Proxy / Reverse Proxy (si usas Nginx/PA/Render)
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# USE_X_FORWARDED_HOST=True

# Email Settings
EMAIL_HOST=srv24.cpanelhost.cl
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=subscription@egarage.cl
EMAIL_PASSWORD=your-email-password-here
DEFAULT_FROM_EMAIL=eGarage <subscription@egarage.cl>

# Base de datos
DATABASE_URL=sqlite:///db.sqlite3
# Para PostgreSQL: postgres://user:password@localhost:5432/dbname
# Para MySQL: mysql://user:password@localhost:3306/dbname

# Allauth Settings
ACCOUNT_EMAIL_VERIFICATION=none
ACCOUNT_CONFIRM_EMAIL_ON_GET=True

# Static Files (opcional - para usar WhiteNoise)
# DJANGO_WHITENOISE=True

# Internacionalización
LANGUAGE_CODE=es
TIME_ZONE=America/Santiago

# Production Settings (uncomment for production)
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=egarage.cl,www.egarage.cl
# DJANGO_CSRF_TRUSTED_ORIGINS=https://egarage.cl,https://www.egarage.cl
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# ACCOUNT_EMAIL_VERIFICATION=mandatory
# ACCOUNT_CONFIRM_EMAIL_ON_GET=False
# EMAIL_PASSWORD=your-real-production-password

# Configuración de empresa (opcional)
# EMPRESA_DEFAULT=1
# PAIS_DEFAULT=cl
