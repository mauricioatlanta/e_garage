{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Space Command Center</title>
    <style>
        body {
            background: #0a0a0f;
            color: white;
            font-family: 'Orbitron', 'Segoe UI', monospace;
            margin: 0;
            padding: 20px;
            min-height: 100vh;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        .header {
            text-align: center;
            margin-bottom: 40px;
            position: relative;
        }
        .logout-btn {
            position: absolute;
            top: 0;
            right: 0;
            background: rgba(255, 51, 102, 0.2);
            border: 1px solid #ff3366;
            color: #ff3366;
            padding: 10px 20px;
            border-radius: 5px;
            text-decoration: none;
            font-family: 'Orbitron', monospace;
            font-weight: bold;
            transition: all 0.3s ease;
        }
        .logout-btn:hover {
            background: rgba(255, 51, 102, 0.3);
            border-color: #ffd700;
            color: #ffd700;
            text-decoration: none;
            box-shadow: 0 0 15px #ff3366;
        }
        /* Language Switcher */
        .language-switcher {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1000;
            background: rgba(5, 15, 25, 0.95);
            border: 1px solid #00ffff;
            border-radius: 25px;
            padding: 8px;
            backdrop-filter: blur(10px);
        }
        .language-switcher a {
            display: inline-block;
            padding: 8px 16px;
            margin: 0 4px;
            color: #00ffff;
            text-decoration: none;
            border-radius: 20px;
            transition: all 0.3s ease;
            font-size: 0.9rem;
            font-weight: bold;
        }
        .language-switcher a:hover,
        .language-switcher a.active {
            background: #00ffff;
            color: #0a0a0f;
            box-shadow: 0 0 15px #00ffff;
        }
        .title {
            color: #00ffff;
            font-size: 2.5rem;
            font-weight: 900;
            margin-bottom: 10px;
            text-shadow: 0 0 20px #00ffff;
        }
        .subtitle {
            color: #00ff88;
            font-family: 'Courier New', monospace;
            font-size: 1.1rem;
        }
        .nav-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }
        .nav-card {
            background: rgba(0, 212, 255, 0.1);
            border: 1px solid #00ffff;
            padding: 20px;
            border-radius: 10px;
            text-decoration: none;
            color: white;
            text-align: center;
            transition: all 0.3s ease;
        }
        .nav-card:hover {
            border-color: #ffd700;
            transform: translateY(-5px);
            box-shadow: 0 0 20px #ffd700;
            text-decoration: none;
            color: white;
        }
        .nav-icon {
            font-size: 2rem;
            margin-bottom: 10px;
        }
        .nav-title {
            font-weight: bold;
            color: #00ffff;
            margin-bottom: 5px;
        }
        .nav-desc {
            font-size: 0.8rem;
            color: #b0c4de;
        }
        .kpis-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }
        .kpi-card {
            background: rgba(0, 255, 136, 0.1);
            border: 1px solid #00ff88;
            padding: 15px;
            border-radius: 10px;
            text-align: center;
        }
        .kpi-title {
            font-size: 1.5rem;
            font-weight: bold;
            color: #00ff88;
            margin-bottom: 10px;
        }
        .kpi-value {
            font-size: 2rem;
            font-weight: 900;
            color: #00ff88;
            text-shadow: 0 0 10px #00ff88;
            margin-bottom: 5px;
        }
        .kpi-desc {
            font-size: 0.8rem;
            color: #ffd700;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Language Switcher -->
        <div class="language-switcher">
            <a href="{% url 'us:centro_operaciones' %} %}" class="active">EN</a>
            <a href="{% url 'usa_es:centro_operaciones_espacial' %}">ES</a>
        </div>

        <div class="header">
            <a href="/accounts/logout/" class="logout-btn">🚪 Logout</a>
            <h1 class="title">🚀 Space Command Center</h1>
            <p class="subtitle">Advanced Operations Control</p>
        </div>

        <div class="nav-grid">
            <!-- Documents Module -->
            <a href="/us/documentos/" class="nav-card">
                <div class="nav-icon">📄</div>
                <div class="nav-title">Documents</div>
                <div class="nav-desc">Create and manage documents</div>
            </a>

            <!-- Reports Module -->
            <a href="/us/reports/" class="nav-card">
                <div class="nav-icon">📊</div>
                <div class="nav-title">Reports</div>
                <div class="nav-desc">Generate and view reports</div>
            </a>

            <!-- Clients Module -->
            <a href="/us/clientes/" class="nav-card">
                <div class="nav-icon">👥</div>
                <div class="nav-title">Clients</div>
                <div class="nav-desc">Manage client information</div>
            </a>

            <!-- Vehicles Module -->
            <a href="/us/vehiculos/" class="nav-card">
                <div class="nav-icon">🚗</div>
                <div class="nav-title">Vehicles</div>
                <div class="nav-desc">Manage vehicle fleet</div>
            </a>

            <!-- Technicians Module -->
            <a href="/us/configuracion/" class="nav-card">
                <div class="nav-icon">👨‍🔧</div>
                <div class="nav-title">Technicians</div>
                <div class="nav-desc">Manage technician profiles</div>
            </a>

            <!-- Services Module -->
            <a href="/us/servicios/" class="nav-card">
                <div class="nav-icon">🛠️</div>
                <div class="nav-title">Services</div>
                <div class="nav-desc">Manage service operations</div>
            </a>
        </div>

        <!-- KPIs Section -->
        <div class="kpis-grid">
            <div class="kpi-card">
                <div class="kpi-title">Monthly</div>
                <div class="kpi-value">USD 0</div>
                <div class="kpi-desc">This month</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-title">Documents</div>
                <div class="kpi-value">0</div>
                <div class="kpi-desc">Total count</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-title">Vehicles</div>
                <div class="kpi-value">0</div>
                <div class="kpi-desc">Active fleet</div>
            </div>

            <div class="kpi-card">
                <div class="kpi-title">Services</div>
                <div class="kpi-value">0</div>
                <div class="kpi-desc">Pending</div>
            </div>
        </div>
    </div>
</body>
</html>
