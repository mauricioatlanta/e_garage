{% extends 'base.html' %}
{% load i18n static country_url %}
{% block content %}
<div class="max-w-xl mx-auto mt-24 p-8 bg-[#181c1f] text-white rounded-2xl shadow-2xl text-center">
  <h2 class="text-3xl font-bold text-fuchsia-400 mb-4">{% trans "Invalid confirmation link" %}</h2>
  <p class="text-lg text-cyan-100 mb-6">{% trans "No email confirmation token found." %}<br>
    {% trans "Please check the link you received in your email or request a new activation email." %}</p>
  <a href="{% country_url 'account_login' %}" class="cta-btn-premium py-3 px-8 rounded-xl font-bold text-xl shadow-xl transition-all">{% trans "Go to sign in" %}</a>
</div>
{% endblock %}
