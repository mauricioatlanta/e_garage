
{% extends 'base.html' %}
{% load widget_tweaks %}

{% block content %}
<div style="margin-bottom:16px;">
  {% if SHOW_DEBUG %}
    <span style="color:gray; font-size:12px;">[DEBUG country: {{ country }}]{% if debug_empresa_pais %} | {{ debug_empresa_pais }}{% endif %}</span>
  {% endif %}
  {% if country == 'US' %}
    <img src="https://flagcdn.com/us.svg" alt="USA" style="width:40px; display:inline; vertical-align:middle; margin-right:8px;">
  {% elif country == 'CL' %}
    <img src="https://flagcdn.com/cl.svg" alt="Chile" style="width:40px; display:inline; vertical-align:middle; margin-right:8px;">
  {% endif %}
</div>
<div class="max-w-5xl mx-auto bg-gradient-to-br from-[#0f2027] via-[#2c5364] to-[#1a2980] p-10 rounded-3xl shadow-2xl relative border border-cyan-400 backdrop-blur-xl" style="box-shadow: 0 0 60px 10px #00ffe7, 0 0 8px 2px #1a2980 inset;">
  <style>
    /* Unificación de formato futurista y tecnológico para todos los campos */
    select, input[type="text"], input[type="number"], input, textarea {
      background: linear-gradient(135deg, #111 60%, #1a2980 100%) !important;
      color: #00ffe7 !important;
      font-family: 'Orbitron', 'Segoe UI', sans-serif !important;
      border: 2.5px solid #00ffe7;
      font-size: 1.18em;
      font-weight: bold;
      border-radius: 1em;
      padding: 1em 1.4em;
      margin-bottom: 1.2em;
      width: 100%;
      box-sizing: border-box;
      box-shadow: 0 0 24px 6px #00ffe7 inset, 0 0 12px 3px #1a2980;
      transition: border 0.2s, box-shadow 0.2s, background 0.3s;
      display: block;
      opacity: 1;
      position: static;
      pointer-events: auto;
      z-index: auto;
      letter-spacing: 2.5px;
      outline: none;
      backdrop-filter: blur(2px);
    }
    select option {
      background: #1a2980;
      color: #00ffe7;
      font-family: 'Orbitron', 'Segoe UI', sans-serif !important;
      font-weight: bold;
      font-size: 1.08em;
      border-bottom: 1px solid #00ffe7;
      padding: 0.6em 1em;
    }
    label {
      color: #00ffe7 !important;
      font-family: 'Orbitron', 'Segoe UI', sans-serif !important;
      letter-spacing: 2.5px;
      font-size: 1.12em;
      font-weight: bold;
      text-shadow: 0 0 8px #00ffe7, 0 0 2px #1a2980;
      margin-bottom: 0.5em;
      display: block;
    }
    .glassmorphism-box {
      background: rgba(15,32,39,0.65);
      box-shadow: 0 0 32px 8px #00ffe7, 0 0 8px 2px #1a2980 inset;
      border-radius: 2em;
      border: 2.5px solid #00ffe7;
      backdrop-filter: blur(8px);
      padding: 2em 1.5em;
      margin-bottom: 1.5em;
    }
    .btn-cine-future {
      background: linear-gradient(90deg, #00ffe7 0%, #1a2980 100%);
      color: #111;
      font-family: 'Orbitron', 'Segoe UI', sans-serif;
      font-weight: bold;
      font-size: 1.15em;
      border-radius: 1em;
      padding: 0.8em 2em;
      box-shadow: 0 0 16px 4px #00ffe7, 0 0 8px 2px #1a2980 inset;
      border: none;
      transition: background 0.2s, color 0.2s, box-shadow 0.2s;
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    .btn-cine-future:hover {
      background: linear-gradient(90deg, #1a2980 0%, #00ffe7 100%);
      color: #00ffe7;
      box-shadow: 0 0 32px 8px #00ffe7, 0 0 8px 2px #1a2980 inset;
    }
    /* Mejorar el input de búsqueda y sugerencias */
    #busqueda-cliente-ajax, #busqueda-marca-ajax, #busqueda-modelo-ajax {
      box-shadow: 0 0 24px 4px #00ffe7 inset;
      border-radius: 1em;
      font-size: 1.08em;
      background: rgba(44,83,100,0.25);
      color: #00ffe7 !important;
      border: none;
      outline: none;
      z-index: 10;
    }
    #sugerencias-clientes,
    #sugerencias-marcas,
    #sugerencias-modelos {
      background: #0f2027;
      color: #fff;
      font-weight: bold;
      border-radius: 1em;
      box-shadow: 0 0 32px 8px #00ffe7;
      margin-top: 0.2em;
      padding: 0.2em 0;
      z-index: 100;
      border: 2px solid #00ffe7;
    }
    #sugerencias-clientes li,
    #sugerencias-marcas li,
    #sugerencias-modelos li {
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
      font-size: 1.12em;
      font-weight: bold;
      padding: 0.7em 1.2em;
      border-bottom: 1px solid #00ffe7;
      color: #fff;
      background: #1a2980;
      border-radius: 0.5em;
    }
    #sugerencias-clientes li:hover,
    #sugerencias-marcas li:hover,
    #sugerencias-modelos li:hover {
      background: #00ffe7;
      color: #0f2027;
    }
    /* Mejorar el título */
    .futuristic-title {
      font-size: 3.2em;
      font-weight: 900;
      letter-spacing: 4px;
      color: #00ffe7;
      text-shadow: 0 0 32px #00ffe7, 0 0 8px #1a2980;
      background: linear-gradient(90deg, #00ffe7 0%, #1a2980 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-fill-color: transparent;
      animation: gradient-move 2s infinite linear alternate;
    }
    @keyframes gradient-move {
      0% { background-position: 0% 50%; }
      100% { background-position: 100% 50%; }
    }
  </style>

  <div class="flex justify-between items-center mb-4">
    <h1 class="text-5xl font-black tracking-widest text-cyan-300 futuristic-title animate-gradient" style="font-family: 'Orbitron', 'Segoe UI', sans-serif; letter-spacing: 4px; text-shadow: 0 0 32px #00ffe7, 0 0 8px #1a2980;">Crear Vehículo</h1>
  {% url 'taller:vehiculos:lista_vehiculos' as url_lista_vehiculos %}
  <a class="btn-cine-future" href="{{ url_lista_vehiculos|default:'#' }}">Volver a la lista</a>
  </div>

  <!-- DEBUG INFO -->
  {% if SHOW_DEBUG %}
  <div class="bg-blue-900/50 border border-blue-400 rounded-lg p-4 mb-6">
    <h4 class="text-blue-200 font-bold mb-2">🔍 DEBUG INFO</h4>
    <p class="text-blue-100 text-sm">País detectado: <strong>{{ country }}</strong></p>
    <p class="text-blue-100 text-sm">Empresa: <strong>{{ debug_empresa_pais }}</strong></p>
    {% if country == 'US' %}
      <p class="text-green-300 text-sm">✅ Usando catálogo USA - {{ marcas_usa|length }} marcas disponibles</p>
    {% else %}
      <p class="text-yellow-300 text-sm">🇨🇱 Usando catálogo Chile - {{ marcas|length }} marcas disponibles</p>
    {% endif %}
  </div>
  {% endif %}

  <form id="form-crear-vehiculo"
        class="space-y-6"
        method="post"
        action="{% url 'taller:vehiculos:crear_vehiculo' %}">
    {% csrf_token %}
    
    <!-- 🔧 DEBUG TEMPORAL - Mostrar errores del formulario -->
    {% if form.errors %}
      <div class="bg-red-900/50 border border-red-400 rounded-xl p-4 mb-6">
        <h3 class="text-red-400 font-bold text-lg mb-2">Errores de Validación:</h3>
        <pre class="text-red-300 text-sm whitespace-pre-wrap">{{ form.errors }}</pre>
        {% if form.non_field_errors %}
          <h4 class="text-red-400 font-bold mt-4 mb-2">Errores Generales:</h4>
          <pre class="text-red-300 text-sm whitespace-pre-wrap">{{ form.non_field_errors }}</pre>
        {% endif %}
      </div>
    {% endif %}

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="glassmorphism-box p-6 rounded-2xl shadow-xl border border-cyan-300">
        <label class="block font-semibold mb-1" for="id_cliente">Cliente</label>
        <div class="relative">
          <input type="text" id="busqueda-cliente-ajax" class="w-full px-4 py-2 rounded-xl bg-black/70 text-white font-bold focus:outline-none focus:ring-2 focus:ring-cyan-400" style="color:#fff !important;" placeholder="Buscar cliente por nombre, apellido, email..." autocomplete="off">
          <ul id="sugerencias-clientes" class="absolute left-0 right-0 bg-[#1a202c] rounded-xl shadow-lg mt-2 z-50 hidden max-h-60 overflow-y-auto"></ul>
          <select id="id_cliente" name="cliente">
            <option value="">---------</option>
            {% for cliente in clientes %}
              <option value="{{ cliente.id }}"
                data-email="{{ cliente.email|default_if_none:'' }}"
                data-telefono="{{ cliente.telefono|default_if_none:'' }}"
                {% if form.cliente.value == cliente.id or form.data.cliente == cliente.id|stringformat:"s" %}selected{% endif %}>
                {{ cliente.nombre }} {{ cliente.apellido }} - {{ cliente.email }}
              </option>
            {% endfor %}
          </select>
          <div id="cliente-detalles" class="mt-2 text-sm text-cyan-200" aria-live="polite"></div>
        </div>
        <div id="error-cliente" class="text-red-400 font-bold mt-2"></div>
        {{ form.cliente.errors }}
      </div>
      <div class="glassmorphism-box p-6 rounded-2xl shadow-xl border border-cyan-300">
  <label class="block font-semibold mb-1" for="id_patente">Patente</label>
  <div class="relative">
          {% render_field form.patente class="w-full px-4 py-2 rounded-xl font-bold focus:outline-none focus:ring-2 focus:ring-cyan-400" placeholder="Patente..." style="background:#111 !important;color:#00ffe7 !important;" %}
        </div>
        {{ form.patente.errors }}
      </div>
      <div class="glassmorphism-box p-6 rounded-2xl shadow-xl border border-cyan-300">
        <label class="block font-semibold mb-1" for="{% if country == 'US' %}id_marca_texto{% else %}id_marca{% endif %}">
          {% if country == 'US' %}Brand{% else %}Marca{% endif %}
        </label>
        <div class="relative">
            {% if country == 'US' %}
              {# Para usuarios de USA, usar el campo marca del formulario que ya está configurado #}
              {{ form.marca }}
              <input type="hidden" name="marca_hidden" value="{{ form.data.marca|default:'' }}">
            {% else %}
              {# Para usuarios de Chile, usar el select tradicional con marcas de Chile #}
              <select id="id_marca" name="marca" class="w-full px-4 py-2 rounded-xl bg-black/70 text-cyan-200 font-bold focus:outline-none focus:ring-2 focus:ring-cyan-400">
                <option value="">---------</option>
                {% for marca in marcas %}
                  <option value="{{ marca.id }}"
                    {% if form.marca.value == marca.id or form.data.marca == marca.id|stringformat:"s" %}selected{% endif %}>
                    {{ marca.nombre }}
                  </option>
                {% endfor %}
                <option value="__nueva__" {% if form.data.marca == "__nueva__" %}selected{% endif %}>Agregar nueva marca...</option>
              </select>
              <input type="text" name="marca_nueva" id="input_marca_nueva" value="{{ form.data.marca_nueva|default:'' }}"
                class="w-full px-4 py-2 rounded-xl bg-black/70 text-cyan-200 font-bold focus:outline-none focus:ring-2 focus:ring-cyan-400 mt-2 {% if form.data.marca != '__nueva__' %}hidden{% endif %}"
                placeholder="Escribe la nueva marca...">
            {% endif %}
        </div>
        <div id="error-marca" class="text-red-400 font-bold mt-2"></div>
        {{ form.marca.errors }}
      </div>
      <div class="glassmorphism-box p-6 rounded-2xl shadow-xl border border-cyan-300">
        <label class="block font-semibold mb-1" for="id_modelo">Modelo</label>
        <div class="relative">
          {% if country == 'US' %}
            {# Para usuarios de USA, usar el campo modelo del formulario que ya está configurado #}
            {{ form.modelo }}
            {{ form.modelo.errors }}
          {% else %}
            <div class="flex space-x-2">
              <select id="id_modelo" name="modelo" class="w-full px-4 py-2 rounded-xl bg-black/70 text-cyan-200 font-bold focus:outline-none focus:ring-2 focus:ring-cyan-400">
                <option value="">Selecciona primero una marca...</option>
              </select>
              <button type="button" 
                      onclick="abrirModalNuevoModelo()" 
                      class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-xl font-bold transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
                      id="btn-nuevo-modelo" 
                      disabled>
                ➕
              </button>
            </div>
            <!-- Modal para agregar nuevo modelo -->
            <div id="modal-nuevo-modelo" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center">
              <div class="bg-gray-900 border border-cyan-400 rounded-xl p-6 w-96 max-w-md">
                <h3 class="text-xl font-bold text-cyan-300 mb-4">Agregar Nuevo Modelo</h3>
                <div class="mb-4">
                  <label class="block text-sm font-medium text-gray-300 mb-2">Marca:</label>
                  <span id="marca-seleccionada" class="text-cyan-200 font-bold"></span>
                </div>
                <div class="mb-4">
                  <label for="nuevo-modelo-nombre" class="block text-sm font-medium text-gray-300 mb-2">Nombre del Modelo:</label>
                  <input type="text" 
                         id="nuevo-modelo-nombre" 
                         class="w-full px-3 py-2 rounded-lg bg-black border border-cyan-500/30 text-cyan-200 focus:outline-none focus:ring-2 focus:ring-cyan-400"
                         placeholder="Ej: Corolla, Civic, etc.">
                </div>
                <div class="flex justify-end space-x-3">
                  <button type="button" 
                          onclick="cerrarModalNuevoModelo()" 
                          class="px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-lg transition-colors duration-200">
                    Cancelar
                  </button>
                  <button type="button" 
                          onclick="guardarNuevoModelo()" 
                          class="px-4 py-2 bg-cyan-600 hover:bg-cyan-700 text-white rounded-lg transition-colors duration-200">
                    Guardar
                  </button>
                </div>
              </div>
            </div>
            {% if form.modelo.errors %}
              <div class="text-red-400 text-sm mt-1">{{ form.modelo.errors.0 }}</div>
            {% endif %}
          {% endif %}
        </div>
        {{ form.modelo.errors }}
      </div>
      <div class="glassmorphism-box p-6 rounded-2xl shadow-xl border border-cyan-300">
        <label class="block font-semibold mb-1" for="id_anio">Año</label>
        <div class="relative">
          {% render_field form.anio class="w-full px-4 py-2 rounded-xl bg-black/70 text-cyan-200 font-bold focus:outline-none focus:ring-2 focus:ring-cyan-400" placeholder="Año..." %}
        </div>
        {{ form.anio.errors }}
      </div>
      <div class="glassmorphism-box p-6 rounded-2xl shadow-xl border border-cyan-300">
        <label class="block font-semibold mb-1" for="id_color">Color</label>
        <div class="relative">
          <select id="id_color" name="color" class="w-full px-4 py-2 rounded-xl bg-black/70 text-cyan-200 font-bold focus:outline-none focus:ring-2 focus:ring-cyan-400">
            <option value="">---------</option>
            {% for color in colores %}
              <option value="{{ color.id }}"
                {% if form.color.value == color.id or form.data.color == color.id|stringformat:"s" %}selected{% endif %}>
                {{ color.nombre }}
              </option>
            {% endfor %}
            <option value="__nuevo__"
              {% if form.data.color == "__nuevo__" %}selected{% endif %}>
              Agregar nuevo color...
            </option>
          </select>
          <input type="text" name="color_nuevo" id="input_color_nuevo" 
                 value="{{ form.data.color_nuevo|default:'' }}"
                 class="w-full px-4 py-2 rounded-xl bg-black/70 text-cyan-200 font-bold focus:outline-none focus:ring-2 focus:ring-cyan-400 mt-2 {% if form.data.color != '__nuevo__' %}hidden{% endif %}" 
                 placeholder="Escribe el nuevo color...">
        </div>
        {{ form.color.errors }}
      </div>
      <div class="glassmorphism-box p-6 rounded-2xl shadow-xl border border-cyan-300">
        <label class="block font-semibold mb-1" for="id_vin">VIN</label>
        <div class="relative">
          {% render_field form.vin class="w-full px-4 py-2 rounded-xl font-bold focus:outline-none focus:ring-2 focus:ring-cyan-400" placeholder="VIN..." style="background:#111 !important;color:#00ffe7 !important;" %}
        </div>
        {{ form.vin.errors }}
      </div>
      <div class="glassmorphism-box p-6 rounded-2xl shadow-xl border border-cyan-300">
        <label class="block font-semibold mb-1" for="id_motor">Motor</label>
        <div class="relative">
          <select id="id_motor" name="motor" class="w-full px-4 py-2 rounded-xl font-bold focus:outline-none focus:ring-2 focus:ring-cyan-400">
            <option value="">---------</option>
            <option value="__nuevo__"
              {% if form.data.motor == "__nuevo__" %}selected{% endif %}>
              Agregar nuevo motor...
            </option>
          </select>
          <input type="text" name="motor_nuevo" id="input_motor_nuevo" 
                 value="{{ form.data.motor_nuevo|default:'' }}"
                 class="w-full px-4 py-2 rounded-xl font-bold focus:outline-none focus:ring-2 focus:ring-cyan-400 mt-2 {% if form.data.motor != '__nuevo__' %}hidden{% endif %}" 
                 placeholder="Escribe el nuevo motor...">
        </div>
        {{ form.motor.errors }}
      </div>
      <div class="glassmorphism-box p-6 rounded-2xl shadow-xl border border-cyan-300">
        <label class="block font-semibold mb-1" for="id_caja">Caja</label>
        <div class="relative">
          <select id="id_caja" name="caja" class="w-full px-4 py-2 rounded-xl font-bold focus:outline-none focus:ring-2 focus:ring-cyan-400">
            <option value="">---------</option>
            <option value="__nuevo__"
              {% if form.data.caja == "__nuevo__" %}selected{% endif %}>
              Agregar nueva caja...
            </option>
          </select>
          <input type="text" name="caja_nueva" id="input_caja_nueva" 
                 value="{{ form.data.caja_nueva|default:'' }}"
                 class="w-full px-4 py-2 rounded-xl font-bold focus:outline-none focus:ring-2 focus:ring-cyan-400 mt-2 {% if form.data.caja != '__nuevo__' %}hidden{% endif %}" 
                 placeholder="Escribe la nueva caja...">
        </div>
        {{ form.caja.errors }}
      </div>
    </div>

    <div class="flex justify-end gap-4 pt-6">
  {% url 'taller:vehiculos:lista_vehiculos' as url_lista_vehiculos %}
  <a href="{{ url_lista_vehiculos|default:'#' }}" class="btn-cine-future">Cancelar</a>
      <button class="btn-cine-future" type="submit">
        <span class="glow-text-future">Guardar Vehículo</span>
      </button>
    </div>
  </form>

<script>
  // Logger simple para confirmar que el submit ocurre y NO se llama preventDefault()
  (function () {
    const f = document.getElementById('form-crear-vehiculo');
    if (!f) return;
    f.addEventListener('submit', function (e) {
      console.log('[Crear Vehículo] submit disparado');
      // No hacer e.preventDefault() aquí.
    });
  })();
</script>
  <!-- AJAX búsqueda de clientes -->
<script>
// === Utilidades (primero) ===
function setOptions(el, html) { if (el) el.innerHTML = html; }
const qs = (s) => document.querySelector(s);

// === Declaración de referencias ===
const inputCliente       = qs('#busqueda-cliente-ajax');
const sugerenciasCliente = qs('#sugerencias-clientes');
const selectCliente      = qs('#id_cliente');
const errorCliente       = qs('#error-cliente');
const selectMarca        = qs('#id_marca');
const selectMarcaUsa     = document.getElementById('id_marca_usa');
// --- Dinámica USA: cargar modelos al elegir marca ---
{# Namespace correcto para la API de modelos USA #}
{% url 'taller:vehiculos:api_modelos_usa' as url_api_modelos_usa %}
{% url 'taller:vehiculos:api_motores_por_modelo' as url_api_motores %}
{% url 'taller:vehiculos:api_cajas_por_modelo' as url_api_cajas %}

const selectModeloUsa = document.getElementById('id_modelo_usa');  // Select de modelo USA
const hiddenMarca     = document.getElementById('id_marca');       // Campo oculto (opcional)
const MODELOS_USA_URL = "{{ url_api_modelos_usa|default:'#' }}";
const MOTORES_API_URL = "{{ url_api_motores|default:'#' }}";
const CAJAS_API_URL = "{{ url_api_cajas|default:'#' }}";
if(MODELOS_USA_URL === '#') { console.warn('[DEBUG] No se resolvió URL api_modelos_usa'); }

// --- Carga modelos USA simplificada ---
async function cargarModelosUsa(marcaId, preselectId = null) {
  if (!selectModeloUsa || !MODELOS_USA_URL || MODELOS_USA_URL === '#') return;
  if (!marcaId) { 
    setOptions(selectModeloUsa, '<option value="">---------</option>'); 
    return; 
  }

  // Estado cargando
  selectModeloUsa.disabled = true;
  setOptions(selectModeloUsa, '<option value="">Cargando…</option>');

  try {
    const res = await fetch(`${MODELOS_USA_URL}?marca=${encodeURIComponent(marcaId)}`);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    let json = await res.json();

    // Normalizar respuesta
    let items = Array.isArray(json) ? json : (json.results || []);
    const data = items.map(m => {
      if (typeof m === 'string') return { id: m, nombre: m };
      return { 
        id: String(m.id ?? m.value ?? m.slug ?? m.nombre ?? m.text),
        nombre: String(m.nombre ?? m.text ?? m.label ?? m.modelo ?? m.name ?? m.id)
      };
    });

    // Construir options
    let html = '<option value="">---------</option>';
    for (const m of data) html += `<option value="${m.id}">${m.nombre}</option>`;
    setOptions(selectModeloUsa, html);

    // Preselección si se especifica
    if (preselectId) selectModeloUsa.value = String(preselectId);
    
    console.log(`✅ Modelos cargados: ${data.length}`);
  } catch (err) {
    console.error('Error cargando modelos USA:', err);
    setOptions(selectModeloUsa, '<option value="">Error al cargar modelos</option>');
  } finally {
    selectModeloUsa.disabled = false;
  }
}

// --- Eventos USA ---
if (selectMarcaUsa) {
  selectMarcaUsa.addEventListener('change', (e) => {
    cargarModelosUsa(e.target.value);
  });
  
  // Pre-carga si ya viene una marca seleccionada
  if (selectMarcaUsa.value) {
    const preselectModelo = "{{ form.data.modelo_usa|default:'' }}";
    cargarModelosUsa(selectMarcaUsa.value, preselectModelo || null);
  }
}
const selectModelo       = qs('#id_modelo');
const selectMotor        = qs('#id_motor');
const selectCaja         = qs('#id_caja');
const inputMarcaNueva    = qs('#input_marca_nueva');
const inputModeloNuevo   = qs('#input_modelo_nuevo');
const selectColor        = qs('#id_color');
const inputColorNuevo    = qs('#input_color_nuevo');

// === USA: Sincronizar marca_usa con campo oculto marca ===
if (selectMarcaUsa && selectMarca) {
  selectMarcaUsa.addEventListener('change', function() {
    selectMarca.value = this.value;
    // Disparar evento para que DAL/Select2 recargue modelos si es necesario
    const event = new Event('change', { bubbles: true });
    selectMarca.dispatchEvent(event);
  });
  // Inicializar valor al cargar
  if (selectMarcaUsa.value) {
    selectMarca.value = selectMarcaUsa.value;
  }
}

// === CLIENTE: búsqueda en tiempo real ===
{% url 'taller:vehiculos:api_busqueda_clientes' as url_api_clientes %}
const CLIENTES_API_URL = "{{ url_api_clientes|default:'#' }}";
let timer = null, aborter = null;
function limpiarSug() {
  if (!sugerenciasCliente) return;
  sugerenciasCliente.innerHTML = '';
  sugerenciasCliente.classList.add('hidden');
}
function setErrorCliente(msg) {
  if (errorCliente) errorCliente.textContent = msg || '';
}
function renderClientes(list) {
  limpiarSug();
  if (!Array.isArray(list) || list.length === 0) {
    setErrorCliente('No se encontraron clientes.');
    return;
  }
  setErrorCliente('');
  sugerenciasCliente.classList.remove('hidden');
  list.forEach(c => {
    const li = document.createElement('li');
    li.innerHTML = `<div class="font-bold">${c.nombre} ${c.apellido}</div><div class="text-xs text-cyan-200">${c.email || ''} • ${c.telefono || ''}</div>`;
    li.className = 'px-4 py-2 hover:bg-cyan-700 cursor-pointer rounded';
    li.onclick = () => {
      // rellenar select y mostrar detalles
      selectCliente.value = c.id;
      inputCliente.value  = `${c.nombre} ${c.apellido}`;
      const detalles = document.getElementById('cliente-detalles');
      if(detalles) detalles.innerHTML = `<strong>${c.nombre} ${c.apellido}</strong><br>${c.email||''} • ${c.telefono||''}`;
      limpiarSug();
    };
    sugerenciasCliente.appendChild(li);
  });
}
// Si ya hay un cliente seleccionado al cargar la página, mostrar detalles
document.addEventListener('DOMContentLoaded', function(){
  try{
    const sel = document.getElementById('id_cliente');
    const detalles = document.getElementById('cliente-detalles');
    if(sel && sel.value){
      const opt = sel.options[sel.selectedIndex];
      if(opt && detalles){
        const email = opt.getAttribute('data-email') || '';
        const tel = opt.getAttribute('data-telefono') || '';
        detalles.innerHTML = `<strong>${opt.text}</strong><br>${email} • ${tel}`;
      }
    }
  }catch(e){console.warn('No mostrar detalles cliente:', e);}
});
if (inputCliente && sugerenciasCliente && selectCliente && errorCliente) {
  document.addEventListener('click', (e) => {
    if (!sugerenciasCliente.contains(e.target) && e.target !== inputCliente) limpiarSug();
  });
  inputCliente.addEventListener('input', () => {
    const q = inputCliente.value.trim();
    if (q.length < 2) { limpiarSug(); setErrorCliente(''); return; }
    if (timer) clearTimeout(timer);
    timer = setTimeout(async () => {
      try {
        if (aborter) aborter.abort();
        aborter = new AbortController();
        const res = await fetch(`${CLIENTES_API_URL}?q=${encodeURIComponent(q)}`, { signal: aborter.signal });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        renderClientes(await res.json());
      } catch (err) {
        if (err.name === 'AbortError') return;
        setErrorCliente('Error al buscar clientes.');
        limpiarSug();
      }
    }, 220);
  });
}

// ...el resto de la lógica de Select2/DAL y búsqueda de clientes permanece...

// === COLOR: input manual si "__nuevo__" ===
if (selectColor && inputColorNuevo) {
  selectColor.addEventListener('change', () => {
    if (selectColor.value === '__nuevo__') {
      inputColorNuevo.classList.remove('hidden'); inputColorNuevo.required = true; inputColorNuevo.focus();
    } else {
      inputColorNuevo.classList.add('hidden'); inputColorNuevo.required = false; inputColorNuevo.value = '';
    }
  });
  // Autoselección por ?nuevo_color=ID
  const nuevoColorId = new URLSearchParams(location.search).get('nuevo_color');
  if (nuevoColorId) {
    selectColor.value = nuevoColorId;
    inputColorNuevo.value = '';
    inputColorNuevo.classList.add('hidden');
    inputColorNuevo.required = false;
  }
}
</script>
  <style>
    #busqueda-cliente-ajax {
      box-shadow: 0 0 16px 2px #00ffe7 inset;
      border-radius: 0.8em;
      font-size: 1em;
      background: rgba(44,83,100,0.2);
      color: #111 !important;
      border: none;
      outline: none;
      z-index: 10;
    }
    #sugerencias-clientes,
    #sugerencias-marcas,
    #sugerencias-modelos {
      background: #0f2027;
      color: #fff;
      font-weight: bold;
      border-radius: 0.8em;
      box-shadow: 0 0 32px 8px #00ffe7;
      margin-top: 0.2em;
      padding: 0.2em 0;
      z-index: 100;
      border: 2px solid #00ffe7;
    }
    #sugerencias-clientes li,
    #sugerencias-marcas li,
    #sugerencias-modelos li {
      cursor: pointer;
      transition: background 0.2s, color 0.2s;
      font-size: 1.08em;
      font-weight: bold;
      padding: 0.5em 1em;
      border-bottom: 1px solid #00ffe7;
      color: #fff;
      background: #1a2980;
    }
    #sugerencias-clientes li:hover,
    #sugerencias-marcas li:hover,
    #sugerencias-modelos li:hover {
      background: #00ffe7;
      color: #0f2027;
    }
  </style>
  <!-- Eliminado JS de búsqueda manual, Select2/DAL ya provee búsqueda avanzada -->
</div>
{% endblock %}

{% block extra_js %}
  {{ form.media }}
  <style>
  /* Caja del control */
  .select2-container .select2-selection--single{
    background:#0f0f10 !important;
    border:2px solid #00ffe7 !important;
    border-radius:14px !important;
    min-height:48px;
    box-shadow:0 0 12px rgba(0,255,231,.25) inset;
  }
  .select2-container--default .select2-selection--single .select2-selection__rendered{
    color:#00ffe7 !important;
    font-weight:700; letter-spacing:.5px; padding-left:14px !important;
  }
  .select2-container--default .select2-selection--single .select2-selection__arrow b{
    border-color:#00ffe7 transparent transparent transparent !important;
  }
  .select2-dropdown{
    background:#0f2027 !important;
    border:2px solid #00ffe7 !important;
    border-radius:12px !important;
    box-shadow:0 0 24px rgba(0,255,231,.35);
  }
  .select2-results__option{
    color:#c5fffb !important;
    font-weight:600;
  }
  .select2-results__option--highlighted.select2-results__option--selectable{
    background:#00ffe7 !important; color:#0f2027 !important;
  }
  .select2-container .select2-selection__placeholder{
    color:#46f5e4 !important; opacity:.8;
  }
  </style>
  
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    console.log('🌍 País detectado: {{ country }}');

    {% if country == 'CL' %}
    // FUNCIONALIDAD PARA CHILE
    console.log('🇨🇱 Configurando carga de modelos para Chile...');
    
    const marcaSelect = document.getElementById('id_marca');
    const modeloSelect = document.getElementById('id_modelo');
    const btnNuevoModelo = document.getElementById('btn-nuevo-modelo');
    
    if (marcaSelect && modeloSelect) {
      marcaSelect.addEventListener('change', function() {
        const marcaId = this.value;
        console.log('Marca seleccionada:', marcaId);
        
        // Limpiar modelos
        modeloSelect.innerHTML = '<option value="">---------</option>';
        
        // Habilitar/deshabilitar botón de nuevo modelo
        if (btnNuevoModelo) {
          btnNuevoModelo.disabled = !marcaId;
        }
        
        if (marcaId) {
          fetch(`/taller/vehiculos/api/modelos/?marca_id=${marcaId}`)
            .then(response => response.json())
            .then(data => {
              console.log('Modelos recibidos:', data);
              data.forEach(modelo => {
                const option = document.createElement('option');
                option.value = modelo.id;
                option.textContent = modelo.nombre;
                modeloSelect.appendChild(option);
              });
            })
            .catch(error => {
              console.error('Error cargando modelos:', error);
            });
        }
      });
    }
    {% endif %}

    {% if country == 'US' %}
    // FUNCIONALIDAD PARA USA
    console.log('🇺🇸 Configurando carga de modelos para USA...');
    
    const marcaSelect = document.getElementById('id_marca');
    const modeloSelect = document.getElementById('id_modelo');
    
    if (marcaSelect && modeloSelect) {
      marcaSelect.addEventListener('change', function() {
        const marcaSeleccionada = this.value;
        console.log('Marca seleccionada (USA):', marcaSeleccionada);
        
        // Limpiar modelos
        modeloSelect.innerHTML = '<option value="">---------</option>';
        
        if (marcaSeleccionada) {
          // TEMPORAL: Usar datos del contexto en lugar de API
          console.log('Usando datos del contexto para modelos USA');
          // Los modelos se cargarán desde el formulario
        }
      });
    }
    {% endif %}
  });
  
  // FUNCIONES PARA MANEJAR EL MODAL DE NUEVOS MODELOS
  function abrirModalNuevoModelo() {
    const marcaSelect = document.getElementById('id_marca');
    const marcaSeleccionada = document.getElementById('marca-seleccionada');
    const modal = document.getElementById('modal-nuevo-modelo');
    
    if (marcaSelect.value) {
      const marcaOption = marcaSelect.options[marcaSelect.selectedIndex];
      marcaSeleccionada.textContent = marcaOption.textContent;
      modal.classList.remove('hidden');
    } else {
      alert('Por favor selecciona una marca primero');
    }
  }
  
  function cerrarModalNuevoModelo() {
    const modal = document.getElementById('modal-nuevo-modelo');
    const input = document.getElementById('nuevo-modelo-nombre');
    modal.classList.add('hidden');
    input.value = '';
  }
  
  async function guardarNuevoModelo() {
    const marcaSelect = document.getElementById('id_marca');
    const input = document.getElementById('nuevo-modelo-nombre');
    const modeloSelect = document.getElementById('id_modelo');
    const modal = document.getElementById('modal-nuevo-modelo');
    
    const marcaId = marcaSelect.value;
    const modeloNombre = input.value.trim();
    
    if (!modeloNombre) {
      alert('Por favor ingresa el nombre del modelo');
      return;
    }
    
    try {
      const response = await fetch('/taller/vehiculos/api/modelos/crear/', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]').value
        },
        body: JSON.stringify({
          marca_id: marcaId,
          nombre: modeloNombre
        })
      });
      
      const data = await response.json();
      
      if (response.ok) {
        // Agregar el nuevo modelo al select
        const option = document.createElement('option');
        option.value = data.id;
        option.textContent = data.nombre;
        modeloSelect.appendChild(option);
        
        // Seleccionar el nuevo modelo
        modeloSelect.value = data.id;
        
        // Cerrar modal
        cerrarModalNuevoModelo();
        
        // Mostrar mensaje de éxito
        alert('✅ Modelo agregado exitosamente');
      } else {
        alert('❌ Error: ' + (data.error || 'No se pudo crear el modelo'));
      }
    } catch (error) {
      console.error('Error:', error);
      alert('❌ Error de conexión');
    }
  }
  
  // Cerrar modal al hacer clic fuera de él
  document.addEventListener('click', function(event) {
    const modal = document.getElementById('modal-nuevo-modelo');
    if (event.target === modal) {
      cerrarModalNuevoModelo();
    }
  });
  
  // Cerrar modal con Escape
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      cerrarModalNuevoModelo();
    }
  });
  
  // FUNCIONES PARA CARGAR MOTORES Y CAJAS DINÁMICAMENTE
  function setOptions(el, html) { 
    if (el) el.innerHTML = html; 
  }

  async function cargarOpciones(endpoint, modeloId) {
    if (!endpoint || endpoint === '#' || !modeloId) return [];
    try {
      const r = await fetch(`${endpoint}?modelo_id=${encodeURIComponent(modeloId)}`);
      if (!r.ok) return [];
      return await r.json(); // [{id, nombre}, ...]
    } catch (e) {
      console.error('Error cargando opciones:', e);
      return [];
    }
  }

  async function recargarMotorYCaja(modeloId) {
    const selMotor = document.getElementById('id_motor');
    const selCaja = document.getElementById('id_caja');

    // placeholders
    setOptions(selMotor, '<option value="">---------</option>');
    setOptions(selCaja, '<option value="">---------</option>');

    // carga en paralelo
    try {
      const [motores, cajas] = await Promise.all([
        cargarOpciones(MOTORES_API_URL, modeloId),
        cargarOpciones(CAJAS_API_URL, modeloId)
      ]);

      // construir options para motor
      let htmlMotor = '<option value="">---------</option>';
      motores.forEach(m => { 
        htmlMotor += `<option value="${m.id}">${m.nombre}</option>`; 
      });
      setOptions(selMotor, htmlMotor);

      // construir options para caja
      let htmlCaja = '<option value="">---------</option>';
      cajas.forEach(c => { 
        htmlCaja += `<option value="${c.id}">${c.nombre}</option>`; 
      });
      setOptions(selCaja, htmlCaja);

      console.log(`✅ Motores cargados: ${motores.length}, Cajas cargadas: ${cajas.length}`);
    } catch(e) { 
      console.error('Error recargando motor/caja:', e); 
    }
  }

  // Detectar cambio de modelo (Chile y USA)
  document.addEventListener('DOMContentLoaded', () => {
    const selModeloCL = document.getElementById('id_modelo');
    const selModeloUS = document.getElementById('id_modelo_usa');

    function onModeloChange(e) {
      const modeloId = e.target.value;
      // Limpia selección actual
      const selMotor = document.getElementById('id_motor');
      const selCaja = document.getElementById('id_caja');
      if (selMotor) selMotor.value = '';
      if (selCaja) selCaja.value = '';

      if (modeloId) {
        recargarMotorYCaja(modeloId);
      } else {
        // sin modelo -> reset a placeholder
        setOptions(selMotor, '<option value="">---------</option>');
        setOptions(selCaja, '<option value="">---------</option>');
      }
    }

    if (selModeloCL) selModeloCL.addEventListener('change', onModeloChange);
    if (selModeloUS) selModeloUS.addEventListener('change', onModeloChange);

    // precarga si ya viene un modelo seleccionado (edición o re-render con errores)
    const preCL = selModeloCL?.value;
    const preUS = selModeloUS?.value;
    const pre = preCL || preUS;
    if (pre) recargarMotorYCaja(pre);
  });
  </script>
{% endblock %}
