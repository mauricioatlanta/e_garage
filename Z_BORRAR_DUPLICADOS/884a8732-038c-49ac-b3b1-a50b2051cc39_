<table class="w-full table-auto text-left text-white table-cool">
  <thead class="text-lime-300 border-b border-lime-400">
    <tr>
      <th class="py-3 px-4">Nombre</th>
      <th class="py-3 px-4">Correo</th>
      <th class="py-3 px-4">Teléfono</th>
      <th class="py-3 px-4">Dirección</th>
      <th class="py-3 px-4">Región</th>
      <th class="py-3 px-4">Ciudad</th>
      <th class="py-3 px-4 text-center">Acciones</th>
    </tr>
  </thead>
  <tbody>
    {% for cliente in clientes %}
    <tr class="border-b border-white/10 hover:bg-white/6 transition-colors">
      <td class="py-3 px-4">{{ cliente.nombre }}{% if cliente.apellido %} {{ cliente.apellido }}{% endif %}</td>
      <td class="py-3 px-4">{{ cliente.email }}</td>
      <td class="py-3 px-4">{{ cliente.telefono }}</td>
      <td class="py-3 px-4">{{ cliente.direccion }}</td>
      <td class="py-3 px-4">{% if cliente.region %}{{ cliente.region.nombre }}{% endif %}</td>
      <td class="py-3 px-4">{% if cliente.ciudad %}{{ cliente.ciudad.nombre }}{% endif %}</td>
      <td class="py-3 px-4 text-center">
  {% load country_url %}
  {% country_url 'clientes:ver_cliente' cliente.id as url_ver_cliente %}
  {% country_url 'clientes:editar_cliente' cliente.id as url_editar_cliente %}
  {% country_url 'clientes:eliminar_cliente' pk=cliente.id as url_eliminar_cliente %}
  <div class="inline-flex items-center gap-2 justify-center">
    <a href="{{ url_ver_cliente|default:'#' }}" class="btn-small view-btn" title="Ver cliente">👁️ Ver</a>
    <a href="{{ url_editar_cliente|default:'#' }}" class="btn-small edit-btn" title="Editar cliente">✏️ Editar</a>
    <a href="{{ url_eliminar_cliente|default:'#' }}"
       class="btn-small delete-btn"
       onclick="return confirmarEliminacion('{{ cliente.nombre }}{% if cliente.apellido %} {{ cliente.apellido }}{% endif %}')">🗑️ Eliminar</a>
  </div>
      </td>
    </tr>
    {% empty %}
    <tr>
      <td colspan="7" class="text-center py-6 text-gray-300">No hay clientes registrados.</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
