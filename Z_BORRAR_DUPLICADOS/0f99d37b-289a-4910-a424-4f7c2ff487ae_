{% load static i18n %}
<!doctype html>
<html lang="{{ LANGUAGE_CODE }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% block title %}eGarage — {% trans "Acceso" %}{% endblock %}</title>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="{% static 'css/eg-future.css' %}?v={{ STATIC_VERSION }}" rel="stylesheet" />
</head>
<body class="eg-bg">
  <div class="eg-stars"></div>
  <main class="eg-center">
    {% if messages %}
      <div class="eg-messages">
        {% for message in messages %}
          <div class="eg-msg">{{ message }}</div>
        {% endfor %}
      </div>
    {% endif %}
    {% block content %}{% endblock %}
  </main>
  <footer class="eg-footer">
    <span>eGarage • {{ country|default:"CL" }} • {{ LANGUAGE_CODE|upper }}</span>
  </footer>
</body>
</html>
