<!-- Sección de Totales - Diseño Profesional -->
<div class="totals-section-professional">
  <div class="totals-header">
    <h3 class="totals-title">
      <i class="fas fa-calculator"></i>
      {% if empresa.pais == 'CL' %}Resumen Financiero{% else %}Financial Summary{% endif %}
    </h3>
  </div>

  <div class="totals-container">
    <!-- Subtotal Items -->
    <div class="totals-subsection">
      <div class="totals-row">
        <div class="totals-label">
          <i class="fas fa-cog"></i>
          {% if empresa.pais == 'CL' %}Repuestos{% else %}Parts{% endif %}
        </div>
        <div class="totals-amount" id="total-repuestos-display">$0.00</div>
        <input type="hidden" id="total-repuestos" value="0.00">
      </div>

      <div class="totals-row">
        <div class="totals-label">
          <i class="fas fa-tools"></i>
          {% if empresa.pais == 'CL' %}Servicios{% else %}Services{% endif %}
        </div>
        <div class="totals-amount" id="total-servicios-display">$0.00</div>
        <input type="hidden" id="total-servicios" value="0.00">
      </div>

      <div class="totals-row">
        <div class="totals-label">
          <i class="fas fa-building"></i>
          {% if empresa.pais == 'CL' %}Otros Servicios{% else %}Other Services{% endif %}
        </div>
        <div class="totals-amount" id="total-otros-servicios-display">$0.00</div>
        <input type="hidden" id="total-otros-servicios" value="0.00">
      </div>
    </div>

    <!-- Separator -->
    <div class="totals-separator"></div>

    <!-- Subtotal -->
    <div class="totals-subsection">
      <div class="totals-row subtotal-row">
        <div class="totals-label">
          <i class="fas fa-plus-circle"></i>
          {% if empresa.pais == 'CL' %}Subtotal{% else %}Subtotal{% endif %}
        </div>
        <div class="totals-amount subtotal-amount" id="subtotal-display">$0.00</div>
        <input type="hidden" id="subtotal" value="0.00">
      </div>
    </div>

    <!-- Tax Section -->
    <div class="totals-subsection tax-subsection">
      <div class="tax-toggle">
        <label class="tax-toggle-label">
          <input type="checkbox" id="incluir-impuestos" class="tax-checkbox">
          <span class="tax-toggle-text">
            <i class="fas fa-percentage"></i>
            {% if empresa.pais == 'CL' %}Incluir IVA (19%){% else %}Include Tax (8.25%){% endif %}
          </span>
        </label>
      </div>

      <div class="totals-row tax-row" id="tax-row" style="display: none;">
        <div class="totals-label">
          <i class="fas fa-receipt"></i>
          {% if empresa.pais == 'CL' %}IVA{% else %}Tax{% endif %}
        </div>
        <div class="totals-amount tax-amount" id="monto-impuestos-display">$0.00</div>
        <input type="hidden" id="monto-impuestos" value="0.00">
      </div>
    </div>

    <!-- Grand Total -->
    <div class="totals-separator"></div>

    <div class="totals-subsection grand-total-subsection">
      <div class="totals-row grand-total-row">
        <div class="totals-label grand-total-label">
          <i class="fas fa-dollar-sign"></i>
          {% if empresa.pais == 'CL' %}TOTAL FINAL{% else %}GRAND TOTAL{% endif %}
        </div>
        <div class="totals-amount grand-total-amount" id="gran-total-display">$0.00</div>
        <input type="hidden" id="gran-total" value="0.00">
      </div>
    </div>
  </div>
</div>

