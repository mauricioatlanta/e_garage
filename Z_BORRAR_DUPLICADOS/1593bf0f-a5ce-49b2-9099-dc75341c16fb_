{% block content %}
<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <!-- DEBUG: LANGUAGE_CODE={{ LANGUAGE_CODE }}, request.path={{ request.path }}, country={{ country }} -->
