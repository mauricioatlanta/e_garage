# ============================================================================
# VARIABLES DE ENTORNO - eGarage v2.0 PRODUCCIÓN
# ============================================================================
# Copia este archivo a .env en el servidor y configura los valores
# ============================================================================

# DJANGO
DJANGO_SECRET_KEY=generar-nueva-con-get_random_secret_key
DEBUG=False
ALLOWED_HOSTS=egarage.cl,www.egarage.cl

# BASE DE DATOS (PostgreSQL)
DB_NAME=egarage_prod
DB_USER=egarage
DB_PASSWORD=password-seguro-cambiar
DB_HOST=localhost
DB_PORT=5432

# EMAIL
EMAIL_HOST=srv24.cpanelhost.cl
EMAIL_PORT=465
EMAIL_HOST_USER=subscription@egarage.cl
EMAIL_HOST_PASSWORD=tu-password-email

# SEGURIDAD HTTPS
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://egarage.cl,https://www.egarage.cl

# REDIS (opcional)
REDIS_URL=redis://127.0.0.1:6379/1

# SENTRY (opcional)
# SENTRY_DSN=https://...

