{% extends "base.html" %}
{% load i18n %}
{% block content %}
<style>
body {
  min-height: 100vh;
  margin: 0;
  background: linear-gradient(135deg, #0f0f23 0%, #1a1a2e 25%, #16213e 50%, #0f3460 75%, #533483 100%);
  background-size: 400% 400%;
  animation: gradientShift 15s ease infinite;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

@keyframes gradientShift {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

.reset-complete-container {
  max-width: 500px;
  margin: 80px auto 0 auto;
  background: rgba(15, 15, 35, 0.95);
  backdrop-filter: blur(20px);
  border-radius: 24px;
  border: 2px solid rgba(0, 255, 127, 0.3);
  box-shadow:
    0 20px 60px rgba(0, 0, 0, 0.5),
    0 0 40px rgba(0, 255, 127, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.1);
  padding: 3rem 2.5rem;
  color: #fff;
  text-align: center;
  position: relative;
  z-index: 2;
  overflow: hidden;
}

.reset-complete-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, #00ff7f, #a3ff12, #00eaff, transparent);
  animation: borderGlow 3s ease-in-out infinite;
}

@keyframes borderGlow {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

.reset-complete-container h2 {
  color: #00ff7f;
  font-family: 'Orbitron', 'Segoe UI', Arial, sans-serif;
  font-size: 2.2rem;
  font-weight: 700;
  margin-bottom: 1.5rem;
  text-shadow: 0 0 20px #00ff7f88;
  letter-spacing: 2px;
  animation: titlePulse 2s ease-in-out infinite;
}

@keyframes titlePulse {
  0%, 100% { text-shadow: 0 0 20px #00ff7f88; }
  50% { text-shadow: 0 0 30px #00ff7f, 0 0 40px #00ff7f66; }
}

.reset-complete-container p {
  color: #b2e0ff;
  margin-bottom: 2rem;
  font-size: 1.1rem;
  line-height: 1.6;
  opacity: 0.9;
}

.reset-complete-container .icon-success {
  display: block;
  margin: 0 auto 2rem auto;
  width: 80px;
  height: 80px;
  filter: drop-shadow(0 0 20px #00ff7f88);
  animation: iconFloat 3s ease-in-out infinite;
}

@keyframes iconFloat {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}

.reset-complete-container .btn-success {
  background: linear-gradient(135deg, #00ff7f 0%, #a3ff12 50%, #00eaff 100%);
  color: #000;
  font-family: 'Orbitron', 'Segoe UI', Arial, sans-serif;
  font-size: 1.2rem;
  font-weight: 700;
  padding: 1rem 2rem;
  border: none;
  border-radius: 12px;
  cursor: pointer;
  box-shadow:
    0 8px 25px rgba(0, 255, 127, 0.4),
    0 0 20px rgba(0, 255, 127, 0.2);
  letter-spacing: 1px;
  transition: all 0.3s ease;
  margin-top: 1rem;
  width: 100%;
  text-decoration: none;
  display: inline-block;
  position: relative;
  overflow: hidden;
}

.reset-complete-container .btn-success::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.5s;
}

.reset-complete-container .btn-success:hover::before {
  left: 100%;
}

.reset-complete-container .btn-success:hover {
  background: linear-gradient(135deg, #00eaff 0%, #a3ff12 50%, #00ff7f 100%);
  transform: translateY(-3px) scale(1.05);
  box-shadow:
    0 15px 35px rgba(0, 255, 127, 0.6),
    0 0 30px rgba(0, 255, 127, 0.4);
}

.success-animation {
  position: relative;
  display: inline-block;
}

.success-animation::after {
  content: '✓';
  position: absolute;
  top: -10px;
  right: -10px;
  background: #00ff7f;
  color: #000;
  border-radius: 50%;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  animation: successBounce 0.6s ease-out;
}

@keyframes successBounce {
  0% { transform: scale(0); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.floating-particles {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
}

.particle {
  position: absolute;
  width: 4px;
  height: 4px;
  background: #00ff7f;
  border-radius: 50%;
  animation: float 6s infinite linear;
  opacity: 0.6;
}

@keyframes float {
  0% {
    transform: translateY(100vh) rotate(0deg);
    opacity: 0;
  }
  10% {
    opacity: 0.6;
  }
  90% {
    opacity: 0.6;
  }
  100% {
    transform: translateY(-100px) rotate(360deg);
    opacity: 0;
  }
}

.particle:nth-child(1) { left: 10%; animation-delay: 0s; }
.particle:nth-child(2) { left: 20%; animation-delay: 1s; }
.particle:nth-child(3) { left: 30%; animation-delay: 2s; }
.particle:nth-child(4) { left: 40%; animation-delay: 3s; }
.particle:nth-child(5) { left: 50%; animation-delay: 4s; }
.particle:nth-child(6) { left: 60%; animation-delay: 5s; }
.particle:nth-child(7) { left: 70%; animation-delay: 0.5s; }
.particle:nth-child(8) { left: 80%; animation-delay: 1.5s; }
.particle:nth-child(9) { left: 90%; animation-delay: 2.5s; }
</style>

<div class="floating-particles">
  <div class="particle"></div>
  <div class="particle"></div>
  <div class="particle"></div>
  <div class="particle"></div>
  <div class="particle"></div>
  <div class="particle"></div>
  <div class="particle"></div>
  <div class="particle"></div>
  <div class="particle"></div>
</div>

<div class="reset-complete-container">
  <div class="success-animation">
    <svg class="icon-success" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 48 48">
      <rect width="48" height="48" rx="12" fill="#00ff7f" fill-opacity="0.15"/>
      <path d="M16 20l8 8 16-16" stroke="#00ff7f" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  <h2>{% trans "¡Contraseña Restablecida!" %}</h2>
  <p>{% trans "Tu contraseña ha sido restablecida exitosamente. Ahora puedes iniciar sesión con tu nueva contraseña." %}</p>

  {% load country_url %}
  <a href="{% country_url 'account_login' %}" class="btn-success">{% trans "Iniciar Sesión" %}</a>
</div>
{% endblock %}
