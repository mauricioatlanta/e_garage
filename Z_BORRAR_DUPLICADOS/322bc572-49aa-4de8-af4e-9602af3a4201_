{% load i18n static %}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <title>{% trans "Agregar motor" %}</title>
  <link rel="stylesheet" href="{% static 'css/select2-contrast.css' %}">
  <style>
    body{background:#0b1020;color:#e6f0ff;font-family:Montserrat,Arial,sans-serif;padding:18px}
    .card{background:#0f172a;border:1px solid #334155;border-radius:12px;padding:16px;max-width:520px;margin:auto}
    label{display:block;margin:.25rem 0 .35rem;color:#cfe1ff}
    input[type=text]{width:100%;background:#0b1020;border:1px solid #334155;border-radius:10px;color:#e6f0ff;padding:.55rem .7rem}
    .row{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
    .actions{display:flex;gap:.5rem;justify-content:flex-end;margin-top:1rem}
    .btn{background:#1e293b;border:1px solid #334155;color:#e6f0ff;border-radius:10px;padding:.55rem .9rem;cursor:pointer}
    .btn:hover{background:#0b3a4a;border-color:#22d3ee}
    .muted{opacity:.75;font-size:.9rem}
  </style>
</head>
<body>
  <div class="card">
    <h2 style="margin-top:0">{% trans "Agregar motor" %}</h2>

    <form method="post">
      {% csrf_token %}
      <input type="hidden" name="next" value="{{ next|default:'' }}">
      <input type="hidden" name="modelo" value="{{ modelo_id|default:'' }}">

      <label>{% trans "Nombre del motor" %} *</label>
      <input type="text" name="nombre" autofocus required placeholder="Ej: 5.7L V8, 2.0L Turbo, etc.">

      <div class="row">
        <div>
          <label>{% trans "Modelo (referencia)" %}</label>
          <input type="text" value="{{ modelo_id|default:'—' }}" disabled class="muted">
        </div>
        <div>
          <label>{% trans "Estado" %}</label>
          <input type="text" value="{% if modelo_id %}{% trans 'Se asociará al modelo' %}{% else %}{% trans 'Motor general' %}{% endif %}" disabled class="muted">
        </div>
      </div>

      <div class="actions">
        <button type="button" class="btn" onclick="window.close()">{% trans "Cancelar" %}</button>
        <button class="btn" type="submit">{% trans "Guardar" %}</button>
      </div>
    </form>
  </div>
</body>
</html>
