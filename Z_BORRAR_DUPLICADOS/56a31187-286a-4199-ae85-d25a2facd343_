{% extends "base.html" %}
{% load country_url %}
{% load i18n static %}

{% block content %}
{% csrf_token %}

<div id="servicios-endpoints"
     data-search-url="{% country_url 'servicios:buscar_servicios_api' %}"
     data-create-categoria-url="{% country_url 'servicios:crear_categoria_api' %}"
     data-create-subcategoria-url="{% country_url 'servicios:crear_subcategoria_api' %}"
     data-view-url-template="{% country_url 'servicios:ver_servicio' 0 %}"
     data-edit-url-template="{% country_url 'servicios:editar_servicio' 0 %}"
     data-delete-url-template="/cl/es/servicios/0/eliminar/"
     data-país="CL"
     class="hidden"></div>

<div class="min-h-screen bg-black relative overflow-hidden">
  <div id="spaceBackground" class="absolute inset-0">
    <div class="stars"></div>
    <div class="twinkling"></div>
    <div class="clouds"></div>
  </div>

  <div class="relative z-10 p-4 lg:p-6">
    <div class="relative mb-6">
      <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-cyan-500 via-fuchsia-500 to-lime-400 opacity-20 blur-xl animate-pulse"></div>
      <div class="relative rounded-xl border border-cyan-400/30 bg-black/40 backdrop-blur-sm p-4 lg:p-6">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-cyan-400 to-blue-600 flex items-center justify-center text-xl shadow-lg ring-2 ring-cyan-400/40">🔧</div>
            <div>
              <h1 class="text-3xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-cyan-300 via-lime-300 to-emerald-400">
                Catálogo inteligente de servicios
              </h1>
              <p class="text-gray-400 text-sm">Explora, busca y administra los servicios de tu taller en tiempo real.</p>
            </div>
          </div>
          <div class="flex flex-wrap gap-3 justify-end">
            <button id="btnNuevaCategoria"
                    class="relative inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gradient-to-r from-purple-600 via-fuchsia-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white text-sm font-semibold border border-pink-400/40 shadow-lg shadow-pink-900/40 transition-all">
              <span>➕</span>
              <span>Crear categoría</span>
            </button>
            <button id="btnNuevaSubcategoria"
                    class="relative inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gradient-to-r from-indigo-600 via-cyan-600 to-blue-600 hover:from-indigo-500 hover:to-blue-500 text-white text-sm font-semibold border border-cyan-400/40 shadow-lg shadow-cyan-900/40 transition-all">
              <span>➕</span>
              <span>Nueva subcategoría</span>
            </button>
            <a href="{% country_url 'servicios:crear_servicio' %}"
               class="relative inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gradient-to-r from-emerald-600 via-lime-600 to-green-600 hover:from-emerald-500 hover:to-green-500 text-white text-sm font-semibold border border-emerald-400/40 shadow-lg shadow-emerald-900/40 transition-all">
              <span>⚙️</span>
              <span>Agregar servicio</span>
            </a>
          </div>
        </div>

        <div class="mt-4 grid grid-cols-2 lg:grid-cols-4 gap-3 text-xs text-gray-400">
          <div class="flex items-center gap-2"><span class="text-cyan-300">📂</span> <span>{{ stats.total_categorias }} categorías</span></div>
          <div class="flex items-center gap-2"><span class="text-lime-300">🧩</span> <span>{{ stats.total_subcategorias }} subcategorías</span></div>
          <div class="flex items-center gap-2"><span class="text-fuchsia-300">🛠️</span> <span>{{ stats.total_servicios }} servicios totales</span></div>
          <div class="flex items-center gap-2"><span class="text-amber-300">✨</span> <span>{{ stats.categorias_con_servicios }} categorías con contenido</span></div>
        </div>
      </div>
    </div>

    <div class="mb-4 space-y-3">
      <div class="relative group">
        <div class="absolute -inset-0.5 rounded-lg bg-gradient-to-r from-cyan-600 via-fuchsia-600 to-lime-600 opacity-40 blur group-hover:opacity-60 transition-opacity"></div>
        <div class="relative flex flex-col lg:flex-row lg:items-center lg:gap-4 rounded-lg border border-cyan-500/30 bg-black/40 backdrop-blur-sm overflow-hidden p-3">
          <div class="relative flex-1">
            <input type="search" id="searchInput" autocomplete="off"
                   placeholder="Buscar al instante por nombre, categoría, subcategoría o alias..."
                   class="w-full pl-10 pr-4 py-3 bg-black/30 text-gray-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-cyan-400/50 text-sm rounded-lg border border-cyan-400/20">
            <div class="absolute left-3 top-1/2 transform -translate-y-1/2 text-cyan-400">🔍</div>
          </div>
          <div class="flex flex-wrap gap-2">
            <select id="categoriaFilter"
                    class="px-3 py-2 rounded-lg bg-black/40 border border-cyan-400/30 text-cyan-300 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-400/50 min-w-[180px]">
              <option value="">Todas las categorías</option>
              {% for categoria in categorias %}
              <option value="{{ categoria.id }}" data-code="{{ categoria.code }}">{{ categoria.get_label }}</option>
              {% endfor %}
            </select>
            <select id="subcategoriaFilter"
                    class="px-3 py-2 rounded-lg bg-black/40 border border-emerald-400/30 text-emerald-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400/50 min-w-[200px]">
              <option value="">Todas las subcategorías</option>
              {% for subcategoria in subcategorias %}
              <option value="{{ subcategoria.id }}" data-categoria-id="{{ subcategoria.categoria_id }}">{{ subcategoria.get_label }}</option>
              {% endfor %}
            </select>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-between text-xs text-gray-400">
        <p id="resultsCounter">Mostrando {{ servicios|length }} de {{ stats.total_servicios }} servicios.</p>
        <div id="loaderServicios" class="hidden flex items-center gap-2 text-cyan-300">
          <span class="w-3 h-3 border-2 border-cyan-300 border-t-transparent rounded-full animate-spin"></span>
          <span>Buscando...</span>
        </div>
      </div>
    </div>

    <div id="servicesContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
      {% for servicio in servicios %}
      <div class="group relative service-card hover:scale-[1.02] transition-all duration-300"
           data-name="{{ servicio.nombre|default:'' }}"
           data-categoria="{{ servicio.categoria.get_label|default:'' }}"
           data-subcategoria="{{ servicio.subcategoria.get_label|default:'' }}"
           data-categoria-id="{{ servicio.categoria_id|default_if_none:'' }}"
           data-subcategoria-id="{{ servicio.subcategoria_id|default_if_none:'' }}">
        <div class="absolute -inset-1 rounded-lg bg-gradient-to-r from-cyan-600/20 via-fuchsia-600/20 to-lime-600/20 opacity-0 group-hover:opacity-100 blur transition-all duration-300"></div>
        <div class="relative rounded-lg border border-gray-700/50 bg-black/40 backdrop-blur-sm hover:border-cyan-400/30 transition-all duration-300 h-52 flex flex-col">
          <div class="p-3 border-b border-gray-700/30 flex-shrink-0">
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-md bg-gradient-to-br from-cyan-500/20 to-blue-500/20 border border-cyan-400/30 flex items-center justify-center">
                  <span class="text-cyan-300 text-sm">⚙️</span>
                </div>
                <div>
                  <p class="text-cyan-300 font-mono font-semibold text-sm truncate w-40">{{ servicio.nombre|default:'-' }}</p>
                  <p class="text-gray-600 text-[11px] uppercase tracking-widest">ID #{{ servicio.pk }}</p>
                </div>
              </div>
              <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
            </div>
          </div>
          <div class="p-3 space-y-2 flex-1">
            <div>
              <p class="text-[11px] text-gray-500 uppercase tracking-wider">Servicio</p>
              <p class="text-gray-100 font-medium text-sm truncate">{{ servicio.nombre|default:'-' }}</p>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <p class="text-[11px] text-gray-500 uppercase tracking-wider">Categoría</p>
                <p class="text-emerald-300 font-semibold text-xs truncate">{{ servicio.categoria.get_label|default:'-' }}</p>
              </div>
              <div>
                <p class="text-[11px] text-gray-500 uppercase tracking-wider">Subcategoría</p>
                <p class="text-lime-300 font-semibold text-xs truncate">{{ servicio.subcategoria.get_label|default:'-' }}</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-5 h-5 rounded-md bg-gradient-to-br from-fuchsia-500/20 to-purple-500/20 border border-fuchsia-400/30 flex items-center justify-center">
                <span class="text-fuchsia-300 text-xs">🧠</span>
              </div>
              <div>
                <p class="text-[11px] text-gray-500 uppercase tracking-wider">Tipo</p>
                <p class="text-fuchsia-300 font-semibold text-xs">{% if servicio.tipo %}{{ servicio.tipo|title }}{% else %}Interno{% endif %}</p>
              </div>
            </div>
          </div>
          <div class="p-3 border-t border-gray-700/30 flex-shrink-0">
            <div class="flex justify-between gap-1">
              <a href="{% country_url 'servicios:ver_servicio' servicio.pk %}"
                 class="flex-1 px-2 py-1.5 rounded-md bg-gradient-to-r from-cyan-600/20 to-blue-600/20 border border-cyan-400/40 text-cyan-300 hover:from-cyan-500/30 hover:to-blue-500/30 transition-all duration-200 text-xs font-semibold text-center">Ver</a>
              <a href="{% country_url 'servicios:editar_servicio' servicio.pk %}"
                 class="flex-1 px-2 py-1.5 rounded-md bg-gradient-to-r from-emerald-600/20 to-green-600/20 border border-emerald-400/40 text-emerald-300 hover:from-emerald-500/30 hover:to-green-500/30 transition-all duration-200 text-xs font-semibold text-center">Editar</a>
              <button type="button"
                      onclick="confirmarEliminacion({{ servicio.pk }}, '{{ servicio.nombre|escapejs }}')"
                      class="flex-1 px-2 py-1.5 rounded-md bg-gradient-to-r from-red-600/20 to-pink-600/20 border border-red-400/40 text-red-300 hover:from-red-500/30 hover:to-pink-500/30 transition-all duration-200 text-xs font-semibold text-center">Eliminar</button>
            </div>
          </div>
        </div>
      </div>
      {% empty %}
      <div class="col-span-full">
        <div class="relative">
          <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-gray-600 via-gray-500 to-gray-600 opacity-20 blur-xl"></div>
          <div class="relative rounded-xl border border-gray-600/30 bg-black/40 backdrop-blur-sm p-8 text-center">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-gray-500/20 to-gray-600/20 border border-gray-400/30 flex items-center justify-center text-2xl">🔧</div>
            <h3 class="text-lg font-bold text-gray-300 mb-2">No hay servicios registrados</h3>
            <p class="text-gray-500 text-sm">Agrega servicios para comenzar a construir tu catálogo inteligente.</p>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

<div id="modalEliminacion" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden z-50">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="relative w-full max-w-md">
      <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-red-500 via-pink-500 to-red-500 opacity-30 blur-xl"></div>
      <div class="relative rounded-xl border border-red-400/30 bg-black/95 backdrop-blur-lg p-6">
        <div class="text-center space-y-4">
          <div class="w-16 h-16 mx-auto rounded-full bg-gradient-to-br from-red-600/20 to-pink-600/20 border border-red-400/40 flex items-center justify-center text-3xl">⚠️</div>
          <div class="space-y-2">
            <h3 class="text-xl font-bold text-gray-100">Confirmar eliminación</h3>
            <p class="text-gray-400 text-sm">¿Estás seguro de eliminar el servicio <span id="nombreServicio" class="text-red-400 font-semibold"></span>? Esta acción no se puede deshacer.</p>
          </div>
          <div class="flex gap-3">
            <button type="button" onclick="cerrarModal()" class="flex-1 px-4 py-2 rounded-lg bg-gradient-to-r from-gray-600/20 to-gray-700/20 border border-gray-500/40 text-gray-300 hover:from-gray-500/30 hover:to-gray-600/30 transition-all duration-200 text-sm font-medium">Cancelar</button>
            <button type="button" onclick="eliminarServicio()" class="flex-1 px-4 py-2 rounded-lg bg-gradient-to-r from-red-600/20 to-pink-600/20 border border-red-400/40 text-red-300 hover:from-red-500/30 hover:to-pink-500/30 transition-all duration-200 text-sm font-medium">Eliminar</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div id="modalNuevaCategoria" class="fixed inset-0 bg-black/60 backdrop-blur hidden z-50">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="relative w-full max-w-md">
      <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-purple-500 via-pink-500 to-cyan-500 opacity-30 blur-xl"></div>
      <div class="relative rounded-xl border border-purple-400/30 bg-black/95 backdrop-blur-lg p-6">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-xl font-bold text-gray-100">Crear nueva categoría</h3>
          <button type="button" class="text-gray-400 hover:text-gray-200" data-close-modal="modalNuevaCategoria">✖</button>
        </div>
        <form id="formNuevaCategoria" class="space-y-4">
          <div>
            <label for="inputNombreCategoria" class="text-sm text-gray-400">Nombre de la categoría</label>
            <input id="inputNombreCategoria" type="text" class="mt-1 w-full px-3 py-2 rounded-lg bg-black/40 border border-purple-400/40 text-gray-100 focus:outline-none focus:ring-2 focus:ring-purple-400/50" placeholder="Ej: Frenos deportivos" required>
          </div>
          <div>
            <label for="inputAliasCategoria" class="text-sm text-gray-400">Alias o modismos (separados por coma)</label>
            <input id="inputAliasCategoria" type="text" class="mt-1 w-full px-3 py-2 rounded-lg bg-black/40 border border-purple-400/40 text-gray-100 focus:outline-none focus:ring-2 focus:ring-purple-400/50" placeholder="Ej: brake service, frenos racing">
          </div>
          <div class="flex justify-end gap-2">
            <button type="button" class="px-4 py-2 rounded-lg bg-gray-700/60 text-gray-300" data-close-modal="modalNuevaCategoria">Cancelar</button>
            <button type="submit" class="px-4 py-2 rounded-lg bg-gradient-to-r from-purple-600 via-fuchsia-600 to-pink-600 text-white font-semibold">Guardar categoría</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<div id="modalNuevaSubcategoria" class="fixed inset-0 bg-black/60 backdrop-blur hidden z-50">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="relative w-full max-w-md">
      <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-indigo-500 via-cyan-500 to-teal-500 opacity-30 blur-xl"></div>
      <div class="relative rounded-xl border border-cyan-400/30 bg-black/95 backdrop-blur-lg p-6">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-xl font-bold text-gray-100">Nueva subcategoría</h3>
          <button type="button" class="text-gray-400 hover:text-gray-200" data-close-modal="modalNuevaSubcategoria">✖</button>
        </div>
        <form id="formNuevaSubcategoria" class="space-y-4">
          <div>
            <label for="modalSubcategoriaCategoria" class="text-sm text-gray-400">Categoría padre</label>
            <select id="modalSubcategoriaCategoria" class="mt-1 w-full px-3 py-2 rounded-lg bg-black/40 border border-cyan-400/40 text-gray-100 focus:outline-none focus:ring-2 focus:ring-cyan-400/50" required>
              <option value="">Selecciona categoría</option>
              {% for categoria in categorias %}
              <option value="{{ categoria.id }}">{{ categoria.get_label }}</option>
              {% endfor %}
            </select>
          </div>
          <div>
            <label for="inputNombreSubcategoria" class="text-sm text-gray-400">Nombre de la subcategoría</label>
            <input id="inputNombreSubcategoria" type="text" class="mt-1 w-full px-3 py-2 rounded-lg bg-black/40 border border-cyan-400/40 text-gray-100 focus:outline-none focus:ring-2 focus:ring-cyan-400/50" placeholder="Ej: Rectificación de discos" required>
          </div>
          <div>
            <label for="inputAliasSubcategoria" class="text-sm text-gray-400">Alias o modismos (separados por coma)</label>
            <input id="inputAliasSubcategoria" type="text" class="mt-1 w-full px-3 py-2 rounded-lg bg-black/40 border border-cyan-400/40 text-gray-100 focus:outline-none focus:ring-2 focus:ring-cyan-400/50" placeholder="Ej: discos, brake rotors">
          </div>
          <div class="flex justify-end gap-2">
            <button type="button" class="px-4 py-2 rounded-lg bg-gray-700/60 text-gray-300" data-close-modal="modalNuevaSubcategoria">Cancelar</button>
            <button type="submit" class="px-4 py-2 rounded-lg bg-gradient-to-r from-indigo-600 via-cyan-600 to-blue-600 text-white font-semibold">Guardar subcategoría</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
@keyframes move-stars { 0% { transform: translateY(0px); } 100% { transform: translateY(-1000px); } }
@keyframes twinkle { 0%, 100% { opacity: 0.3; } 50% { opacity: 1; } }
@keyframes move-clouds { 0% { transform: translateX(-100%); } 100% { transform: translateX(100vw); } }
@keyframes float { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-10px); } }
@keyframes explode { 0% { transform: scale(0); opacity: 1; } 100% { transform: scale(2); opacity: 0; } }
.stars { position: absolute; width: 100%; height: 100%; background-image: radial-gradient(2px 2px at 20px 30px, #eee, transparent),
          radial-gradient(2px 2px at 40px 70px, rgba(255,255,255,0.8), transparent),
          radial-gradient(1px 1px at 90px 40px, #fff, transparent),
          radial-gradient(1px 1px at 130px 80px, rgba(255,255,255,0.6), transparent),
          radial-gradient(2px 2px at 160px 30px, #ddd, transparent);
        background-repeat: repeat; background-size: 200px 100px; animation: move-stars 50s linear infinite; }
.twinkling { position: absolute; width: 100%; height: 100%; background-image: radial-gradient(1px 1px at 25px 5px, white, transparent),
             radial-gradient(1px 1px at 50px 25px, white, transparent),
             radial-gradient(1px 1px at 125px 20px, white, transparent),
             radial-gradient(1px 1px at 150px 75px, white, transparent);
             background-repeat: repeat; background-size: 200px 100px; animation: twinkle 3s ease-in-out infinite; }
.clouds { position: absolute; width: 100%; height: 100%; background-image: radial-gradient(20px 20px at 50px 50px, rgba(255,255,255,0.1), transparent),
          radial-gradient(15px 15px at 150px 30px, rgba(255,255,255,0.1), transparent),
          radial-gradient(25px 25px at 250px 70px, rgba(255,255,255,0.1), transparent);
          background-repeat: repeat; background-size: 300px 100px; animation: move-clouds 30s linear infinite; }
.particle { position: absolute; width: 2px; height: 2px; background: #00ffff; border-radius: 50%; animation: float 3s ease-in-out infinite; }
.explosion { position: absolute; width: 4px; height: 4px; background: radial-gradient(circle, #ff00ff, #00ffff, #ffff00); border-radius: 50%; animation: explode 0.5s ease-out forwards; pointer-events: none; }
.service-card { cursor: pointer; }
.service-card:hover { z-index: 10; }
.modal-open { overflow: hidden; }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const endpoints = document.getElementById('servicios-endpoints').dataset;
  const searchInput = document.getElementById('searchInput');
  const categoriaFilter = document.getElementById('categoriaFilter');
  const subcategoriaFilter = document.getElementById('subcategoriaFilter');
  const resultsCounter = document.getElementById('resultsCounter');
  const loader = document.getElementById('loaderServicios');
  const servicesContainer = document.getElementById('servicesContainer');
  const modalCategoria = document.getElementById('modalNuevaCategoria');
  const modalSubcategoria = document.getElementById('modalNuevaSubcategoria');
  const modalEliminacion = document.getElementById('modalEliminacion');
  const formNuevaCategoria = document.getElementById('formNuevaCategoria');
  const formNuevaSubcategoria = document.getElementById('formNuevaSubcategoria');
  const inputNombreCategoria = document.getElementById('inputNombreCategoria');
  const inputAliasCategoria = document.getElementById('inputAliasCategoria');
  const inputNombreSubcategoria = document.getElementById('inputNombreSubcategoria');
  const inputAliasSubcategoria = document.getElementById('inputAliasSubcategoria');
  const selectSubcategoriaCategoria = document.getElementById('modalSubcategoriaCategoria');
  const btnNuevaCategoria = document.getElementById('btnNuevaCategoria');
  const btnNuevaSubcategoria = document.getElementById('btnNuevaSubcategoria');

  let abortController = null;
  let servicioAEliminar = null;

  const categoriasData = [
    {% for categoria in categorias %}
    { id: {{ categoria.id }}, code: "{{ categoria.code|escapejs }}", label: "{{ categoria.get_label|escapejs }}" }{% if not forloop.last %},{% endif %}
    {% endfor %}
  ];

  const subcategoriasData = [
    {% for subcategoria in subcategorias %}
    { id: {{ subcategoria.id }}, code: "{{ subcategoria.code|escapejs }}", label: "{{ subcategoria.get_label|escapejs }}", categoria_id: {{ subcategoria.categoria_id }} }{% if not forloop.last %},{% endif %}
    {% endfor %}
  ];

  const initialServices = [
    {% for servicio in servicios %}
    {
      pk: {{ servicio.pk }},
      nombre: "{{ servicio.nombre|escapejs }}",
      categoria: "{{ servicio.categoria.get_label|default:''|escapejs }}",
      categoria_id: {% if servicio.categoria_id %}{{ servicio.categoria_id }}{% else %}null{% endif %},
      categoria_code: "{% if servicio.categoria %}{{ servicio.categoria.code|escapejs }}{% endif %}",
      subcategoria: "{{ servicio.subcategoria.get_label|default:''|escapejs }}",
      subcategoria_id: {% if servicio.subcategoria_id %}{{ servicio.subcategoria_id }}{% else %}null{% endif %},
      subcategoria_code: "{% if servicio.subcategoria %}{{ servicio.subcategoria.code|escapejs }}{% endif %}",
      tipo: "{{ servicio.tipo|default:''|escapejs }}"
    }{% if not forloop.last %},{% endif %}
    {% endfor %}
  ];

  let currentServicios = initialServices.slice();
  let ultimaCuenta = currentServicios.length;

  const escapeHtml = (value) => {
    if (value === null || value === undefined) return "";
    return String(value).replace(/[&<>"'`]/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#x27;',
      '`': '&#x60;'
    })[char]);
  };

  const buildUrl = (template, id) => template.replace(/0(?=\/?$)/, id);

  const mostrarToast = (mensaje, tipo = 'ok') => {
    const toast = document.createElement('div');
    toast.className = `fixed bottom-6 right-6 px-4 py-3 rounded-lg text-sm font-semibold shadow-lg transition-all duration-300 ${tipo === 'error' ? 'bg-red-600/80 text-white' : 'bg-emerald-600/80 text-white'}`;
    toast.textContent = mensaje;
    document.body.appendChild(toast);
    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-3');
      setTimeout(() => toast.remove(), 300);
    }, 2500);
  };

  const setLoading = (state) => {
    loader.classList.toggle('hidden', !state);
  };

  const ordenarPorEtiqueta = (lista) => lista.sort((a, b) => a.label.localeCompare(b.label, 'es', { sensitivity: 'base' }));

  const renderCategoriaOptions = (selected = categoriaFilter.value) => {
    ordenarPorEtiqueta(categoriasData);
    const opcionesFiltro = document.createDocumentFragment();
    const defaultOpt = document.createElement('option');
    defaultOpt.value = '';
    defaultOpt.textContent = 'Todas las categorías';
    opcionesFiltro.appendChild(defaultOpt);

    categoriasData.forEach(cat => {
      const opt = document.createElement('option');
      opt.value = cat.id;
      opt.dataset.code = cat.code;
      opt.textContent = cat.label;
      opcionesFiltro.appendChild(opt);
    });

    categoriaFilter.innerHTML = '';
    categoriaFilter.appendChild(opcionesFiltro);
    categoriaFilter.value = selected || '';

    const opcionesModal = document.createDocumentFragment();
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = 'Selecciona categoría';
    opcionesModal.appendChild(placeholder);
    categoriasData.forEach(cat => {
      const opt = document.createElement('option');
      opt.value = cat.id;
      opt.textContent = cat.label;
      opcionesModal.appendChild(opt);
    });
    selectSubcategoriaCategoria.innerHTML = '';
    selectSubcategoriaCategoria.appendChild(opcionesModal);
  };

  const renderSubcategoriaOptions = (selected = subcategoriaFilter.value) => {
    ordenarPorEtiqueta(subcategoriasData);
    const fragment = document.createDocumentFragment();
    const defaultOpt = document.createElement('option');
    defaultOpt.value = '';
    defaultOpt.textContent = 'Todas las subcategorías';
    fragment.appendChild(defaultOpt);
    subcategoriasData.forEach(sub => {
      const opt = document.createElement('option');
      opt.value = sub.id;
      opt.dataset.categoriaId = String(sub.categoria_id);
      opt.textContent = sub.label;
      fragment.appendChild(opt);
    });
    subcategoriaFilter.innerHTML = '';
    subcategoriaFilter.appendChild(fragment);
    if (selected && Array.from(subcategoriaFilter.options).some(opt => opt.value === selected)) {
      subcategoriaFilter.value = selected;
    }
    filtrarSubcategoriasPorCategoria();
  };

  const filtrarSubcategoriasPorCategoria = () => {
    const categoriaSeleccionada = categoriaFilter.value;
    Array.from(subcategoriaFilter.options).forEach(opt => {
      if (!opt.value) {
        opt.hidden = false;
        return;
      }
      const pertenece = !categoriaSeleccionada || opt.dataset.categoriaId === categoriaSeleccionada;
      opt.hidden = !pertenece;
    });
    if (subcategoriaFilter.selectedOptions.length && subcategoriaFilter.selectedOptions[0].hidden) {
      subcategoriaFilter.value = '';
    }
  };

  const construirCard = (servicio) => {
    const nombre = escapeHtml(servicio.nombre || '-');
    const categoria = escapeHtml(servicio.categoria || '-');
    const subcategoria = escapeHtml(servicio.subcategoria || '-');
    const tipo = escapeHtml(servicio.tipo ? servicio.tipo : 'Interno');
    const viewUrl = buildUrl(endpoints.viewUrlTemplate, servicio.pk);
    const editUrl = buildUrl(endpoints.editUrlTemplate, servicio.pk);
    return `
      <div class="group relative service-card hover:scale-[1.02] transition-all duration-300"
           data-name="${nombre}"
           data-categoria="${categoria}"
           data-subcategoria="${subcategoria}"
           data-categoria-id="${servicio.categoria_id || ''}"
           data-subcategoria-id="${servicio.subcategoria_id || ''}">
        <div class="absolute -inset-1 rounded-lg bg-gradient-to-r from-cyan-600/20 via-fuchsia-600/20 to-lime-600/20 opacity-0 group-hover:opacity-100 blur transition-all duration-300"></div>
        <div class="relative rounded-lg border border-gray-700/50 bg-black/40 backdrop-blur-sm hover:border-cyan-400/30 transition-all duration-300 h-52 flex flex-col">
          <div class="p-3 border-b border-gray-700/30 flex-shrink-0">
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-md bg-gradient-to-br from-cyan-500/20 to-blue-500/20 border border-cyan-400/30 flex items-center justify-center">
                  <span class="text-cyan-300 text-sm">⚙️</span>
                </div>
                <div>
                  <p class="text-cyan-300 font-mono font-semibold text-sm truncate w-40">${nombre}</p>
                  <p class="text-gray-600 text-[11px] uppercase tracking-widest">ID #${servicio.pk}</p>
                </div>
              </div>
              <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
            </div>
          </div>
          <div class="p-3 space-y-2 flex-1">
            <div>
              <p class="text-[11px] text-gray-500 uppercase tracking-wider">Servicio</p>
              <p class="text-gray-100 font-medium text-sm truncate">${nombre}</p>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <p class="text-[11px] text-gray-500 uppercase tracking-wider">Categoría</p>
                <p class="text-emerald-300 font-semibold text-xs truncate">${categoria || '-'}</p>
              </div>
              <div>
                <p class="text-[11px] text-gray-500 uppercase tracking-wider">Subcategoría</p>
                <p class="text-lime-300 font-semibold text-xs truncate">${subcategoria || '-'}</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-5 h-5 rounded-md bg-gradient-to-br from-fuchsia-500/20 to-purple-500/20 border border-fuchsia-400/30 flex items-center justify-center">
                <span class="text-fuchsia-300 text-xs">🧠</span>
              </div>
              <div>
                <p class="text-[11px] text-gray-500 uppercase tracking-wider">Tipo</p>
                <p class="text-fuchsia-300 font-semibold text-xs">${tipo || 'Interno'}</p>
              </div>
            </div>
          </div>
          <div class="p-3 border-t border-gray-700/30 flex-shrink-0">
            <div class="flex justify-between gap-1">
              <a href="${viewUrl}" class="flex-1 px-2 py-1.5 rounded-md bg-gradient-to-r from-cyan-600/20 to-blue-600/20 border border-cyan-400/40 text-cyan-300 hover:from-cyan-500/30 hover:to-blue-500/30 transition-all duration-200 text-xs font-semibold text-center">Ver</a>
              <a href="${editUrl}" class="flex-1 px-2 py-1.5 rounded-md bg-gradient-to-r from-emerald-600/20 to-green-600/20 border border-emerald-400/40 text-emerald-300 hover:from-emerald-500/30 hover:to-green-500/30 transition-all duration-200 text-xs font-semibold text-center">Editar</a>
              <button type="button" class="flex-1 px-2 py-1.5 rounded-md bg-gradient-to-r from-red-600/20 to-pink-600/20 border border-red-400/40 text-red-300 hover:from-red-500/30 hover:to-pink-500/30 transition-all duration-200 text-xs font-semibold text-center" onclick="confirmarEliminacion(${servicio.pk}, '${escapeHtml(servicio.nombre || '')}')">Eliminar</button>
            </div>
          </div>
        </div>
      </div>
    `;
  };

  const renderServices = (items, total = items.length) => {
    ultimaCuenta = total;
    if (!items.length) {
      servicesContainer.innerHTML = `
        <div class="col-span-full">
          <div class="relative">
            <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-gray-600 via-gray-500 to-gray-600 opacity-20 blur-xl"></div>
            <div class="relative rounded-xl border border-gray-600/30 bg-black/40 backdrop-blur-sm p-8 text-center">
              <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-gray-500/20 to-gray-600/20 border border-gray-400/30 flex items-center justify-center text-2xl">🔍</div>
              <h3 class="text-lg font-bold text-gray-300 mb-2">Sin resultados</h3>
              <p class="text-gray-500 text-sm">Prueba con otra palabra clave o crea una nueva categoría para este servicio.</p>
            </div>
          </div>
        </div>`;
    } else {
      servicesContainer.innerHTML = items.map(construirCard).join('');
    }
    resultsCounter.textContent = `${total} ${total === 1 ? 'servicio encontrado' : 'servicios encontrados'}`;
  };

  const debounce = (fn, delay = 250) => {
    let timeout;
    return (...args) => {
      clearTimeout(timeout);
      timeout = setTimeout(() => fn.apply(null, args), delay);
    };
  };

  const fetchServicios = () => {
    const params = new URLSearchParams();
    const query = (searchInput.value || '').trim();
    const categoria = categoriaFilter.value;
    const subcategoria = subcategoriaFilter.value;
    if (query) params.append('q', query);
    if (categoria) params.append('categoria', categoria);
    if (subcategoria) params.append('subcategoria', subcategoria);

    if (abortController) abortController.abort();
    abortController = new AbortController();

    setLoading(true);
    fetch(`${endpoints.searchUrl}?${params.toString()}`, {
      signal: abortController.signal,
      headers: {
        'Accept': 'application/json'
      }
    })
      .then(response => {
        if (!response.ok) {
          throw new Error('Error al buscar servicios');
        }
        return response.json();
      })
      .then(data => {
        currentServicios = (data.servicios || []).map(item => ({
          pk: item.pk,
          nombre: item.nombre,
          categoria: item.categoria,
          categoria_id: item.categoria_id,
          categoria_code: item.categoria_code,
          subcategoria: item.subcategoria,
          subcategoria_id: item.subcategoria_id,
          subcategoria_code: item.subcategoria_code,
          tipo: item.tipo
        }));
        renderServices(currentServicios, data.total || currentServicios.length);
      })
      .catch(error => {
        if (error.name !== 'AbortError') {
          console.error(error);
          mostrarToast('No fue posible completar la búsqueda', 'error');
        }
      })
      .finally(() => setLoading(false));
  };

  const debouncedFetch = debounce(() => fetchServicios());

  const abrirModal = (modal) => {
    modal.classList.remove('hidden');
    document.body.classList.add('modal-open');
  };

  const cerrarModalGenerico = (modal) => {
    modal.classList.add('hidden');
    document.body.classList.remove('modal-open');
  };

  btnNuevaCategoria.addEventListener('click', () => abrirModal(modalCategoria));
  btnNuevaSubcategoria.addEventListener('click', () => abrirModal(modalSubcategoria));

  document.querySelectorAll('[data-close-modal]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const targetModal = document.getElementById(btn.dataset.closeModal);
      if (targetModal) cerrarModalGenerico(targetModal);
    });
  });

  [modalCategoria, modalSubcategoria, modalEliminacion].forEach(modal => {
    if (!modal) return;
    modal.addEventListener('click', (e) => {
      if (e.target === modal) cerrarModalGenerico(modal);
    });
  });

  formNuevaCategoria.addEventListener('submit', (e) => {
    e.preventDefault();
    const nombre = inputNombreCategoria.value.trim();
    if (!nombre) {
      mostrarToast('Debes ingresar un nombre.', 'error');
      return;
    }
    const aliases = (inputAliasCategoria.value || '')
      .split(',')
      .map(item => item.trim())
      .filter(Boolean);

    fetch(endpoints.createCategoriaUrl, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRFToken': csrftoken,
        'Accept': 'application/json'
      },
      body: JSON.stringify({ nombre, aliases })
    })
      .then(resp => resp.json())
      .then(data => {
        if (!data.success) {
          throw new Error(data.error || 'No se pudo crear la categoría');
        }
        categoriasData.push({ id: data.categoria.id, code: data.categoria.code, label: data.categoria.label });
        renderCategoriaOptions(data.categoria.id);
        mostrarToast(`Categoría "${data.categoria.label}" lista para usar.`);
        formNuevaCategoria.reset();
        cerrarModalGenerico(modalCategoria);
      })
      .catch(error => {
        console.error(error);
        mostrarToast(error.message, 'error');
      });
  });

  formNuevaSubcategoria.addEventListener('submit', (e) => {
    e.preventDefault();
    const categoriaId = selectSubcategoriaCategoria.value;
    const nombre = inputNombreSubcategoria.value.trim();
    if (!categoriaId || !nombre) {
      mostrarToast('Selecciona categoría y nombre para la subcategoría.', 'error');
      return;
    }
    const aliases = (inputAliasSubcategoria.value || '')
      .split(',')
      .map(item => item.trim())
      .filter(Boolean);

    fetch(endpoints.createSubcategoriaUrl, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRFToken': csrftoken,
        'Accept': 'application/json'
      },
      body: JSON.stringify({ categoria_id: categoriaId, nombre, aliases })
    })
      .then(resp => resp.json())
      .then(data => {
        if (!data.success) {
          throw new Error(data.error || 'No se pudo crear la subcategoría');
        }
        subcategoriasData.push({
          id: data.subcategoria.id,
          code: data.subcategoria.code,
          label: nombre,
          categoria_id: parseInt(data.subcategoria.categoria_id, 10)
        });
        renderSubcategoriaOptions(data.subcategoria.id);
        mostrarToast(`Subcategoría "${nombre}" disponible.`);
        formNuevaSubcategoria.reset();
        cerrarModalGenerico(modalSubcategoria);
      })
      .catch(error => {
        console.error(error);
        mostrarToast(error.message, 'error');
      });
  });

  searchInput.addEventListener('input', debouncedFetch);
  categoriaFilter.addEventListener('change', () => {
    filtrarSubcategoriasPorCategoria();
    debouncedFetch();
  });
  subcategoriaFilter.addEventListener('change', debouncedFetch);

  const createParticles = () => {
    const particles = document.getElementById('particles');
    if (!particles) return;
    particles.innerHTML = '';
    for (let i = 0; i < 50; i++) {
      const particle = document.createElement('div');
      particle.className = 'particle';
      particle.style.left = Math.random() * 100 + '%';
      particle.style.top = Math.random() * 100 + '%';
      particle.style.animationDelay = Math.random() * 3 + 's';
      particles.appendChild(particle);
    }
  };

  const createExplosion = (x, y, target) => {
    const explosion = document.createElement('div');
    explosion.className = 'explosion';
    explosion.style.left = `${x}px`;
    explosion.style.top = `${y}px`;
    target.appendChild(explosion);
    setTimeout(() => explosion.remove(), 500);
  };

  servicesContainer.addEventListener('click', (event) => {
    const card = event.target.closest('.service-card');
    if (!card) return;
    if (event.target.closest('a') || event.target.closest('button')) return;
    const rect = card.getBoundingClientRect();
    createExplosion(event.clientX - rect.left, event.clientY - rect.top, card);
  });

  window.confirmarEliminacion = (id, nombre) => {
    servicioAEliminar = id;
    document.getElementById('nombreServicio').textContent = nombre;
    abrirModal(document.getElementById('modalEliminacion'));
  };

  window.cerrarModal = () => {
    servicioAEliminar = null;
    cerrarModalGenerico(document.getElementById('modalEliminacion'));
  };

  window.eliminarServicio = () => {
    if (!servicioAEliminar) return;
    const deleteTemplate = endpoints.deleteUrlTemplate;
    const url = buildUrl(deleteTemplate, servicioAEliminar);
    fetch(url, {
      method: 'POST',
      headers: {
        'X-CSRFToken': csrftoken,
        'Content-Type': 'application/json'
      }
    })
      .then(resp => {
        if (!resp.ok) throw new Error('No fue posible eliminar el servicio');
        mostrarToast('Servicio eliminado correctamente');
        window.location.reload();
      })
      .catch(error => {
        console.error(error);
        mostrarToast(error.message, 'error');
      });
  };

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      cerrarModal();
      cerrarModalGenerico(modalCategoria);
      cerrarModalGenerico(modalSubcategoria);
    }
  });

  renderCategoriaOptions();
  renderSubcategoriaOptions();
  renderServices(currentServicios, ultimaCuenta);
  createParticles();
  setTimeout(() => fetchServicios(), 200);
});
</script>

{% endblock %}
