# eGarage - Variables de entorno (12-factor)
# Copia este archivo a .env y ajusta los valores según tu entorno

# Seguridad
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True

# Base de datos
DATABASE_URL=sqlite:///db.sqlite3
# Para PostgreSQL: postgres://user:password@localhost:5432/dbname
# Para MySQL: mysql://user:password@localhost:3306/dbname

# Hosts permitidos (separados por comas)
ALLOWED_HOSTS=localhost,127.0.0.1

# Internacionalización
LANGUAGE_CODE=es
TIME_ZONE=America/Santiago

# Email
EMAIL_PASSWORD=your-email-password-here

# Configuración de empresa (opcional)
# EMPRESA_DEFAULT=1
# PAIS_DEFAULT=cl