{% extends 'taller/us/en/base.html' %}{% load static %}
{% load i18n %}
{% load widget_tweaks %}

{% block title %}
    {% trans "Servicios del Taller" %} - eGarage
{% endblock %}

<!-- Debug: Current namespace -->
<!-- Namespace: {{ request.resolver_match.namespace }} -->

{% block extra_css %}
<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --secondary-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        --success-gradient: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
        --dark-bg: #1a1a2e;
        --darker-bg: #16213e;
        --accent-blue: #0f3460;
        --neon-blue: #00d4ff;
        --neon-purple: #b84fce;
        --glass-bg: rgba(255, 255, 255, 0.1);
        --glass-border: rgba(255, 255, 255, 0.2);
    }

    body {
        background: var(--dark-bg);
        background-image:
            radial-gradient(circle at 25% 25%, #667eea22 0%, transparent 50%),
            radial-gradient(circle at 75% 75%, #764ba222 0%, transparent 50%);
        color: #ffffff;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    .futuristic-header {
        background: var(--primary-gradient);
        padding: 2rem 0;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
    }

    .futuristic-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="0.5"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
        opacity: 0.3;
    }

    .header-content {
        position: relative;
        z-index: 2;
    }

    .header-title {
        font-size: 3rem;
        font-weight: 800;
        text-align: center;
        margin: 0;
        text-shadow: 0 0 20px rgba(255, 255, 255, 0.5);
        background: linear-gradient(45deg, #ffffff, #00d4ff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: glow 2s ease-in-out infinite alternate;
    }

    @keyframes glow {
        from { text-shadow: 0 0 20px rgba(255, 255, 255, 0.5); }
        to { text-shadow: 0 0 30px rgba(0, 212, 255, 0.8); }
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: var(--glass-bg);
        backdrop-filter: blur(10px);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        padding: 1.5rem;
        text-align: center;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
        transition: left 0.5s;
    }

    .stat-card:hover::before {
        left: 100%;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 212, 255, 0.3);
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--neon-blue);
        display: block;
    }

    .stat-label {
        color: #b8c5d1;
        font-size: 0.9rem;
        margin-top: 0.5rem;
    }

    .search-section {
        background: var(--glass-bg);
        backdrop-filter: blur(15px);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2rem;
        position: relative;
    }

    .search-container {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: end;
    }

    .search-field {
        flex: 1;
        min-width: 300px;
    }

    .search-input {
        width: 100%;
        padding: 1rem 1.5rem;
        border: 2px solid transparent;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff;
        font-size: 1rem;
        transition: all 0.3s ease;
        backdrop-filter: blur(5px);
    }

    .search-input:focus {
        outline: none;
        border-color: var(--neon-blue);
        box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
        background: rgba(255, 255, 255, 0.15);
    }

    .search-input::placeholder {
        color: #b8c5d1;
    }

    .filter-select {
        padding: 1rem 1.5rem;
        border: 2px solid transparent;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff;
        font-size: 1rem;
        min-width: 200px;
        transition: all 0.3s ease;
    }

    .filter-select:focus {
        outline: none;
        border-color: var(--neon-purple);
        box-shadow: 0 0 20px rgba(184, 79, 206, 0.3);
    }

    .btn-futuristic {
        padding: 1rem 2rem;
        border: none;
        border-radius: 12px;
        background: var(--secondary-gradient);
        color: #ffffff;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: 0 4px 15px rgba(245, 87, 108, 0.3);
    }

    .btn-futuristic:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(245, 87, 108, 0.5);
        color: #ffffff;
        text-decoration: none;
    }

    .btn-primary {
        background: var(--success-gradient);
        box-shadow: 0 4px 15px rgba(79, 172, 254, 0.3);
    }

    .btn-primary:hover {
        box-shadow: 0 8px 25px rgba(79, 172, 254, 0.5);
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .service-card {
        background: var(--glass-bg);
        backdrop-filter: blur(10px);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        padding: 1.5rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .service-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: var(--primary-gradient);
    }

    .service-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(102, 126, 234, 0.2);
    }

    .service-title {
        font-size: 1.3rem;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 0.5rem;
    }

    .service-category {
        color: var(--neon-blue);
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .service-subcategory {
        color: #b8c5d1;
        font-size: 0.8rem;
    }

    .loading-spinner {
        display: none;
        text-align: center;
        padding: 2rem;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid rgba(255, 255, 255, 0.1);
        border-left: 4px solid var(--neon-blue);
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .no-results {
        text-align: center;
        padding: 3rem;
        color: #b8c5d1;
        display: none;
    }

    .navigation-tabs {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .nav-tab {
        padding: 0.8rem 1.5rem;
        border: 2px solid rgba(0, 212, 255, 0.3);
        border-radius: 12px;
        background: transparent;
        color: rgba(255, 255, 255, 0.7);
        text-decoration: none;
        transition: all 0.3s ease;
        font-weight: 500;
        backdrop-filter: blur(5px);
    }

    .nav-tab:hover, .nav-tab.active {
        border-color: var(--neon-blue);
        color: var(--neon-blue);
        background: rgba(0, 212, 255, 0.1);
        text-decoration: none;
        box-shadow: 0 0 15px rgba(0, 212, 255, 0.3);
        transform: translateY(-2px);
    }

    .nav-tab.active {
        background: rgba(0, 212, 255, 0.2);
        color: white;
        position: relative;
        overflow: hidden;
    }

    .nav-tab.active::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.5s;
    }

    .nav-tab.active:hover::before {
        left: 100%;
    }

    @media (max-width: 768px) {
        .header-title {
            font-size: 2rem;
        }

        .search-container {
            flex-direction: column;
        }

        .search-field,
        .filter-select {
            min-width: auto;
        }

        .services-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
{% endblock %}

{% block content %}
<div class="futuristic-header">
    <div class="container">
        <div class="header-content">
            <h1 class="header-title">{% trans "Centro de Servicios Avanzado" %}</h1>
            <p class="text-center text-white-50 mt-3">{% trans "Gestión inteligente de servicios mecánicos con tecnología de vanguardia" %}</p>
        </div>
    </div>
</div>

<div class="container">
    <!-- Estadísticas -->
    <div class="stats-grid">
        <div class="stat-card">
            <span class="stat-number">{{ stats.total_servicios }}</span>
            <div class="stat-label">{% trans "Servicios Activos" %}</div>
        </div>
        <div class="stat-card">
            <span class="stat-number">{{ stats.total_categorias }}</span>
            <div class="stat-label">{% trans "Categorías" %}</div>
        </div>
        <div class="stat-card">
            <span class="stat-number">{{ stats.total_subcategorias }}</span>
            <div class="stat-label">{% trans "Subcategorías" %}</div>
        </div>
    </div>

    <!-- Navegación -->
    <div class="navigation-tabs">
        <a href="{% if request.resolver_match.namespace == 'chile:servicios' or request.resolver_match.namespace == 'usa:servicios' %}{% url request.resolver_match.namespace|add:':servicios_menu' %}{% else %}{% url 'us:$1' %} %}{% endif %}" class="nav-tab active">
            <i class="fas fa-cogs"></i> {% trans "Servicios Internos" %}
        </a>
        <a href="{% if request.resolver_match.namespace == 'chile:servicios' or request.resolver_match.namespace == 'usa:servicios' %}{% url request.resolver_match.namespace|add:':otros_servicios_menu' %}{% else %}{% url 'us:$1' %} %}{% endif %}" class="nav-tab">
            <i class="fas fa-handshake"></i> {% trans "Servicios Externos" %}
        </a>
        <a href="{% if request.resolver_match.namespace == 'chile:servicios' or request.resolver_match.namespace == 'usa:servicios' %}{% url request.resolver_match.namespace|add:':crear_servicio' %}{% else %}{% url 'us:$1' %} %}{% endif %}" class="nav-tab">
            <i class="fas fa-plus"></i> {% trans "Nuevo Servicio" %}
        </a>
    </div>

    <!-- Búsqueda Inteligente -->
    <div class="search-section">
        <h3 class="text-white mb-3">
            <i class="fas fa-search me-2"></i>{% trans "Búsqueda Inteligente en Tiempo Real" %}
        </h3>
        <div class="search-container">
            <div class="search-field">
                <input type="text"
                       id="searchInput"
                       class="search-input"
                       placeholder="{% trans 'Buscar servicios, categorías, subcategorías...' %}">
            </div>
            <select id="categoriaFilter" class="filter-select">
                <option value="">{% trans "Todas las categorías" %}</option>
                {% for categoria in categorias %}
                    <option value="{{ categoria.id }}">{{ categoria.get_label }}</option>
                {% endfor %}
            </select>
            <button type="button" class="btn-futuristic btn-primary" id="btnBuscar">
                <i class="fas fa-search"></i> {% trans "Buscar" %}
            </button>
        </div>
    </div>

    <!-- Loading -->
    <div class="loading-spinner" id="loadingSpinner">
        <div class="spinner"></div>
        <p class="mt-3">{% trans "Buscando servicios..." %}</p>
    </div>

    <!-- Sin resultados -->
    <div class="no-results" id="noResults">
        <i class="fas fa-search fa-3x mb-3 text-muted"></i>
        <h4>{% trans "No se encontraron servicios" %}</h4>
        <p>{% trans "Intenta con otros términos de búsqueda o revisa los filtros aplicados." %}</p>
    </div>

    <!-- Grid de Servicios -->
    <div class="services-grid" id="servicesGrid">
        {% for servicio in servicios %}
        <div class="service-card">
            <div class="service-title">{{ servicio.nombre }}</div>
            <div class="service-category">
                <i class="fas fa-tag me-1"></i>{{ servicio.categoria.get_label }}
            </div>
            {% if servicio.subcategoria %}
            <div class="service-subcategory">
                <i class="fas fa-folder me-1"></i>{{ servicio.subcategoria.get_label }}
            </div>
            {% endif %}
        </div>
        {% empty %}
        <div class="col-12 text-center py-5">
            <i class="fas fa-tools fa-3x mb-3 text-muted"></i>
            <h4>{% trans "No hay servicios disponibles" %}</h4>
            <p class="text-muted">{% trans "Comienza agregando servicios a tu taller." %}</p>
            <a href="{% if request.resolver_match.namespace == 'chile:servicios' or request.resolver_match.namespace == 'usa:servicios' %}{% url request.resolver_match.namespace|add:':crear_servicio' %}{% else %}{% url 'us:$1' %} %}{% endif %}" class="btn-futuristic btn-primary mt-3">
                <i class="fas fa-plus"></i> {% trans "Crear Primer Servicio" %}
            </a>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('searchInput');
    const categoriaFilter = document.getElementById('categoriaFilter');
    const servicesGrid = document.getElementById('servicesGrid');
    const loadingSpinner = document.getElementById('loadingSpinner');
    const noResults = document.getElementById('noResults');
    let searchTimeout;

    function showLoading() {
        loadingSpinner.style.display = 'block';
        servicesGrid.style.display = 'none';
        noResults.style.display = 'none';
    }

    function hideLoading() {
        loadingSpinner.style.display = 'none';
    }

    function showResults(data) {
        hideLoading();

        if (data.servicios.length === 0) {
            servicesGrid.style.display = 'none';
            noResults.style.display = 'block';
            return;
        }

        noResults.style.display = 'none';
        servicesGrid.style.display = 'grid';

        // Limpiar grid
        servicesGrid.innerHTML = '';

        // Agregar servicios
        data.servicios.forEach(servicio => {
            const serviceCard = document.createElement('div');
            serviceCard.className = 'service-card';
            serviceCard.style.opacity = '0';
            serviceCard.style.transform = 'translateY(20px)';

            serviceCard.innerHTML = `
                <div class="service-title">${servicio.nombre}</div>
                <div class="service-category">
                    <i class="fas fa-tag me-1"></i>${servicio.categoria}
                </div>
                ${servicio.subcategoria ? `
                    <div class="service-subcategory">
                        <i class="fas fa-folder me-1"></i>${servicio.subcategoria}
                    </div>
                ` : ''}
            `;

            servicesGrid.appendChild(serviceCard);

            // Animación de entrada
            setTimeout(() => {
                serviceCard.style.transition = 'all 0.3s ease';
                serviceCard.style.opacity = '1';
                serviceCard.style.transform = 'translateY(0)';
            }, 50);
        });
    }

    function searchServices() {
        const query = searchInput.value.trim();
        const categoria = categoriaFilter.value;

        showLoading();

        const params = new URLSearchParams();
        if (query) params.append('q', query);
        if (categoria) params.append('categoria', categoria);

        fetch(`{% if request.resolver_match.namespace == 'chile:servicios' or request.resolver_match.namespace == 'usa:servicios' %}{% url request.resolver_match.namespace|add:':buscar_servicios_api' %}{% else %}{% url 'us:$1' %} %}{% endif %}?${params}`)
            .then(response => response.json())
            .then(data => {
                showResults(data);
            })
            .catch(error => {
                console.error('Error:', error);
                hideLoading();
                servicesGrid.style.display = 'none';
                noResults.style.display = 'block';
            });
    }

    // Búsqueda en tiempo real
    searchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(searchServices, 300);
    });

    // Filtro por categoría
    categoriaFilter.addEventListener('change', searchServices);

    // Botón de búsqueda
    document.getElementById('btnBuscar').addEventListener('click', searchServices);

    // Búsqueda al presionar Enter
    searchInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            searchServices();
        }
    });
});
</script>
{% endblock %}
