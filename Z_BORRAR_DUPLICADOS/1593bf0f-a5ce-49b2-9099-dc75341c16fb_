<script>
document.addEventListener("DOMContentLoaded", () => {
  // Configuración de partículas futuristas
  tsParticles.load("tsparticles", {
    fullScreen: { enable: false },
    background: { color: { value: "transparent" } },
    particles: {
      number: { value: 120 },
      color: { value: ["#00ffff", "#00e6ff", "#0099cc", "#ffffff"] },
      size: {
        value: { min: 1, max: 3 },
        animation: {
          enable: true,
          speed: 2,
          minimumValue: 0.5
        }
      },
      move: {
        enable: true,
        speed: { min: 0.3, max: 1.2 },
        direction: "none",
        outModes: { default: "out" }
      },
      links: {
        enable: true,
        color: "#00e6d0",
        opacity: 0.2,
        distance: 150,
        width: 1
      },
      opacity: {
        value: { min: 0.3, max: 0.8 },
        animation: {
          enable: true,
          speed: 1,
          minimumValue: 0.1
        }
      }
    },
    interactivity: {
      events: {
        onHover: {
          enable: true,
          mode: "repulse"
        },
        onClick: {
          enable: true,
          mode: "push"
        }
      },
      modes: {
        repulse: {
          distance: 100,
          duration: 0.4
        },
        push: {
          quantity: 4
        }
      }
    }
  });

  // Añadir clase fade-in a elementos que aparecen
  const sections = document.querySelectorAll('.form-section');
  sections.forEach((section, index) => {
    setTimeout(() => {
      section.classList.add('fade-in');
    }, index * 100);
  });
});
</script>
