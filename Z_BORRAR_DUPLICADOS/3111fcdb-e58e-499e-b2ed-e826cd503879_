{% extends "base.html" %}
{% load country_url %}
{% load i18n static widget_tweaks %}
{% load static %}

{% block content %}
<!-- Fondo animado -->
<div class="fixed inset-0 overflow-hidden pointer-events-none">
  <div class="absolute inset-0 bg-gradient-to-br from-[#0a0a0a] via-[#0d1117] to-[#0f172a]"></div>
  <!-- Partículas animadas -->
  <div class="absolute top-16 left-12 w-2 h-2 bg-cyan-400 rounded-full animate-ping opacity-20"></div>
  <div class="absolute top-1/3 right-20 w-1 h-1 bg-fuchsia-400 rounded-full animate-pulse opacity-30"></div>
  <div class="absolute bottom-24 left-1/4 w-1.5 h-1.5 bg-lime-400 rounded-full animate-bounce opacity-25"></div>
  <div class="absolute top-2/3 left-1/5 w-1 h-1 bg-emerald-400 rounded-full animate-ping opacity-20"></div>
  <div class="absolute bottom-1/2 right-1/3 w-2 h-2 bg-purple-400 rounded-full animate-pulse opacity-15"></div>
  <!-- Líneas de matriz animadas -->
  <div class="absolute inset-0 opacity-5">
    <div class="w-full h-px bg-gradient-to-r from-transparent via-cyan-500 to-transparent animate-pulse"></div>
    <div class="w-px h-full bg-gradient-to-b from-transparent via-fuchsia-500 to-transparent animate-pulse absolute left-1/3"></div>
    <div class="w-px h-full bg-gradient-to-b from-transparent via-lime-500 to-transparent animate-pulse absolute right-1/4"></div>
  </div>
</div>

<div class="relative min-h-screen p-4 sm:p-6">
  <!-- Header compacto -->
  <div class="relative mb-6">
    <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-cyan-500 via-fuchsia-500 to-lime-400 opacity-20 blur-xl animate-pulse"></div>
    <div class="relative rounded-2xl border border-cyan-400/30 bg-gradient-to-r from-[#0d1117]/90 to-[#111827]/90 backdrop-blur-sm p-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-400 to-green-600 flex items-center justify-center text-xl shadow-lg ring-2 ring-emerald-400/40">➕</div>
          <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-emerald-300 via-lime-300 to-green-400">
              {% trans "Crear Vehículo" %}
            </h1>
            <p class="text-gray-400 text-xs mt-0.5">{% trans "Registro vehicular" %}</p>
          </div>
        </div>

        <a href="{% url 'chile:taller:vehiculos:lista_vehiculos' %}"
           class="inline-flex items-center space-x-2 px-4 py-2 rounded-xl bg-gradient-to-r from-gray-600/20 to-gray-500/20 border border-gray-400/40 text-gray-300 hover:from-gray-500/30 hover:to-gray-400/30 hover:text-gray-200 transition-all duration-300">
          <span>⟲</span>
          <span class="hidden sm:inline">{% trans "Volver" %}</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Layout de dos columnas como libro abierto -->
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

      <!-- COLUMNA IZQUIERDA: Búsqueda de Cliente -->
      <div class="space-y-6">
        <!-- Información del Cliente -->
        <div class="relative">
          <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-cyan-500/20 via-blue-500/20 to-purple-500/20 blur-xl"></div>
          <div class="relative rounded-xl border border-cyan-400/30 bg-gradient-to-r from-[#0d1117]/90 to-[#111827]/90 backdrop-blur-sm p-6">
            <div class="flex items-center space-x-3 mb-4">
              <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-500/30 to-blue-500/30 border border-cyan-400/40 flex items-center justify-center">
                <span class="text-cyan-300 text-sm">👤</span>
              </div>
              <h2 class="text-lg font-bold text-cyan-300">{% trans "Información del Cliente" %}</h2>
            </div>

            <div class="space-y-4">
              <div>
                <label for="busqueda-cliente" class="block text-sm font-medium text-gray-300 mb-2">
                  {% trans "Cliente" %} *
                </label>
                <div class="relative">
                  <!-- Campo de búsqueda de cliente -->
                  <input type="text"
                         id="busqueda-cliente"
                         placeholder="🔍 Escribe el nombre del cliente para buscar..."
                         class="w-full px-4 py-3 pl-10 rounded-lg bg-gradient-to-r from-[#0a0a0a]/80 to-[#111827]/80 border border-cyan-500/30 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-cyan-400/50 focus:border-cyan-400"
                         autocomplete="off">

                  <!-- Icono de búsqueda -->
                  <div class="absolute left-3 top-1/2 transform -translate-y-1/2 text-cyan-400">
                    🔍
                  </div>

                  <!-- Loading spinner -->
                  <div id="loading-cliente" class="hidden absolute right-3 top-1/2 transform -translate-y-1/2">
                    <div class="w-4 h-4 border-2 border-cyan-400 border-t-transparent rounded-full animate-spin"></div>
                  </div>

                  <!-- Lista de sugerencias -->
                  <div id="sugerencias-clientes" class="absolute top-full left-0 right-0 mt-1 hidden" style="z-index: 9999;">
                    <div class="bg-gradient-to-r from-[#0d1117] to-[#111827] border border-cyan-400/40 rounded-lg shadow-2xl shadow-cyan-500/20 max-h-60 overflow-y-auto">
                      <!-- Las sugerencias se cargarán aquí -->
                    </div>
                  </div>

                  <!-- Cliente seleccionado -->
                  <div id="cliente-seleccionado" class="hidden mt-2 p-3 rounded-lg bg-gradient-to-r from-cyan-600/20 to-blue-600/20 border border-cyan-400/40">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center space-x-3">
                        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-500/30 to-blue-500/30 border border-cyan-400/40 flex items-center justify-center">
                          <span class="text-cyan-300 text-sm">👤</span>
                        </div>
                        <div>
                          <p class="text-cyan-200 font-medium" id="cliente-nombre"></p>
                          <p class="text-gray-400 text-xs" id="cliente-info"></p>
                        </div>
                      </div>
                      <button type="button"
                              id="limpiar-cliente"
                              class="text-gray-400 hover:text-red-400 transition-colors">
                        ✕
                      </button>
                    </div>
                  </div>
                </div>
                {% if form.cliente.errors %}
                  <div class="mt-1 text-xs text-red-400">
                    {{ form.cliente.errors.0 }}
                  </div>
                {% endif %}
              </div>

            </div>
          </div>
        </div>

        <!-- Información adicional del cliente (oculta con widget estándar) -->
        <div id="info-cliente-adicional" class="relative hidden">
          <!-- Esta sección está oculta porque usamos el widget estándar de autocompletado -->
        </div>
      </div>

      <!-- COLUMNA DERECHA: Formulario del Vehículo -->
      <div class="space-y-6">
        <form method="post" class="space-y-6">
          {% csrf_token %}

          <!-- Información del Vehículo -->
          <div class="relative">
            <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-emerald-500/20 via-lime-500/20 to-green-500/20 blur-xl"></div>
            <div class="relative rounded-xl border border-emerald-400/30 bg-gradient-to-r from-[#0d1117]/90 to-[#111827]/90 backdrop-blur-sm p-6">
          <div class="flex items-center space-x-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-emerald-500/30 to-green-500/30 border border-emerald-400/40 flex items-center justify-center">
              <span class="text-emerald-300 text-sm">🚗</span>
            </div>
            <h2 class="text-lg font-bold text-white">{% trans "Datos del Vehículo" %}</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <label for="{{ form.anio.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                {% trans "Año" %} *
              </label>
              {{ form.anio|add_class:"w-full px-4 py-3 rounded-lg bg-gradient-to-r from-[#0a0a0a]/80 to-[#111827]/80 border border-emerald-500/30 text-emerald-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-400/50 focus:border-emerald-400" }}
              {% if form.anio.errors %}
                <div class="mt-1 text-xs text-red-400">
                  {{ form.anio.errors.0 }}
                </div>
              {% endif %}
            </div>

            <div>
              <label for="{{ form.marca.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                {% trans "Marca" %} *
              </label>
              <select name="marca" id="id_marca" required class="w-full px-4 py-3 rounded-lg bg-gradient-to-r from-[#0a0a0a]/80 to-[#111827]/80 border border-emerald-500/30 text-emerald-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-400/50 focus:border-emerald-400">
                <option value="">Seleccionar marca...</option>
                <!-- Las opciones se cargarán dinámicamente -->
                <option value="add_new" style="background-color: #4B5563; color: white; font-style: italic;">➕ Agregar nueva marca...</option>
              </select>
              <div id="form-crear-marca" class="hidden mt-2 p-3 bg-emerald-900/20 border border-emerald-500/30 rounded-lg">
                <input type="text" id="nuevo-marca" placeholder="Nombre de la nueva marca..." class="w-full px-3 py-2 rounded bg-emerald-800/50 border border-emerald-500/30 text-emerald-200 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emerald-400/50">
                <div class="flex gap-2 mt-2">
                  <button type="button" id="btn-guardar-marca" class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-sm">Guardar</button>
                  <button type="button" id="btn-cancelar-marca" class="px-3 py-1 bg-gray-600 hover:bg-gray-700 text-white rounded text-sm">Cancelar</button>
                </div>
              </div>
              {% if form.marca.errors %}
                <div class="mt-1 text-xs text-red-400">
                  {{ form.marca.errors.0 }}
                </div>
              {% endif %}
            </div>

            <div>
              <label for="{{ form.modelo.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                {% trans "Modelo" %} *
              </label>
              <select name="modelo" id="id_modelo" required class="w-full px-4 py-3 rounded-lg bg-gradient-to-r from-[#0a0a0a]/80 to-[#111827]/80 border border-emerald-500/30 text-emerald-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-400/50 focus:border-emerald-400">
                <option value="">Seleccionar modelo...</option>
                <!-- Las opciones se cargarán dinámicamente -->
                <option value="add_new" style="background-color: #4B5563; color: white; font-style: italic;">➕ Agregar nuevo modelo...</option>
              </select>
              <div id="form-crear-modelo" class="hidden mt-2 p-3 bg-emerald-900/20 border border-emerald-500/30 rounded-lg">
                <input type="text" id="nuevo-modelo" placeholder="Nombre del nuevo modelo..." class="w-full px-3 py-2 rounded bg-emerald-800/50 border border-emerald-500/30 text-emerald-200 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emerald-400/50">
                <div class="flex gap-2 mt-2">
                  <button type="button" id="btn-guardar-modelo" class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-sm">Guardar</button>
                  <button type="button" id="btn-cancelar-modelo" class="px-3 py-1 bg-gray-600 hover:bg-gray-700 text-white rounded text-sm">Cancelar</button>
                </div>
              </div>
              {% if form.modelo.errors %}
                <div class="mt-1 text-xs text-red-400">
                  {{ form.modelo.errors.0 }}
                </div>
              {% endif %}
            </div>
          </div>

          <!-- Segunda fila con patente y color -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
            <div>
              <label for="{{ form.patente.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
                {% trans "Patente" %}
              </label>
              {{ form.patente|add_class:"w-full px-4 py-3 rounded-lg bg-gradient-to-r from-[#0a0a0a]/80 to-[#111827]/80 border border-emerald-500/30 text-emerald-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-400/50 focus:border-emerald-400" }}
              {% if form.patente.errors %}
                <div class="mt-1 text-xs text-red-400">
                  {{ form.patente.errors.0 }}
                </div>
              {% endif %}
            </div>

            <div>
              <label for="id_color" class="block text-sm font-medium text-gray-300 mb-2">
                {% trans "Color" %}
              </label>
              <select name="color" id="id_color" class="w-full px-4 py-3 rounded-lg bg-gradient-to-r from-[#0a0a0a]/80 to-[#111827]/80 border border-emerald-500/30 text-emerald-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-emerald-400/50 focus:border-emerald-400">
                <option value="">Seleccionar color...</option>
                <option value="1" style="background-color: #000000; color: white;">🖤 Negro</option>
                <option value="2" style="background-color: #FFFFFF; color: black;">⚪ Blanco</option>
                <option value="3" style="background-color: #FF0000; color: white;">🔴 Rojo</option>
                <option value="4" style="background-color: #0000FF; color: white;">🔵 Azul</option>
                <option value="5" style="background-color: #00FF00; color: black;">🟢 Verde</option>
                <option value="6" style="background-color: #FFFF00; color: black;">🟡 Amarillo</option>
                <option value="7" style="background-color: #808080; color: white;">⚫ Gris</option>
                <option value="add_new" style="background-color: #4B5563; color: white; font-style: italic;">➕ Agregar nuevo color...</option>
              </select>
              <div id="form-crear-color" class="hidden mt-2 p-3 bg-emerald-900/20 border border-emerald-500/30 rounded-lg">
                <input type="text" id="nuevo-color" placeholder="Nombre del nuevo color..." class="w-full px-3 py-2 rounded bg-emerald-800/50 border border-emerald-500/30 text-emerald-200 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emerald-400/50">
                <div class="flex gap-2 mt-2">
                  <button type="button" id="btn-guardar-color" class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-sm">Guardar</button>
                  <button type="button" id="btn-cancelar-color" class="px-3 py-1 bg-gray-600 hover:bg-gray-700 text-white rounded text-sm">Cancelar</button>
                </div>
              </div>
              {% if form.color.errors %}
                <div class="mt-1 text-xs text-red-400">
                  {{ form.color.errors.0 }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <!-- Información Técnica -->
      <div class="relative">
        <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-fuchsia-500/20 via-purple-500/20 to-pink-500/20 blur-xl"></div>
        <div class="relative rounded-xl border border-fuchsia-400/30 bg-gradient-to-r from-[#0d1117]/90 to-[#111827]/90 backdrop-blur-sm p-6">
          <div class="flex items-center space-x-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-fuchsia-500/30 to-purple-500/30 border border-fuchsia-400/40 flex items-center justify-center">
              <span class="text-fuchsia-300 text-sm">⚙️</span>
            </div>
            <h2 class="text-lg font-bold text-fuchsia-300">{% trans "Información Técnica" %}</h2>
          </div>

          <!-- VIN - Fila individual -->
          <div class="mb-4">
            <label for="{{ form.vin.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
              {% trans "VIN" %}
            </label>
            {{ form.vin|add_class:"w-full px-4 py-3 rounded-lg bg-gradient-to-r from-[#0a0a0a]/80 to-[#111827]/80 border border-fuchsia-500/30 text-fuchsia-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-fuchsia-400/50 focus:border-fuchsia-400" }}
            {% if form.vin.errors %}
              <div class="mt-1 text-xs text-red-400">
                {{ form.vin.errors.0 }}
              </div>
            {% endif %}
          </div>

          <!-- Motor - Fila individual -->
          <div class="mb-4">
            <label for="id_motor" class="block text-sm font-medium text-gray-300 mb-2">
              {% trans "Motor" %}
            </label>
            <select name="motor" id="id_motor" class="w-full px-4 py-3 rounded-lg bg-gradient-to-r from-[#0a0a0a]/80 to-[#111827]/80 border border-fuchsia-500/30 text-fuchsia-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-fuchsia-400/50 focus:border-fuchsia-400">
              <option value="">Seleccionar motor...</option>
              <option value="add_new" style="background-color: #4B5563; color: white; font-style: italic;">➕ Agregar nuevo motor...</option>
            </select>
            <div id="form-crear-motor" class="hidden mt-2 p-3 bg-fuchsia-900/20 border border-fuchsia-500/30 rounded-lg">
              <input type="text" id="nuevo-motor" placeholder="Nombre del nuevo motor..." class="w-full px-3 py-2 rounded bg-fuchsia-800/50 border border-fuchsia-500/30 text-fuchsia-200 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-400/50">
              <div class="flex gap-2 mt-2">
                <button type="button" id="btn-guardar-motor" class="px-3 py-1 bg-fuchsia-600 hover:bg-fuchsia-700 text-white rounded text-sm">Guardar</button>
                <button type="button" id="btn-cancelar-motor" class="px-3 py-1 bg-gray-600 hover:bg-gray-700 text-white rounded text-sm">Cancelar</button>
              </div>
            </div>
            {% if form.motor.errors %}
              <div class="mt-1 text-xs text-red-400">
                {{ form.motor.errors.0 }}
              </div>
            {% endif %}
          </div>

          <!-- Caja - Fila individual -->
          <div class="mb-4">
            <label for="id_caja" class="block text-sm font-medium text-gray-300 mb-2">
              {% trans "Caja" %}
            </label>
            <select name="caja" id="id_caja" class="w-full px-4 py-3 rounded-lg bg-gradient-to-r from-[#0a0a0a]/80 to-[#111827]/80 border border-fuchsia-500/30 text-fuchsia-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-fuchsia-400/50 focus:border-fuchsia-400">
              <option value="">Seleccionar caja...</option>
              <option value="add_new" style="background-color: #4B5563; color: white; font-style: italic;">➕ Agregar nueva caja...</option>
            </select>
            <div id="form-crear-caja" class="hidden mt-2 p-3 bg-fuchsia-900/20 border border-fuchsia-500/30 rounded-lg">
              <input type="text" id="nuevo-caja" placeholder="Nombre de la nueva caja..." class="w-full px-3 py-2 rounded bg-fuchsia-800/50 border border-fuchsia-500/30 text-fuchsia-200 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-400/50">
              <div class="flex gap-2 mt-2">
                <button type="button" id="btn-guardar-caja" class="px-3 py-1 bg-fuchsia-600 hover:bg-fuchsia-700 text-white rounded text-sm">Guardar</button>
                <button type="button" id="btn-cancelar-caja" class="px-3 py-1 bg-gray-600 hover:bg-gray-700 text-white rounded text-sm">Cancelar</button>
              </div>
            </div>
            {% if form.caja.errors %}
              <div class="mt-1 text-xs text-red-400">
                {{ form.caja.errors.0 }}
              </div>
            {% endif %}
          </div>

          <!-- Kilometraje - Fila individual -->
          <div class="mb-4">
            <label for="{{ form.kilometraje.id_for_label }}" class="block text-sm font-medium text-gray-300 mb-2">
              {% trans "Kilometraje" %}
            </label>
            {{ form.kilometraje|add_class:"w-full px-4 py-3 rounded-lg bg-gradient-to-r from-[#0a0a0a]/80 to-[#111827]/80 border border-fuchsia-500/30 text-fuchsia-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-fuchsia-400/50 focus:border-fuchsia-400" }}
            {% if form.kilometraje.errors %}
              <div class="mt-1 text-xs text-red-400">
                {{ form.kilometraje.errors.0 }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>

      <!-- Observaciones -->
      {% if form.observaciones %}
      <div class="relative">
        <div class="absolute -inset-1 rounded-xl bg-gradient-to-r from-orange-500/20 via-yellow-500/20 to-amber-500/20 blur-xl"></div>
        <div class="relative rounded-xl border border-orange-400/30 bg-gradient-to-r from-[#0d1117]/90 to-[#111827]/90 backdrop-blur-sm p-6">
          <div class="flex items-center space-x-3 mb-4">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-orange-500/30 to-amber-500/30 border border-orange-400/40 flex items-center justify-center">
              <span class="text-orange-300 text-sm">📝</span>
            </div>
            <h2 class="text-lg font-bold text-orange-300">{% trans "Observaciones" %}</h2>
          </div>

          {{ form.observaciones|add_class:"w-full px-4 py-3 rounded-lg bg-gradient-to-r from-[#0a0a0a]/80 to-[#111827]/80 border border-orange-500/30 text-orange-200 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-400/50 focus:border-orange-400 resize-none" }}
          {% if form.observaciones.errors %}
            <div class="mt-1 text-xs text-red-400">
              {{ form.observaciones.errors.0 }}
            </div>
          {% endif %}
        </div>
      </div>
      {% endif %}

          <!-- Botones de acción -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="{% url 'chile:taller:vehiculos:lista_vehiculos' %}"
               class="group flex-1 inline-flex items-center justify-center space-x-2 px-8 py-4 rounded-xl border border-gray-500/40 bg-gradient-to-r from-gray-600/20 to-gray-400/10 hover:from-gray-500/30 hover:to-gray-300/20 text-gray-200 font-semibold transition-all shadow hover:shadow-gray-500/20">
              <span class="text-lg">⟲</span>
              <span>{% trans "Cancelar" %}</span>
            </a>

            <button type="submit"
                    class="group flex-1 relative inline-flex items-center justify-center space-x-2 px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-600 via-lime-600 to-green-600 hover:from-emerald-500 hover:via-lime-500 hover:to-green-500 text-white font-bold shadow-lg shadow-emerald-800/40 transition-all duration-300 border border-emerald-400/40">
              <span class="text-lg">💾</span>
              <span>{% trans "Crear Vehículo" %}</span>
              <div class="absolute -inset-px rounded-xl ring-2 ring-emerald-400/40 animate-pulse opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Footer del formulario -->
  <div class="mt-8 text-center">
