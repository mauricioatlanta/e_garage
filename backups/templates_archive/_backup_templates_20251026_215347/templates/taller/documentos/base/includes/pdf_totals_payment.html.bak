{% load i18n %}
{# Totales + forma de pago. Asume objeto 'obj' (Documento) y contexto de empresa_* #}
<style>
  .totals-wrap { page-break-inside: avoid; break-inside: avoid; margin-top: 10mm; }
  .totals-grid { display: table; width: 100%; table-layout: fixed; }
  .tg-col { display: table-cell; vertical-align: top; }
  .tg-col.left { width: 55%; padding-right: 8mm; }
  .tg-col.right { width: 45%; }

  .card { border: 1px solid #cbd5e1; padding: 6mm; }
  .tt { font-weight: 600; margin-bottom: 3mm; color: #0f172a; } /* slate-900 */
  .row { display:flex; justify-content:space-between; align-items:baseline; gap:8px; }
  .muted { color:#475569; } /* slate-600 */
  .hr { height: 1px; background:#e2e8f0; margin: 3mm 0; } /* slate-200 */
  .grand { font-size: 15px; font-weight: 700; }

  .kv { display:flex; justify-content:space-between; gap:8px; margin: 2mm 0; }
  .pill { display:inline-block; border:1px solid #cbd5e1; padding:1mm 3mm; border-radius: 9999px; font-size: 11px; }
</style>

<div class="totals-wrap">
  <div class="totals-grid">
    <!-- RESUMEN DE CONCEPTOS -->
    <div class="tg-col left">
      <div class="card">
        <div class="tt">
          {% if empresa_pais == "US" %} Summary {% else %} Resumen {% endif %}
        </div>

        {# Subtotales por tipo. En CL el IVA aplica SOLO a repuestos. #}
        <div class="kv">
          <span class="muted">
            {% if empresa_pais == "US" %} Parts Subtotal {% else %} Subtotal Repuestos {% endif %}
          </span>
          <span>
            {{ obj.neto_repuestos|default:0|money_fmt:empresa_moneda }}
          </span>
        </div>
        <div class="kv">
          <span class="muted">
            {% if empresa_pais == "US" %} Services Subtotal {% else %} Subtotal Servicios {% endif %}
          </span>
          <span>
            {{ obj.neto_servicios|default:0|money_fmt:empresa_moneda }}
          </span>
        </div>
        {% if obj.neto_otros_servicios %}
        <div class="kv">
          <span class="muted">
            {% if empresa_pais == "US" %} Outsourced Services {% else %} Otros Servicios {% endif %}
          </span>
          <span>
            {{ obj.neto_otros_servicios|default:0|money_fmt:empresa_moneda }}
          </span>
        </div>
        {% endif %}

        {% if obj.descuento %}
          <div class="kv">
            <span class="muted">
              {% if empresa_pais == "US" %} Discount {% else %} Descuento {% endif %}
            </span>
            <span>-{{ obj.descuento|money_fmt:empresa_moneda }}</span>
          </div>
        {% endif %}

        <div class="hr"></div>

        {# Impuesto #}
        <div class="kv">
          <span class="muted">
            {% if empresa_pais == "US" %}
              Sales Tax ({{ obj.tax_rate_applied|default_if_none:0 }}%)
            {% else %}
              IVA ({{ obj.tax_rate_applied|default_if_none:19 }}%)
            {% endif %}
          </span>
          <span>
            {{ obj.tax_amount|default:0|money_fmt:empresa_moneda }}
          </span>
        </div>

        <div class="kv grand">
          <span>
            {% if empresa_pais == "US" %} Grand Total {% else %} Total General {% endif %}
          </span>
          <span>
            {{ obj.total|default:0|money_fmt:empresa_moneda }}
          </span>
        </div>

        <div class="hr"></div>

        {# Monto en palabras #}
        <div class="muted">
          {% if empresa_pais == "US" %} Amount in words: {% else %} Monto en palabras: {% endif %}
        </div>
        <div>
          {{ obj.total|money_words:empresa_moneda }}
        </div>
      </div>
    </div>

    <!-- FORMA DE PAGO -->
    <div class="tg-col right">
      <div class="card">
        <div class="tt">
          {% if empresa_pais == "US" %} Payment Details {% else %} Forma de Pago {% endif %}
        </div>

        <div class="kv">
          <span class="muted">{% if empresa_pais == "US" %} Method {% else %} Método {% endif %}</span>
          <span>
            {{ obj.get_metodo_pago_display|default:obj.metodo_pago|default:"—" }}
            {% if obj.ult4 %}<span class="pill">**** {{ obj.ult4 }}</span>{% endif %}
          </span>
        </div>

        <div class="kv">
          <span class="muted">{% if empresa_pais == "US" %} Paid {% else %} Pagado {% endif %}</span>
          <span>{{ obj.monto_pagado|default:0|money_fmt:empresa_moneda }}</span>
        </div>

        <div class="kv">
          <span class="muted">{% if empresa_pais == "US" %} Balance {% else %} Saldo {% endif %}</span>
          <span>{{ obj.saldo_pendiente|default:0|money_fmt:empresa_moneda }}</span>
        </div>

        {% if obj.fecha_pago %}
        <div class="kv">
          <span class="muted">{% if empresa_pais == "US" %} Paid on {% else %} Fecha de pago {% endif %}</span>
          <span>{{ obj.fecha_pago|date:"d/m/Y H:i" }}</span>
        </div>
        {% endif %}

        {% if obj.nota_pago %}
        <div class="hr"></div>
        <div class="muted">
          {% if empresa_pais == "US" %} Note {% else %} Nota {% endif %}:
        </div>
        <div>{{ obj.nota_pago }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
