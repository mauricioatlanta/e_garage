# eGarage - Variables de Entorno
# Copia este archivo a .env y ajusta los valores según tu entorno

# ===== CONFIGURACIÓN BÁSICA =====
DJANGO_SECRET_KEY=tu-clave-secreta-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== BASE DE DATOS =====
# Para desarrollo (SQLite)
# DATABASE_URL=sqlite:///db.sqlite3

# Para producción (PostgreSQL)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/egarage_db

# ===== IDIOMA Y ZONA HORARIA =====
LANGUAGE_CODE=es
TIME_ZONE=America/Santiago

# ===== EMAIL =====
EMAIL_PASSWORD=tu-password-email-aqui

# ===== CONFIGURACIÓN DE PRODUCCIÓN =====
# Descomenta para producción
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# ===== CONFIGURACIÓN ESPECÍFICA DEL PROYECTO =====
# Configuraciones específicas de eGarage
# IVA_CHILE=19
# SALES_TAX_USA=8.25
