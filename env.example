# ======================================================
# Variables de Entorno - eGarage
# ======================================================
# Copia este archivo como .env y configura tus valores
# cp env.example .env
# ======================================================

# ---------- Django Core ----------
DJANGO_SECRET_KEY=tu-clave-secreta-muy-larga-y-aleatoria-aqui
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,egarage.cl,www.egarage.cl

# ---------- Seguridad / HTTPS ----------
# En producción, configurar estos valores:
DJANGO_CSRF_TRUSTED_ORIGINS=https://egarage.cl,https://www.egarage.cl
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
DJANGO_X_FRAME_OPTIONS=DENY

# ---------- Base de Datos ----------
# SQLite (por defecto, no requiere configuración adicional)
# Para PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/egarage_db

# ---------- Email Configuration ----------
# ⚠️ IMPORTANTE: Configurar EMAIL_PASSWORD en producción
EMAIL_HOST=srv24.cpanelhost.cl
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=subscription@egarage.cl
EMAIL_PASSWORD=tu-password-de-email-aqui
DEFAULT_FROM_EMAIL=eGarage <subscription@egarage.cl>
EMAIL_TIMEOUT=30

# ---------- Allauth / Autenticación ----------
ACCOUNT_EMAIL_VERIFICATION=none
# Opciones: none, optional, mandatory

# ---------- Static y Media Files ----------
STATIC_ROOT=/ruta/a/staticfiles
MEDIA_ROOT=/ruta/a/media

# ---------- Sentry (Monitoreo de Errores) ----------
# ⚠️ Opcional pero muy recomendado para producción
# Obtener DSN en: https://sentry.io
SENTRY_DSN=
SENTRY_RELEASE=egarage@1.0.0

# ======================================================
# Notas:
# ======================================================
# 1. NUNCA commitar el archivo .env al repositorio
# 2. Agregar .env al .gitignore
# 3. En desarrollo, DEBUG=True está bien
# 4. En producción, cambiar DEBUG=False y configurar todos los SECURE_* apropiadamente
# 5. Generar DJANGO_SECRET_KEY con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ======================================================


