[Unit]
Description=gunicorn daemon for egarage
After=network.target

[Service]
Environment="DJANGO_SETTINGS_MODULE=gestion_taller.settings_prod"
User=root
Group=www-data
WorkingDirectory=/srv/egarage

# 🔥 CLAVE
RuntimeDirectory=gunicorn
RuntimeDirectoryMode=0755

ExecStart=/srv/egarage/venv/bin/gunicorn gestion_taller.wsgi:application --preload \
  --workers 1 \
  --threads 1 \
  --timeout 120 \
  --bind unix:/run/gunicorn/gunicorn.sock

Restart=always

[Install]
WantedBy=multi-user.target
