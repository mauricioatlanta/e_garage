{% load i18n %}
{# Firma/sello para última sección del documento #}
<style>
  /* Evita cortes feos en impresión */
  .sig-section {
    page-break-inside: avoid;
    break-inside: avoid;
    margin-top: 16mm;
    border-top: 1px solid #cbd5e1; /* slate-300 */
    padding-top: 8mm;
    font-size: 12px;
    color: #111827; /* gray-900 */
  }
  .sig-grid {
    display: table;
    width: 100%;
    table-layout: fixed;
  }
  .sig-col { display: table-cell; vertical-align: top; padding-right: 10mm; }
  .sig-col:last-child { padding-right: 0; }

  .sig-box {
    border: 1px solid #cbd5e1;
    padding: 10mm 8mm;
    min-height: 38mm;       /* Alto cómodo para firmar */
    page-break-inside: avoid;
  }
  .sig-title { font-weight: 600; margin-bottom: 3mm; }
  .sig-line  {
    border-bottom: 1px solid #94a3b8; /* slate-400 */
    height: 0; margin: 6mm 0 3mm 0;
  }
  .muted { color: #475569; font-size: 11px; } /* slate-600 */

  /* Sello/Stamp */
  .stamp {
    border: 2px solid #0f766e; /* teal-700 */
    padding: 4mm 6mm;
    display: inline-block;
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.6px;
  }
  .stamp-paid   { color: #065f46; border-color: #065f46; }   /* emerald-800 */
  .stamp-unpaid { color: #b45309; border-color: #b45309; }   /* amber-700 */

  /* QR (opcional) */
  .qr-box {
    border: 1px dashed #94a3b8;
    width: 28mm; height: 28mm;
    display: inline-block;
    background-size: cover;
    background-position: center;
  }

  /* Empujar cerca del fondo en la última página, sin forzar overlay */
  .push-end {
    margin-top: 12mm; /* puedes subir/bajar este margen si te queda muy arriba/abajo */
  }

  @media print {
    /* Garantiza que no "flote"; evita sombras en PDF */
    .sig-box, .stamp { box-shadow: none !important; }
  }
</style>

<div class="sig-section">
  <div class="sig-grid">
    <div class="sig-col" style="width: 50%;">
      <div class="sig-box">
        <div class="sig-title">
          {% if empresa_pais|default:"CL" == "US" %} Received in Good Order {% else %} Recibí Conforme {% endif %}
        </div>
        <div class="sig-line"></div>
        <div class="muted">
          {% if empresa_pais|default:"CL" == "US" %}
            Signature • Printed Name • ID
          {% else %}
            Firma • Nombre • ID
          {% endif %}
        </div>

        <div class="push-end">
          <div class="muted">
            {% if empresa_pais|default:"CL" == "US" %} Date {% else %} Fecha {% endif %}:
            <strong>{{ obj.fecha_emision|date:"d/m/Y" }}</strong>
          </div>
        </div>
      </div>
    </div>

    <div class="sig-col" style="width: 50%;">
      <div class="sig-box">
        <div class="sig-title">
          {% if empresa_pais|default:"CL" == "US" %} Authorized By {% else %} Autorizado por {% endif %}
        </div>
        <div class="muted">
          <strong>{{ empresa_nombre|default:"Mi Empresa" }}</strong>
          {% if empresa_pais|default:"CL" == "US" and empresa_ein %} · EIN: {{ empresa_ein }}{% endif %}
          {% if empresa_pais|default:"CL" != "US" and empresa_rut %} · RUT: {{ empresa_rut }}{% endif %}
        </div>
        <div class="sig-line"></div>
        <div class="muted">
          {% if empresa_pais|default:"CL" == "US" %} Signature • Position {% else %} Firma • Cargo {% endif %}
        </div>

        <div class="push-end" style="display:flex; gap:8mm; align-items:center;">
          {% if verification_qr_url %}
            <div class="qr-box" style="background-image:url('{{ verification_qr_url }}');"></div>
          {% else %}
            <div class="qr-box"></div>
          {% endif %}
          <div class="muted">
            {% if empresa_pais|default:"CL" == "US" %}
              Verify: {{ verification_code|default:"—" }}
            {% else %}
              Verificación: {{ verification_code|default:"—" }}
            {% endif %}
            <br/>
            {% if obj.numero %}
              {% if empresa_pais|default:"CL" == "US" %} Document No. {% else %} Documento N° {% endif %}
              <strong>{{ obj.numero }}</strong>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>

  {# Sello de pago opcional #}
  <div style="margin-top: 8mm;">
    {% if obj.pagado %}
      <span class="stamp stamp-paid">
        {% if empresa_pais|default:"CL" == "US" %} Paid {% else %} Pagado {% endif %}
      </span>
    {% else %}
      <span class="stamp stamp-unpaid">
        {% if empresa_pais|default:"CL" == "US" %} Unpaid {% else %} Pendiente {% endif %}
      </span>
    {% endif %}
  </div>
</div>
