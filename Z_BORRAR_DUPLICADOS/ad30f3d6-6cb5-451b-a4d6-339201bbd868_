<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 60" class="egarage-logo-simple">
  <defs>
    <linearGradient id="logoGradientSimple" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00ffff;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#0099ff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#6600ff;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Fondo del logo con mejor contraste -->
  <rect x="0" y="0" width="200" height="60" rx="15" fill="rgba(255,255,255,0.95)" stroke="url(#logoGradientSimple)" stroke-width="3"/>

  <!-- Icono de garage/herramienta -->
  <g transform="translate(15,15)">
    <!-- Herramienta principal -->
    <path d="M5 15 L25 5 L25 15 L20 20 L10 20 Z" fill="url(#logoGradientSimple)"/>
    <!-- Detalles tecnológicos -->
    <circle cx="15" cy="12" r="3" fill="#00ffff"/>
    <rect x="8" y="18" width="14" height="2" fill="#00ffff"/>
    <!-- Líneas de energía -->
    <path d="M2 8 L8 8 M2 12 L6 12 M2 16 L4 16" stroke="#00ffff" stroke-width="1"/>
  </g>

  <!-- Texto eGarage -->
  <text x="50" y="25" font-family="Arial, sans-serif" font-size="16" font-weight="bold" fill="url(#logoGradientSimple)">e</text>
  <text x="62" y="25" font-family="Arial, sans-serif" font-size="20" font-weight="900" fill="#333333">Garage</text>

  <!-- Subtítulo -->
  <text x="50" y="42" font-family="Arial, sans-serif" font-size="8" fill="#666666">DIGITAL WORKSHOP</text>

  <!-- Elementos decorativos -->
  <circle cx="180" cy="15" r="2" fill="#00ffff"/>
  <circle cx="185" cy="25" r="1.5" fill="#6600ff"/>
  <circle cx="175" cy="35" r="1" fill="#0099ff"/>
</svg>
