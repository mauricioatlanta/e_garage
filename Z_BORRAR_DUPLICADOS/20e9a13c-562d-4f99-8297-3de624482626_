{% load country_url %}
{% extends 'base.html' %}
{% load static %}
{% load humanize %}

<!-- 🟡 CRUZ AMARILLA - TEMPLATE DASHBOARD NORMAL -->
<div style="position: fixed; top: 10px; left: 10px; width: 50px; height: 50px; background-color: #ffff00; z-index: 9999; border: 3px solid #000; display: flex; align-items: center; justify-content: center; color: black; font-weight: bold; font-size: 12px;">DASH</div>

{% block title %}{{ empresa.nombre_taller }} - Centro de Operaciones{% endblock %}

{% block extra_css %}
<style>
/* 🎨 Estilo futurista para dashboard empresarial */
:root {
    --cyber-blue: #00ffff;
    --cyber-green: #00ff88;
    --cyber-purple: #8000ff;
    --cyber-red: #ff0044;
    --cyber-gold: #ffd700;
    --dark-bg: #0a0a0a;
    --card-bg: rgba(16, 20, 24, 0.95);
    --glass-bg: rgba(255, 255, 255, 0.05);
}

body {
    background: linear-gradient(135deg, #0c0c0c 0%, #1a1a2e 50%, #16213e 100%);
    color: #ffffff;
    font-family: 'Inter', 'Segoe UI', sans-serif;
}

.cyber-container {
    background: var(--card-bg);
    border: 1px solid var(--cyber-blue);
    border-radius: 15px;
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 32px rgba(0, 255, 255, 0.1);
}

.kpi-card {
    background: linear-gradient(145deg, var(--glass-bg), rgba(0, 255, 255, 0.05));
    border: 1px solid var(--cyber-blue);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: center;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.kpi-card:hover {
    border-color: var(--cyber-green);
    box-shadow: 0 0 20px rgba(0, 255, 136, 0.3);
    transform: translateY(-2px);
}

.kpi-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.1), transparent);
    transition: left 0.5s;
}

.kpi-card:hover::before {
    left: 100%;
}

.kpi-value {
    font-size: 2.5rem;
    font-weight: bold;
    color: var(--cyber-blue);
    text-shadow: 0 0 10px var(--cyber-blue);
}

.kpi-label {
    color: #b0b8c1;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.alert-card {
    background: var(--card-bg);
    border-left: 4px solid var(--cyber-red);
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 0.5rem;
    transition: all 0.3s ease;
}

.alert-card:hover {
    border-left-color: var(--cyber-gold);
    box-shadow: 0 4px 16px rgba(255, 0, 68, 0.2);
}

.cyber-button {
    background: linear-gradient(45deg, var(--cyber-blue), var(--cyber-green));
    border: none;
    border-radius: 25px;
    padding: 12px 24px;
    color: #000;
    font-weight: bold;
    text-decoration: none;
    display: inline-block;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.cyber-button:hover {
    transform: scale(1.05);
    box-shadow: 0 0 20px rgba(0, 255, 255, 0.5);
}

.section-title {
    color: var(--cyber-blue);
    font-size: 1.5rem;
    font-weight: bold;
    margin-bottom: 1rem;
    text-shadow: 0 0 10px var(--cyber-blue);
}

.ranking-item {
    background: var(--glass-bg);
    border: 1px solid rgba(0, 255, 255, 0.2);
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 0.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.3s ease;
}

.ranking-item:hover {
    border-color: var(--cyber-green);
    background: rgba(0, 255, 136, 0.05);
}

.status-badge {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: bold;
    text-transform: uppercase;
}

.status-active { background: var(--cyber-green); color: #000; }
.status-pending { background: var(--cyber-gold); color: #000; }
.status-warning { background: var(--cyber-red); color: #fff; }

.glow-text {
    text-shadow: 0 0 10px currentColor;
}

.chart-container {
    background: var(--card-bg);
    border: 1px solid var(--cyber-blue);
    border-radius: 12px;
    padding: 1.5rem;
    height: 300px;
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
}

.pulse-animation {
    animation: pulse 2s infinite;
}

.nav-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
}

.nav-card {
    background: var(--card-bg);
    border: 1px solid var(--cyber-purple);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: center;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
}

.nav-card:hover {
    border-color: var(--cyber-green);
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(128, 0, 255, 0.3);
}
</style>
{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto p-6">

    <!-- 🏢 Cabecera del Centro de Operaciones -->
    <div class="cyber-container p-6 mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-4xl font-bold glow-text mb-2">
                    {{ pais_emoji }} {{ empresa.nombre_taller }}
                </h1>
                <p class="text-xl text-gray-300">Centro de Operaciones Empresarial</p>
                <p class="text-sm text-gray-400">{{ fecha_hoy|date:"l, d F Y" }}</p>
            </div>
            <div class="text-right">
                <div class="text-sm text-gray-400">Usuario:</div>
                <div class="text-lg font-bold text-cyan-400">{{ user.username }}</div>
                <div class="text-sm text-gray-400">{{ empresa.get_pais_display }}</div>
            </div>
        </div>
    </div>

    <!-- 📊 KPIs Principales -->
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 mb-6">

        <!-- Documentos -->
        <div class="kpi-card">
            <div class="kpi-value">{{ documentos_hoy }}</div>
            <div class="kpi-label">Docs Hoy</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-value">{{ documentos_semana }}</div>
            <div class="kpi-label">Docs Semana</div>
        </div>

        <!-- Facturación -->
        <div class="kpi-card">
            <div class="kpi-value">{{ moneda }}{{ facturacion_hoy|floatformat:0|intcomma }}</div>
            <div class="kpi-label">Ventas Hoy</div>
        </div>

        <div class="kpi-card">
            <div class="kpi-value">{{ moneda }}{{ facturacion_mes|floatformat:0|intcomma }}</div>
            <div class="kpi-label">Ventas Mes</div>
        </div>

        <!-- Clientes -->
        <div class="kpi-card">
            <div class="kpi-value">{{ clientes_atendidos_semana }}</div>
            <div class="kpi-label">Clientes Semana</div>
        </div>

        <!-- Técnicos -->
        <div class="kpi-card">
            <div class="kpi-value">{{ tecnicos_activos }}</div>
            <div class="kpi-label">Técnicos Activos</div>
        </div>
    </div>

    <!-- 📈 Estado Operativo -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">

        <!-- Estado de Documentos -->
        <div class="cyber-container p-6">
            <h3 class="section-title">📋 Estado de Documentos</h3>
            <div class="space-y-3">
                <div class="flex justify-between items-center">
                    <span>Presupuestos Pendientes</span>
                    <span class="status-badge status-pending">{{ presupuestos_pendientes }}</span>
                </div>
                <div class="flex justify-between items-center">
                    <span>Órdenes en Proceso</span>
                    <span class="status-badge status-active">{{ ordenes_en_proceso }}</span>
                </div>
                <div class="flex justify-between items-center">
                    <span>Facturas del Mes</span>
                    <span class="status-badge status-active">{{ facturas_mes }}</span>
                </div>
            </div>
        </div>

        <!-- Métricas de Eficiencia -->
        <div class="cyber-container p-6">
            <h3 class="section-title">🎯 Métricas de Eficiencia</h3>
            <div class="space-y-3">
                <div class="text-center">
                    <div class="text-2xl font-bold text-cyan-400">{{ moneda }}{{ ticket_promedio|floatformat:0|intcomma }}</div>
                    <div class="text-sm text-gray-400">Ticket Promedio</div>
                </div>
                <div class="text-center">
                    <div class="text-2xl font-bold text-green-400">{{ eficiencia_conversion|floatformat:1 }}%</div>
                    <div class="text-sm text-gray-400">Tasa Conversión</div>
                </div>
                <div class="text-center">
                    <div class="text-2xl font-bold text-purple-400">{{ marcas_atendidas }}</div>
                    <div class="text-sm text-gray-400">Marcas Atendidas</div>
                </div>
            </div>
        </div>

        <!-- Proyecciones IA -->
        <div class="cyber-container p-6">
            <h3 class="section-title">🤖 Proyecciones IA</h3>
            <div class="space-y-3">
                <div class="text-center">
                    <div class="text-2xl font-bold text-gold-400">{{ proyeccion_docs_mes }}</div>
                    <div class="text-sm text-gray-400">Docs Proyectados/Mes</div>
                </div>
                <div class="text-center">
                    <div class="text-2xl font-bold text-green-400">{{ moneda }}{{ proyeccion_facturacion|floatformat:0|intcomma }}</div>
                    <div class="text-sm text-gray-400">Facturación Proyectada</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 🔧 Rankings y Tops -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">

        <!-- Top Servicios -->
        <div class="cyber-container p-6">
            <h3 class="section-title">⚙️ Servicios Más Demandados</h3>
            {% for servicio in servicios_top %}
            <div class="ranking-item">
                <div>
                    <div class="font-semibold">{{ servicio.nombre }}</div>
                    <div class="text-sm text-gray-400">{{ servicio.cantidad }} servicios</div>
                </div>
                <div class="text-right">
                    <div class="text-lg font-bold text-green-400">{{ moneda }}{{ servicio.ingresos|floatformat:0|intcomma }}</div>
                </div>
            </div>
            {% empty %}
            <div class="text-center text-gray-400 py-4">No hay datos de servicios</div>
            {% endfor %}
        </div>

        <!-- Top Técnicos -->
        <div class="cyber-container p-6">
            <h3 class="section-title">👨‍🔧 Técnicos Más Productivos</h3>
            {% for tecnico in tecnicos_productivos %}
            <div class="ranking-item">
                <div>
                    <div class="font-semibold">{{ tecnico.nombre }}</div>
                    <div class="text-sm text-gray-400">{{ tecnico.docs_realizados }} documentos</div>
                </div>
                <div class="text-right">
                    <div class="text-lg font-bold text-green-400">{{ moneda }}{{ tecnico.ingresos_generados|floatformat:0|intcomma|default:"0" }}</div>
                </div>
            </div>
            {% empty %}
            <div class="text-center text-gray-400 py-4">No hay datos de técnicos</div>
            {% endfor %}
        </div>
    </div>

    <!-- ⚠️ Alertas y Oportunidades -->
    {% if alertas %}
    <div class="cyber-container p-6 mb-6">
        <h3 class="section-title">⚠️ Alertas y Oportunidades</h3>
        {% for alerta in alertas %}
        <div class="alert-card">
            <div class="flex items-start justify-between">
                <div>
                    <div class="font-semibold text-{{ alerta.tipo }}-400">{{ alerta.titulo }}</div>
                    <div class="text-sm text-gray-400">{{ alerta.descripcion }}</div>
                </div>
                <div class="text-sm text-cyan-400">{{ alerta.accion }}</div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    <!-- 🚀 Navegación Rápida -->
    <div class="cyber-container p-6">
        <h3 class="section-title">🚀 Acceso Rápido a Funciones</h3>
        <div class="nav-grid">

            <a href="/cl/reportes/" class="nav-card">
                <div class="text-3xl mb-2">📊</div>
                <div class="font-semibold">Reportes Completos</div>
                <div class="text-sm text-gray-400">Análisis detallados</div>
            </a>

            <a href="/cl/reportes/inteligencia/" class="nav-card">
                <div class="text-3xl mb-2">🚀</div>
                <div class="font-semibold">Inteligencia Operativa</div>
                <div class="text-sm text-gray-400">Dashboard futurista</div>
            </a>

            <a href="/cl/taller/reportes/mecanicos/" class="nav-card">
                <div class="text-3xl mb-2">👨‍🔧</div>
                <div class="font-semibold">Reportes por Técnico</div>
                <div class="text-sm text-gray-400">Productividad individual</div>
            </a>

            <a href="/analytics/" class="nav-card">
                <div class="text-3xl mb-2">📈</div>
                <div class="font-semibold">Business Intelligence</div>
                <div class="text-sm text-gray-400">Análisis avanzado</div>
            </a>

            <a href="/documentos/" class="nav-card">
                <div class="text-3xl mb-2">📄</div>
                <div class="font-semibold">Gestión Documentos</div>
                <div class="text-sm text-gray-400">Crear y administrar</div>
            </a>

            <a href="/cl/clientes/" class="nav-card">
                <div class="text-3xl mb-2">👥</div>
                <div class="font-semibold">Gestión Clientes</div>
                <div class="text-sm text-gray-400">Base de clientes</div>
            </a>

            <a href="/cl/vehiculos/" class="nav-card">
                <div class="text-3xl mb-2">🚗</div>
                <div class="font-semibold">Gestión Vehículos</div>
                <div class="text-sm text-gray-400">Flota de vehículos</div>
            </a>

            <a href="{% country_url 'configuracion' %}" class="nav-card">
                <div class="text-3xl mb-2">⚙️</div>
                <div class="font-semibold">Configuración</div>
                <div class="text-sm text-gray-400">Ajustes del taller</div>
            </a>

            <a href="{% country_url 'servicios:otros_servicios_menu' %}" class="nav-card">
                <div class="text-3xl mb-2">🏢</div>
                <div class="font-semibold">Otros Servicios</div>
                <div class="text-sm text-gray-400">Servicios externos</div>
            </a>
        </div>
    </div>

    <!-- 📊 Gráfico de Tendencias (placeholder para Chart.js) -->
    <div class="cyber-container p-6 mt-6">
        <h3 class="section-title">📊 Tendencias de Facturación</h3>
        <div class="chart-container">
            <canvas id="chartTendencias" width="100%" height="200"></canvas>
        </div>
    </div>

</div>

<!-- JavaScript para gráficos y animaciones -->
<script>
document.addEventListener('DOMContentLoaded', function() {

    // Animación de contadores
    function animateCounters() {
        const counters = document.querySelectorAll('.kpi-value');
        counters.forEach(counter => {
            const target = parseInt(counter.textContent.replace(/[^\d]/g, ''));
            if (target > 0) {
                let current = 0;
                const increment = target / 30;
                const timer = setInterval(() => {
                    current += increment;
                    if (current >= target) {
                        current = target;
                        clearInterval(timer);
                    }
                    counter.textContent = counter.textContent.replace(/\d+/, Math.floor(current));
                }, 50);
            }
        });
    }

    // Ejecutar animaciones
    animateCounters();

    // Gráfico de tendencias (placeholder)
    const ctx = document.getElementById('chartTendencias');
    if (ctx && window.Chart) {
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun'],
                datasets: [{
                    label: 'Facturación',
                    data: [120000, 190000, 300000, 250000, 220000, 350000],
                    borderColor: '#00ffff',
                    backgroundColor: 'rgba(0, 255, 255, 0.1)',
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        labels: {
                            color: '#ffffff'
                        }
                    }
                },
                scales: {
                    x: {
                        ticks: { color: '#ffffff' },
                        grid: { color: 'rgba(255, 255, 255, 0.1)' }
                    },
                    y: {
                        ticks: { color: '#ffffff' },
                        grid: { color: 'rgba(255, 255, 255, 0.1)' }
                    }
                }
            }
        });
    }

    // Actualización automática cada 5 minutos
    setInterval(() => {
        location.reload();
    }, 300000);
});
</script>
{% endblock %}
