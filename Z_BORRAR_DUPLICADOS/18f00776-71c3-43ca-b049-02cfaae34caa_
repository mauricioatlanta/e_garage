{% extends "base.html" %}
{% load static %}

{% block title %}Registro Completado - eGarage{% endblock %}

{% block content %}
<div class="min-h-screen bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 flex items-center justify-center px-4">
    <div class="max-w-md w-full bg-white rounded-lg shadow-xl p-8">
        <div class="text-center">
            <!-- Logo -->
            <div class="mb-6">
                <img src="{% static 'img/TallerPro_logo.png' %}" alt="eGarage Logo" class="w-20 h-20 mx-auto">
            </div>

            <!-- Icono de éxito -->
            <div class="mb-4">
                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto">
                    <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
            </div>

            {% if codigo %}
            <!-- PRUEBA GRATUITA -->
            <h1 class="text-2xl font-bold text-gray-900 mb-4">
                ¡Registro Completado!
            </h1>

            <p class="text-gray-600 mb-6">
                Tu cuenta de prueba gratuita ha sido creada exitosamente. Hemos enviado un código de activación a tu email para completar el proceso.
            </p>

            <!-- Información del código (solo para desarrollo) -->
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
                <h3 class="text-sm font-medium text-blue-800 mb-2">Información de Desarrollo:</h3>
                <p class="text-sm text-blue-700">
                    <strong>Código de activación:</strong> Se ha generado y enviado por email<br>
                    <strong>Notificación:</strong> Se ha enviado a subscription@egarage.cl
                </p>
            </div>

            {% elif pago %}
            <!-- SUSCRIPCIÓN PAGADA -->
            <h1 class="text-2xl font-bold text-gray-900 mb-4">
                ¡Registro Completado!
            </h1>

            <p class="text-gray-600 mb-6">
                Tu cuenta ha sido creada exitosamente. Hemos enviado las instrucciones de pago a tu email para activar tu suscripción <strong>{{ plan }}</strong>.
            </p>

            <!-- Información de pago -->
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
                <h3 class="text-sm font-medium text-yellow-800 mb-2">📋 Próximos Pasos:</h3>
                <div class="text-sm text-yellow-700 space-y-1">
                    <p>1. <strong>Revisa tu email</strong> con las instrucciones de pago</p>
                    <p>2. <strong>Realiza la transferencia</strong> bancaria</p>
                    <p>3. <strong>Envía el comprobante</strong> a: subcription@egarage.cl</p>
                    <p>4. <strong>Espera la confirmación</strong> del administrador</p>
                    <p>5. <strong>Recibirás tus credenciales</strong> de acceso</p>
                </div>
            </div>

            <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-6">
                <h3 class="text-sm font-medium text-green-800 mb-2">⏰ Tiempo de Procesamiento:</h3>
                <p class="text-sm text-green-700">
                    Una vez enviado el comprobante, recibirás la confirmación en 24-48 horas hábiles.
                </p>
            </div>

            {% else %}
            <!-- FALLBACK -->
            <h1 class="text-2xl font-bold text-gray-900 mb-4">
                ¡Registro Completado!
            </h1>

            <p class="text-gray-600 mb-6">
                Tu cuenta ha sido creada exitosamente. Revisa tu email para más información.
            </p>
            {% endif %}

            <!-- Botones de acción -->
            <div class="space-y-3">
                <a href="{% url 'account_login' %}"
                   class="w-full bg-cyan-600 hover:bg-cyan-700 text-white font-medium py-3 px-4 rounded-lg transition duration-200 flex items-center justify-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
                    </svg>
                    Iniciar Sesión
                </a>

                <a href="{% url 'registro' %}"
                   class="w-full text-cyan-600 hover:text-cyan-700 font-medium py-2 px-4 transition duration-200">
                    ← Registrar Otra Cuenta
                </a>
            </div>

            <!-- Información adicional -->
            <div class="mt-6 pt-6 border-t border-gray-200">
                <p class="text-xs text-gray-500">
                    Si no recibes el email de activación, revisa tu carpeta de spam o
                    <a href="{% url 'account_reset_password' %}" class="text-cyan-600 hover:text-cyan-700">recupera tu contraseña</a>.
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
