
{% load country_url %}
<aside class="fixed top-0 left-0 h-full w-20 bg-gray-800 pt-20 flex flex-col items-center space-y-6 z-40">
  <a href="{% country_url 'clientes:lista_clientes' %}" title="Clientes">
    <i class="fas fa-users text-xl text-cyan-300 hover:text-white"></i>
  </a>
  <a href="{% if request.path|slice:":4" == "/us/" %}/us/vehiculos/{% else %}/cl/vehiculos/{% endif %}" title="Vehículos">
    <i class="fas fa-car text-xl text-cyan-300 hover:text-white"></i>
  </a>
  <a href="{% country_url 'servicios:servicios_menu' %}" title="Servicios">
    <i class="fas fa-tools text-xl text-cyan-300 hover:text-white"></i>
  </a>
  <a href="{% country_url 'repuestos:lista_repuestos' %}" title="Repuestos">
    <i class="fas fa-cogs text-xl text-cyan-300 hover:text-white"></i>
  </a>
  <a href="{% country_url 'documentos:lista_documentos' %}" title="Documentos">
    <i class="fas fa-file-invoice text-xl text-cyan-300 hover:text-white"></i>
  </a>
  <a href="{% country_url 'reportes:reportes_dashboard' %}" title="Reportes">
    <i class="fas fa-chart-bar text-xl text-cyan-300 hover:text-white"></i>
  </a>
  <a href="{% if request.path|slice:':3' == '/cl' %}/cl/es/servicios/otros-servicios/{% elif request.path|slice:':3' == '/us' %}/us/en/servicios/otros-servicios/{% else %}/cl/es/servicios/otros-servicios/{% endif %}" title="Otros Servicios">
    <i class="fas fa-handshake text-xl text-cyan-300 hover:text-white"></i>
  </a>
</aside>
