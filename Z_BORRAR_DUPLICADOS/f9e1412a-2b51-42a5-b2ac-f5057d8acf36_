  <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
  <script>
    VANTA.NET({
      el: "#vanta-matrix",
      mouseControls: true,
      touchControls: true,
      minHeight: 420.00,
      minWidth: 200.00,
      scale: 1.0,
      scaleMobile: 1.0,
      color: 0x00ffff,
      backgroundColor: 0x0d0d0d,
      points: 12.0,
      maxDistance: 22.0,
      spacing: 18.0
    });
    VANTA.WAVES({
      el: "#vanta-bg",
      color: 0x00ffff,
      shininess: 50,
      waveHeight: 20,
      waveSpeed: 0.7,
      zoom: 0.85,
      backgroundColor: 0x0d0d0d
    });
    AOS.init({
      duration: 900,
      once: true,
      offset: 80,
      delay: 100,
      easing: 'ease-in-out-cubic'
    });
    document.addEventListener('DOMContentLoaded', function() {
      const toggle = document.createElement('div');
      toggle.className = 'toggle-switch';
      toggle.innerHTML = '<span>🌙</span><span id="toggle-label">Oscuro</span>';
      document.body.appendChild(toggle);
      let isLight = false;
      toggle.onclick = function() {
        isLight = !isLight;
        document.body.classList.toggle('light-mode', isLight);
        document.getElementById('toggle-label').textContent = isLight ? 'Claro' : 'Oscuro';
        toggle.firstChild.textContent = isLight ? '☀️' : '🌙';
      };
    });
  </script>
</body>
</html>
