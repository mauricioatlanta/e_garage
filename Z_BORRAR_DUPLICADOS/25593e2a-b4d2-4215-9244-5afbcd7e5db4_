{% extends 'base.html' %}
{% load static i18n %}

{% block title %}⚙️ Settings Center - eGarage{% endblock %}

{% block extra_css %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600;700&display=swap');
    
    :root {
        --neon-cyan: #00ffff;
        --neon-purple: #b026ff;
        --neon-pink: #ff00ff;
        --dark-card: #151932;
        --text-primary: #ffffff;
        --text-secondary: #a0aec0;
    }

    body {
        background: linear-gradient(135deg, #0a0e27 0%, #1a1f3a 50%, #0f1629 100%);
        background-attachment: fixed;
        font-family: 'Rajdhani', sans-serif;
        color: var(--text-primary);
    }

    .settings-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1rem 4rem;
        position: relative;
    }

    .section-buttons-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
        position: relative;
        z-index: 10;
    }

    .section-button {
        border-radius: 16px;
        padding: 1.3rem 1.5rem;
        background: linear-gradient(145deg, #151932, #1f2442);
        border: 1px solid rgba(0, 255, 255, 0.25);
        color: var(--text-primary);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        font-size: .95rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: all .25s ease;
        box-shadow: 0 0 18px rgba(0, 255, 255, .12);
    }

    .section-button span {
        display: flex;
        align-items: center;
        gap: .6rem;
    }

    .section-button i {
        font-size: 1.2rem;
        color: var(--neon-cyan);
    }

    .section-button .arrow {
        transition: transform .25s ease;
    }

    .section-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 25px rgba(0, 255, 255, .4);
        border-color: var(--neon-cyan);
    }

    .section-button.active {
        background: linear-gradient(135deg, rgba(0,255,255,.18), rgba(176,38,255,.18));
        border-color: var(--neon-cyan);
    }

    .section-button.active .arrow {
        transform: rotate(180deg);
    }

    /* Card de sección (solo una visible) */
    .settings-section-wrapper {
        margin-top: 1rem;
    }

    .settings-section {
        background: rgba(21, 25, 50, 0.88);
        border-radius: 20px;
        border: 1px solid rgba(0,255,255,.25);
        box-shadow: 0 10px 35px rgba(0,0,0,.45);
        padding: 2rem 2.2rem;
        margin-bottom: 1.5rem;
    }

    .settings-section-header {
        display: flex;
        align-items: center;
        gap: .8rem;
        margin-bottom: 1.5rem;
        padding-bottom: .9rem;
        border-bottom: 1px solid rgba(0,255,255,.25);
    }

    .settings-section-header i {
        font-size: 1.4rem;
        background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple));
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .settings-section-header h3 {
        margin: 0;
        font-size: 1.2rem;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-family: 'Orbitron', sans-serif;
    }

    .form-label {
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
        font-size: .85rem;
        color: var(--text-secondary);
        margin-bottom: .45rem;
    }

    .form-control,
    .form-select,
    textarea.form-control {
        background: #111528;
        border-radius: 10px;
        border: 1px solid rgba(0,255,255,.3);
        color: var(--text-primary);
        padding: .7rem 1rem;
        font-size: .95rem;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--neon-cyan);
        box-shadow: 0 0 0 .15rem rgba(0,255,255,.35);
        outline: none;
    }

    .form-control-color {
        width: 100%;
        height: 48px;
        cursor: pointer;
        padding: 0;
    }

    .btn-save {
        margin-top: 1rem;
        padding: .9rem 1.8rem;
        border-radius: 999px;
        background: linear-gradient(135deg, rgba(0,255,255,.25), rgba(176,38,255,.25));
        border: 1px solid var(--neon-cyan);
        color: #fff;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        font-size: .85rem;
        box-shadow: 0 0 22px rgba(0,255,255,.35);
        transition: all .25s ease;
        cursor: pointer;
    }

    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 30px rgba(0,255,255,.6);
    }

    /* Invisible por defecto */
    .settings-section { 
        display: none; 
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .settings-section.active { 
        display: block; 
        opacity: 1;
    }

    #settings-placeholder {
        margin-top: 3rem;
        text-align: center;
        color: var(--text-secondary);
    }

    #settings-placeholder i {
        font-size: 2rem;
        color: var(--neon-cyan);
        margin-bottom: .5rem;
    }

    /* Ocultar mensajes del sistema */
    .alert-settings, .settings-header {
        display: none !important;
    }

</style>
{% endblock %}

{% block content %}
<div class="settings-container">
    <h1 class="mb-3" style="font-family: 'Orbitron', sans-serif; text-transform: uppercase; letter-spacing: .18em; font-size: 1.2rem;">
        {% if request.LANGUAGE_CODE == 'es' %}⚙️ Centro de Ajustes{% else %}⚙️ Settings Center{% endif %}
    </h1>
    <p class="mb-4" style="color: var(--text-secondary);">
        {% if request.LANGUAGE_CODE == 'es' %}Elige qué quieres editar. Solo se muestra una sección a la vez.{% else %}Choose what you want to edit. Only one section is shown at a time.{% endif %}
    </p>

    <!-- BOTONES DE NAVEGACIÓN (solo esto visible al principio) -->
    <div class="section-buttons-row">
        <button type="button"
                class="section-button"
                data-section="profile"
                onclick="openSettingsSection('profile')">
            <span>
                <i class="fas fa-building"></i>
                {% if request.LANGUAGE_CODE == 'es' %}INFORMACIÓN DE EMPRESA{% else %}COMPANY INFORMATION{% endif %}
            </span>
            <span class="arrow">
                <i class="fas fa-chevron-down"></i>
            </span>
        </button>

        <button type="button"
                class="section-button"
                data-section="financial"
                onclick="openSettingsSection('financial')">
            <span>
                <i class="fas fa-receipt"></i>
                {% if request.LANGUAGE_CODE == 'es' %}IMPUESTOS Y FINANZAS{% else %}TAXES & FINANCE{% endif %}
            </span>
            <span class="arrow">
                <i class="fas fa-chevron-down"></i>
            </span>
        </button>

        <button type="button"
                class="section-button"
                data-section="theme"
                onclick="openSettingsSection('theme')">
            <span>
                <i class="fas fa-palette"></i>
                {% if request.LANGUAGE_CODE == 'es' %}TEMA Y COLORES{% else %}THEME & COLORS{% endif %}
            </span>
            <span class="arrow">
                <i class="fas fa-chevron-down"></i>
            </span>
        </button>

        <button type="button"
                class="section-button"
                data-section="modules"
                onclick="openSettingsSection('modules')">
            <span>
                <i class="fas fa-industry"></i>
                {% if request.LANGUAGE_CODE == 'es' %}RUBRO Y MÓDULOS{% else %}INDUSTRY & MODULES{% endif %}
            </span>
            <span class="arrow">
                <i class="fas fa-chevron-down"></i>
            </span>
        </button>

        <button type="button"
                class="section-button"
                data-section="employees"
                onclick="openSettingsSection('employees')">
            <span>
                <i class="fas fa-users"></i>
                {% if request.LANGUAGE_CODE == 'es' %}GESTIÓN DE EMPLEADOS{% else %}EMPLOYEE MANAGEMENT{% endif %}
            </span>
            <span class="arrow">
                <i class="fas fa-chevron-down"></i>
            </span>
        </button>
    </div>

    <!-- MENSAJE INICIAL -->
    <div id="settings-placeholder">
        <i class="fas fa-hand-pointer"></i>
        <p class="mt-2">{% if request.LANGUAGE_CODE == 'es' %}Selecciona una sección para comenzar a editar tu configuración.{% else %}Select a section to start editing your settings.{% endif %}</p>
    </div>

    <!-- CONTENEDOR DE SECCIÓN (solo UNA visible) -->
    <div class="settings-section-wrapper">

        <!-- PROFILE -->
        <div id="section-profile" class="settings-section">
            <form method="post" enctype="multipart/form-data">
                {% csrf_token %}
                <input type="hidden" name="section" value="profile">

                <div class="settings-section-header">
                    <i class="fas fa-building"></i>
                    <h3>{% if request.LANGUAGE_CODE == 'es' %}Información de Empresa{% else %}Company Information{% endif %}</h3>
                </div>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">{{ profile_form.company_name.label }}</label>
                        {{ profile_form.company_name }}
                        {{ profile_form.company_name.errors }}

                        <label class="form-label mt-3">{{ profile_form.tagline.label }}</label>
                        {{ profile_form.tagline }}
                        {{ profile_form.tagline.errors }}

                        <label class="form-label mt-3">{{ profile_form.address.label }}</label>
                        {{ profile_form.address }}
                        {{ profile_form.address.errors }}
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">{{ profile_form.logo.label }}</label>
                        {{ profile_form.logo }}
                        {{ profile_form.logo.errors }}
                    </div>
                </div>

                <div class="row g-3 mt-3">
                    <div class="col-md-4">
                        <label class="form-label">{{ profile_form.phone.label }}</label>
                        {{ profile_form.phone }}
                        {{ profile_form.phone.errors }}
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">{{ profile_form.email.label }}</label>
                        {{ profile_form.email }}
                        {{ profile_form.email.errors }}
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">{{ profile_form.website.label }}</label>
                        {{ profile_form.website }}
                        {{ profile_form.website.errors }}
                    </div>
                </div>

                <div class="row g-3 mt-3">
                    <div class="col-md-6">
                        <label class="form-label">{{ profile_form.tax_id.label }}</label>
                        {{ profile_form.tax_id }}
                        {{ profile_form.tax_id.errors }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">{{ profile_form.business_license.label }}</label>
                        {{ profile_form.business_license }}
                        {{ profile_form.business_license.errors }}
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-save">
                        <i class="fas fa-save me-2"></i>{% if request.LANGUAGE_CODE == 'es' %}Guardar información{% else %}Save company info{% endif %}
                    </button>
                </div>
            </form>
        </div>

        <!-- FINANCIAL -->
        <div id="section-financial" class="settings-section">
            <form method="post">
                {% csrf_token %}
                <input type="hidden" name="section" value="financial">

                <div class="settings-section-header">
                    <i class="fas fa-receipt"></i>
                    <h3>{% if request.LANGUAGE_CODE == 'es' %}Impuestos y Finanzas{% else %}Taxes & Finance{% endif %}</h3>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">{{ financial_form.currency.label }}</label>
                        {{ financial_form.currency }}
                        {{ financial_form.currency.errors }}
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">{{ financial_form.tax_rate.label }}</label>
                        {{ financial_form.tax_rate }}
                        {{ financial_form.tax_rate.errors }}
                    </div>
                    <div class="col-md-4 d-flex align-items-center">
                        <div class="form-check mt-3">
                            {{ financial_form.apply_tax_by_default }}
                            <label class="form-check-label">
                                {{ financial_form.apply_tax_by_default.label }}
                            </label>
                            {{ financial_form.apply_tax_by_default.errors }}
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-save">
                        <i class="fas fa-save me-2"></i>{% if request.LANGUAGE_CODE == 'es' %}Guardar configuración fiscal{% else %}Save financial settings{% endif %}
                    </button>
                </div>
            </form>
        </div>

        <!-- THEME -->
        <div id="section-theme" class="settings-section">
            <form method="post">
                {% csrf_token %}
                <input type="hidden" name="section" value="theme">

                <div class="settings-section-header">
                    <i class="fas fa-palette"></i>
                    <h3>{% if request.LANGUAGE_CODE == 'es' %}Tema y Colores{% else %}Theme & Colors{% endif %}</h3>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">{{ theme_form.primary_color.label }}</label>
                        {{ theme_form.primary_color }}
                        {{ theme_form.primary_color.errors }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">{{ theme_form.secondary_color.label }}</label>
                        {{ theme_form.secondary_color }}
                        {{ theme_form.secondary_color.errors }}
                    </div>
                </div>

                <div class="row g-3 mt-3">
                    <div class="col-md-12">
                        <div class="form-check">
                            {{ theme_form.separate_by_technician }}
                            <label class="form-check-label">
                                {{ theme_form.separate_by_technician.label }}
                            </label>
                            {{ theme_form.separate_by_technician.errors }}
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-save">
                        <i class="fas fa-save me-2"></i>{% if request.LANGUAGE_CODE == 'es' %}Guardar tema{% else %}Save theme{% endif %}
                    </button>
                </div>
            </form>
        </div>

        <!-- MODULES -->
        <div id="section-modules" class="settings-section">
            <form method="post">
                {% csrf_token %}
                <input type="hidden" name="section" value="modules">

                <div class="settings-section-header">
                    <i class="fas fa-industry"></i>
                    <h3>{% if request.LANGUAGE_CODE == 'es' %}Rubro y módulos del documento{% else %}Industry & document modules{% endif %}</h3>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">{{ rubro_form.rubro_principal.label }}</label>
                        {{ rubro_form.rubro_principal }}
                        {{ rubro_form.rubro_principal.errors }}
                    </div>
                </div>

                <div class="row g-4 mt-1">
                    <div class="col-md-3">
                        <label class="form-label d-block">{{ rubro_form.usa_vehiculos.label }}</label>
                        <div class="form-check form-switch text-secondary">
                            {{ rubro_form.usa_vehiculos }}
                            <span class="ms-2">{% if request.LANGUAGE_CODE == 'es' %}Mostrar selección de vehículos{% else %}Show vehicle selector{% endif %}</span>
                        </div>
                        {{ rubro_form.usa_vehiculos.errors }}
                    </div>
                    <div class="col-md-3">
                        <label class="form-label d-block">{{ rubro_form.usa_servicios.label }}</label>
                        <div class="form-check form-switch text-secondary">
                            {{ rubro_form.usa_servicios }}
                            <span class="ms-2">{% if request.LANGUAGE_CODE == 'es' %}Mostrar servicios internos{% else %}Show services section{% endif %}</span>
                        </div>
                        {{ rubro_form.usa_servicios.errors }}
                    </div>
                    <div class="col-md-3">
                        <label class="form-label d-block">{{ rubro_form.usa_otros_servicios.label }}</label>
                        <div class="form-check form-switch text-secondary">
                            {{ rubro_form.usa_otros_servicios }}
                            <span class="ms-2">{% if request.LANGUAGE_CODE == 'es' %}Activar servicios externos{% else %}Enable outsourced services{% endif %}</span>
                        </div>
                        {{ rubro_form.usa_otros_servicios.errors }}
                    </div>
                    <div class="col-md-3">
                        <label class="form-label d-block">{{ rubro_form.usa_kilometraje.label }}</label>
                        <div class="form-check form-switch text-secondary">
                            {{ rubro_form.usa_kilometraje }}
                            <span class="ms-2">{% if request.LANGUAGE_CODE == 'es' %}Solicitar kilometraje{% else %}Request mileage{% endif %}</span>
                        </div>
                        {{ rubro_form.usa_kilometraje.errors }}
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-4">
                    <button type="submit" class="btn btn-save">
                        <i class="fas fa-save me-2"></i>{% if request.LANGUAGE_CODE == 'es' %}Guardar rubro y módulos{% else %}Save industry & modules{% endif %}
                    </button>
                </div>
            </form>
        </div>

        <!-- EMPLOYEES -->
        <div id="section-employees" class="settings-section">
            <div class="settings-section-header">
                <i class="fas fa-users"></i>
                <h3>{% if request.LANGUAGE_CODE == 'es' %}Gestión de Empleados{% else %}Employee Management{% endif %}</h3>
            </div>

            <!-- Formulario para crear técnico -->
            <form method="post" class="mb-4">
                {% csrf_token %}
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">{% if request.LANGUAGE_CODE == 'es' %}Nombre Completo *{% else %}Full Name *{% endif %}</label>
                        <input type="text" name="nombre" class="form-control" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">{% if request.LANGUAGE_CODE == 'es' %}Teléfono{% else %}Phone{% endif %}</label>
                        <input type="text" name="telefono" class="form-control">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">{% if request.LANGUAGE_CODE == 'es' %}Dirección{% else %}Address{% endif %}</label>
                        <input type="text" name="direccion" class="form-control">
                    </div>
                </div>
                <div class="d-flex justify-content-end mt-3">
                    <button type="submit" name="crear_tecnico" class="btn btn-save">
                        <i class="fas fa-plus me-2"></i>{% if request.LANGUAGE_CODE == 'es' %}Agregar Empleado{% else %}Add Employee{% endif %}
                    </button>
                </div>
            </form>

            <!-- Lista de técnicos -->
            {% if tecnicos %}
                <h5 class="mb-3" style="color: var(--neon-cyan); font-family: 'Orbitron', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                    <i class="fas fa-list me-2"></i>{% if request.LANGUAGE_CODE == 'es' %}Empleados Registrados ({{ tecnicos|length }}){% else %}Registered Employees ({{ tecnicos|length }}){% endif %}
                </h5>
                {% for tecnico in tecnicos %}
                    <div style="background: rgba(10, 14, 39, 0.6); border: 1px solid rgba(0, 255, 255, 0.2); border-radius: 15px; padding: 1.5rem; margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center;">
                        <div>
                            <h5 style="margin: 0; color: var(--text-primary);">{{ tecnico.nombre }}</h5>
                            {% if tecnico.telefono %}<p style="margin: 0.5rem 0 0 0; color: var(--text-secondary);"><i class="fas fa-phone"></i> {{ tecnico.telefono }}</p>{% endif %}
                            {% if tecnico.direccion %}<p style="margin: 0.5rem 0 0 0; color: var(--text-secondary);"><i class="fas fa-map-marker-alt"></i> {{ tecnico.direccion }}</p>{% endif %}
                        </div>
                        <form method="post" style="display: inline;">
                            {% csrf_token %}
                            <input type="hidden" name="toggle_tecnico" value="{{ tecnico.id }}">
                            <button type="submit" class="btn btn-save" style="padding: 0.5rem 1rem; font-size: 0.9rem;">
                                {% if tecnico.activo %}
                                    <i class="fas fa-ban me-1"></i>{% if request.LANGUAGE_CODE == 'es' %}Desactivar{% else %}Deactivate{% endif %}
                                {% else %}
                                    <i class="fas fa-check me-1"></i>{% if request.LANGUAGE_CODE == 'es' %}Activar{% else %}Activate{% endif %}
                                {% endif %}
                            </button>
                        </form>
                    </div>
                {% endfor %}
            {% else %}
                <p style="color: var(--text-secondary); text-align: center; padding: 2rem;">
                    <i class="fas fa-info-circle me-2"></i>{% if request.LANGUAGE_CODE == 'es' %}No hay empleados registrados. Agrega uno usando el formulario arriba.{% else %}No employees registered. Add one using the form above.{% endif %}
                </p>
            {% endif %}
        </div>

    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Función para abrir sección
    window.openSettingsSection = function(sectionName) {
        // Ocultar placeholder
        const placeholder = document.getElementById("settings-placeholder");
        if (placeholder) placeholder.style.display = "none";

        // Desactivar todos los botones
        document.querySelectorAll(".section-button").forEach(btn => {
            btn.classList.remove("active");
        });

        // Activar el botón actual
        const activeBtn = document.querySelector(`.section-button[data-section="${sectionName}"]`);
        if (activeBtn) activeBtn.classList.add("active");

        // Ocultar todas las secciones
        document.querySelectorAll(".settings-section").forEach(sec => {
            sec.classList.remove("active");
        });

        // Mostrar solo la sección seleccionada
        const target = document.getElementById(`section-${sectionName}`);
        if (target) {
            target.classList.add("active");
            // Asegurar que el contenido sea visible antes de hacer scroll
            // Forzar reflow para asegurar que el display: block se aplique
            target.offsetHeight;
            
            // Scroll suave sin ocultar contenido - usar scrollTo en lugar de scrollIntoView
            // para tener más control sobre el comportamiento
            setTimeout(() => {
                const targetPosition = target.getBoundingClientRect().top + window.pageYOffset - 20;
                // Asegurar que no hagamos scroll más allá del inicio del documento
                const scrollPosition = Math.max(0, targetPosition);
                window.scrollTo({
                    top: scrollPosition,
                    behavior: "smooth"
                });
            }, 150);
        }
    };
});
</script>
{% endblock %}

