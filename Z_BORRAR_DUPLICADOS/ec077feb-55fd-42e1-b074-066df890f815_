{% load static %}
{% load i18n %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{% block title %}{{ company_name|default:"eGarage" }}{% endblock %}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- JavaScript catalog for gettext -->
  <script src="{% url 'javascript-catalog' %}"></script>

  <!-- Main styles -->
  <link rel="stylesheet" href="{% static 'css/dashboard.css' %}">
  <link rel="stylesheet" href="{% static 'css/output.css' %}">
  {% if enable_space_bg|default:1 %}
    <link rel="stylesheet" href="{% static 'css/starfield.css' %}">
  {% endif %}

  <!-- Dynamic CSS variables for branding -->
  <style>
    :root {
      --company-primary: {{ primary_color|default:"#0d6efd" }};
      --company-secondary: {{ secondary_color|default:"#6c757d" }};
      --bs-primary: {{ primary_color|default:"#0d6efd" }};
      --bs-secondary: {{ secondary_color|default:"#6c757d" }};
    }

    /* Apply company colors */
    .text-primary, .navbar-brand { color: var(--company-primary) !important; }
    .bg-primary { background-color: var(--company-primary) !important; }
    .btn-primary {
      background-color: var(--company-primary) !important;
      border-color: var(--company-primary) !important;
    }
    .btn-primary:hover {
      background-color: color-mix(in srgb, var(--company-primary) 85%, black) !important;
      border-color: color-mix(in srgb, var(--company-primary) 85%, black) !important;
    }
    .border-primary { border-color: var(--company-primary) !important; }

    /* Custom logo in header */
    .company-logo {
      max-height: 60px;
      max-width: 120px;
      object-fit: contain;
    }
  </style>

  <!-- jQuery -->
  <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

  <!-- Autocomplete Light (DAL) -->
  <script src="{% static 'autocomplete_light/jquery.init.js' %}"></script>
  <script src="{% static 'autocomplete_light/select2.js' %}"></script>
  <script src="{% static 'autocomplete_light/autocomplete_light.js' %}"></script>
  <script src="{% static 'autocomplete_light/autocomplete.init.js' %}"></script>

  {% block extra_head %}{% endblock %}
  {% block extra_css %}{% endblock %}
</head>

<body class="bg-[#05070c] text-white font-sans min-h-screen flex flex-col relative dark-mode {% if enable_space_bg == 2 %}starfield-lite{% endif %}">

{% if enable_space_bg|default:1 %}
  <!-- Animated star background (full or light mode) -->
  <div id="bg-starfield" aria-hidden="true">
    <div class="stars layer1"></div>
    {% if enable_space_bg != 2 %}
      <div class="stars layer2"></div>
      <div class="stars layer3"></div>
    {% endif %}
  </div>
{% endif %}

<!-- Unified header and navigation (now with dynamic branding) -->
<header class="flex items-center gap-4 p-4 bg-white shadow-md">
  <img src="{{ company_logo|default:'/static/img/TallerPro_logo.png' }}"
       alt="{{ company_name|default:'eGarage' }} Logo"
       class="company-logo mx-auto">
  <div class="flex flex-col">
    <h1 class="text-xl font-bold text-gray-800">{{ company_name|default:"eGarage" }}</h1>
    {% if company_tagline %}
      <span class="text-sm text-gray-600">{{ company_tagline }}</span>
    {% elif request.user.is_authenticated %}
      <span class="text-sm text-gray-600">Workshop Management System</span>
    {% endif %}
  </div>

  <div class="ml-auto flex items-center gap-4">
    <!-- Settings Button -->
    {% if request.user.is_authenticated %}
      {% load country_url %}
      {% country_url 'futuristic_company_settings' app_namespace='direct' as settings_url %}
      {% if settings_url %}
        <a href="{{ settings_url }}"
           class="flex items-center gap-2 px-3 py-2 text-gray-600 hover:text-gray-800 hover:bg-gray-100 rounded-lg transition"
           title="⚡ Futuristic Control Center">
          <i class="fas fa-cog"></i>
          <span class="hidden md:inline">⚡ Control Center</span>
        </a>
      {% endif %}
    {% endif %}

    <!-- Language selector - Solo para USA -->
    {% if request.country == "US" %}
    <form action="{% url 'set_language' %}" method="post" class="flex items-center">
      {% csrf_token %}
      <input name="next" type="hidden" value="{{ request.get_full_path }}">
      <select name="language" onchange="this.form.submit()" class="border border-cyan-400 rounded px-2 py-1 text-gray-800 bg-white">
        {% get_current_language as LANGUAGE_CODE %}
        {% get_available_languages as LANGUAGES %}
        {% for lang in LANGUAGES %}
          <option value="{{ lang.0 }}" {% if lang.0 == LANGUAGE_CODE %}selected{% endif %}>{{ lang.1 }}</option>
        {% endfor %}
      </select>
    </form>
    {% endif %}
  </div>
</header>

<nav class="w-full bg-black/60 backdrop-blur border-b border-cyan-700/40 shadow-lg py-3 px-6 flex items-center justify-between z-50 relative">
  <div class="flex items-center gap-8">
    {% if request.user.is_authenticated %}
      {% url 'taller:dashboard_suscripciones' as dashboard_url %}
      {% if dashboard_url %}
        <a href="{{ dashboard_url }}" class="text-2xl font-extrabold text-cyan-300 tracking-widest hover:text-lime-300 transition">{{ company_name|default:"eGarage" }}</a>
      {% endif %}
      {% if empresa_usuario %}
        <span class="ml-4 text-lg font-semibold text-lime-300">{{ empresa_usuario.nombre_taller }}</span>
      {% elif company_tagline %}
        <span class="ml-4 text-lg font-semibold text-lime-300">{{ company_tagline }}</span>
      {% endif %}
    {% else %}
      <a href="/" class="text-2xl font-extrabold text-cyan-300 tracking-widest hover:text-lime-300 transition">{{ company_name|default:"eGarage" }}</a>
    {% endif %}
  </div>
  <div class="flex items-center gap-4">
    {% if request.user.is_authenticated %}
      <!-- Main navigation buttons -->
      {% url 'usa:clientes:lista_clientes' as url_clientes %}
      {% url 'vehiculos:lista_vehiculos' as url_vehiculos %}
      {% url 'usa:repuestos:lista_repuestos' as url_repuestos %}
      {% if url_clientes %}
        <a href="{{ url_clientes }}" class="text-cyan-300 hover:text-lime-300 transition flex items-center gap-2">
          <span>👥</span>
          <span class="hidden md:inline">Clients</span>
        </a>
      {% endif %}
      {% if url_vehiculos %}
        <a href="{{ url_vehiculos }}" class="text-cyan-300 hover:text-lime-300 transition flex items-center gap-2">
          <span>🚗</span>
          <span class="hidden md:inline">Vehicles</span>
        </a>
      {% endif %}
      {% if url_repuestos %}
        <a href="{{ url_repuestos }}" class="text-cyan-300 hover:text-lime-300 transition flex items-center gap-2">
          <span>🔧</span>
          <span class="hidden md:inline">Parts</span>
        </a>
      {% endif %}

      <!-- Space Center -->
      <a href="{% url 'usa:centro_operaciones_espacial' %}" class="text-cyan-300 hover:text-lime-300 transition flex items-center gap-2">
        <span>🛰️</span>
        <span class="hidden md:inline">Space Center</span>
      </a>

      <!-- Reports -->
      <a href="{% url 'reportes_us_en:dashboard' %}" class="text-cyan-300 hover:text-lime-300 transition flex items-center gap-2">
        <span>📊</span>
        <span class="hidden md:inline">Reports</span>
      </a>

      <!-- Settings -->
      {% load country_url %}
      {% country_url 'company_settings' app_namespace='direct' as url_settings %}
      {% if url_settings %}
        <a href="{{ url_settings }}" class="text-cyan-300 hover:text-lime-300 transition flex items-center gap-2">
          <span>⚙️</span>
          <span class="hidden md:inline">Settings</span>
        </a>
      {% endif %}
      {% url 'usa:servicios:servicios_menu' as url_servicios %}
      {% if url_servicios %}
        <a href="{{ url_servicios }}" class="text-cyan-300 hover:text-lime-300 transition flex items-center gap-2">
          <span>🧰</span>
          <span class="hidden md:inline">Services</span>
        </a>
      {% endif %}

      <!-- Other Services -->
      {% url 'usa:servicios:otros_servicios_menu' as url_otros %}
      {% if url_otros %}
        <a href="{{ url_otros }}" class="text-cyan-300 hover:text-lime-300 transition flex items-center gap-2">
          <span>🛠️</span>
          <span class="hidden md:inline">Other Services</span>
        </a>
      {% endif %}
      {% comment %} Documents with updated namespaces {% endcomment %}
      {% if request.path|slice:":3" == "/cl" %}
        {% url 'documentos_cl_es:lista_documentos' as url_documentos %}
      {% elif request.path|slice:":3" == "/us" %}
        {% url 'documentos_us_en:lista_documentos' as url_documentos %}
      {% else %}
        {% url 'documentos_cl_es:lista_documentos' as url_documentos %}
      {% endif %}
      {% if url_documentos %}
        <a href="{{ url_documentos }}" class="text-cyan-300 hover:text-lime-300 transition flex items-center gap-2">
          <span>📄</span>
          <span class="hidden md:inline">Documents</span>
        </a>
      {% endif %}

      <!-- Visual separator -->
      <div class="h-6 w-px bg-cyan-700"></div>

      <!-- Configuration -->
      {% url 'taller:configuracion' as url_config %}
      {% if url_config %}
        <a href="{{ url_config }}" class="text-cyan-300 hover:text-lime-300 transition flex items-center gap-2">
          <span>⚙️</span>
          <span class="hidden md:inline">Configuration</span>
        </a>
      {% endif %}

      <!-- Language selector - Solo para USA -->
      {% if request.country == "US" %}
      <form action="{% url 'set_language' %}" method="post" class="inline-block mx-2">
        {% csrf_token %}
        <input name="next" type="hidden" value="{{ request.get_full_path }}">
        <select name="language" onchange="this.form.submit()" class="bg-black/60 text-cyan-300 border border-cyan-700 rounded px-2 py-1 text-sm">
          <option value="es" {% if LANGUAGE_CODE == 'es' %}selected{% endif %}>🇺🇸 ES</option>
          <option value="en" {% if LANGUAGE_CODE == 'en' %}selected{% endif %}>🇺🇸 EN</option>
        </select>
      </form>
      {% endif %}

      <span class="text-cyan-200 font-semibold">{{ request.user.username }}</span>
      <form action="{% url 'account_logout' %}" method="post" style="display:inline;">
        {% csrf_token %}
        <button type="submit" class="bg-red-500 hover:bg-red-400 text-white font-bold px-4 py-2 rounded-xl transition shadow">
          Logout
        </button>
      </form>
    {% else %}
      <a href="{% url 'account_login' %}" class="bg-cyan-500 hover:bg-cyan-400 text-white font-bold px-4 py-2 rounded-xl transition shadow">
        Login or Register
      </a>
    {% endif %}
  </div>
</nav>

{% block fondo_extra %}{% endblock %}

{% block content %}{% endblock %}

<!-- Unified footer -->
<footer class="bg-black/80 border-t border-cyan-700/40 py-4 mt-auto">
  <div class="container mx-auto px-4 text-center">
    <span class="text-xs text-gray-400 block">© 2025 <strong class="text-cyan-300">{{ company_name|default:"Atlanta Reciclajes" }}</strong> — All rights reserved.</span>
    {% if company_settings.address or company_settings.phone or company_settings.email %}
      <span class="text-xs text-gray-400 block">
        {% if company_settings.address %}{{ company_settings.address }}{% endif %}
        {% if company_settings.phone %} • Tel: {{ company_settings.phone }}{% endif %}
        {% if company_settings.email %} • Email: <a href="mailto:{{ company_settings.email }}" class="text-cyan-400 hover:text-cyan-300">{{ company_settings.email }}</a>{% endif %}
      </span>
    {% else %}
      <span class="text-xs text-gray-400 block">{{ company_name|default:"eGarage" }} AI™ system developed by Atlanta Reciclajes</span>
    {% endif %}
    <span class="text-xs text-gray-500 block">Contact: <a href="mailto:{{ company_settings.email|default:'suscripcion@atlantareciclajes.cl' }}" class="text-cyan-400 hover:text-cyan-300">{{ company_settings.email|default:"suscripcion@atlantareciclajes.cl" }}</a></span>
  </div>
</footer>

{% block extra_js %}{% endblock %}

{% if enable_space_bg|default:1 and enable_space_bg != 2 %}
  <script src="{% static 'js/starfield.js' %}"></script>
{% endif %}

<script>
    // CSRF helper
    function getCookie(name) {
        let cookieValue = null;
        if (document.cookie && document.cookie !== '') {
            const cookies = document.cookie.split(';');
            for (let i = 0; i < cookies.length; i++) {
                const cookie = cookies[i].trim();
                if (cookie.substring(0, name.length + 1) === (name + '=')) {
                    cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                    break;
                }
            }
        }
        return cookieValue;
    }

    // Add CSRF token to all AJAX requests
    function csrfSafeMethod(method) {
        return (/^(GET|HEAD|OPTIONS|TRACE)$/.test(method));
    }

    $.ajaxSetup({
        beforeSend: function(xhr, settings) {
            if (!csrfSafeMethod(settings.type) && !this.crossDomain) {
                xhr.setRequestHeader("X-CSRFToken", getCookie('csrftoken'));
            }
        }
    });
</script>
</body>
</html>
