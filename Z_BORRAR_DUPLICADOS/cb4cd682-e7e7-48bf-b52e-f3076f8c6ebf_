{% extends "base.html" %}
{% load static %}

{% block content %}
<div class="w-full min-h-screen flex flex-col items-center justify-center bg-gradient-to-br from-cyan-900 via-blue-900 to-black">
  <div class="bg-[#0d1117cc] rounded-2xl shadow-2xl p-10 border-2 border-cyan-400/40 backdrop-blur-xl max-w-md w-full mt-10">
    <div class="flex flex-col items-center mb-6">
      <img src="{% static 'img/TallerPro_logo.png' %}" alt="E-Garage Logo" class="h-16 mb-3 drop-shadow-lg animate-pulse">
      <h1 class="text-3xl md:text-4xl font-extrabold text-center text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-yellow-300 mb-2 tracking-tight futuristic-glow">
        {% trans "Select your country" %}
      </h1>
      <p class="text-center text-base text-cyan-100 mb-2 max-w-xs font-semibold">
        {% trans "Please choose your country to continue with the registration process." %}
      </p>
    </div>
    <form method="post" action="">
      {% csrf_token %}
      <div class="mb-6">
        <label for="id_country" class="block text-cyan-200 font-bold mb-1">{% trans "Country" %}</label>
        {{ form.country|add_class:'input-futurista'|attr:'placeholder:'|add:'{% trans "Select your country" %}' }}
        {{ form.country.errors }}
      </div>
      <button type="submit" class="w-full py-3 mt-4 rounded-lg bg-gradient-to-r from-cyan-400 via-fuchsia-400 to-yellow-300 text-white font-bold text-lg shadow-lg hover:from-yellow-300 hover:to-cyan-400 transition-all duration-300 animate-pulse border-2 border-cyan-400/40">
        {% trans "Continue" %}
      </button>
    </form>
  </div>
</div>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<style>
  .futuristic-glow {
    text-shadow: 0 0 24px #00ffe7, 0 0 8px #00ffe7, 0 0 2px #fff;
    letter-spacing: 2px;
  }
  .input-futurista {
    background: #000 !important;
    color: #e0f7fa;
    border: 2px solid #00ffe7cc;
    border-radius: 0.9rem;
    padding: 0.85rem 1.1rem;
    width: 100%;
    font-size: 1.15rem;
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
    box-shadow: 0 2px 16px 0 #00ffe755, 0 0 0 2px #f500ff33;
    outline: none;
    font-family: 'Orbitron', 'Inter', 'Segoe UI', Arial, sans-serif;
    letter-spacing: 1px;
    transition: border 0.2s, box-shadow 0.2s, background 0.3s;
    backdrop-filter: blur(2px);
  }
  .input-futurista:focus {
    border: 2.5px solid #f500ff;
    box-shadow: 0 0 24px 0 #f500ffcc, 0 0 0 2px #00ffe7cc;
    background: #000 !important;
    color: #fff;
  }
  .input-futurista::placeholder {
    color: #b2ebf2 !important;
    opacity: 1;
    font-style: italic;
    letter-spacing: 1px;
  }
  .input-futurista,
  .input-futurista:-webkit-autofill,
  .input-futurista:-webkit-autofill:focus,
  .input-futurista:-webkit-autofill:hover,
  .input-futurista:-webkit-autofill:active {
    -webkit-text-fill-color: #e0f7fa !important;
    color: #e0f7fa !important;
    background: #000 !important;
    transition: background-color 5000s ease-in-out 0s;
  }
</style>
{% endblock %}
