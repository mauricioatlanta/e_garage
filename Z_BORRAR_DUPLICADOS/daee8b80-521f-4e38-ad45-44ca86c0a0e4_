{% load i18n %}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comprobante Recibido</title>
</head>
<body style="margin: 0; padding: 0; font-family: 'Helvetica', 'Arial', sans-serif; background-color: #0a0a0a; color: #ffffff;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #0a0a0a;">
        <tr>
            <td align="center" style="padding: 40px 20px;">
                <table width="600" cellpadding="0" cellspacing="0" style="background: linear-gradient(135deg, rgba(213, 43, 30, 0.1) 0%, rgba(0, 51, 160, 0.08) 100%); border: 1px solid rgba(213, 43, 30, 0.3); border-radius: 16px; padding: 40px;">
                    <!-- Logo -->
                    <tr>
                        <td align="center" style="padding-bottom: 30px;">
                            <h1 style="color: #d52b1e; font-size: 32px; margin: 0; font-weight: bold;">💰 eGarage</h1>
                        </td>
                    </tr>

                    <!-- Título -->
                    <tr>
                        <td align="center" style="padding-bottom: 20px;">
                            <h2 style="color: #ffffff; font-size: 24px; margin: 0;">Comprobante Recibido</h2>
                        </td>
                    </tr>

                    <!-- Mensaje -->
                    <tr>
                        <td style="color: #cbd5e1; font-size: 16px; line-height: 1.6; padding-bottom: 30px;">
                            <p>Hola <strong style="color: #ffffff;">{{ empresa.nombre_taller }}</strong>,</p>

                            <p>Hemos recibido tu comprobante de pago con éxito.</p>

                            <div style="background: rgba(0, 0, 0, 0.3); border-left: 4px solid #d52b1e; padding: 20px; margin: 20px 0; border-radius: 8px;">
                                <table width="100%" style="color: #ffffff;">
                                    <tr>
                                        <td style="padding: 8px 0;"><strong>Plan:</strong></td>
                                        <td style="padding: 8px 0; text-align: right;">{{ plan|title }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px 0;"><strong>Monto:</strong></td>
                                        <td style="padding: 8px 0; text-align: right;">${{ monto|floatformat:0 }} {{ moneda }}</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 8px 0;"><strong>Fecha:</strong></td>
                                        <td style="padding: 8px 0; text-align: right;">{{ fecha }}</td>
                                    </tr>
                                </table>
                            </div>

                            <p style="margin-top: 20px;">Nuestro equipo verificará tu pago en las próximas <strong style="color: #22d3ee;">24-48 horas</strong>.</p>

                            <p>Te enviaremos un email de confirmación una vez que tu suscripción esté activa.</p>
                        </td>
                    </tr>

                    <!-- Qué esperar -->
                    <tr>
                        <td style="background: rgba(34, 211, 238, 0.1); border-radius: 8px; padding: 20px; margin-top: 20px;">
                            <p style="color: #22d3ee; font-weight: bold; margin: 0 0 10px 0;">📋 ¿Qué sigue?</p>
                            <ol style="color: #cbd5e1; margin: 0; padding-left: 20px; line-height: 1.8;">
                                <li>Verificamos tu comprobante</li>
                                <li>Confirmamos el pago en nuestra cuenta</li>
                                <li>Activamos tu suscripción</li>
                                <li>Te enviamos un email de confirmación</li>
                            </ol>
                        </td>
                    </tr>

                    <!-- Contacto -->
                    <tr>
                        <td style="color: #94a3b8; font-size: 14px; line-height: 1.6; padding-top: 30px; border-top: 1px solid rgba(255, 255, 255, 0.1);">
                            <p>Si tienes alguna pregunta o necesitas asistencia, no dudes en contactarnos:</p>
                            <p style="color: #22d3ee;">📧 subcription@egarage.cl</p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="padding-top: 30px; color: #64748b; font-size: 14px;">
                            <p>Gracias por elegir eGarage,<br>
                            <strong style="color: #d52b1e;">Equipo eGarage</strong></p>

                            <p style="margin-top: 20px; font-size: 12px;">
                                📧 subcription@egarage.cl | 🌐 www.egarage.cl
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
