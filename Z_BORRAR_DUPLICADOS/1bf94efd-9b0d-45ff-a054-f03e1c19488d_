{% load i18n static %}
<!DOCTYPE html>
<html lang="{{ LANGUAGE_CODE }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% trans "Welcome to eGarage USA" %}</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css" />
  <script src="https://cdn.lordicon.com/lordicon.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/vanta/0.5.24/vanta.waves.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/vanta/0.5.24/vanta.net.min.js"></script>
  <style>
    .glitch {
      color: #0ff;
      position: relative;
      display: inline-block;
    }
    .glitch::after {
      content: attr(data-text);
      position: absolute;
      left: 2px;
      top: 0;
      color: #f0f;
      opacity: 0.7;
      text-shadow: -1px 0 red;
      animation: glitch 1s infinite linear alternate-reverse;
    }
    @keyframes glitch {
      0% { left:2px; opacity:0.7; }
      20% { left:-2px; opacity:0.5; }
      40% { left:2px; opacity:0.8; }
      60% { left:1px; opacity:0.6; }
      80% { left:-1px; opacity:0.9; }
      100% { left:2px; opacity:0.7; }
    }
    .toggle-switch {
      position: fixed;
      top: 1.5rem;
      right: 1.5rem;
      z-index: 50;
      background: rgba(0,0,0,0.7);
      border-radius: 9999px;
      padding: 0.5rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      box-shadow: 0 2px 12px #00ffff44;
      transition: background 0.3s;
    }
    .toggle-switch:hover {
      background: rgba(255,255,255,0.1);
    }
    .light-mode {
      background: #f7fafc !important;
      color: #222 !important;
    }
    .light-mode .glass-card, .light-mode .glass {
      background: rgba(0,0,0,0.08) !important;
      color: #222 !important;
    }
    .light-mode .futuristic-glow {
      text-shadow: 0 0 12px #00f0ff, 0 0 2px #fff;
      color: #0d0d0d !important;
    }
    .light-mode .svg-blob path[fill] {
      fill: #f7fafc !important;
    }
    .light-mode .svg-blob path[stroke] {
      stroke: #00ffff !important;
    }
    .light-mode .icon-float {
      color: #0d0d0d !important;
    }
    .sticky-cta {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 50;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    @media (max-width: 640px) {
      .sticky-cta {
        right: 0.5rem;
        left: 0.5rem;
        bottom: 0.5rem;
        justify-content: center;
      }
    }
  </style>
  <style>
    body {
      background: #0d0d0d !important;
      font-family: 'Share Tech Mono', 'Orbitron', monospace;
      color: #fff;
      min-height: 100vh;
    }
    h1, h2, h3, h4, .futuristic-glow {
      font-family: 'Orbitron', 'Share Tech Mono', monospace !important;
      letter-spacing: 1.5px;
    }
    .futuristic-glow {
      text-shadow: 0 0 24px #00ffff, 0 0 12px #00f0ff, 0 0 4px #fff;
    }
    .glass-card, .glass {
      background: rgba(255,255,255,0.08);
      backdrop-filter: blur(12px);
      border-radius: 1.5rem;
      box-shadow: 0 8px 32px 0 rgba(0,255,255,0.10);
      color: #fff;
      transition: transform 0.2s, background 0.2s;
    }
    .glass-card:hover, .glass:hover {
      transform: scale(1.04);
      background: rgba(0,255,255,0.12);
    }
    .section-sep {
      width: 100vw;
      height: 80px;
      margin: 0 -50vw;
      left: 50%;
      position: relative;
      z-index: 2;
    }
    .svg-blob {
      width: 100vw;
      height: 100px;
      display: block;
      margin: 0;
      z-index: 2;
    }
    .icon-float {
      transition: transform 0.3s, color 0.3s;
      will-change: transform;
    }
    .icon-float:hover {
      transform: scale(1.25) rotate(-8deg);
      color: #f472b6;
    }
    .lordicon-cta {
      width: 80px;
      height: 80px;
      margin: 0 auto 1.5rem auto;
      display: block;
    }
    .aos-animate {
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between bg-[#0d0d0d]">
  <!-- Selector de idioma fijo en la esquina superior derecha -->
  <div class="fixed top-4 right-4 z-50">
    <form action="{% url 'set_language' %}" method="post" class="inline">
      {% csrf_token %}
      <input type="hidden" name="next" value="{{ request.get_full_path }}">
      <select name="language" onchange="this.form.submit()" class="bg-gray-800 text-white text-sm rounded px-3 py-2 border border-cyan-400 hover:border-cyan-300 transition-colors backdrop-blur-sm">
        <option value="en" {% if request.LANGUAGE_CODE == 'en' %}selected{% endif %}>🇺🇸 English</option>
        <option value="es" {% if request.LANGUAGE_CODE == 'es' %}selected{% endif %}>🇪🇸 Español</option>
      </select>
    </form>
  </div>

  <!-- Fondo animado Vanta.js -->
  <!-- Fondo Matrix animado Vanta.js en cabecera -->
  <div id="vanta-matrix" class="fixed top-0 left-0 w-full h-[420px] -z-10"></div>
  <div id="vanta-bg" class="fixed inset-0 -z-20"></div>
  <main class="relative z-10">
    <!-- Hero Section -->
    <section class="text-center py-24 px-6 relative" data-aos="fade-up">
      <img src="{% static 'img/logo.png' %}" alt="eGarage Logo" class="mx-auto mb-8 w-32 md:w-40 animate-spin-slow" style="filter: drop-shadow(0 0 24px #00ffff88);">
      <h1 class="text-5xl md:text-6xl font-extrabold futuristic-glow glitch mb-6" data-text="{% trans 'The #1 Auto Shop Platform in the USA' %}">{% trans "The #1 Auto Shop Platform in the USA" %}</h1>
      <div class="absolute left-1/2 -translate-x-1/2 top-8 md:top-10 z-10">
        <lord-icon
          src="https://cdn.lordicon.com/wxhtpnnk.json"
          trigger="loop"
          colors="primary:#00ffff,secondary:#00bfff"
          style="width:64px;height:64px;filter:drop-shadow(0 0 16px #00ffffcc);"
        ></lord-icon>
      </div>
      <p class="text-xl text-cyan-200 mb-8">{% trans "Trusted by mechanics across America. Real features. Bilingual support. No risk." %}</p>
      <div class="mt-10 flex flex-col md:flex-row gap-4 justify-center">
        <a href="/registro/" class="px-10 py-4 bg-gradient-to-r from-lime-400 to-cyan-400 text-black font-bold rounded-full shadow-lg hover:scale-105 transition-all card-glow text-xl">🚀 {% trans "Start Free Trial" %}</a>
        <a href="#plans" class="px-10 py-4 bg-gradient-to-r from-cyan-400 to-blue-500 text-black font-bold rounded-full shadow-lg hover:scale-105 transition-all card-glow text-xl">💰 {% trans "See Pricing" %}</a>
      </div>
    </section>
  <!-- Botón sticky CTA flotante -->
  <div class="sticky-cta">
    <a href="#cta" class="bg-gradient-to-r from-cyan-400 to-blue-500 text-black px-6 py-3 rounded-full shadow-lg hover:scale-105 transition text-lg font-bold">🚀 {% trans "Start Now" %}</a>
  </div>
    <!-- Separador SVG -->
    <div class="svg-blob">
      <svg viewBox="0 0 1440 100" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0,80 Q720,0 1440,80 L1440,100 L0,100 Z" fill="#0d0d0d"/><path d="M0,80 Q720,0 1440,80" stroke="#00eaff" stroke-width="4" fill="none"/></svg>
    </div>

    <!-- Virtudes agrupadas -->
    <section class="max-w-5xl mx-auto py-20 px-4 grid md:grid-cols-3 gap-12" id="virtues">
      <!-- Gestión -->
      <div data-aos="fade-right">
        <h2 class="text-4xl font-bold text-cyan-300 mb-6 futuristic-glow">{% trans "Management" %}</h2>
        <div class="glass-card p-6 mb-6 flex flex-col items-center">
          <i class="fas fa-shield-alt text-5xl mb-4 icon-float"></i>
          <h3 class="text-2xl font-bold mb-2">{% trans "Warranty Control" %}</h3>
          <p class="text-lg text-gray-300">{% trans "Track guarantees by time or mileage with alerts and digital records." %}</p>
        </div>
        <div class="glass-card p-6 flex flex-col items-center">
          <i class="fas fa-chart-line text-5xl mb-4 icon-float"></i>
          <h3 class="text-2xl font-bold mb-2">{% trans "Profit Reports" %}</h3>
          <p class="text-lg text-gray-300">{% trans "Know your earnings from services, parts, or both — in real time." %}</p>
        </div>
      </div>
      <!-- Automatización -->
      <div data-aos="fade-up">
        <h2 class="text-4xl font-bold text-cyan-300 mb-6 futuristic-glow">{% trans "Automation" %}</h2>
        <div class="glass-card p-6 mb-6 flex flex-col items-center">
          <i class="fas fa-user-cog text-5xl mb-4 icon-float"></i>
          <h3 class="text-2xl font-bold mb-2">{% trans "Mechanic Performance" %}</h3>
          <p class="text-lg text-gray-300">{% trans "Measure performance, job times and track top performers." %}</p>
        </div>
        <div class="glass-card p-6 flex flex-col items-center">
          <i class="fas fa-boxes text-5xl mb-4 icon-float"></i>
          <h3 class="text-2xl font-bold mb-2">{% trans "Inventory Alerts" %}</h3>
          <p class="text-lg text-gray-300">{% trans "Get notified when stock is low or inactive." %}</p>
        </div>
      </div>
      <!-- Cliente -->
      <div data-aos="fade-left">
        <h2 class="text-4xl font-bold text-lime-300 mb-6 futuristic-glow">{% trans "Client" %}</h2>
        <div class="glass-card p-6 mb-6 flex flex-col items-center">
          <i class="fas fa-file-signature text-5xl mb-4 icon-float"></i>
          <h3 class="text-2xl font-bold mb-2">{% trans "Digital Documents" %}</h3>
          <p class="text-lg text-gray-300">{% trans "Paperless work orders, check-ins, diagnostics and receipts." %}</p>
        </div>
        <div class="glass-card p-6 flex flex-col items-center">
          <i class="fas fa-users text-5xl mb-4 icon-float"></i>
          <h3 class="text-2xl font-bold mb-2">{% trans "Customer Portal" %}</h3>
          <p class="text-lg text-gray-300">{% trans "Clients can view invoices, service history and updates online." %}</p>
        </div>
      </div>
    </section>
    <!-- Separador SVG -->
    <div class="svg-blob">
      <svg viewBox="0 0 1440 100" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0,20 Q720,100 1440,20 L1440,100 L0,100 Z" fill="#0d0d0d"/><path d="M0,20 Q720,100 1440,20" stroke="#00bfff" stroke-width="4" fill="none"/></svg>
    </div>

    <!-- Layout tipo revista scroll alterno -->
    <section class="max-w-6xl mx-auto py-20 px-4 flex flex-col gap-24">
      <div class="flex flex-col md:flex-row items-center gap-12" data-aos="fade-right">
        <div class="flex-1">
          <h2 class="text-4xl font-bold text-cyan-200 mb-4 futuristic-glow">{% trans "All-in-one Dashboard" %}</h2>
          <p class="text-lg text-gray-400">{% trans "Everything you need in one place: jobs, inventory, clients, and more." %}</p>
        </div>
        <div class="flex-1 flex justify-center">
          <i class="fas fa-tachometer-alt text-7xl text-cyan-400 icon-float"></i>
        </div>
      </div>
      <div class="flex flex-col items-center text-center" data-aos="fade-up">
        <h2 class="text-4xl font-bold text-cyan-200 mb-4 futuristic-glow">{% trans "Automated Reminders" %}</h2>
        <i class="fas fa-bell text-6xl text-cyan-400 mb-4 icon-float"></i>
        <p class="text-lg text-gray-400 max-w-2xl">{% trans "Never miss a service or follow-up. Automated notifications for you and your clients." %}</p>
      </div>
      <div class="relative" data-aos="fade-left">
        <div class="absolute left-0 top-1/2 w-2 h-64 bg-gradient-to-b from-cyan-400 to-blue-500 rounded-full -translate-y-1/2"></div>
        <div class="ml-12">
          <h2 class="text-4xl font-bold text-lime-200 mb-4 futuristic-glow">{% trans "Timeline of Success" %}</h2>
          <ul class="space-y-6">
            <li class="flex items-center gap-4">
              <span class="w-8 h-8 rounded-full bg-cyan-400 flex items-center justify-center text-black font-bold">1</span>
              <span class="text-lg text-gray-300">{% trans "Register your shop in minutes" %}</span>
            </li>
            <li class="flex items-center gap-4">
              <span class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center text-black font-bold">2</span>
              <span class="text-lg text-gray-300">{% trans "Import your clients and inventory" %}</span>
            </li>
            <li class="flex items-center gap-4">
              <span class="w-8 h-8 rounded-full bg-lime-400 flex items-center justify-center text-black font-bold">3</span>
              <span class="text-lg text-gray-300">{% trans "Start working smarter, not harder!" %}</span>
            </li>
          </ul>
        </div>
      </div>
      <div class="w-full py-16 flex flex-col items-center justify-center bg-gradient-to-r from-blue-900/30 via-cyan-900/30 to-black/80 rounded-3xl" data-aos="fade-up">
        <h2 class="text-4xl font-bold text-cyan-300 mb-4 futuristic-glow">{% trans "Real-time Analytics" %}</h2>
        <i class="fas fa-chart-pie text-6xl text-cyan-400 mb-4 icon-float"></i>
        <p class="text-lg text-gray-400 max-w-2xl">{% trans "Visualize your business growth and make data-driven decisions instantly." %}</p>
      </div>
    </section>
    <!-- Separador SVG -->
    <div class="svg-blob">
      <svg viewBox="0 0 1440 100" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0,60 Q720,100 1440,60 L1440,100 L0,100 Z" fill="#0d0d0d"/><path d="M0,60 Q720,100 1440,60" stroke="#00eaff" stroke-width="4" fill="none"/></svg>
    </div>

    <!-- Testimonios -->
    <section class="max-w-6xl mx-auto py-20 px-4" id="testimonials">
      <h2 class="text-4xl font-bold text-center text-cyan-300 mb-12 futuristic-glow" data-aos="fade-up">{% trans "What our clients say" %}</h2>
      <div class="grid md:grid-cols-3 gap-10">
        <div class="bg-white/5 rounded-3xl p-8 flex flex-col items-center" data-aos="fade-up">
          <img src="/static/img/testimonio1.jpg" alt="Don Luis Auto" class="w-20 h-20 rounded-full mb-4 border-4 border-cyan-400 object-cover shadow-lg" />
          <p class="text-3xl text-white leading-snug mb-4">"{% trans "This software changed how we work forever." %}"</p>
          <div class="mt-2 text-cyan-400 font-bold">Don Luis Auto — Atlanta, GA</div>
        </div>
        <div class="bg-white/5 rounded-3xl p-8 flex flex-col items-center" data-aos="fade-up" data-aos-delay="150">
          <img src="/static/img/testimonio2.jpg" alt="AutoPro Miami" class="w-20 h-20 rounded-full mb-4 border-4 border-blue-400 object-cover shadow-lg" />
          <p class="text-3xl text-white leading-snug mb-4">"{% trans "Bilingual support helped us migrate fast. Recommended for any shop in the USA." %}"</p>
          <div class="mt-2 text-blue-400 font-bold">AutoPro — Miami, FL</div>
        </div>
        <div class="bg-white/5 rounded-3xl p-8 flex flex-col items-center" data-aos="fade-up" data-aos-delay="300">
          <img src="/static/img/testimonio3.jpg" alt="Speed Garage Dallas" class="w-20 h-20 rounded-full mb-4 border-4 border-lime-400 object-cover shadow-lg" />
          <p class="text-3xl text-white leading-snug mb-4">"{% trans "The free trial convinced us. Now everything is digital and our customers notice." %}"</p>
          <div class="mt-2 text-lime-400 font-bold">Speed Garage — Dallas, TX</div>
        </div>
      </div>
    </section>
    <!-- Separador SVG -->
    <div class="svg-blob">
      <svg viewBox="0 0 1440 100" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0,80 Q720,0 1440,80 L1440,100 L0,100 Z" fill="#0d0d0d"/><path d="M0,80 Q720,0 1440,80" stroke="#00eaff" stroke-width="4" fill="none"/></svg>
    </div>

    <!-- CTA Final Supernova -->
    <section id="cta" class="w-full min-h-[60vh] flex flex-col items-center justify-center py-32 relative" style="background:#0d0d0d;" data-aos="zoom-in">
      <div class="flex flex-col items-center justify-center mb-6">
        <lord-icon
          src="https://cdn.lordicon.com/wxhtpnnk.json"
          trigger="loop"
          colors="primary:#00ffff,secondary:#00bfff"
          style="width:80px;height:80px;filter:drop-shadow(0 0 24px #00eaffcc);"
        ></lord-icon>
      </div>
      <h2 class="text-5xl text-cyan-300 font-bold futuristic-glow text-center mb-8">
        {% trans "Ready to upgrade your workshop into a smart force?" %}
      </h2>
      <a href="/signup/" class="mt-8 px-10 py-4 bg-gradient-to-r from-cyan-400 to-blue-500 text-black text-xl font-bold rounded-2xl hover:scale-105 transition shadow-2xl">{% trans "Start Free Today" %}</a>
    </section>
    <footer class="mt-20 text-center text-gray-400 text-sm pb-10">
      <p>&copy; 2025 eGarage USA. {% trans "Built with AI for mechanics" %}</p>
    </footer>
  </main>
  <!-- Scripts -->
  <script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>
  <script>
    // Vanta.js fondo Matrix en cabecera
    VANTA.NET({
      el: "#vanta-matrix",
      mouseControls: true,
      touchControls: true,
      minHeight: 420.00,
      minWidth: 200.00,
      scale: 1.0,
      scaleMobile: 1.0,
      color: 0x00ffff,
      backgroundColor: 0x0d0d0d,
      points: 12.0,
      maxDistance: 22.0,
      spacing: 18.0
    });
    // Vanta.js fondo animado general
    VANTA.WAVES({
      el: "#vanta-bg",
      color: 0x00ffff,
      shininess: 50,
      waveHeight: 20,
      waveSpeed: 0.7,
      zoom: 0.85,
      backgroundColor: 0x0d0d0d
    });
    // AOS.js animaciones scroll
    AOS.init({
      duration: 900,
      once: true,
      offset: 80,
      delay: 100,
      easing: 'ease-in-out-cubic'
    });
    // Toggle dark/light mode
    document.addEventListener('DOMContentLoaded', function() {
      const toggle = document.createElement('div');
      toggle.className = 'toggle-switch';
      toggle.innerHTML = '<span>🌙</span><span id="toggle-label">Dark</span>';
      document.body.appendChild(toggle);
      let isLight = false;
      toggle.onclick = function() {
        isLight = !isLight;
        document.body.classList.toggle('light-mode', isLight);
        document.getElementById('toggle-label').textContent = isLight ? 'Light' : 'Dark';
        toggle.firstChild.textContent = isLight ? '☀️' : '🌙';
      };
    });
  </script>
</body>
</html>
