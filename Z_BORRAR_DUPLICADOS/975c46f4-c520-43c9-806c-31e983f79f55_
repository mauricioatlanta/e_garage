  <script defer>
    document.addEventListener('DOMContentLoaded', function () {
      // Respeta reduce-motion para accesibilidad
      const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduce) {
        // Vanta.js Globe
        if (typeof VANTA !== 'undefined' && VANTA.GLOBE) {
          VANTA.GLOBE({
            el: "#vanta-globe",
            mouseControls: true,
            touchControls: true,
            gyroControls: false,
            minHeight: 200.00,
            minWidth: 200.00,
            scale: 1.00,
            scaleMobile: 1.00,
            color: 0x22d3ee,
            color2: 0x60a5fa,
            backgroundColor: 0x0a0a0a,
            size: 1.00
          });
        }

        // Vanta.js Dots
        if (typeof VANTA !== 'undefined' && VANTA.DOTS) {
          VANTA.DOTS({
            el: "#vanta-dots",
            mouseControls: true,
            touchControls: true,
            gyroControls: false,
            minHeight: 200.00,
            minWidth: 200.00,
            scale: 1.00,
            scaleMobile: 1.00,
            color: 0x22d3ee,
            color2: 0x60a5fa,
            backgroundColor: 0x0a0a0a,
            size: 3.00,
            spacing: 35.00,
            showLines: false
          });
        }

        // AOS.js animaciones scroll
        if (typeof AOS !== 'undefined') {
          AOS.init({
            duration: 900,
            once: true,
            offset: 80,
            delay: 100,
            easing: 'ease-in-out-cubic'
          });
        }
      }

      console.log('Página cargada completamente');
    });
  </script>
