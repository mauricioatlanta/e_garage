<!-- Sección de Información del Documento -->
<div class="document-info-section">
  <h2 class="document-info-title">
    {% if empresa.pais == 'CL' %}Información del Documento{% else %}Document Information{% endif %}
  </h2>

  <div class="document-info-grid">
    <!-- Tipo de Documento -->
    <div class="info-card document-type-card">
      <div class="info-card-header">
        <i class="fas fa-file-alt"></i>
        <label for="id_tipo" class="info-card-label">
          {% if empresa.pais == 'CL' %}Tipo de Documento{% else %}Document Type{% endif %}
        </label>
      </div>
      <select name="{{ form.tipo.html_name }}" id="id_tipo" class="info-card-input">
        {% for value, label in form.tipo.field.choices %}
          <option value="{{ value }}" {% if form.tipo.value == value or form.initial.tipo == value %}selected{% endif %}>
            {{ label }}
          </option>
        {% endfor %}
      </select>
    </div>

    <!-- Estado de Pago -->
    <div class="info-card payment-status-card">
      <div class="info-card-header">
        <i class="fas fa-credit-card"></i>
        <label for="id_estado_pago" class="info-card-label">
          {% if empresa.pais == 'CL' %}Estado de Pago{% else %}Payment Status{% endif %}
        </label>
      </div>
      <select name="{{ form.estado.html_name }}" id="id_estado_pago" class="info-card-input">
        {% for value, label in form.estado.field.choices %}
          <option value="{{ value }}" {% if form.estado.value == value or form.initial.estado == value %}selected{% endif %}>
            {{ label }}
          </option>
        {% endfor %}
      </select>
    </div>

    <!-- Número Asignado -->
    <div class="info-card document-number-card">
      <div class="info-card-header">
        <i class="fas fa-hashtag"></i>
        <label class="info-card-label">
          {% if empresa.pais == 'CL' %}Número Asignado{% else %}Assigned Number{% endif %}
        </label>
      </div>
      <div id="numero_preview" class="document-number-badge">{{ form.instance.numero_documento|default:"—" }}</div>
    </div>
  </div>
</div>

<!-- Campos adicionales -->
<div class="doc-additional-fields">
  <div class="field">
    <label for="id_fecha_emision" class="label">
      {% if empresa.pais == 'CL' %}Fecha de emisión{% else %}Issue date{% endif %}
    </label>
    <input type="date"
           name="{{ form.fecha_emision.html_name }}"
           id="id_fecha_emision"
           class="info-card-input"
           value="{{ form.fecha_emision.value|default:'' }}"
           required>
    <script>
      // Llenar automáticamente con la fecha actual si el campo está vacío
      document.addEventListener('DOMContentLoaded', function() {
        const fechaInput = document.getElementById('id_fecha_emision');
        if (fechaInput && !fechaInput.value) {
          const today = new Date();
          const year = today.getFullYear();
          const month = String(today.getMonth() + 1).padStart(2, '0');
          const day = String(today.getDate()).padStart(2, '0');
          fechaInput.value = `${year}-${month}-${day}`;
        }
      });
    </script>
  </div>

  <div class="field">
    <label for="id_tecnico_responsable" class="label">
      {% if empresa.pais == 'CL' %}Técnico responsable{% else %}Responsible technician{% endif %}
    </label>
    {{ form.tecnico_responsable }}
  </div>

  <div class="field">
    <label for="id_cliente_search" class="label">
      {% if empresa.pais == 'CL' %}Buscar cliente{% else %}Search client{% endif %}
    </label>
    {{ form.cliente_search }}
    <div id="cliente_search_results" class="search-results" style="display: none;"></div>
  </div>

  <div class="field">
    <label for="id_cliente" class="label">
      {% if empresa.pais == 'CL' %}Cliente seleccionado{% else %}Selected client{% endif %}
    </label>
    {{ form.cliente }}
  </div>

  <div class="field">
    <label for="id_vehiculo" class="label">
      {% if empresa.pais == 'CL' %}Vehículo{% else %}Vehicle{% endif %}
    </label>
    {{ form.vehiculo }}
  </div>

  <div class="field">
    <label for="id_kilometraje" class="label">
      {% if empresa.pais == 'CL' %}Kilometraje{% else %}Mileage{% endif %}
    </label>
    {{ form.kilometraje }}
  </div>
</div>

        <!-- Sección de Repuestos -->
        <div class="repuestos-section">
          <h3 class="section-title">
            {% if empresa.pais == 'CL' %}Repuestos{% else %}Parts{% endif %}
          </h3>

  <div id="repuestos-container">
    <div class="repuesto-item" data-repuesto-index="0">
      <div class="repuesto-fields">
        <div class="field">
          <label class="label">
            {% if empresa.pais == 'CL' %}Part Number{% else %}Part Number{% endif %}
          </label>
          <input type="text" class="input repuesto-part-number" placeholder="Ingrese part number..." autocomplete="off">
          <div class="repuesto-search-results" style="display: none;"></div>
        </div>

        <div class="field">
          <label class="label">
            {% if empresa.pais == 'CL' %}Nombre del Repuesto{% else %}Part Name{% endif %}
          </label>
          <input type="text" class="input repuesto-nombre" readonly>
        </div>

        <div class="field">
          <label class="label">
            {% if empresa.pais == 'CL' %}Precio de Compra{% else %}Purchase Price{% endif %}
          </label>
          <input type="number" class="input repuesto-precio-compra" step="0.01" readonly>
        </div>

        <div class="field">
          <label class="label">
            {% if empresa.pais == 'CL' %}Precio de Venta{% else %}Sale Price{% endif %}
          </label>
          <input type="number" class="input repuesto-precio-venta" step="0.01" readonly>
        </div>

        <div class="field">
          <label class="label">
            {% if empresa.pais == 'CL' %}Cantidad{% else %}Quantity{% endif %}
          </label>
          <input type="number" class="input repuesto-cantidad" min="1" value="1" step="1">
        </div>

        <div class="field">
          <label class="label">
            {% if empresa.pais == 'CL' %}Total{% else %}Total{% endif %}
          </label>
          <input type="number" class="input repuesto-total" step="0.01" readonly>
        </div>

        <div class="field">
          <button type="button" class="btn btn-remove-repuesto" style="display: none;">
            {% if empresa.pais == 'CL' %}Eliminar{% else %}Remove{% endif %}
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="repuestos-actions">
    <button type="button" class="btn btn-add-repuesto">
      {% if empresa.pais == 'CL' %}+ Agregar Repuesto{% else %}+ Add Part{% endif %}
    </button>
  </div>
</div>

