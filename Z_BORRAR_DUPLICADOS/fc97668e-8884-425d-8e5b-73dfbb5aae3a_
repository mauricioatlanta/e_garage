{% extends "taller/us/en/common/base.html" %}
{% load static %}
{% load widget_tweaks %}
{% load i18n %}

{% block content %}
<style>
/* Tema ultra moderno negro y gris */
body {
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 25%, #2a2a2a 50%, #1a1a1a 75%, #0a0a0a 100%);
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
}

/* Fondo con destellos */
body::before {
    content: '';
    position: fixed;
    top: 0; left: 0; width: 100vw; height: 100vh;
    z-index: -1;
    background:
        radial-gradient(circle at 20% 30%, rgba(128, 128, 128, 0.2) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(64, 64, 64, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 40% 80%, rgba(96, 96, 96, 0.15) 0%, transparent 40%);
    animation: shimmer 6s ease-in-out infinite alternate;
}

/* Partículas flotantes */
body::after {
    content: '';
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: -1;
    background-image:
        radial-gradient(2px 2px at 20px 30px, rgba(255, 255, 255, 0.8), transparent),
        radial-gradient(2px 2px at 40px 70px, rgba(128, 128, 128, 0.6), transparent),
        radial-gradient(1px 1px at 90px 40px, rgba(192, 192, 192, 0.7), transparent),
        radial-gradient(1px 1px at 130px 80px, rgba(255, 255, 255, 0.5), transparent),
        radial-gradient(2px 2px at 160px 30px, rgba(160, 160, 160, 0.6), transparent);
    background-repeat: repeat;
    background-size: 200px 200px;
    animation: sparkle 8s linear infinite;
}

@keyframes shimmer {
    0% { filter: brightness(1) contrast(1.2); }
    50% { filter: brightness(1.3) contrast(1.5); }
    100% { filter: brightness(1.1) contrast(1.3); }
}

@keyframes sparkle {
    0% { transform: translateY(0px) rotate(0deg); opacity: 1; }
    50% { transform: translateY(-20px) rotate(180deg); opacity: 0.8; }
    100% { transform: translateY(0px) rotate(360deg); opacity: 1; }
}

.language-selector {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 50;
    background: rgba(18, 18, 18, 0.9);
    border: 1px solid rgba(128, 128, 128, 0.3);
    border-radius: 10px;
    padding: 0.5rem;
    backdrop-filter: blur(10px);
}

.language-btn {
    color: #c0c0c0;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: 5px;
    transition: all 0.3s ease;
    margin: 0 0.25rem;
    font-weight: 500;
}

.language-btn:hover {
    color: #ffffff;
    background: rgba(128, 128, 128, 0.2);
    text-decoration: none;
}

.signup-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
}

.signup-card {
    background: rgba(18, 18, 18, 0.95);
    border-radius: 20px;
    border: 1px solid rgba(128, 128, 128, 0.3);
    box-shadow:
        0 8px 32px rgba(128, 128, 128, 0.3),
        inset 0 1px 0 rgba(192, 192, 192, 0.1);
    padding: 3rem 2.5rem;
    width: 100%;
    max-width: 450px;
    backdrop-filter: blur(20px);
    position: relative;
    overflow: hidden;
}

.signup-card::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(128, 128, 128, 0.05) 0%, transparent 70%);
    animation: rotate 20s linear infinite;
    z-index: -1;
}

@keyframes rotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.logo {
    height: 4rem;
    margin-bottom: 1rem;
    filter: drop-shadow(0 0 10px rgba(192, 192, 192, 0.3));
}

.signup-title {
    font-size: 2.5rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.5rem;
    color: #d0d0d0;
    text-shadow:
        0 0 20px rgba(208, 208, 208, 0.6),
        0 0 2px #fff,
        0 0 40px rgba(128, 128, 128, 0.4);
    letter-spacing: 0.1em;
    font-family: 'Orbitron', 'Share Tech Mono', sans-serif;
}

.signup-subtitle {
    text-align: center;
    color: #a0a0a0;
    margin-bottom: 2rem;
    font-size: 1rem;
    font-weight: 500;
    max-width: 300px;
    margin-left: auto;
    margin-right: auto;
}

.form-group {
    margin-bottom: 1.5rem;
}

.form-label {
    display: block;
    color: #c0c0c0;
    font-weight: 600;
    margin-bottom: 0.5rem;
    text-shadow: 0 0 5px rgba(192, 192, 192, 0.3);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.input-futurista {
    width: 100%;
    background: #1a1a1a;
    border: 2px solid #606060;
    border-radius: 10px;
    padding: 0.8rem 1rem;
    color: #e0e0e0;
    font-size: 1rem;
    transition: all 0.3s ease;
    box-shadow:
        0 0 10px rgba(128, 128, 128, 0.2),
        inset 0 0 5px rgba(64, 64, 64, 0.3);
    font-family: 'Share Tech Mono', monospace;
}

.input-futurista:focus {
    outline: none;
    border-color: #a0a0a0;
    box-shadow:
        0 0 20px rgba(160, 160, 160, 0.4),
        inset 0 0 10px rgba(96, 96, 96, 0.3);
    transform: scale(1.02);
}

.input-futurista::placeholder {
    color: rgba(128, 128, 128, 0.7);
}

.btn-signup {
    width: 100%;
    background: linear-gradient(135deg, #404040 0%, #606060 50%, #808080 100%);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 1rem 2rem;
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow:
        0 4px 15px rgba(128, 128, 128, 0.3),
        inset 0 0 10px rgba(160, 160, 160, 0.2);
    text-shadow: 0 0 5px rgba(255, 255, 255, 0.3);
    margin-top: 1rem;
}

.btn-signup:hover {
    transform: translateY(-2px) scale(1.02);
    background: linear-gradient(135deg, #505050 0%, #707070 50%, #909090 100%);
    box-shadow:
        0 6px 20px rgba(144, 144, 144, 0.4),
        inset 0 0 15px rgba(192, 192, 192, 0.3);
}

.login-link {
    text-align: center;
    margin-top: 2rem;
    color: #a0a0a0;
    font-size: 0.9rem;
}

.login-link a {
    color: #c0c0c0;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
}

.login-link a:hover {
    color: #ffffff;
    text-shadow: 0 0 10px rgba(192, 192, 192, 0.5);
}

.error-message {
    background: rgba(64, 64, 64, 0.6);
    border: 1px solid #808080;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 1.5rem;
    text-align: center;
    color: #e0e0e0;
    font-size: 0.9rem;
}

.field-error {
    color: #ff8080;
    font-size: 0.8rem;
    margin-top: 0.25rem;
    text-shadow: 0 0 5px rgba(255, 128, 128, 0.3);
}

/* Responsive */
@media (max-width: 480px) {
    .signup-card {
        margin: 1rem;
        padding: 2rem 1.5rem;
    }

    .signup-title {
        font-size: 2rem;
    }
}

/* Efectos adicionales */
.glow-effect {
    animation: glow 2s ease-in-out infinite alternate;
}

@keyframes glow {
    from { text-shadow: 0 0 20px rgba(208, 208, 208, 0.6); }
    to { text-shadow: 0 0 30px rgba(224, 224, 224, 0.8), 0 0 40px rgba(192, 192, 192, 0.6); }
}
</style>

<!-- Selector de idioma -->
<div class="language-selector">
    <a href="/us/" class="language-btn">EN</a>
    <a href="/cl/" class="language-btn">ES</a>
</div>

<div class="signup-container">
    <div class="signup-card">
        <div class="text-center mb-6">
            <img src="{% static 'img/TallerPro_logo.png' %}" alt="E-Garage Logo" class="logo mx-auto">
            <h1 class="signup-title glow-effect">
                {% trans "Create Account" %}
            </h1>
            <p class="signup-subtitle">
                {% trans "Join the premium workshop management platform" %}
            </p>
        </div>

        {% if messages %}
            {% for message in messages %}
                <div class="error-message">
                    {{ message }}
                </div>
            {% endfor %}
        {% endif %}

        <form method="post" class="space-y-4" id="signup-form">
            {% csrf_token %}

            <div class="form-group">
                <label for="id_email" class="form-label">{% trans "Email Address" %}</label>
                {{ form.email|add_class:'input-futurista'|attr:'placeholder:your@email.com' }}
                {% if form.email.errors %}
                    {% for error in form.email.errors %}
                        <div class="field-error">{{ error }}</div>
                    {% endfor %}
                {% endif %}
            </div>

            <div class="form-group">
                <label for="id_username" class="form-label">{% trans "Username" %}</label>
                {{ form.username|add_class:'input-futurista'|attr:'placeholder:Username' }}
                {% if form.username.errors %}
                    {% for error in form.username.errors %}
                        <div class="field-error">{{ error }}</div>
                    {% endfor %}
                {% endif %}
            </div>

            <div class="form-group">
                <label for="id_password1" class="form-label">{% trans "Password" %}</label>
                {{ form.password1|add_class:'input-futurista'|attr:'placeholder:••••••••' }}
                {% if form.password1.errors %}
                    {% for error in form.password1.errors %}
                        <div class="field-error">{{ error }}</div>
                    {% endfor %}
                {% endif %}
            </div>

            <div class="form-group">
                <label for="id_password2" class="form-label">{% trans "Confirm Password" %}</label>
                {{ form.password2|add_class:'input-futurista'|attr:'placeholder:••••••••' }}
                {% if form.password2.errors %}
                    {% for error in form.password2.errors %}
                        <div class="field-error">{{ error }}</div>
                    {% endfor %}
                {% endif %}
            </div>

            {% if form.non_field_errors %}
                <div class="error-message">
                    {% for error in form.non_field_errors %}
                        {{ error }}
                    {% endfor %}
                </div>
            {% endif %}

            <button type="submit" class="btn-signup">
                🚀 {% trans "Create Account" %}
            </button>
        </form>

        <div class="login-link">
            {% trans "Already have an account?" %}
            <a href="{% url 'account_login' %}">{% trans "Sign In" %}</a>
        </div>
    </div>
</div>

{% endblock %}
