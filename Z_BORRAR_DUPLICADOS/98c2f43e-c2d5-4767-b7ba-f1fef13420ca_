<script>
// JavaScript para la funcionalidad de la sección de totales profesional
document.addEventListener('DOMContentLoaded', function() {
    const taxCheckbox = document.getElementById('incluir-impuestos');
    const taxRow = document.getElementById('tax-row');

    // Toggle para mostrar/ocultar la fila de impuestos
    if (taxCheckbox && taxRow) {
        taxCheckbox.addEventListener('change', function() {
            if (this.checked) {
                taxRow.style.display = 'flex';
                taxRow.style.animation = 'fadeIn 0.3s ease-in';
            } else {
                taxRow.style.animation = 'fadeOut 0.3s ease-out';
                setTimeout(() => {
                    taxRow.style.display = 'none';
                }, 300);
            }
            updateTotals();
        });
    }

    // Función para actualizar los totales
    function updateTotals() {
        const repuestos = parseFloat(document.getElementById('total-repuestos')?.value || 0);
        const servicios = parseFloat(document.getElementById('total-servicios')?.value || 0);
        const otros = parseFloat(document.getElementById('total-otros-servicios')?.value || 0);

        const subtotal = repuestos + servicios + otros;

        // Actualizar displays
        updateDisplay('total-repuestos-display', repuestos);
        updateDisplay('total-servicios-display', servicios);
        updateDisplay('total-otros-servicios-display', otros);
        updateDisplay('subtotal-display', subtotal);

        // Calcular impuestos si está habilitado
        let tax = 0;
        if (taxCheckbox && taxCheckbox.checked) {
            // Chile: 19% solo en repuestos, USA: 8.25% en todo
            const isChile = document.querySelector('[data-country="CL"]') ||
                           window.location.pathname.includes('/cl/');
            if (isChile) {
                tax = repuestos * 0.19; // IVA solo en repuestos para Chile
            } else {
                tax = subtotal * 0.0825; // Tax en todo para USA
            }
            updateDisplay('monto-impuestos-display', tax);
        }

        const grandTotal = subtotal + tax;
        updateDisplay('gran-total-display', grandTotal);
    }

    // Función para formatear y actualizar displays
    function updateDisplay(elementId, value) {
        const element = document.getElementById(elementId);
        if (element) {
            const formatted = new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD',
                minimumFractionDigits: 2
            }).format(value);
            element.textContent = formatted;
        }
    }

    // Observar cambios en los campos de totales
    const totalInputs = ['total-repuestos', 'total-servicios', 'total-otros-servicios'];
    totalInputs.forEach(inputId => {
        const input = document.getElementById(inputId);
        if (input) {
            input.addEventListener('input', updateTotals);
        }
    });

    // Inicializar totales
    updateTotals();

    // ===== FUNCIONALIDAD PARA AGREGAR REPUESTOS =====
    // REMOVED: addRepuestoRow function - handled by documentos_form_enhanced.js to avoid duplicate functionality

    // Función para configurar eventos de una fila de repuesto
    function setupRepuestoRowEvents(row) {
        const partNumberField = row.querySelector('.repuesto-part-number');
        const nombreField = row.querySelector('.repuesto-nombre');
        const precioCompraField = row.querySelector('.repuesto-precio-compra');
        const precioVentaField = row.querySelector('.repuesto-precio-venta');
        const cantidadField = row.querySelector('.repuesto-cantidad');
        const totalField = row.querySelector('.repuesto-total');
        const removeBtn = row.querySelector('.btn-remove-repuesto');

        // Función para calcular total
        function calculateTotal() {
            const cantidad = parseFloat(cantidadField.value) || 0;
            const precioVenta = parseFloat(precioVentaField.value) || 0;
            const total = cantidad * precioVenta;
            totalField.value = total.toFixed(2);
            updateTotals();
        }

        // Event listener para part number (búsqueda de repuesto)
        if (partNumberField) {
            partNumberField.addEventListener('input', function() {
                const partNumber = this.value.trim();
                if (partNumber.length >= 2) {
                    // Aquí podrías agregar lógica de búsqueda AJAX
                    // Por ahora, simular datos
                    setTimeout(() => {
                        nombreField.value = `Repuesto ${partNumber}`;
                        precioCompraField.value = '100.00';
                        precioVentaField.value = '150.00';
                        calculateTotal();
                    }, 500);
                }
            });
        }

        // Event listeners para campos numéricos
        if (cantidadField) {
            cantidadField.addEventListener('input', calculateTotal);
        }

        if (precioVentaField) {
            precioVentaField.addEventListener('input', calculateTotal);
        }

        // Event listener para botón eliminar
        if (removeBtn) {
            removeBtn.addEventListener('click', function() {
                row.remove();
                updateTotals();
            });
        }
    }

