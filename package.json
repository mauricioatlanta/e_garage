    "test:desktop": "playwright test --project=\"Desktop Chrome\"",
    "test:headed": "playwright test --headed",
    "test:mobile": "playwright test --project=\"Mobile iPhone 12\"",
    "test:report": "playwright show-report",
    "test:ui": "playwright test --ui"
