{% extends 'taller/us/en/base.html' %}{% load static widget_tweaks i18n %}

{% block title %}Configuration Center | {{ empresa.nombre_taller|default:"E-Garage" }}{% endblock %}

{% block extra_head %}
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Exo+2:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
    :root {
        --calypso-blue: #00d4ff;
        --calypso-cyan: #00ffff;
        --calypso-dark: #1a1a2e;
        --calypso-darker: #0a0a0f;
        --calypso-black: #000000;
        --calypso-accent: #0080ff;
        --calypso-light: #40e0ff;
        --glass-bg: rgba(0, 212, 255, 0.1);
        --neon-glow: 0 0 30px;
    }

    body {
        background:
            radial-gradient(circle at 20% 80%, rgba(0, 212, 255, 0.3) 0%, transparent 50%),
            radial-gradient(circle at 80% 20%, rgba(0, 128, 255, 0.3) 0%, transparent 50%),
            radial-gradient(circle at 40% 40%, rgba(64, 224, 255, 0.2) 0%, transparent 50%),
            linear-gradient(135deg, #000000 0%, #0a0a0f 25%, #1a1a2e 50%, #16213e 75%, #0f3460 100%);
        color: #ffffff;
        font-family: 'Orbitron', 'Exo 2', sans-serif;
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
    }

    /* Circuito de fondo animado */
    body::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image:
            linear-gradient(90deg, transparent 98%, rgba(0, 212, 255, 0.3) 100%),
            linear-gradient(0deg, transparent 98%, rgba(0, 212, 255, 0.3) 100%),
            radial-gradient(circle at 20% 80%, rgba(0, 212, 255, 0.1) 0%, transparent 50%),
            radial-gradient(circle at 80% 20%, rgba(0, 128, 255, 0.1) 0%, transparent 50%);
        background-size: 50px 50px, 50px 50px, 100% 100%, 100% 100%;
        animation: circuitFlow 20s linear infinite;
        z-index: -2;
    }

    @keyframes circuitFlow {
        0% { transform: translate(0, 0); }
        100% { transform: translate(50px, 50px); }
    }

    /* Partículas flotantes */
    .particle {
        position: fixed;
        width: 4px;
        height: 4px;
        background: var(--calypso-blue);
        border-radius: 50%;
        animation: float 6s ease-in-out infinite;
        z-index: 1;
    }

    .particle:nth-child(1) { top: 20%; left: 10%; animation-delay: 0s; }
    .particle:nth-child(2) { top: 60%; right: 20%; animation-delay: 1s; }
    .particle:nth-child(3) { bottom: 30%; left: 30%; animation-delay: 2s; }
    .particle:nth-child(4) { top: 40%; right: 50%; animation-delay: 3s; }
    .particle:nth-child(5) { bottom: 60%; right: 10%; animation-delay: 4s; }

    @keyframes float {
        0%, 100% { transform: translateY(0px); opacity: 0.3; }
        50% { transform: translateY(-20px); opacity: 1; }
    }

    .config-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px;
        position: relative;
        z-index: 10;
    }

    .config-header {
        text-align: center;
        margin-bottom: 50px;
        padding: 40px;
        background: rgba(0, 0, 0, 0.8);
        border: 2px solid rgba(0, 212, 255, 0.6);
        border-radius: 20px;
        backdrop-filter: blur(20px);
        box-shadow:
            0 0 50px rgba(0, 212, 255, 0.3),
            inset 0 0 50px rgba(0, 0, 0, 0.5);
        position: relative;
    }

    .config-header::before {
        content: '';
        position: absolute;
        top: -2px;
        left: -2px;
        right: -2px;
        bottom: -2px;
        background: linear-gradient(45deg, var(--calypso-blue), var(--calypso-accent), var(--calypso-blue));
        border-radius: 22px;
        z-index: -1;
        animation: borderGlow 3s ease-in-out infinite alternate;
    }

    @keyframes borderGlow {
        0% { opacity: 0.5; }
        100% { opacity: 1; }
    }

    .config-title {
        color: #ffffff;
        font-size: 3rem;
        font-weight: 900;
        margin-bottom: 15px;
        text-shadow: 0 0 30px rgba(0, 212, 255, 0.8);
        font-family: 'Orbitron', monospace;
        background: linear-gradient(45deg, #ffffff, var(--calypso-blue), #ffffff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: titleGlow 2s ease-in-out infinite alternate;
    }

    @keyframes titleGlow {
        0% { filter: brightness(1); }
        100% { filter: brightness(1.2); }
    }

    .config-subtitle {
        color: var(--calypso-cyan);
        font-size: 1.2rem;
        font-weight: 400;
        margin-bottom: 10px;
    }

    .config-description {
        color: #a0a0a0;
        font-size: 1rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .config-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(500px, 1fr));
        gap: 30px;
        margin-bottom: 40px;
    }

    .config-section {
        background: rgba(0, 0, 0, 0.8);
        border: 1px solid rgba(0, 212, 255, 0.4);
        border-radius: 15px;
        padding: 30px;
        backdrop-filter: blur(15px);
        box-shadow: 0 0 30px rgba(0, 212, 255, 0.2);
        transition: all 0.3s ease;
    }

    .config-section:hover {
        border-color: rgba(0, 212, 255, 0.7);
        box-shadow: 0 0 40px rgba(0, 212, 255, 0.4);
        transform: translateY(-5px);
    }

    .section-title {
        color: var(--calypso-blue);
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 25px;
        text-align: center;
        font-family: 'Orbitron', monospace;
        text-shadow: 0 0 15px rgba(0, 212, 255, 0.6);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        color: var(--calypso-cyan);
        font-weight: 600;
        font-size: 0.9rem;
        margin-bottom: 8px;
        display: block;
        text-shadow: 0 0 8px rgba(0, 255, 255, 0.4);
    }

    .form-input {
        width: 100%;
        padding: 12px 15px;
        background: rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(0, 212, 255, 0.4);
        border-radius: 8px;
        color: #ffffff;
        font-size: 1rem;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .form-input:focus {
        outline: none;
        border-color: var(--calypso-blue);
        box-shadow: 0 0 15px rgba(0, 212, 255, 0.4);
        background: rgba(0, 0, 0, 0.8);
    }

    .form-input::placeholder {
        color: #666;
    }

    .country-indicator {
        background: linear-gradient(135deg, #00d4ff, #0891b2);
        color: #000;
        padding: 4px 12px;
        border-radius: 15px;
        font-size: 0.8rem;
        font-weight: 900;
        text-shadow: 0 0 5px rgba(0, 212, 255, 0.5);
        box-shadow: 0 0 10px rgba(0, 212, 255, 0.3);
        border: 1px solid rgba(0, 212, 255, 0.6);
        animation: countryGlow 2s ease-in-out infinite alternate;
    }

    @keyframes countryGlow {
        0% {
            box-shadow: 0 0 10px rgba(0, 212, 255, 0.3);
            text-shadow: 0 0 5px rgba(0, 212, 255, 0.5);
        }
        100% {
            box-shadow: 0 0 15px rgba(0, 212, 255, 0.6);
            text-shadow: 0 0 8px rgba(0, 212, 255, 0.8);
        }
    }

    .country-indicator.cl {
        background: linear-gradient(135deg, #ff6b35, #f7931e);
        border: 1px solid rgba(255, 107, 53, 0.6);
        box-shadow: 0 0 10px rgba(255, 107, 53, 0.3);
        text-shadow: 0 0 5px rgba(255, 107, 53, 0.5);
    }

    .country-indicator.us {
        background: linear-gradient(135deg, #00d4ff, #0891b2);
        border: 1px solid rgba(0, 212, 255, 0.6);
        box-shadow: 0 0 10px rgba(0, 212, 255, 0.3);
        text-shadow: 0 0 5px rgba(0, 212, 255, 0.5);
    }

    /* Estilos para elementos futuristas */
    .futuristic-form {
        background: rgba(0, 0, 0, 0.8);
        border: 1px solid rgba(0, 212, 255, 0.4);
        border-radius: 20px;
        padding: 30px;
        backdrop-filter: blur(15px);
        box-shadow: 0 0 30px rgba(0, 212, 255, 0.2);
        margin-top: 20px;
    }

    .futuristic-title {
        color: #ffffff;
        font-size: 2.5rem;
        font-weight: 900;
        margin-bottom: 20px;
        text-shadow: 0 0 30px rgba(0, 212, 255, 0.8);
        font-family: 'Orbitron', monospace;
        background: linear-gradient(45deg, #ffffff, var(--calypso-blue), #ffffff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: titleGlow 2s ease-in-out infinite alternate;
        display: flex;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .futuristic-title .country-indicator {
        font-size: 0.6rem;
        padding: 6px 12px;
        margin-left: 10px;
        flex-shrink: 0;
    }

    .futuristic-label {
        color: var(--calypso-cyan);
        font-weight: 600;
        font-size: 1rem;
        margin-bottom: 8px;
        display: block;
        text-shadow: 0 0 8px rgba(0, 255, 255, 0.4);
        font-family: 'Orbitron', monospace;
    }

    .futuristic-input {
        width: 100%;
        padding: 12px 15px;
        background: rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(0, 212, 255, 0.4);
        border-radius: 8px;
        color: #ffffff;
        font-size: 1rem;
        transition: all 0.3s ease;
        backdrop-filter: blur(10px);
    }

    .futuristic-input:focus {
        outline: none;
        border-color: var(--calypso-blue);
        box-shadow: 0 0 15px rgba(0, 212, 255, 0.4);
        background: rgba(0, 0, 0, 0.8);
    }

    .futuristic-btn {
        background: linear-gradient(135deg, var(--calypso-blue), var(--calypso-accent));
        color: #000;
        padding: 12px 25px;
        border: none;
        border-radius: 10px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
        box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
        font-family: 'Orbitron', monospace;
    }

    .futuristic-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 30px rgba(0, 212, 255, 0.5);
        background: linear-gradient(135deg, var(--calypso-accent), var(--calypso-blue));
    }

    .country-indicator.cl:hover {
        box-shadow: 0 0 15px rgba(255, 107, 53, 0.6);
        text-shadow: 0 0 8px rgba(255, 107, 53, 0.8);
    }

    .btn-submit {
        background: linear-gradient(135deg, var(--calypso-blue), var(--calypso-accent));
        color: #000;
        padding: 12px 30px;
        border: none;
        border-radius: 25px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-family: 'Orbitron', monospace;
        box-shadow: 0 4px 15px rgba(0, 212, 255, 0.3);
        width: 100%;
    }

    .btn-submit:hover {
        background: linear-gradient(135deg, var(--calypso-accent), var(--calypso-blue));
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 212, 255, 0.5);
    }

    .status-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-top: 30px;
    }

    .status-card {
        background: rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(0, 212, 255, 0.3);
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        backdrop-filter: blur(10px);
        transition: all 0.3s ease;
    }

    .status-card:hover {
        border-color: rgba(0, 212, 255, 0.6);
        transform: translateY(-3px);
    }

    .status-value {
        font-size: 2rem;
        font-weight: 900;
        color: var(--calypso-blue);
        margin-bottom: 5px;
        font-family: 'Orbitron', monospace;
    }

    .status-label {
        color: #a0a0a0;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .logo-preview {
        max-width: 200px;
        height: auto;
        border: 2px solid var(--calypso-blue);
        border-radius: 10px;
        margin-top: 10px;
        box-shadow: 0 0 15px rgba(0, 212, 255, 0.3);
    }

    .info-box {
        background: rgba(0, 255, 0, 0.1);
        border: 1px solid rgba(0, 255, 0, 0.3);
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 30px;
        text-align: center;
    }

    .info-box h3 {
        color: #00ff00;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .info-box p {
        color: #a0a0a0;
        margin: 0;
    }

    /* Estilos para botones de navegación */
    .nav-buttons {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 12px !important;
        margin-bottom: 24px !important;
        visibility: visible !important;
        opacity: 1 !important;
        z-index: 100 !important;
    }

    .nav-buttons a {
        display: inline-flex !important;
        align-items: center !important;
        gap: 8px !important;
        padding: 8px 16px !important;
        border-radius: 8px !important;
        text-decoration: none !important;
        transition: all 0.3s ease !important;
        font-size: 14px !important;
        font-weight: 500 !important;
        white-space: nowrap !important;
        visibility: visible !important;
        opacity: 1 !important;
    }

    @media (max-width: 768px) {
        .config-grid {
            grid-template-columns: 1fr;
        }

        .config-title {
            font-size: 2rem;
        }

        .config-container {
            padding: 20px 10px;
        }

        .nav-buttons {
            flex-direction: column !important;
        }

        .nav-buttons a {
            width: 100% !important;
            justify-content: center !important;
        }
    }
</style>
{% endblock %}

