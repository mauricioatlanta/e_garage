{% extends "taller/documentos/base/base_documento.html" %}
{% load i18n %}

{% load static %}

{% block title %}
  Editar Documento
{% endblock %}

{% block extra_head %}
  {% if pdf_mode %}
    {# Usa archivo estático si preferes: <link rel="stylesheet" href="{% static 'css/document_print.css' %}"> #}
    {% include "taller/documentos/base/includes/theme_print.html" %}
  {% else %}
    {% include "taller/documentos/base/includes/theme.html" %}
    {% include "taller/documentos/base/includes/theme_dark.html" %}
  {% endif %}
{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            {# Mapea el valor inicial desde form (POST/instance) #}
            {% with tipo_init=form.data.tipo|default:form.instance.tipo|default:"OT" %}
            <div id="doc-shell" class="doc-shell theme-ot">  {# clase inicial se ajustará vía JS #}

                <div class="flex items-center justify-between mb-4">
                    <div class="space-x-2">
                        <span id="doc-chip" class="doc-chip chip-ot">🔧 OT</span>
                        <span class="text-xs text-gray-500">#{{ obj.id }}</span>
                    </div>
                    <div class="text-xs text-gray-400">
                        {{ empresa_nombre|default:"Mi Empresa" }} • {{ empresa_moneda|default:"CLP" }}
                    </div>
                </div>

                <form id="document-form" method="post" novalidate>
                    {% csrf_token %}

                    <!-- Grid de campos principales -->
                    <div class="grid sm:grid-cols-2 gap-4 mb-6">
                        <div>
                            <label class="block text-sm mb-1" for="id_tipo">
                                {{ form.tipo.label }}
                            </label>
                            {{ form.tipo }}
                            {% if form.tipo.errors %}
                                <div class="text-red-500 text-sm mt-1">{{ form.tipo.errors }}</div>
                            {% endif %}
                        </div>

                        <div>
                            <label class="block text-sm mb-1" for="id_numero">
                                {{ form.numero.label }}
                            </label>
                            {{ form.numero }}
                            {% if form.numero.errors %}
                                <div class="text-red-500 text-sm mt-1">{{ form.numero.errors }}</div>
                            {% endif %}
                        </div>

                        <div>
                            <label class="block text-sm mb-1" for="id_fecha_emision">
                                {{ form.fecha_emision.label }}
                            </label>
                            {{ form.fecha_emision }}
                            {% if form.fecha_emision.errors %}
                                <div class="text-red-500 text-sm mt-1">{{ form.fecha_emision.errors }}</div>
                            {% endif %}
                        </div>

                        <div>
                            <label class="block text-sm mb-1" for="id_tecnico_responsable">
                                {{ form.tecnico_responsable.label }}
                            </label>
                            {{ form.tecnico_responsable }}
                            {% if form.tecnico_responsable.errors %}
                                <div class="text-red-500 text-sm mt-1">{{ form.tecnico_responsable.errors }}</div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Campos de relación con DAL -->
                    <div class="grid sm:grid-cols-2 gap-4 mb-6">
                        <div>
                            <label class="block text-sm mb-1" for="id_cliente">
                                {{ form.cliente.label }}
                            </label>
                            {{ form.cliente }}
                            {% if form.cliente.errors %}
                                <div class="text-red-500 text-sm mt-1">{{ form.cliente.errors }}</div>
                            {% endif %}
                        </div>

                        <div>
                            <label class="block text-sm mb-1" for="id_vehiculo">
                                {{ form.vehiculo.label }}
                            </label>
                            {{ form.vehiculo }}
                            {% if form.vehiculo.errors %}
                                <div class="text-red-500 text-sm mt-1">{{ form.vehiculo.errors }}</div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Campos adicionales -->
                    <div class="grid sm:grid-cols-2 gap-4 mb-6">
                        <div>
                            <label class="block text-sm mb-1" for="id_kilometraje">
                                {{ form.kilometraje.label }}
                            </label>
                            {{ form.kilometraje }}
                            {% if form.kilometraje.errors %}
                                <div class="text-red-500 text-sm mt-1">{{ form.kilometraje.errors }}</div>
                            {% endif %}
                        </div>

                        <div class="flex items-center">
                            <div class="form-check">
                                {{ form.pagado }}
                                <label class="form-check-label" for="id_pagado">
                                    {{ form.pagado.label }}
                                </label>
                                {% if form.pagado.errors %}
                                    <div class="text-red-500 text-sm mt-1">{{ form.pagado.errors }}</div>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <!-- Observaciones -->
                    <div class="mb-6">
                        <label class="block text-sm mb-1" for="id_observaciones">
                            {{ form.observaciones.label }}
                        </label>
                        {{ form.observaciones }}
                        {% if form.observaciones.errors %}
                            <div class="text-red-500 text-sm mt-1">{{ form.observaciones.errors }}</div>
                        {% endif %}
                    </div>

                    <!-- Errores generales -->
                    {% if form.non_field_errors %}
                        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-4">
                            {{ form.non_field_errors }}
                        </div>
                    {% endif %}

                    <!-- Botones -->
                    <div class="flex justify-between items-center">
                        <a href="{% url 'documentos:lista' %}" class="px-4 py-2 rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50">
                            {% if country == "US" %}Cancel{% else %}Cancelar{% endif %}
                        </a>
                        <button type="submit" class="px-6 py-2 rounded-lg bg-gray-900 text-white hover:bg-gray-800">
                            {% if country == "US" %}Update Document{% else %}Actualizar Documento{% endif %}
                        </button>
                    </div>
                </form>
            </div>
            {% endwith %}
        </div>
    </div>
</div>

<!-- Scripts DAL -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
$(document).ready(function() {
    // Inicializar Select2 para los campos DAL
    $('#id_cliente').select2({
        placeholder: "{% if country == 'US' %}Search customer...{% else %}Buscar cliente...{% endif %}",
        allowClear: true,
        minimumInputLength: 2
    });

    $('#id_vehiculo').select2({
        placeholder: "{% if country == 'US' %}Search vehicle...{% else %}Buscar vehículo...{% endif %}",
        allowClear: true,
        minimumInputLength: 1
    });

    // Cuando cambie el cliente, actualizar vehículos
    $('#id_cliente').on('change', function() {
        var clienteId = $(this).val();
        var vehiculoSelect = $('#id_vehiculo');

        if (clienteId) {
            // Habilitar vehículos y cargar solo los del cliente seleccionado
            vehiculoSelect.prop('disabled', false);
            vehiculoSelect.empty();
            vehiculoSelect.append('<option value="">{% if country == "US" %}Loading vehicles...{% else %}Cargando vehículos...{% endif %}</option>');

            // La lógica de filtrado se maneja automáticamente por DAL con forward
            vehiculoSelect.trigger('change');
        } else {
            // Deshabilitar vehículos si no hay cliente
            vehiculoSelect.prop('disabled', true);
            vehiculoSelect.empty();
            vehiculoSelect.append('<option value="">{% if country == "US" %}Select customer first{% else %}Seleccione cliente primero{% endif %}</option>');
        }
    });

    // Inicializar estado de vehículos
    if (!$('#id_cliente').val()) {
        $('#id_vehiculo').prop('disabled', true);
        $('#id_vehiculo').append('<option value="">{% if country == "US" %}Select customer first{% else %}Seleccione cliente primero{% endif %}</option>');
    }
});

// Tema dinámico del documento
(function () {
    const shell = document.getElementById('doc-shell');
    const chip  = document.getElementById('doc-chip');
    const tipo  = document.getElementById('id_tipo');

    // Mapas de clases por tipo
    const shellThemes = {
        'OT':   ['theme-ot'],
        'PRES': ['theme-pres'],
        'REC':  ['theme-rec'],
    };
    const chipThemes = {
        'OT':   { classes: ['chip-ot'],   label: '🔧 OT' },
        'PRES': { classes: ['chip-pres'], label: '📋 PRES' },
        'REC':  { classes: ['chip-rec'],  label: '🧾 REC' },
    };

    function resetShellThemes() {
        shell.classList.remove('theme-ot', 'theme-pres', 'theme-rec');
    }
    function resetChipThemes() {
        chip.classList.remove('chip-ot', 'chip-pres', 'chip-rec');
    }

    function applyTheme(value) {
        const v = (value || 'OT').toUpperCase();
        resetShellThemes();
        resetChipThemes();
        (shellThemes[v] || shellThemes['OT']).forEach(c => shell.classList.add(c));
        const conf = chipThemes[v] || chipThemes['OT'];
        conf.classes.forEach(c => chip.classList.add(c));
        chip.textContent = conf.label;
    }

    // Inicializa según valor del formulario
    applyTheme('{{ tipo_init }}');

    // Reacciona a cambios del select
    tipo && tipo.addEventListener('change', function (e) {
        applyTheme(e.target.value);
    });
})();
</script>

<style>
.select2-container {
    width: 100% !important;
}
.select2-container--default .select2-selection--single {
    height: 38px;
    border: 1px solid #ced4da;
    border-radius: 0.375rem;
}
.select2-container--default .select2-selection--single .select2-selection__rendered {
    line-height: 36px;
    padding-left: 12px;
}
</style>
{% endblock %}
