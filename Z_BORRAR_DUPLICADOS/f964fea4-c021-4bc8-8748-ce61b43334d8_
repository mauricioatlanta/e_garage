{% extends 'base.html' %}
{% load static %}

{% block extra_head %}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
<link href="/static/css/estilo_futurista.css" rel="stylesheet">

<style>
  body {
    background: linear-gradient(120deg, #0f2027 0%, #2c5364 50%, #7f00ff 100%);
    min-height: 100vh;
    font-family: 'Orbitron', 'Montserrat', Arial, sans-serif;
  }

  .documento-container {
    background: rgba(20, 20, 40, 0.97);
    border-radius: 1.5rem;
    box-shadow: 0 0 32px 4px #7f00ff99, 0 0 0 1px #00f2fe;
    border: 1px solid #7f00ff;
    color: #fff;
    padding: 2.5rem;
    margin: 2rem auto;
    max-width: 1200px;
    position: relative;
    overflow: hidden;
  }

  .documento-title {
    color: #00f2fe;
    text-shadow: 0 0 8px #7f00ff;
    font-size: 2.2rem;
    font-weight: bold;
    margin-bottom: 2rem;
    text-align: center;
  }

  .seccion-card {
    background: rgba(30, 30, 60, 0.8);
    border-radius: 1rem;
    padding: 1.5rem;
    margin-bottom: 2rem;
    border: 1px solid rgba(0, 242, 254, 0.3);
  }

  .seccion-title {
    color: #00f2fe;
    font-size: 1.3rem;
    font-weight: bold;
    margin-bottom: 1rem;
    text-shadow: 0 0 4px #7f00ff;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-group.full-width {
    grid-column: 1 / -1;
  }

  .form-label {
    color: #00f2fe;
    font-weight: bold;
    margin-bottom: 0.5rem;
    text-shadow: 0 0 2px #7f00ff;
  }

  .form-input {
    background: rgba(20, 20, 40, 0.95);
    border: 2px solid #00f2fe;
    border-radius: 0.5rem;
    color: #fff;
    padding: 0.75rem;
    font-size: 1rem;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 8px rgba(0, 242, 254, 0.2);
  }

  .form-input:focus {
    outline: none;
    border-color: #7f00ff;
    box-shadow: 0 0 12px #7f00ff, 0 2px 8px rgba(0, 242, 254, 0.3);
    background: rgba(30, 30, 50, 0.98);
  }

  .form-input::placeholder {
    color: #94a3b8;
    opacity: 0.8;
  }

  .form-select {
    background: rgba(20, 20, 40, 0.95) !important;
    border: 2px solid #00f2fe !important;
    border-radius: 0.5rem !important;
    color: #fff !important;
    padding: 0.75rem !important;
    font-size: 1rem !important;
    transition: all 0.3s ease !important;
    width: 100% !important;
    backdrop-filter: blur(10px) !important;
    box-shadow: 0 2px 8px rgba(0, 242, 254, 0.2) !important;
  }

  .form-select:focus {
    outline: none !important;
    border-color: #7f00ff !important;
    box-shadow: 0 0 12px #7f00ff, 0 2px 8px rgba(0, 242, 254, 0.3) !important;
    background: rgba(30, 30, 50, 0.98) !important;
  }

  .form-select option {
    background: #1a1a2e;
    color: #fff;
    padding: 0.5rem;
  }

  .form-select option:hover {
    background: #2a2a4e;
  }

  .form-control {
    background: rgba(20, 20, 40, 0.95) !important;
    border: 2px solid #00f2fe !important;
    border-radius: 0.5rem !important;
    color: #fff !important;
    padding: 0.75rem !important;
    font-size: 1rem !important;
    transition: all 0.3s ease !important;
    backdrop-filter: blur(10px) !important;
    box-shadow: 0 2px 8px rgba(0, 242, 254, 0.2) !important;
  }

  .form-control:focus {
    outline: none !important;
    border-color: #7f00ff !important;
    box-shadow: 0 0 12px #7f00ff, 0 2px 8px rgba(0, 242, 254, 0.3) !important;
    background: rgba(30, 30, 50, 0.98) !important;
  }

  .form-control::placeholder {
    color: #94a3b8 !important;
    opacity: 0.8 !important;
  }

  /* Estilos específicos para campos con clases Tailwind */
  input[type="text"].form-control,
  input[type="date"].form-control,
  input[type="number"].form-control,
  textarea.form-control {
    background: rgba(20, 20, 40, 0.95) !important;
    border: 2px solid #00f2fe !important;
    color: #fff !important;
  }

  select.form-select {
    background: rgba(20, 20, 40, 0.95) !important;
    border: 2px solid #00f2fe !important;
    color: #fff !important;
  }

  .btn-primary {
    background: linear-gradient(45deg, #7f00ff, #00f2fe);
    border: none;
    border-radius: 0.75rem;
    color: #fff;
    padding: 1rem 2rem;
    font-size: 1.1rem;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(127, 0, 255, 0.4);
  }

  .btn-secondary {
    background: rgba(108, 117, 125, 0.8);
    border: 1px solid #6c757d;
    border-radius: 0.5rem;
    color: #fff;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-secondary:hover {
    background: rgba(108, 117, 125, 1);
    transform: translateY(-1px);
  }

  .table-futurista {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
    background: rgba(20, 20, 40, 0.6);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .table-futurista th {
    background: linear-gradient(45deg, #7f00ff, #00f2fe);
    color: #fff;
    padding: 1rem;
    text-align: left;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .table-futurista td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(127, 0, 255, 0.3);
    color: #fff;
  }

  .table-futurista tr:hover {
    background: rgba(127, 0, 255, 0.1);
  }

  .input-number {
    text-align: right;
  }

  .total-row {
    background: rgba(127, 0, 255, 0.2) !important;
    font-weight: bold;
  }

  .total-row td {
    color: #00f2fe !important;
    font-size: 1.1rem;
    text-shadow: 0 0 4px #7f00ff;
  }

  .total-row td {
    border-top: 2px solid #00f2fe;
    color: #00f2fe;
    text-shadow: 0 0 4px #7f00ff;
  }

  .form-textarea {
    resize: vertical;
    min-height: 80px;
  }

  .autocomplete-container {
    position: relative;
  }

  .autocomplete-results {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(20, 20, 40, 0.98);
    border: 1px solid #00f2fe;
    border-radius: 0.5rem;
    max-height: 200px;
    overflow-y: auto;
    z-index: 1000;
    display: none;
    box-shadow: 0 4px 20px rgba(0, 242, 254, 0.3);
  }

  .autocomplete-item {
    padding: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .autocomplete-item:hover, .autocomplete-item.selected {
    background: rgba(127, 0, 255, 0.3);
  }

  .autocomplete-item:last-child {
    border-bottom: none;
  }

  .autocomplete-item-name {
    color: #00f2fe;
    font-weight: bold;
    margin-bottom: 0.25rem;
  }

  .autocomplete-item-details {
    color: #ccc;
    font-size: 0.9rem;
  }

  .autocomplete-item-precio {
    color: #00ff88;
    font-weight: bold;
    float: right;
  }

  .autocomplete-create {
    background: rgba(0, 255, 136, 0.2);
    border-top: 2px solid #00ff88;
    color: #00ff88;
    font-weight: bold;
    text-align: center;
  }

  .autocomplete-create:hover {
    background: rgba(0, 255, 136, 0.4);
  }

  .totales-section {
    background: rgba(0,0,0,0.5);
    border: 2px solid #00ffe7;
    border-radius: 1em;
    padding: 1.5em;
    margin: 1em 0;
  }

  .totales-row {
    display: flex;
    justify-content: space-between;
    margin: 0.5em 0;
    font-size: 1.1em;
  }

  .totales-total {
    border-top: 2px solid #00ffe7;
    padding-top: 0.5em;
    font-size: 1.3em;
    font-weight: bold;
  }

  input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: #00ffe7;
  }


  /* Temas dinámicos para tipos de documento */
  .theme-ot   {
    background: linear-gradient(135deg, #0f2027 0%, #203a43 50%, #2c5364 100%);
    border: 3px solid #22d3ee;
    box-shadow: 0 0 20px rgba(34, 211, 238, 0.3);
  }
  .theme-fac  {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
    border: 3px solid #a78bfa;
    box-shadow: 0 0 20px rgba(167, 139, 250, 0.3);
  }
  .theme-pres {
    background: linear-gradient(135deg, #102a43 0%, #243b53 50%, #1e3a8a 100%);
    border: 3px solid #34d399;
    box-shadow: 0 0 20px rgba(52, 211, 153, 0.3);
  }
</style>
{% endblock %}

{% block content %}
<div class="documento-container">
  <div style="position: fixed; top: 10px; left: 10px; z-index: 9999; background: red; color: white; padding: 10px; border-radius: 5px; font-weight: bold;">
    🔴 TEMPLATE BASE_DOCUMENTO CHILE CARGADO 🔴
  </div>

  {% block documento_title %}
  <div class="flex justify-between items-center">
    <h1 class="documento-title">📝 Crear Documento</h1>
    <label class="flex items-center text-cyan-200 font-semibold">
      <input type="checkbox" id="id_pagado" name="pagado" class="mr-2">
      Documento pagado
    </label>
  </div>
  {% endblock %}

  {% block documento_content %}
  <!-- Contenido del documento -->
  {% endblock %}
</div>
{% endblock %}
