{% extends "base.html" %}
{% load static i18n %}

{% block title %}⚙️ {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Centro de Configuración{% else %}Settings Center{% endif %} - eGarage{% endblock %}

{% block extra_css %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600;700&display=swap');
    
    :root {
        --neon-cyan: #00ffff;
        --neon-purple: #b026ff;
        --neon-pink: #ff00ff;
        --dark-bg: #0a0e27;
        --dark-card: #151932;
        --dark-border: #1e2447;
        --text-primary: #ffffff;
        --text-secondary: #a0aec0;
        --accent-glow: rgba(0, 255, 255, 0.3);
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(135deg, #0a0e27 0%, #1a1f3a 50%, #0f1629 100%);
        background-attachment: fixed;
        font-family: 'Rajdhani', sans-serif;
        color: var(--text-primary);
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
    }

    /* Animated background grid */
    body::before {
        content: '';
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: 
            linear-gradient(rgba(0, 255, 255, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(0, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 50px 50px;
        pointer-events: none;
        z-index: 0;
        animation: gridMove 20s linear infinite;
    }

    @keyframes gridMove {
        0% { transform: translate(0, 0); }
        100% { transform: translate(50px, 50px); }
    }

    /* Floating particles effect */
    .particles {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
        overflow: hidden;
    }

    .particle {
        position: absolute;
        width: 2px;
        height: 2px;
        background: var(--neon-cyan);
        border-radius: 50%;
        box-shadow: 0 0 6px var(--neon-cyan);
        animation: float 15s infinite;
        opacity: 0.6;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0) translateX(0); opacity: 0; }
        10% { opacity: 0.6; }
        90% { opacity: 0.6; }
        100% { transform: translateY(-100vh) translateX(100vw); opacity: 0; }
    }

    .settings-container {
        max-width: 1600px;
        margin: 0 auto;
        padding: 2rem;
        position: relative;
        z-index: 10;
    }

    /* Futuristic Header */
    .settings-header {
        background: linear-gradient(135deg, rgba(0, 255, 255, 0.1) 0%, rgba(176, 38, 255, 0.1) 100%);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(0, 255, 255, 0.3);
        border-radius: 20px;
        padding: 3rem;
        margin-bottom: 2rem;
        box-shadow: 
            0 8px 32px rgba(0, 0, 0, 0.3),
            0 0 40px rgba(0, 255, 255, 0.1),
            inset 0 0 60px rgba(176, 38, 255, 0.05);
        position: relative;
        overflow: hidden;
        animation: pulseGlow 3s ease-in-out infinite;
    }

    .settings-header::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(0, 255, 255, 0.1) 0%, transparent 70%);
        animation: rotate 20s linear infinite;
    }

    @keyframes rotate {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    @keyframes pulseGlow {
        0%, 100% { box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), 0 0 40px rgba(0, 255, 255, 0.1), inset 0 0 60px rgba(176, 38, 255, 0.05); }
        50% { box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3), 0 0 60px rgba(0, 255, 255, 0.2), inset 0 0 80px rgba(176, 38, 255, 0.1); }
    }

    .settings-header h1 {
        margin: 0;
        font-size: 3rem;
        font-weight: 900;
        font-family: 'Orbitron', sans-serif;
        background: linear-gradient(135deg, #00ffff 0%, #b026ff 50%, #ff00ff 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-shadow: 0 0 30px rgba(0, 255, 255, 0.5);
        position: relative;
        z-index: 2;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .settings-header p {
        margin: 1rem 0 0 0;
        color: var(--text-secondary);
        font-size: 1.2rem;
        font-weight: 400;
        position: relative;
        z-index: 2;
    }

    /* Navigation Tabs - Futuristic Style */
    .settings-nav {
        background: rgba(21, 25, 50, 0.6);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(0, 255, 255, 0.2);
        border-radius: 15px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    }

    .settings-nav .nav-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        border: none;
    }

    .settings-nav .nav-link {
        color: var(--text-secondary);
        font-weight: 600;
        font-size: 1rem;
        border-radius: 12px;
        padding: 1rem 1.5rem;
        transition: all 0.3s ease;
        margin: 0;
        border: 1px solid transparent;
        background: rgba(0, 255, 255, 0.05);
        position: relative;
        overflow: hidden;
        font-family: 'Rajdhani', sans-serif;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .settings-nav .nav-link::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.2), transparent);
        transition: left 0.5s;
    }

    .settings-nav .nav-link:hover::before {
        left: 100%;
    }

    .settings-nav .nav-link:hover {
        background: rgba(0, 255, 255, 0.1);
        border-color: rgba(0, 255, 255, 0.3);
        color: var(--neon-cyan);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(0, 255, 255, 0.2);
    }

    .settings-nav .nav-link.active {
        background: linear-gradient(135deg, rgba(0, 255, 255, 0.2) 0%, rgba(176, 38, 255, 0.2) 100%);
        border: 1px solid var(--neon-cyan);
        color: var(--text-primary);
        box-shadow: 
            0 0 20px rgba(0, 255, 255, 0.4),
            inset 0 0 20px rgba(176, 38, 255, 0.2);
    }

    .settings-nav .nav-link i {
        margin-right: 0.5rem;
        font-size: 1.1rem;
    }

    /* Form Sections - Glassmorphism */
    .form-section {
        background: rgba(21, 25, 50, 0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(0, 255, 255, 0.2);
        border-radius: 20px;
        padding: 2.5rem;
        margin-bottom: 2rem;
        box-shadow: 
            0 8px 32px rgba(0, 0, 0, 0.3),
            0 0 0 1px rgba(0, 255, 255, 0.1);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .form-section::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--neon-cyan), var(--neon-purple), var(--neon-pink));
        opacity: 0.6;
    }

    .form-section:hover {
        border-color: rgba(0, 255, 255, 0.4);
        box-shadow: 
            0 12px 40px rgba(0, 0, 0, 0.4),
            0 0 30px rgba(0, 255, 255, 0.2);
        transform: translateY(-2px);
    }

    .form-section h4 {
        color: var(--neon-cyan);
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        font-weight: 700;
        font-size: 1.5rem;
        font-family: 'Orbitron', sans-serif;
        padding-bottom: 1rem;
        border-bottom: 2px solid rgba(0, 255, 255, 0.2);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .form-section h4 i {
        font-size: 1.8rem;
        background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        filter: drop-shadow(0 0 10px rgba(0, 255, 255, 0.5));
    }

    /* Form Controls - Futuristic Inputs */
    .form-label {
        color: var(--text-primary);
        font-weight: 600;
        font-size: 1rem;
        margin-bottom: 0.75rem;
        display: block;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-family: 'Rajdhani', sans-serif;
    }

    .form-control,
    .form-select {
        background: rgba(10, 14, 39, 0.6);
        border: 1px solid rgba(0, 255, 255, 0.3);
        border-radius: 10px;
        padding: 0.875rem 1.25rem;
        color: var(--text-primary);
        font-size: 1rem;
        transition: all 0.3s ease;
        font-family: 'Rajdhani', sans-serif;
    }

    .form-control:focus,
    .form-select:focus {
        background: rgba(10, 14, 39, 0.8);
        border-color: var(--neon-cyan);
        box-shadow: 
            0 0 0 0.2rem rgba(0, 255, 255, 0.25),
            0 0 20px rgba(0, 255, 255, 0.3);
        outline: none;
        color: var(--text-primary);
    }

    .form-control::placeholder {
        color: rgba(160, 174, 192, 0.5);
    }

    .form-control-color {
        width: 100%;
        height: 60px;
        border-radius: 10px;
        cursor: pointer;
        border: 2px solid rgba(0, 255, 255, 0.3);
        transition: all 0.3s ease;
    }

    .form-control-color:hover {
        border-color: var(--neon-cyan);
        box-shadow: 0 0 20px rgba(0, 255, 255, 0.4);
        transform: scale(1.05);
    }

    /* Logo Preview - Futuristic */
    .logo-preview {
        max-width: 400px;
        max-height: 200px;
        border: 2px dashed rgba(0, 255, 255, 0.4);
        border-radius: 15px;
        padding: 2rem;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
        background: rgba(10, 14, 39, 0.4);
        margin-bottom: 1rem;
        position: relative;
        overflow: hidden;
    }

    .logo-preview::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: linear-gradient(45deg, transparent, rgba(0, 255, 255, 0.1), transparent);
        animation: shine 3s infinite;
    }

    @keyframes shine {
        0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
        100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
    }

    .logo-preview:hover {
        border-color: var(--neon-cyan);
        background: rgba(0, 255, 255, 0.1);
        box-shadow: 0 0 30px rgba(0, 255, 255, 0.3);
        transform: scale(1.02);
    }

    .logo-preview img {
        max-width: 100%;
        max-height: 150px;
        object-fit: contain;
        filter: drop-shadow(0 0 10px rgba(0, 255, 255, 0.5));
    }

    /* Buttons - Neon Style */
    .btn-save,
    .btn-primary {
        background: linear-gradient(135deg, rgba(0, 255, 255, 0.2) 0%, rgba(176, 38, 255, 0.2) 100%);
        border: 2px solid var(--neon-cyan);
        color: var(--text-primary);
        padding: 1rem 2.5rem;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-family: 'Rajdhani', sans-serif;
        position: relative;
        overflow: hidden;
        box-shadow: 0 0 20px rgba(0, 255, 255, 0.3);
    }

    .btn-save::before,
    .btn-primary::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.5s;
    }

    .btn-save:hover::before,
    .btn-primary:hover::before {
        left: 100%;
    }

    .btn-save:hover,
    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 
            0 8px 30px rgba(0, 255, 255, 0.5),
            0 0 40px rgba(176, 38, 255, 0.4);
        border-color: var(--neon-purple);
        background: linear-gradient(135deg, rgba(0, 255, 255, 0.3) 0%, rgba(176, 38, 255, 0.3) 100%);
    }

    .btn-secondary {
        background: rgba(160, 174, 192, 0.1);
        border: 2px solid rgba(160, 174, 192, 0.3);
        color: var(--text-secondary);
        padding: 1rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .btn-secondary:hover {
        background: rgba(160, 174, 192, 0.2);
        border-color: rgba(160, 174, 192, 0.5);
        color: var(--text-primary);
        transform: translateY(-2px);
    }

    /* Employees Section */
    .tecnicos-section {
        background: rgba(21, 25, 50, 0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(0, 255, 255, 0.2);
        border-radius: 20px;
        padding: 2.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }

    .form-tecnico {
        background: rgba(10, 14, 39, 0.5);
        border: 2px dashed rgba(0, 255, 255, 0.3);
        border-radius: 15px;
        padding: 2rem;
        margin-bottom: 2rem;
        transition: all 0.3s ease;
    }

    .form-tecnico:hover {
        border-color: var(--neon-cyan);
        background: rgba(0, 255, 255, 0.05);
        box-shadow: 0 0 30px rgba(0, 255, 255, 0.2);
    }

    .form-tecnico h5 {
        color: var(--neon-cyan);
        margin-bottom: 1.5rem;
        font-weight: 700;
        font-family: 'Orbitron', sans-serif;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .tecnico-card {
        background: rgba(10, 14, 39, 0.6);
        border: 1px solid rgba(0, 255, 255, 0.2);
        border-radius: 15px;
        padding: 1.5rem 2rem;
        margin-bottom: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .tecnico-card::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        background: linear-gradient(180deg, var(--neon-cyan), var(--neon-purple));
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .tecnico-card:hover::before {
        opacity: 1;
    }

    .tecnico-card:hover {
        border-color: rgba(0, 255, 255, 0.5);
        box-shadow: 0 4px 20px rgba(0, 255, 255, 0.3);
        transform: translateX(5px);
        background: rgba(10, 14, 39, 0.8);
    }

    .tecnico-card.inactive {
        opacity: 0.5;
        background: rgba(10, 14, 39, 0.3);
    }

    .tecnico-info h5 {
        margin: 0;
        color: var(--text-primary);
        font-weight: 700;
        font-size: 1.2rem;
        font-family: 'Rajdhani', sans-serif;
    }

    .tecnico-info p {
        margin: 0.5rem 0 0 0;
        color: var(--text-secondary);
        font-size: 0.95rem;
    }

    .tecnico-info i {
        color: var(--neon-cyan);
        margin-right: 0.5rem;
    }

    .badge-status {
        padding: 0.5rem 1.25rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-family: 'Rajdhani', sans-serif;
    }

    .badge-active {
        background: rgba(0, 255, 255, 0.2);
        color: var(--neon-cyan);
        border: 1px solid var(--neon-cyan);
        box-shadow: 0 0 15px rgba(0, 255, 255, 0.3);
    }

    .badge-inactive {
        background: rgba(160, 174, 192, 0.2);
        color: var(--text-secondary);
        border: 1px solid rgba(160, 174, 192, 0.3);
    }

    .btn-sm {
        padding: 0.5rem 1.25rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-warning {
        background: rgba(255, 193, 7, 0.2);
        border: 1px solid rgba(255, 193, 7, 0.5);
        color: #ffc107;
    }

    .btn-warning:hover {
        background: rgba(255, 193, 7, 0.3);
        border-color: #ffc107;
        box-shadow: 0 0 20px rgba(255, 193, 7, 0.4);
    }

    .btn-success {
        background: rgba(40, 167, 69, 0.2);
        border: 1px solid rgba(40, 167, 69, 0.5);
        color: #28a745;
    }

    .btn-success:hover {
        background: rgba(40, 167, 69, 0.3);
        border-color: #28a745;
        box-shadow: 0 0 20px rgba(40, 167, 69, 0.4);
    }

    /* Alerts */
    .alert-settings {
        border-radius: 15px;
        border: 1px solid;
        padding: 1.25rem 1.5rem;
        backdrop-filter: blur(10px);
        font-weight: 600;
    }

    .alert-success {
        background: rgba(40, 167, 69, 0.2);
        border-color: rgba(40, 167, 69, 0.5);
        color: #28a745;
        box-shadow: 0 0 20px rgba(40, 167, 69, 0.2);
    }

    .alert-error,
    .alert-danger {
        background: rgba(220, 53, 69, 0.2);
        border-color: rgba(220, 53, 69, 0.5);
        color: #dc3545;
        box-shadow: 0 0 20px rgba(220, 53, 69, 0.2);
    }

    .alert-info {
        background: rgba(0, 255, 255, 0.1);
        border-color: rgba(0, 255, 255, 0.3);
        color: var(--neon-cyan);
        box-shadow: 0 0 20px rgba(0, 255, 255, 0.2);
    }

    /* Form Check */
    .form-check-input {
        width: 1.5rem;
        height: 1.5rem;
        background: rgba(10, 14, 39, 0.6);
        border: 2px solid rgba(0, 255, 255, 0.3);
        border-radius: 5px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .form-check-input:checked {
        background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple));
        border-color: var(--neon-cyan);
        box-shadow: 0 0 15px rgba(0, 255, 255, 0.5);
    }

    .form-check-label {
        color: var(--text-primary);
        font-weight: 600;
        margin-left: 0.5rem;
        font-family: 'Rajdhani', sans-serif;
    }

    /* Stats Display */
    .stats-display {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
    }

    .stat-card {
        flex: 1;
        min-width: 200px;
        background: rgba(21, 25, 50, 0.6);
        border: 1px solid rgba(0, 255, 255, 0.2);
        border-radius: 15px;
        padding: 1.5rem;
        text-align: center;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        border-color: var(--neon-cyan);
        box-shadow: 0 0 25px rgba(0, 255, 255, 0.3);
        transform: translateY(-5px);
    }

    .stat-value {
        font-size: 2.5rem;
        font-weight: 900;
        font-family: 'Orbitron', sans-serif;
        background: linear-gradient(135deg, var(--neon-cyan), var(--neon-purple));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.5rem;
    }

    .stat-label {
        color: var(--text-secondary);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 0.9rem;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .settings-container {
            padding: 1rem 0.75rem;
        }

        .settings-header h1 {
            font-size: 1.75rem;
        }

        .settings-header p {
            font-size: 0.9rem;
        }

        .settings-nav {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .settings-nav .nav-link {
            font-size: 0.85rem;
            padding: 0.75rem 0.875rem;
            min-width: auto;
            white-space: nowrap;
        }

        .form-section {
            padding: 1.25rem 1rem;
        }

        .form-section h4 {
            font-size: 1.1rem;
        }

        .form-control,
        .form-select,
        textarea.form-control {
            padding: 0.875rem;
            min-height: 44px;
            font-size: 16px; /* Evita zoom en iOS */
        }

        .tecnico-card {
            flex-direction: column;
            align-items: flex-start;
            gap: 1rem;
            padding: 1rem;
        }

        .btn-save {
            width: 100%;
            padding: 1rem;
            min-height: 44px;
        }

        .logo-preview {
            min-height: 150px;
        }
    }

    @media (max-width: 480px) {
        .settings-container {
            padding: 0.75rem 0.5rem;
        }

        .settings-header h1 {
            font-size: 1.5rem;
        }

        .settings-nav .nav-link {
            font-size: 0.8rem;
            padding: 0.75rem 0.5rem;
        }

        .form-section {
            padding: 1rem 0.75rem;
        }

        .form-section h4 {
            font-size: 1rem;
        }

        .row {
            margin: 0;
        }

        .col-md-6,
        .col-md-8,
        .col-md-4 {
            padding: 0;
            margin-bottom: 1rem;
        }
    }

    /* Scrollbar Styling */
    ::-webkit-scrollbar {
        width: 10px;
    }

    ::-webkit-scrollbar-track {
        background: rgba(10, 14, 39, 0.5);
    }

    ::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, var(--neon-cyan), var(--neon-purple));
        border-radius: 5px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(180deg, var(--neon-purple), var(--neon-pink));
    }
</style>
{% endblock %}

{% block content %}
<!-- Floating Particles -->
<div class="particles" id="particles"></div>

<div class="settings-container">
    <!-- Futuristic Header -->
    <div class="settings-header">
        <h1>
            <i class="fas fa-cog"></i>
            {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Centro de Configuración{% else %}Settings Center{% endif %}
        </h1>
        <p>{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Panel de control avanzado para personalizar tu empresa{% else %}Advanced control panel to customize your company{% endif %}</p>
    </div>

    <!-- Messages -->
    {% if messages %}
        {% for message in messages %}
            <div class="alert alert-settings alert-{{ message.tags }} alert-dismissible fade show" role="alert">
                {% if message.tags == 'success' %}
                    <i class="fas fa-check-circle me-2"></i>
                {% else %}
                    <i class="fas fa-exclamation-triangle me-2"></i>
                {% endif %}
                {{ message }}
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endif %}

    <!-- Navigation Tabs -->
    <div class="settings-nav">
        <ul class="nav nav-pills" id="settingsTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="profile-tab" data-bs-toggle="pill" data-bs-target="#profile" type="button" role="tab">
                    <i class="fas fa-building"></i>{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Información de la Empresa{% else %}Company Information{% endif %}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tax-tab" data-bs-toggle="pill" data-bs-target="#tax" type="button" role="tab">
                    <i class="fas fa-receipt"></i>{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Impuestos y Finanzas{% else %}Taxes & Finance{% endif %}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="theme-tab" data-bs-toggle="pill" data-bs-target="#theme" type="button" role="tab">
                    <i class="fas fa-palette"></i>{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Tema y Colores{% else %}Theme & Colors{% endif %}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tecnicos-tab" data-bs-toggle="pill" data-bs-target="#tecnicos" type="button" role="tab">
                    <i class="fas fa-users"></i>{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Gestión de Empleados{% else %}Employee Management{% endif %}
                </button>
            </li>
        </ul>
    </div>

    <form method="post" enctype="multipart/form-data" id="settingsForm">
        {% csrf_token %}
        <input type="hidden" name="section" id="sectionInput" value="profile">

        <div class="tab-content" id="settingsTabsContent">
            <!-- Tab: Company Information -->
            <div class="tab-pane fade show active" id="profile" role="tabpanel">
                <!-- Name and Tagline -->
                <div class="form-section">
                    <h4>
                        <i class="fas fa-tag"></i>
                        {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Identidad de la Empresa{% else %}Company Identity{% endif %}
                    </h4>

                    <div class="row">
                        <div class="col-md-8 mb-4">
                            <label class="form-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Nombre de la Empresa *{% else %}Company Name *{% endif %}</label>
                            <input type="text" name="company_name" id="id_company_name" class="form-control" value="{{ config.company_name|default:'' }}" placeholder="{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Ingrese el nombre de su empresa{% else %}Enter your company name{% endif %}" required>
                            <small class="form-text text-muted" style="color: var(--text-secondary);">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Este nombre aparecerá en lugar de "eGarage" en toda la plataforma{% else %}This name will appear instead of "eGarage" throughout the platform{% endif %}</small>
                        </div>
                        <div class="col-md-4 mb-4">
                            <label class="form-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Eslogan / Lema{% else %}Tagline / Slogan{% endif %}</label>
                            <input type="text" name="tagline" id="id_tagline" class="form-control" value="{{ config.tagline|default:'' }}" placeholder="{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Su eslogan aquí{% else %}Your tagline here{% endif %}">
                        </div>
                    </div>
                </div>

                <!-- Logo -->
                <div class="form-section">
                    <h4>
                        <i class="fas fa-image"></i>
                        {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Logo de la Empresa{% else %}Company Logo{% endif %}
                    </h4>

                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Logo{% else %}Logo{% endif %}</label>
                            <div class="logo-preview" onclick="document.getElementById('id_logo').click()">
                                {% if config.logo %}
                                    <img src="{{ config.logo.url }}" alt="{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Logo actual{% else %}Current logo{% endif %}" id="logoPreview">
                                {% else %}
                                    <div id="logoPreview">
                                        <i class="fas fa-upload fa-3x" style="color: var(--neon-cyan); margin-bottom: 1rem;"></i>
                                        <p style="color: var(--text-secondary); margin: 0;">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Haga clic para subir logo{% else %}Click to upload logo{% endif %}</p>
                                    </div>
                                {% endif %}
                            </div>
                            <input type="file" name="logo" id="id_logo" accept="image/*" style="display: none;" onchange="previewLogo(this)">
                            <small class="form-text text-muted" style="color: var(--text-secondary);">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Formatos: PNG, JPG, JPEG, SVG, WEBP (máx. 2MB){% else %}Formats: PNG, JPG, JPEG, SVG, WEBP (max. 2MB){% endif %}</small>
                        </div>
                    </div>
                </div>

                <!-- Contact Information -->
                <div class="form-section">
                    <h4>
                        <i class="fas fa-phone"></i>
                        {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Información de Contacto{% else %}Contact Information{% endif %}
                    </h4>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Teléfono{% else %}Phone{% endif %}</label>
                            <input type="text" name="phone" id="id_phone" class="form-control" value="{{ config.phone|default:'' }}" placeholder="{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}+56 9 1234 5678{% else %}+1 555 123 4567{% endif %}">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Correo Electrónico{% else %}Email{% endif %}</label>
                            <input type="email" name="email" id="id_email" class="form-control" value="{{ config.email|default:'' }}" placeholder="{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}contacto@suempresa.com{% else %}contact@yourcompany.com{% endif %}">
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Sitio Web{% else %}Website{% endif %}</label>
                            <input type="url" name="website" id="id_website" class="form-control" value="{{ config.website|default:'' }}" placeholder="https://www.suempresa.com">
                        </div>
                    </div>
                </div>

                <!-- Address -->
                <div class="form-section">
                    <h4>
                        <i class="fas fa-map-marker-alt"></i>
                        {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Dirección{% else %}Address{% endif %}
                    </h4>

                    <div class="mb-3">
                        <label class="form-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Dirección Completa{% else %}Full Address{% endif %}</label>
                        <textarea name="address" id="id_address" class="form-control" rows="3" placeholder="{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Ingrese la dirección completa de su taller{% else %}Enter the complete address of your shop{% endif %}">{{ config.address|default:'' }}</textarea>
                    </div>
                </div>

                <!-- Fiscal Information -->
                <div class="form-section">
                    <h4>
                        <i class="fas fa-id-card"></i>
                        {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Información Fiscal{% else %}Fiscal Information{% endif %}
                    </h4>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}RUT / ID Fiscal{% else %}Tax ID / EIN{% endif %}</label>
                            <input type="text" name="tax_id" id="id_tax_id" class="form-control" value="{{ config.tax_id|default:'' }}" placeholder="{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}12.345.678-9{% else %}12-3456789{% endif %}">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Licencia Comercial{% else %}Business License{% endif %}</label>
                            <input type="text" name="business_license" id="id_business_license" class="form-control" value="{{ config.business_license|default:'' }}" placeholder="{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Licencia comercial o registro{% else %}Business license or registration{% endif %}">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab: Taxes & Finance -->
            <div class="tab-pane fade" id="tax" role="tabpanel">
                <div class="form-section">
                    <h4>
                        <i class="fas fa-receipt"></i>
                        {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Configuración de Impuestos{% else %}Tax Configuration{% endif %}
                    </h4>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Moneda{% else %}Currency{% endif %}</label>
                            <select name="currency" id="id_currency" class="form-select">
                                <option value="CLP" {% if config.currency == 'CLP' %}selected{% endif %}>{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Peso Chileno (CLP){% else %}Chilean Peso (CLP){% endif %}</option>
                                <option value="USD" {% if config.currency == 'USD' %}selected{% endif %}>{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Dólar Estadounidense (USD){% else %}US Dollar (USD){% endif %}</option>
                                <option value="EUR" {% if config.currency == 'EUR' %}selected{% endif %}>{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Euro (EUR){% else %}Euro (EUR){% endif %}</option>
                                <option value="MXN" {% if config.currency == 'MXN' %}selected{% endif %}>{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Peso Mexicano (MXN){% else %}Mexican Peso (MXN){% endif %}</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Tasa de Impuesto (%){% else %}Tax Rate (%){% endif %}</label>
                            <input type="number" name="tax_rate" id="id_tax_rate" class="form-control" step="0.01" min="0" max="100" value="{{ config.tax_rate|default:19.00 }}" placeholder="19.00">
                            <small class="form-text text-muted" style="color: var(--text-secondary);">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Ej: 19.00 para Chile, 0.00 para USA{% else %}E.g: 19.00 for Chile, 0.00 for USA{% endif %}</small>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="form-check mt-4">
                                <input type="checkbox" name="apply_tax_by_default" id="id_apply_tax_by_default" class="form-check-input" {% if config.apply_tax_by_default %}checked{% endif %}>
                                <label class="form-check-label" for="id_apply_tax_by_default">
                                    {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Aplicar impuesto por defecto{% else %}Apply tax by default{% endif %}
                                </label>
                            </div>
                            <small class="form-text text-muted" style="color: var(--text-secondary);">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Aplicar automáticamente el impuesto a nuevos documentos{% else %}Automatically apply tax to new documents{% endif %}</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab: Theme & Colors -->
            <div class="tab-pane fade" id="theme" role="tabpanel">
                <div class="form-section">
                    <h4>
                        <i class="fas fa-palette"></i>
                        {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Personalización de Colores{% else %}Color Customization{% endif %}
                    </h4>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Color Principal{% else %}Primary Color{% endif %}</label>
                            <input type="color" name="primary_color" id="id_primary_color" class="form-control form-control-color" value="{{ config.primary_color|default:'#0d6efd' }}">
                            <small class="form-text text-muted" style="color: var(--text-secondary);">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Color principal del tema{% else %}Main theme color{% endif %}</small>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Color Secundario{% else %}Secondary Color{% endif %}</label>
                            <input type="color" name="secondary_color" id="id_secondary_color" class="form-control form-control-color" value="{{ config.secondary_color|default:'#6c757d' }}">
                            <small class="form-text text-muted" style="color: var(--text-secondary);">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Color secundario del tema{% else %}Secondary theme color{% endif %}</small>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h4>
                        <i class="fas fa-cog"></i>
                        {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Configuración Adicional{% else %}Additional Settings{% endif %}
                    </h4>

                    <div class="form-check mb-3">
                        <input type="checkbox" name="separate_by_technician" id="id_separate_by_technician" class="form-check-input" {% if config.separate_by_technician %}checked{% endif %}>
                        <label class="form-check-label" for="id_separate_by_technician">
                            {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Separar reportes por técnico{% else %}Separate reports by technician{% endif %}
                        </label>
                        <small class="form-text text-muted d-block" style="color: var(--text-secondary);">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Mostrar reportes separados por técnico{% else %}Show reports separated by technician{% endif %}</small>
                    </div>
                </div>
            </div>

            <!-- Tab: Employees -->
            <div class="tab-pane fade" id="tecnicos" role="tabpanel">
                <div class="tecnicos-section">
                    <h4>
                        <i class="fas fa-users"></i>
                        {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Gestión de Empleados{% else %}Employee Management{% endif %}
                    </h4>

                    <!-- Stats -->
                    {% if tecnicos %}
                    <div class="stats-display mb-4">
                        <div class="stat-card">
                            <div class="stat-value">{{ tecnicos|length }}</div>
                            <div class="stat-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Total Empleados{% else %}Total Employees{% endif %}</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-value">{{ tecnicos|length|add:"-1"|add:"1" }}</div>
                            <div class="stat-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Empleados Activos{% else %}Active Employees{% endif %}</div>
                        </div>
                    </div>
                    {% endif %}

                    <!-- Form to create employee -->
                    <div class="form-tecnico">
                        <h5>
                            <i class="fas fa-user-plus me-2"></i>
                            {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Agregar Nuevo Empleado{% else %}Add New Employee{% endif %}
                        </h5>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Nombre Completo *{% else %}Full Name *{% endif %}</label>
                                <input type="text" name="nombre" id="id_tecnico_nombre" class="form-control" placeholder="{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Nombre del empleado{% else %}Employee name{% endif %}" required>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Teléfono{% else %}Phone{% endif %}</label>
                                <input type="text" name="telefono" id="id_tecnico_telefono" class="form-control" placeholder="{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}+56 9 1234 5678{% else %}+1 555 123 4567{% endif %}">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Dirección{% else %}Address{% endif %}</label>
                                <input type="text" name="direccion" id="id_tecnico_direccion" class="form-control" placeholder="{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Dirección del empleado{% else %}Employee address{% endif %}">
                            </div>
                        </div>
                        <button type="submit" name="crear_tecnico" class="btn btn-save">
                            <i class="fas fa-plus me-2"></i>{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Agregar Empleado{% else %}Add Employee{% endif %}
                        </button>
                    </div>

                    <!-- Employee List -->
                    {% if tecnicos %}
                        <h5 class="mb-3" style="color: var(--neon-cyan); font-family: 'Orbitron', sans-serif; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">
                            <i class="fas fa-list me-2"></i>
                            {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Empleados Registrados ({{ tecnicos|length }}){% else %}Registered Employees ({{ tecnicos|length }}){% endif %}
                        </h5>
                        {% for tecnico in tecnicos %}
                            <div class="tecnico-card {% if not tecnico.activo %}inactive{% endif %}">
                                <div class="tecnico-info">
                                    <h5>{{ tecnico.nombre }}</h5>
                                    {% if tecnico.telefono %}
                                        <p><i class="fas fa-phone"></i>{{ tecnico.telefono }}</p>
                                    {% endif %}
                                    {% if tecnico.direccion %}
                                        <p><i class="fas fa-map-marker-alt"></i>{{ tecnico.direccion }}</p>
                                    {% endif %}
                                </div>
                                <div class="tecnico-status">
                                    <span class="badge-status {% if tecnico.activo %}badge-active{% else %}badge-inactive{% endif %}">
                                        {% if tecnico.activo %}
                                            <i class="fas fa-check-circle me-1"></i>{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Activo{% else %}Active{% endif %}
                                        {% else %}
                                            <i class="fas fa-times-circle me-1"></i>{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Inactivo{% else %}Inactive{% endif %}
                                        {% endif %}
                                    </span>
                                    <form method="post" style="display: inline;">
                                        {% csrf_token %}
                                        <input type="hidden" name="toggle_tecnico" value="{{ tecnico.id }}">
                                        <button type="submit" class="btn btn-sm {% if tecnico.activo %}btn-warning{% else %}btn-success{% endif %}">
                                            {% if tecnico.activo %}
                                                <i class="fas fa-ban me-1"></i>{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Desactivar{% else %}Deactivate{% endif %}
                                            {% else %}
                                                <i class="fas fa-check me-1"></i>{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Activar{% else %}Activate{% endif %}
                                            {% endif %}
                                        </button>
                                    </form>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}No hay empleados registrados. Agregue uno usando el formulario de arriba.{% else %}No employees registered. Add one using the form above.{% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="form-section">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <button type="submit" class="btn btn-save" id="saveBtn">
                        <i class="fas fa-save me-2"></i>{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Guardar Configuración{% else %}Save Settings{% endif %}
                    </button>
                    <a href="{% url 'taller:dashboard' %}" class="btn btn-secondary ms-2">
                        <i class="fas fa-times me-2"></i>{% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Cancelar{% else %}Cancel{% endif %}
                    </a>
                </div>
                <div style="color: var(--text-secondary);">
                    <small>
                        <i class="fas fa-clock me-1"></i>
                        {% if request.path|slice:':3' == '/cl' or request.path|slice:':4' == '/cl/' or empresa_pais|default:'CL' == 'CL' %}Última actualización:{% else %}Last updated:{% endif %} {{ config.updated_at|date:"m/d/Y H:i" }}
                    </small>
                </div>
            </div>
        </div>
    </form>
</div>
{% endblock %}

{% block extra_js %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Create floating particles
    const particlesContainer = document.getElementById('particles');
    const particleCount = 50;
    
    for (let i = 0; i < particleCount; i++) {
        const particle = document.createElement('div');
        particle.className = 'particle';
        particle.style.left = Math.random() * 100 + '%';
        particle.style.top = Math.random() * 100 + '%';
        particle.style.animationDelay = Math.random() * 15 + 's';
        particle.style.animationDuration = (10 + Math.random() * 10) + 's';
        particlesContainer.appendChild(particle);
    }

    // Update section input when tab changes
    const tabs = document.querySelectorAll('[data-bs-toggle="pill"]');
    const sectionMapping = {
        'profile': 'profile',
        'tax': 'financial',
        'theme': 'theme',
        'tecnicos': 'profile'
    };
    
    tabs.forEach(tab => {
        tab.addEventListener('shown.bs.tab', function(e) {
            const targetId = e.target.getAttribute('data-bs-target').replace('#', '');
            const section = sectionMapping[targetId] || 'profile';
            document.getElementById('sectionInput').value = section;
        });
    });

    // Logo preview
    function previewLogo(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const preview = document.getElementById('logoPreview');
                preview.innerHTML = '<img src="' + e.target.result + '" alt="Logo preview">';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Make previewLogo global
    window.previewLogo = previewLogo;

    // Real-time color updates
    const primaryColor = document.getElementById('id_primary_color');
    const secondaryColor = document.getElementById('id_secondary_color');
    
    if (primaryColor) {
        primaryColor.addEventListener('change', function() {
            document.documentElement.style.setProperty('--bs-primary', this.value);
        });
    }
    
    if (secondaryColor) {
        secondaryColor.addEventListener('change', function() {
            document.documentElement.style.setProperty('--bs-secondary', this.value);
        });
    }

    // Update section before form submit
    const form = document.getElementById('settingsForm');
    form.addEventListener('submit', function(e) {
        if (e.submitter && (e.submitter.name === 'crear_tecnico' || e.submitter.closest('form') && e.submitter.closest('form').querySelector('[name="toggle_tecnico"]'))) {
            return;
        }
        
        const activeTab = document.querySelector('.nav-link.active');
        if (activeTab) {
            const targetId = activeTab.getAttribute('data-bs-target').replace('#', '');
            const section = sectionMapping[targetId] || 'profile';
            document.getElementById('sectionInput').value = section;
        }
    });

    // Add smooth scroll behavior
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }
        });
    });
});
</script>
{% endblock %}
