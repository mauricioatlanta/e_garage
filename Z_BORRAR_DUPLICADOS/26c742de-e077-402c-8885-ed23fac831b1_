{% extends "base.html" %}
{% load country_url %}
{% load static %}

{% block content %}
<!-- 🔴 MARCADOR ROJO OSCURO: TEMPLATE TALLER VEHICULO_LIST.HTML -->
<div style="position: fixed; top: 10px; right: 10px; z-index: 99999; background: darkred; color: white; padding: 10px; border-radius: 5px; font-weight: bold;">🔴 TALLER</div>
<div class="min-h-screen bg-gradient-to-br from-[#0f2027] via-[#2c5364] to-[#1a2980] relative overflow-hidden">
  <!-- Efectos de fondo futuristas -->
  <div class="absolute inset-0">
    <div class="absolute top-0 left-0 w-full h-full bg-[url('data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%2300ffe7" fill-opacity="0.05"%3E%3Ccircle cx="30" cy="30" r="1"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-30"></div>
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl animate-pulse delay-1000"></div>
    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-purple-500/5 rounded-full blur-2xl animate-pulse delay-500"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 py-8">
    <!-- Header futurista -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center space-x-4 mb-6">
        <div class="w-16 h-16 bg-gradient-to-r from-cyan-400 to-blue-500 rounded-full flex items-center justify-center animate-pulse">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
        </div>
        <h1 class="text-6xl font-black bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-600 bg-clip-text text-transparent">
          Flota Vehicular
        </h1>
      </div>
      <div class="text-cyan-300 text-xl font-light tracking-wider mb-8">
        Sistema de Gestión Inteligente • {{ object_list.count }} vehículos registrados
      </div>
    </div>

    <!-- Barra de acciones -->
    <div class="flex flex-col sm:flex-row justify-between items-center mb-8 space-y-4 sm:space-y-0">
      <!-- Búsqueda futurista -->
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="h-5 w-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input type="text" id="searchInput" placeholder="Buscar vehículos..."
               class="pl-10 pr-4 py-3 bg-black/40 border border-cyan-400/30 rounded-2xl text-white placeholder-cyan-300/50 focus:outline-none focus:ring-2 focus:ring-cyan-400 focus:border-transparent backdrop-blur-sm w-80">
      </div>

      <!-- Botón de agregar -->
      <a href="{% country_url 'vehiculos:crear_vehiculo' %}"
         class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold rounded-2xl transition-all duration-300 transform hover:scale-105 shadow-lg group">
        <svg class="w-6 h-6 mr-3 group-hover:rotate-90 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        Agregar Vehículo
      </a>
    </div>

    {% if object_list %}
    <!-- Tabla futurista -->
    <div class="bg-black/40 backdrop-blur-xl rounded-3xl border border-cyan-400/30 shadow-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full">
          <thead class="bg-gradient-to-r from-cyan-900/50 to-blue-900/50">
            <tr>
              <th class="px-8 py-6 text-left text-sm font-bold text-cyan-300 uppercase tracking-wider">
                <div class="flex items-center space-x-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                  </svg>
                  <span>Patente</span>
                </div>
              </th>
              <th class="px-8 py-6 text-left text-sm font-bold text-cyan-300 uppercase tracking-wider">
                <div class="flex items-center space-x-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                  </svg>
                  <span>Vehículo</span>
                </div>
              </th>
              <th class="px-8 py-6 text-left text-sm font-bold text-cyan-300 uppercase tracking-wider">
                <div class="flex items-center space-x-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                  </svg>
                  <span>Propietario</span>
                </div>
              </th>
              <th class="px-8 py-6 text-left text-sm font-bold text-cyan-300 uppercase tracking-wider">
                <div class="flex items-center space-x-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                  <span>Acciones</span>
                </div>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-cyan-700/30">
            {% for vehiculo in object_list %}
            <tr class="hover:bg-cyan-900/20 transition-all duration-300 group">
              <td class="px-8 py-6">
                <div class="flex items-center">
                  <div class="w-12 h-12 bg-gradient-to-r from-cyan-500 to-blue-600 rounded-xl flex items-center justify-center mr-4 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                    </svg>
                  </div>
                  <div>
                    <div class="text-lg font-bold text-white">{{ vehiculo.patente|default:"-" }}</div>
                    <div class="text-sm text-cyan-300">{{ vehiculo.anio|default:"-" }}</div>
                  </div>
                </div>
              </td>
              <td class="px-8 py-6">
                <div>
                  <div class="text-lg font-semibold text-white">{{ vehiculo.marca.nombre|default:"-" }} {{ vehiculo.modelo.nombre|default:"-" }}</div>
                  <div class="text-sm text-gray-400">{{ vehiculo.color.nombre|default:"-" }}</div>
                  {% if vehiculo.vin %}
                  <div class="text-xs text-cyan-400 font-mono mt-1">{{ vehiculo.vin|truncatechars:15 }}</div>
                  {% endif %}
                </div>
              </td>
              <td class="px-8 py-6">
                {% if vehiculo.cliente %}
                <div class="flex items-center">
                  <div class="w-10 h-10 bg-gradient-to-r from-purple-500 to-pink-600 rounded-full flex items-center justify-center mr-3">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                  </div>
                  <div>
                    <div class="text-white font-semibold">{{ vehiculo.cliente.nombre }} {{ vehiculo.cliente.apellido }}</div>
                    <div class="text-sm text-cyan-300">{{ vehiculo.cliente.email|default:"" }}</div>
                  </div>
                </div>
                {% else %}
                <div class="text-gray-500 italic">Sin propietario</div>
                {% endif %}
              </td>
              <td class="px-8 py-6">
                <div class="flex space-x-3">
                  <a href="{% url 'taller:vehiculos:ver_vehiculo' vehiculo.pk %}"
                     class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-cyan-600 to-cyan-700 hover:from-cyan-500 hover:to-cyan-600 text-white text-sm font-semibold rounded-xl transition-all duration-300 transform hover:scale-105 group">
                    <svg class="w-4 h-4 mr-2 group-hover:rotate-12 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                    Ver
                  </a>
                  <a href="{% url 'taller:vehiculos:editar_vehiculo' vehiculo.pk %}"
                     class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-500 hover:to-blue-600 text-white text-sm font-semibold rounded-xl transition-all duration-300 transform hover:scale-105 group">
                    <svg class="w-4 h-4 mr-2 group-hover:rotate-12 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                    Editar
                  </a>
                </div>
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Estadísticas -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-4 gap-6">
      <div class="bg-gradient-to-r from-cyan-900/30 to-cyan-800/30 rounded-2xl p-6 border border-cyan-400/30 backdrop-blur-sm">
        <div class="flex items-center">
          <div class="w-12 h-12 bg-cyan-500/20 rounded-xl flex items-center justify-center mr-4">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
          </div>
          <div>
            <div class="text-2xl font-bold text-white">{{ object_list.count }}</div>
            <div class="text-sm text-cyan-300">Total Vehículos</div>
          </div>
        </div>
      </div>

      <div class="bg-gradient-to-r from-blue-900/30 to-blue-800/30 rounded-2xl p-6 border border-blue-400/30 backdrop-blur-sm">
        <div class="flex items-center">
          <div class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center mr-4">
            <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <div>
            <div class="text-2xl font-bold text-white">{{ object_list.count }}</div>
            <div class="text-sm text-blue-300">Clientes Activos</div>
          </div>
        </div>
      </div>

      <div class="bg-gradient-to-r from-purple-900/30 to-purple-800/30 rounded-2xl p-6 border border-purple-400/30 backdrop-blur-sm">
        <div class="flex items-center">
          <div class="w-12 h-12 bg-purple-500/20 rounded-xl flex items-center justify-center mr-4">
            <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <div>
            <div class="text-2xl font-bold text-white">{{ object_list.count }}</div>
            <div class="text-sm text-purple-300">Marcas Únicas</div>
          </div>
        </div>
      </div>

      <div class="bg-gradient-to-r from-green-900/30 to-green-800/30 rounded-2xl p-6 border border-green-400/30 backdrop-blur-sm">
        <div class="flex items-center">
          <div class="w-12 h-12 bg-green-500/20 rounded-xl flex items-center justify-center mr-4">
            <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <div>
            <div class="text-2xl font-bold text-white">100%</div>
            <div class="text-sm text-green-300">Sistema Activo</div>
          </div>
        </div>
      </div>
    </div>

    {% else %}
    <!-- Estado vacío futurista -->
    <div class="text-center py-16">
      <div class="w-32 h-32 bg-gradient-to-r from-cyan-500/20 to-blue-500/20 rounded-full flex items-center justify-center mx-auto mb-8 animate-pulse">
        <svg class="w-16 h-16 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
        </svg>
      </div>
      <h3 class="text-3xl font-bold text-white mb-4">Flota Vacía</h3>
      <p class="text-cyan-300 text-lg mb-8">No hay vehículos registrados en el sistema</p>
      <a href="{% country_url 'vehiculos:crear_vehiculo' %}"
         class="inline-flex items-center px-8 py-4 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold rounded-2xl transition-all duration-300 transform hover:scale-105 shadow-lg">
        <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
        </svg>
        Agregar Primer Vehículo
      </a>
    </div>
    {% endif %}
  </div>
</div>

<script>
// Búsqueda en tiempo real
document.getElementById('searchInput').addEventListener('input', function() {
  const searchTerm = this.value.toLowerCase();
  const rows = document.querySelectorAll('tbody tr');

  rows.forEach(row => {
    const text = row.textContent.toLowerCase();
    if (text.includes(searchTerm)) {
      row.style.display = '';
      row.classList.add('animate-pulse');
      setTimeout(() => row.classList.remove('animate-pulse'), 500);
    } else {
      row.style.display = 'none';
    }
  });
});

// Efectos de hover mejorados
document.querySelectorAll('tbody tr').forEach(row => {
  row.addEventListener('mouseenter', function() {
    this.style.transform = 'scale(1.02)';
    this.style.boxShadow = '0 20px 40px rgba(0, 255, 231, 0.1)';
  });

  row.addEventListener('mouseleave', function() {
    this.style.transform = 'scale(1)';
    this.style.boxShadow = 'none';
  });
});
</script>
{% endblock %}
