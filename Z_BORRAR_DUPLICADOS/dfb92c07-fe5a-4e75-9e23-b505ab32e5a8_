{% load static %}

<!-- Template helper para assets estáticos canónicos post-limpieza -->
<!-- Usar en templates que necesiten cargar dependencias en orden correcto -->

<!-- CSS Principal -->
<link rel="stylesheet" href="{% static 'taller/common/css/app.min.css' %}">

<!-- Vendor CSS (Select2) -->
<link rel="stylesheet" href="{% static 'vendor/dist/css/select2.min.css' %}">

<!-- Vendor JS (orden correcto) -->
<script src="{% static 'vendor/jquery/jquery-3.6.0.min.js' %}"></script>
<script src="{% static 'vendor/dist/js/jquery-ui.min.js' %}"></script>
<script src="{% static 'vendor/dist/js/select2.min.js' %}"></script>

<!-- Autocomplete Light -->
<script src="{% static 'autocomplete_light_custom/autocomplete.init.js' %}"></script>

<!-- JS de la aplicación -->
<script src="{% static 'taller/common/js/documentos_form.js' %}" defer></script>

<!-- JS runtime (cargar según necesidad) -->
{% if load_app_js %}
<script src="{% static 'taller/js/App.js' %}" defer></script>
{% endif %}

{% if load_es_locale %}
<script src="{% static 'taller/js/es.js' %}" defer></script>
{% endif %}

{% if load_ubicacion_js %}
<script src="{% static 'taller/js/ubicacion.js' %}" defer></script>
{% endif %}

<!-- Video de fondo (opcional) -->
{% if load_background_video %}
  {% include 'taller/common/background_video.html' %}
{% endif %}
