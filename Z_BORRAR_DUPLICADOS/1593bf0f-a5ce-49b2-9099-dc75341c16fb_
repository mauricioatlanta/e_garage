                    <p style="color: #00ccee; margin: 0;">{% if LANGUAGE_CODE == 'en' or request.path|slice:':3' == '/us' %}Modify document information{% else %}Modificar información del documento{% endif %}</p>
                {% else %}
                    <h1 class="mb-2">
                        <i class="fas fa-plus-circle"></i>
                        ➕ {% if LANGUAGE_CODE == 'en' or request.path|slice:':3' == '/us' %}New Document{% else %}Nuevo Documento{% endif %}
                    </h1>
                    <p style="color: #00ccee; margin: 0;">{% if LANGUAGE_CODE == 'en' or request.path|slice:':3' == '/us' %}Complete the document information{% else %}Complete la información del documento{% endif %}</p>
                {% endif %}
            </div>
            <div class="d-flex align-items-center gap-3">
            {% if es_edicion %}
                <span id="badge-pago" class="badge badge-pagado {% if documento.pagado %}badge-pagado-si{% else %}badge-no-pagado{% endif %}">
                    {% if documento.pagado %}{% if LANGUAGE_CODE == 'en' or request.path|slice:':3' == '/us' %}✅ Paid{% else %}✅ Pagado{% endif %}{% else %}{% if LANGUAGE_CODE == 'en' or request.path|slice:':3' == '/us' %}❌ Not Paid{% else %}❌ No Pagado{% endif %}{% endif %}
                </span>
            {% endif %}
            <a href="{% country_url 'documentos:lista_documentos' %}" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> {% if LANGUAGE_CODE == 'en' or request.path|slice:':3' == '/us' %}Back{% else %}Volver{% endif %}
            </a>
            </div>
        </div>
    </div>

    <!-- Mensajes -->
    {% if messages %}
        {% for message in messages %}
        <div class="alert alert-{{ message.tags }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        {% endfor %}
    {% endif %}

    <!-- Formulario -->
    <form method="post" id="documentoForm">
        {% csrf_token %}

        <div class="row">
            <!-- Información del Documento -->
            <div class="col-lg-6">
                <div class="form-section">
                    <h3><i class="fas fa-file-alt text-primary"></i> {% if LANGUAGE_CODE == 'en' or request.path|slice:':3' == '/us' %}Document Information{% else %}Información del Documento{% endif %}</h3>

