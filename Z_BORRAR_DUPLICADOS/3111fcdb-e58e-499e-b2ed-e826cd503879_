                    })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Agregar el nuevo modelo al select
                        const option = document.createElement('option');
                        option.value = data.modelo_id;
                        option.textContent = nombreModelo;
                        option.selected = true;
                        modeloSelect.appendChild(option);

                        // Limpiar y ocultar formulario
                        nuevoModelo.value = '';
                        formCrearModelo.classList.add('hidden');

                        console.log('Modelo creado:', nombreModelo);
                    } else {
                        alert('Error al crear el modelo: ' + (data.error || 'Error desconocido'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error al crear el modelo');
                });
            });
        }
    });

    // Función para buscar clientes
    function buscarClientes(query) {
        if (query.length < 2) {
            sugerenciasContainer.classList.add('hidden');
            return;
        }

        loadingCliente.classList.remove('hidden');

        // Simular llamada AJAX - reemplazar con endpoint real
        fetch(`{% country_url 'clientes:ajax_buscar_clientes' %}?q=${encodeURIComponent(query)}`, {
            method: 'GET',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/json',
            }
        })
        .then(response => response.json())
        .then(data => {
            loadingCliente.classList.add('hidden');
            // Formatear los datos para mostrar nombre completo
            const clientesFormateados = data.map(cliente => ({
                id: cliente.id,
                nombre: `${cliente.nombre} ${cliente.apellido}`.trim(),
                email: cliente.email,
                telefono: cliente.telefono
            }));
            mostrarSugerencias(clientesFormateados);
        })
        .catch(error => {
            console.error('Error en búsqueda:', error);
            loadingCliente.classList.add('hidden');
            // Fallback - mostrar datos simulados
            const clientesSimulados = [
                {id: 1, nombre: 'Juan Pérez', email: 'juan@example.com', telefono: '+56912345678'},
                {id: 2, nombre: 'María González', email: 'maria@example.com', telefono: '+56987654321'},
                {id: 3, nombre: 'Carlos Silva', email: 'carlos@example.com', telefono: '+56911223344'}
            ].filter(c => c.nombre.toLowerCase().includes(query.toLowerCase()));

            mostrarSugerencias(clientesSimulados);
        });
    }

    // Función para mostrar sugerencias
    function mostrarSugerencias(clientes) {
        if (clientes.length === 0) {
            sugerenciasContainer.innerHTML = `
                <div class="bg-gradient-to-r from-[#0d1117] to-[#111827] border border-cyan-400/40 rounded-lg shadow-2xl shadow-cyan-500/20">
                    <div class="p-4 text-center text-gray-400">
                        <div class="w-12 h-12 mx-auto mb-2 rounded-full bg-gradient-to-br from-gray-500/20 to-gray-600/20 border border-gray-400/30 flex items-center justify-center">
                            🔍
                        </div>
                        <p class="text-sm">{% trans 'No se encontraron clientes' %}</p>
                        <p class="text-xs mt-1">{% trans 'Intenta con otro término de búsqueda' %}</p>
                    </div>
                </div>
            `;
            sugerenciasContainer.classList.remove('hidden');
            return;
        }

        const sugerenciasHTML = clientes.map(cliente => `
            <div class="sugerencia-item" data-cliente-id="${cliente.id}" data-cliente-nombre="${cliente.nombre}" data-cliente-info="${cliente.email || ''} ${cliente.telefono || ''}">
                <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-500/30 to-blue-500/30 border border-cyan-400/40 flex items-center justify-center">
                        <span class="text-cyan-300 text-sm">👤</span>
                    </div>
                    <div class="flex-1">
                        <div class="sugerencia-nombre">${cliente.nombre}</div>
                        <div class="sugerencia-info">
                            ${cliente.email ? `📧 ${cliente.email}` : ''}
                            ${cliente.telefono ? `📱 ${cliente.telefono}` : ''}
                        </div>
                    </div>
                    <div class="text-cyan-400 text-xs font-mono">#${cliente.id}</div>
                </div>
            </div>
        `).join('');

        sugerenciasContainer.innerHTML = `
            <div class="bg-gradient-to-r from-[#0d1117] to-[#111827] border border-cyan-400/40 rounded-lg shadow-2xl shadow-cyan-500/20 max-h-60 overflow-y-auto">
                ${sugerenciasHTML}
            </div>
        `;

        sugerenciasContainer.classList.remove('hidden');

        // Agregar eventos de click a las sugerencias
        document.querySelectorAll('.sugerencia-item').forEach(item => {
            item.addEventListener('click', function() {
                seleccionarCliente(
                    this.dataset.clienteId,
                    this.dataset.clienteNombre,
                    this.dataset.clienteInfo
                );
            });
        });
    }

    // Función para seleccionar un cliente
    function seleccionarCliente(id, nombre, info) {
        clienteActual = {id, nombre, info};

        // Establecer el valor en el select oculto
        if (clienteInput) {
            console.log('Estableciendo valor del cliente:', id, 'en campo:', clienteInput);
            clienteInput.value = id;
            console.log('Valor después de establecer:', clienteInput.value);
        } else {
            console.error('No se encontró el campo cliente input');
        }

        // Actualizar la visualización
        busquedaCliente.value = '';
        clienteNombre.textContent = nombre;
        clienteInfo.textContent = info;
        clienteSeleccionado.classList.remove('hidden');
        sugerenciasContainer.classList.add('hidden');

        // Mostrar información adicional del cliente
        mostrarInfoClienteAdicional(id, nombre, info);

        // Efecto visual de confirmación
        clienteSeleccionado.style.transform = 'scale(0.95)';
        clienteSeleccionado.style.transition = 'transform 0.2s ease';
        setTimeout(() => {
            clienteSeleccionado.style.transform = 'scale(1)';
        }, 100);
    }

    // Función para mostrar información adicional del cliente
    function mostrarInfoClienteAdicional(id, nombre, info) {
        const infoAdicional = document.getElementById('info-cliente-adicional');
        const clienteDetalles = document.getElementById('cliente-detalles');

        if (infoAdicional && clienteDetalles) {
            // Simular datos del cliente (en una implementación real, harías una petición AJAX)
            const detallesHTML = `
                <div class="grid grid-cols-1 gap-3">
                    <div class="flex justify-between items-center p-2 rounded-lg bg-gradient-to-r from-blue-600/10 to-indigo-600/10 border border-blue-400/20">
                        <span class="text-blue-300 font-medium">📧 Email:</span>
                        <span class="text-gray-300">${info.split(' ')[0] || 'No disponible'}</span>
                    </div>
                    <div class="flex justify-between items-center p-2 rounded-lg bg-gradient-to-r from-blue-600/10 to-indigo-600/10 border border-blue-400/20">
                        <span class="text-blue-300 font-medium">📱 Teléfono:</span>
                        <span class="text-gray-300">${info.split(' ')[1] || 'No disponible'}</span>
                    </div>
                    <div class="flex justify-between items-center p-2 rounded-lg bg-gradient-to-r from-blue-600/10 to-indigo-600/10 border border-blue-400/20">
                        <span class="text-blue-300 font-medium">🆔 ID Cliente:</span>
                        <span class="text-gray-300 font-mono">#${id}</span>
                    </div>
                </div>
            `;

            clienteDetalles.innerHTML = detallesHTML;
            infoAdicional.classList.remove('hidden');
        }
    }

    // Función para limpiar selección
    function limpiarSeleccion() {
        clienteActual = null;
        if (clienteInput) {
            clienteInput.value = '';
        }
        busquedaCliente.value = '';
        clienteSeleccionado.classList.add('hidden');
        sugerenciasContainer.classList.add('hidden');

        // Ocultar información adicional del cliente
        const infoAdicional = document.getElementById('info-cliente-adicional');
        if (infoAdicional) {
            infoAdicional.classList.add('hidden');
        }

        busquedaCliente.focus();
    }

    // Event listeners
    busquedaCliente.addEventListener('input', function() {
        clearTimeout(timeoutId);
        const query = this.value.trim();

        if (query.length === 0) {
            sugerenciasContainer.classList.add('hidden');
            return;
        }

        // Debounce para evitar demasiadas peticiones
        timeoutId = setTimeout(() => {
            buscarClientes(query);
        }, 300);
    });

    busquedaCliente.addEventListener('focus', function() {
        if (this.value.trim().length >= 2) {
            buscarClientes(this.value.trim());
        }
    });

    // Cerrar sugerencias al hacer click fuera
    document.addEventListener('click', function(e) {
        if (!busquedaCliente.contains(e.target) && !sugerenciasContainer.contains(e.target)) {
            sugerenciasContainer.classList.add('hidden');
        }
    });

    // Limpiar selección
    limpiarCliente.addEventListener('click', limpiarSeleccion);

    // Navegación con teclado
    busquedaCliente.addEventListener('keydown', function(e) {
        const sugerencias = document.querySelectorAll('.sugerencia-item');
        const currentActive = document.querySelector('.sugerencia-item.active');

        if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (currentActive) {
                currentActive.classList.remove('active');
                const next = currentActive.nextElementSibling;
                if (next) next.classList.add('active');
                else sugerencias[0]?.classList.add('active');
            } else {
                sugerencias[0]?.classList.add('active');
            }
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            if (currentActive) {
                currentActive.classList.remove('active');
                const prev = currentActive.previousElementSibling;
                if (prev) prev.classList.add('active');
                else sugerencias[sugerencias.length - 1]?.classList.add('active');
            } else {
                sugerencias[sugerencias.length - 1]?.classList.add('active');
            }
        } else if (e.key === 'Enter') {
            e.preventDefault();
            if (currentActive) {
                currentActive.click();
            }
        } else if (e.key === 'Escape') {
            sugerenciasContainer.classList.add('hidden');
        }
    });
});
</script>


