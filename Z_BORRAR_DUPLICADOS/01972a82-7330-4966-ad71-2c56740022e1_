{% extends "base.html" %}
{% load role_tags %}

{% block title %}Gestión de Equipo - eGarage{% endblock %}

{% block content %}
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <div class="sm:flex sm:items-center">
        <div class="sm:flex-auto">
            <h1 class="text-2xl font-bold text-gray-900">Gestión de Equipo</h1>
            <p class="mt-2 text-sm text-gray-700">
                Administra quién tiene acceso a tu taller y qué permisos tiene.
            </p>
        </div>
        {% if request.user|has_role:'Owner' %}
        <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
            <a href="{% url 'team:team_create' %}" class="inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto">
                <i class="fas fa-user-plus mr-2"></i> + Agregar Miembro
            </a>
        </div>
        {% endif %}
    </div>

    <!-- Estadísticas -->
    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-3">
        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0 bg-indigo-500 rounded-md p-3">
                        <i class="fas fa-users text-white text-xl"></i>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Total Miembros</dt>
                            <dd class="text-lg font-medium text-gray-900">{{ total_miembros|default:0 }}</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0 bg-green-500 rounded-md p-3">
                        <i class="fas fa-check-circle text-white text-xl"></i>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Activos</dt>
                            <dd class="text-lg font-medium text-gray-900">{{ total_activos|default:0 }}</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0 bg-red-500 rounded-md p-3">
                        <i class="fas fa-user-slash text-white text-xl"></i>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Desactivados</dt>
                            <dd class="text-lg font-medium text-gray-900">{{ total_desactivados|default:0 }}</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Owner (Usuario Principal) -->
    {% if owner %}
    <div class="mt-8 bg-white shadow rounded-lg overflow-hidden">
        <div class="px-4 py-5 sm:p-6 border-b border-gray-200">
            <h3 class="text-lg font-medium leading-6 text-gray-900">
                <i class="fas fa-crown text-yellow-500 mr-2"></i> Dueño del Taller
            </h3>
        </div>
        <div class="px-4 py-5 sm:p-6">
            <div class="flex items-center justify-between">
                <div>
                    <h4 class="text-lg font-medium text-gray-900">{{ owner.get_full_name|default:owner.username }}</h4>
                    <p class="mt-1 text-sm text-gray-500">
                        <i class="fas fa-envelope mr-2"></i>{{ owner.email }}
                    </p>
                </div>
                <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium bg-purple-100 text-purple-800">
                    <i class="fas fa-crown mr-1"></i> Owner
                </span>
            </div>
        </div>
    </div>
    {% endif %}

    <div class="mt-8 flex flex-col">
        <div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
            <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
                <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
                    <table class="min-w-full divide-y divide-gray-300">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Nombre</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Rol</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Estado</th>
                                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Fecha de Creación</th>
                                {% if request.user|has_role:'Owner' %}
                                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                                    <span class="sr-only">Acciones</span>
                                </th>
                                {% endif %}
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white">
                            {% for miembro in miembros %}
                            <tr class="{% if not miembro.is_active %}bg-gray-50{% endif %}">
                                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm sm:pl-6">
                                    <div class="flex items-center">
                                        <div class="h-10 w-10 flex-shrink-0">
                                            <!-- Avatar con iniciales -->
                                            <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-gray-500">
                                                <span class="font-medium leading-none text-white">
                                                    {{ miembro.user.first_name|first|upper }}{{ miembro.user.last_name|first|upper }}
                                                </span>
                                            </span>
                                        </div>
                                        <div class="ml-4">
                                            <div class="font-medium text-gray-900">
                                                {{ miembro.user.get_full_name|default:miembro.user.username }}
                                                {% if miembro.user == request.user %} <span class="text-indigo-600">(Tú)</span>{% endif %}
                                            </div>
                                            <div class="text-gray-500">{{ miembro.user.email }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                                    <!-- Badges de Rol -->
                                    {% if miembro.rol == 'Admin' %}
                                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-blue-100 text-blue-800">Administrador</span>
                                    {% elif miembro.rol == 'Vendedor' %}
                                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-green-100 text-green-800">Vendedor</span>
                                    {% elif miembro.rol == 'Tecnico' %}
                                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-yellow-100 text-yellow-800">Técnico</span>
                                    {% elif miembro.rol == 'MIXTO' %}
                                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-purple-100 text-purple-800">Mixto</span>
                                    {% else %}
                                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-gray-100 text-gray-800">{{ miembro.rol }}</span>
                                    {% endif %}
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                                    {% if miembro.is_active %}
                                        <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Activo</span>
                                    {% else %}
                                        <span class="inline-flex rounded-full bg-red-100 px-2 text-xs font-semibold leading-5 text-red-800">Desactivado</span>
                                    {% endif %}
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                                    {{ miembro.fecha_creacion|date:"d/m/Y" }}
                                </td>
                                {% if request.user|has_role:'Owner' %}
                                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                    {% if miembro.user != owner %}
                                        <!-- Acciones Owner -->
                                        <a href="{% url 'team:team_update' miembro.pk %}" class="text-indigo-600 hover:text-indigo-900 mr-4">
                                            <i class="fas fa-edit"></i> Editar
                                        </a>
                                        
                                        {% if miembro.is_active %}
                                            <a href="{% url 'team:team_delete' miembro.pk %}" class="text-red-600 hover:text-red-900" 
                                               onclick="return confirm('¿Estás seguro de desactivar a {{ miembro.user.get_full_name|default:miembro.user.email }}?');">
                                                <i class="fas fa-user-slash"></i> Desactivar
                                            </a>
                                        {% else %}
                                            <a href="{% url 'team:team_reactivate' miembro.pk %}" class="text-green-600 hover:text-green-900"
                                               onclick="return confirm('¿Reactivar a {{ miembro.user.get_full_name|default:miembro.user.email }}?');">
                                                <i class="fas fa-user-check"></i> Reactivar
                                            </a>
                                        {% endif %}
                                    {% else %}
                                        <span class="text-gray-400 text-xs">Usuario principal</span>
                                    {% endif %}
                                </td>
                                {% endif %}
                            </tr>
                            {% empty %}
                            <tr>
                                <td colspan="5" class="px-6 py-12 text-center text-gray-500">
                                    <i class="fas fa-users fa-3x mb-4 text-gray-300"></i>
                                    <p class="text-sm">No hay miembros del equipo registrados.</p>
                                    {% if request.user|has_role:'Owner' %}
                                    <a href="{% url 'team:team_create' %}" class="mt-4 inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700">
                                        <i class="fas fa-user-plus mr-2"></i> Agregar Primer Miembro
                                    </a>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
