{% extends 'base.html' %}
{% load static %}

{% block title %}Configuración del Taller - eGarage{% endblock %}

{% block content %}
<div style="padding: 2rem; max-width: 800px; margin: 0 auto;">
    <h1 style="color: #00ffff; text-align: center; margin-bottom: 2rem;">
        ⚙️ Configuración del Taller
    </h1>

    <div style="background: rgba(0, 0, 0, 0.8); padding: 2rem; border-radius: 10px; border: 1px solid #00ffff;">
        <h2 style="color: #ffffff; margin-bottom: 1rem;">Información de la Empresa</h2>

        <form method="post" style="display: flex; flex-direction: column; gap: 1rem;">
            {% csrf_token %}

            <div>
                <label style="color: #00ffff; display: block; margin-bottom: 0.5rem;">Nombre del Taller:</label>
                <input type="text" name="nombre_taller" value="{{ empresa.nombre_taller|default:'' }}"
                       style="width: 100%; padding: 0.8rem; background: rgba(0, 0, 0, 0.6); border: 1px solid #00ffff; border-radius: 5px; color: #ffffff;">
            </div>

            <div>
                <label style="color: #00ffff; display: block; margin-bottom: 0.5rem;">Empresa:</label>
                <input type="text" name="empresa_nombre" value="{{ empresa.empresa|default:'' }}"
                       style="width: 100%; padding: 0.8rem; background: rgba(0, 0, 0, 0.6); border: 1px solid #00ffff; border-radius: 5px; color: #ffffff;">
            </div>

            <div>
                <label style="color: #00ffff; display: block; margin-bottom: 0.5rem;">Teléfono:</label>
                <input type="text" name="telefono" value="{{ empresa.telefono|default:'' }}"
                       style="width: 100%; padding: 0.8rem; background: rgba(0, 0, 0, 0.6); border: 1px solid #00ffff; border-radius: 5px; color: #ffffff;">
            </div>

            <div>
                <label style="color: #00ffff; display: block; margin-bottom: 0.5rem;">Email:</label>
                <input type="email" name="email" value="{{ empresa.email|default:'' }}"
                       style="width: 100%; padding: 0.8rem; background: rgba(0, 0, 0, 0.6); border: 1px solid #00ffff; border-radius: 5px; color: #ffffff;">
            </div>

            <div>
                <label style="color: #00ffff; display: block; margin-bottom: 0.5rem;">Dirección:</label>
                <textarea name="direccion" rows="3"
                          style="width: 100%; padding: 0.8rem; background: rgba(0, 0, 0, 0.6); border: 1px solid #00ffff; border-radius: 5px; color: #ffffff; resize: vertical;">{{ empresa.direccion|default:'' }}</textarea>
            </div>

            <button type="submit" name="actualizar_empresa"
                    style="background: linear-gradient(45deg, #00ffff, #00ff7f); color: #000; padding: 1rem 2rem; border: none; border-radius: 5px; font-weight: bold; cursor: pointer; margin-top: 1rem;">
                💾 Guardar Configuración
            </button>
        </form>
    </div>

    <div style="text-align: center; margin-top: 2rem;">
        <a href="{% url 'chile:centro_operaciones' %}"
           style="color: #00ffff; text-decoration: none; padding: 0.8rem 1.5rem; border: 1px solid #00ffff; border-radius: 5px; display: inline-block;">
            ← Volver al Dashboard
        </a>
    </div>
</div>
{% endblock %}
